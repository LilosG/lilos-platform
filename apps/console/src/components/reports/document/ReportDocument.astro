---
import type { ReportDetail } from "../../../adapters/reports";
import { documentView } from "../../../lib/report-document";
import BarChart from "./BarChart.astro";
import HorizontalChart from "./HorizontalChart.astro";
import Pair from "./Pair.astro";
import SectionHead from "./SectionHead.astro";
import EmptyState from "../../ui/EmptyState.astro";
interface Props {
  report: ReportDetail;
}
const { report } = Astro.props;
const view = documentView(report);
const { cover, scorecard: score } = view;
// Sections are numbered in the order they appear; one with nothing to say is left out entirely.
const sections = [
  ...(view.glance ? ["glance"] : []),
  "scorecard",
  ...(view.gbp ? ["gbp"] : []),
  ...(view.search ? ["search"] : []),
  ...(view.visits ? ["visits"] : []),
  ...(view.reviews ? ["reviews"] : []),
  ...(view.work ? ["work"] : []),
  ...(view.ahead ? ["ahead"] : []),
  "notes",
] as string[];
const number = (id: string) => sections.indexOf(id) + 1;
const arrow = { up: "▲", down: "▼", flat: "■", none: "" } as const;
---

<article class="doc" data-report-document data-draft={view.draft}>
  {
    view.draft && (
      <p class="draftbanner" data-draft-banner>
        Draft - not for sending
      </p>
    )
  }
  <header class="cover">
    <p class="kicker mono">{cover.kicker}</p>
    <h1>{cover.title}</h1>
    <p class="lede">{cover.intro}</p>
    <p class="prepared">Prepared by {cover.preparedBy} · {cover.preparedOn}</p>
    {
      cover.milestones && (
        <ol class="timeline" data-timeline>
          {cover.milestones.map((item) => (
            <li>
              <span class="when mono">{item.date}</span>
              <span>{item.label}</span>
            </li>
          ))}
        </ol>
      )
    }
  </header>

  {
    view.glance && (
      <section data-section="glance" aria-labelledby="s-glance">
        <SectionHead
          head={view.glance.head}
          number={number("glance")}
          id="s-glance"
        />
        {view.glance.cards.length > 0 && (
          <div class="results">
            {view.glance.cards.map((card) => (
              <div
                class:list={["result", { headline: card.headline }]}
                data-result
              >
                <p class:list={["big", card.tone]}>{card.value}</p>
                <div>
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                </div>
                <p class="foot mono">{card.footer}</p>
              </div>
            ))}
          </div>
        )}
        {view.glance.prose.map((text) => (
          <p class="prose">{text}</p>
        ))}
      </section>
    )
  }

  <section data-section="scorecard" aria-labelledby="s-score">
    <SectionHead head={score.head} number={number("scorecard")} id="s-score" />
    {
      score.card.groups.length ? (
        <div
          class="card flush"
          role="region"
          tabindex="0"
          aria-label="Scorecard"
        >
          <table class="score">
            <thead>
              <tr>
                <th scope="col">What we measured</th>
                <th scope="col" class="dnum">
                  This period
                </th>
                <th scope="col" class="dnum">
                  Compared with
                </th>
                <th scope="col" class="dnum">
                  Change
                </th>
                {score.card.hasYear && (
                  <th scope="col" class="dnum">
                    Same months last year
                  </th>
                )}
              </tr>
            </thead>
            {score.card.groups.map((group) => (
              <tbody>
                <tr class="group">
                  <th scope="colgroup" colspan={score.card.hasYear ? 5 : 4}>
                    {group.kicker}
                  </th>
                </tr>
                {group.rows.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.label}
                      <span class="dsub">{row.source}</span>
                      {row.note && <span class="dsub note">{row.note}</span>}
                    </th>
                    <td class="dnum strong">
                      {row.current}
                      {row.currentSub && (
                        <span class="dsub">{row.currentSub}</span>
                      )}
                    </td>
                    <td class="dnum">{row.compared}</td>
                    <td class:list={["dnum", "change", row.tone]}>
                      {arrow[row.direction] && (
                        <span aria-hidden="true">{arrow[row.direction]} </span>
                      )}
                      {row.change}
                    </td>
                    {score.card.hasYear && (
                      <td class="dnum">
                        {row.year ?? "No comparison"}
                        {row.yearChange && (
                          <span class="dsub">{row.yearChange}</span>
                        )}
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      ) : (
        <EmptyState title="No figures to compare yet">
          Nothing in this report could be stated for the period. The reasons are
          listed under “Notes and definitions”.
        </EmptyState>
      )
    }
    {score.card.footnotes.map((text) => <p class="dcaption">{text}</p>)}
  </section>

  {
    view.gbp && (
      <section data-section="gbp" aria-labelledby="s-gbp">
        <SectionHead head={view.gbp.head} number={number("gbp")} id="s-gbp" />
        <div class="charts">
          {view.gbp.charts.map((chart) => (
            <BarChart chart={chart} />
          ))}
        </div>
        {view.gbp.splits.length > 0 && (
          <div class="splits">
            {view.gbp.splits.map((split) => (
              <HorizontalChart
                title={split.title}
                model={split.model}
                caption={
                  split.title === "Device people used"
                    ? "How many people looked at the profile on a phone and how many on a computer."
                    : "Whether people met the profile in Google Maps or in regular Google Search."
                }
              />
            ))}
          </div>
        )}
        {view.gbp.terms && (
          <div
            class="card flush"
            role="region"
            tabindex="0"
            aria-label="Top search terms"
          >
            <h3 class="cardtitle">Searches that showed the profile</h3>
            <table class="plain">
              <thead>
                <tr>
                  <th scope="col">Search</th>
                  <th scope="col" class="dnum">
                    Times shown
                  </th>
                </tr>
              </thead>
              <tbody>
                {view.gbp.terms.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.keyword}</th>
                    <td class="dnum">{row.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="dcaption inset">
              Google reports a count for common searches and only “fewer than” a
              number for rare ones, shown as “&lt; N”.
              {view.gbp.terms.more > 0 &&
                ` and ${view.gbp.terms.more.toLocaleString("en-US")} more searches are not listed.`}
              {view.gbp.terms.note && ` ${view.gbp.terms.note}`}
            </p>
          </div>
        )}
        {view.gbp.actions && (
          <div
            class="card flush"
            role="region"
            tabindex="0"
            aria-label="Actions by month"
          >
            <h3 class="cardtitle">Actions taken on the profile</h3>
            <table class="plain months">
              <thead>
                <tr>
                  <th scope="col">Action</th>
                  {view.gbp.actions.months.map((month) => (
                    <th scope="col" class="dnum">
                      {month}
                    </th>
                  ))}
                  <th scope="col" class="dnum">
                    Total
                  </th>
                </tr>
              </thead>
              <tbody>
                {view.gbp.actions.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    {row.cells.map((cell) => (
                      <td class="dnum">{cell}</td>
                    ))}
                    <td class="dnum strong">{row.total}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="dcaption inset">
              Calls, website clicks and direction requests are the actions
              closest to a visit.
            </p>
          </div>
        )}
        {view.gbp.locations.length > 0 && (
          <div
            class="card flush"
            role="region"
            tabindex="0"
            aria-label="By location"
          >
            <h3 class="cardtitle">By location</h3>
            <table class="plain">
              <thead>
                <tr>
                  <th scope="col">Location</th>
                  <th scope="col" class="dnum">
                    Profile views
                  </th>
                  <th scope="col" class="dnum">
                    Calls
                  </th>
                  <th scope="col" class="dnum">
                    Website clicks
                  </th>
                  <th scope="col" class="dnum">
                    Directions
                  </th>
                </tr>
              </thead>
              <tbody>
                {view.gbp.locations.map((row) => (
                  <tr>
                    <th scope="row">{row.name}</th>
                    <td class="dnum">{row.views}</td>
                    <td class="dnum">{row.calls}</td>
                    <td class="dnum">{row.website}</td>
                    <td class="dnum">{row.directions}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    )
  }

  {
    view.search && (
      <section data-section="search" aria-labelledby="s-search">
        <SectionHead
          head={view.search.head}
          number={number("search")}
          id="s-search"
        />
        {view.search.view.tiles.length > 0 && (
          <div class="tiles" data-search-tiles>
            {view.search.view.tiles.map((tile) => (
              <div>
                <p class="tilelabel">{tile.label}</p>
                <p class="tilevalue">{tile.value}</p>
                {tile.line && (
                  <p class:list={["tileline", tile.tone]}>{tile.line}</p>
                )}
              </div>
            ))}
          </div>
        )}
        {view.search.view.topics.length > 0 && (
          <div data-topics>
            <h3 class="dsubhead">Results by search topic</h3>
            <div
              class="card flush"
              role="region"
              tabindex="0"
              aria-label="Results by search topic"
            >
              <table class="plain topics">
                <thead>
                  <tr>
                    <th scope="col">Topic</th>
                    <th scope="col" class="dnum">
                      Top 10 searches
                      {view.search.view.comparable && (
                        <span class="dsub">before → after</span>
                      )}
                    </th>
                    <th scope="col" class="dnum">
                      Average position
                      {view.search.view.comparable && (
                        <span class="dsub">before → after</span>
                      )}
                    </th>
                    <th scope="col" class="dnum">
                      Clicks
                      {view.search.view.comparable && (
                        <span class="dsub">before → after</span>
                      )}
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {view.search.view.topics.map((topic) => (
                    <tr>
                      <th scope="row">
                        {topic.label}
                        <span class="dsub">{topic.examples}</span>
                      </th>
                      <td class="dnum">
                        <Pair value={topic.top10} />
                      </td>
                      <td class="dnum">
                        <Pair value={topic.position} />
                      </td>
                      <td class="dnum">
                        <Pair value={topic.clicks} />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="dcaption">
              {view.search.view.topicNote}
              {view.search.view.positionNote &&
                ` ${view.search.view.positionNote}`}
            </p>
          </div>
        )}
        {view.search.view.gains.length > 0 && (
          <div data-gains>
            <h3 class="dsubhead">Searches that gained ground</h3>
            <div
              class="card flush"
              role="region"
              tabindex="0"
              aria-label="Searches that gained ground"
            >
              <table class="plain gains">
                <thead>
                  <tr>
                    <th scope="col">Search</th>
                    <th scope="col" class="dnum">
                      Position
                      <span class="dsub">before → after</span>
                    </th>
                    <th scope="col" class="dnum">
                      Impressions
                      <span class="dsub">before → after</span>
                    </th>
                    <th scope="col" class="dnum">
                      Clicks
                      <span class="dsub">before → after</span>
                    </th>
                  </tr>
                </thead>
                {view.search.view.gains.map((group) => (
                  <tbody>
                    <tr class="group">
                      <th scope="colgroup" colspan="4">
                        {group.label}
                      </th>
                    </tr>
                    {group.rows.map((row) => (
                      <tr>
                        <th scope="row">{row.query}</th>
                        <td class="dnum">
                          <Pair value={row.position} />
                        </td>
                        <td class="dnum">
                          <Pair value={row.impressions} />
                        </td>
                        <td class="dnum">
                          <Pair value={row.clicks} />
                        </td>
                      </tr>
                    ))}
                  </tbody>
                ))}
              </table>
            </div>
            {view.search.view.gainNote && (
              <p class="dcaption">{view.search.view.gainNote}</p>
            )}
          </div>
        )}
        <div class="charts">
          {view.search.view.charts.map((chart) => (
            <BarChart chart={chart} />
          ))}
        </div>
        {view.search.view.pages.length > 0 && (
          <div>
            <h3 class="dsubhead">Pages people landed on</h3>
            <div
              class="card flush"
              role="region"
              tabindex="0"
              aria-label="Top pages"
            >
              <table class="plain">
                <thead>
                  <tr>
                    <th scope="col">Page</th>
                    <th scope="col" class="dnum">
                      Position
                    </th>
                    <th scope="col" class="dnum">
                      Impressions
                    </th>
                    <th scope="col" class="dnum">
                      Clicks
                    </th>
                    <th scope="col" class="dnum">
                      Change in clicks
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {view.search.view.pages.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      <td class="dnum">{row.position}</td>
                      <td class="dnum">{row.impressions}</td>
                      <td class="dnum">{row.clicks}</td>
                      <td class="dnum">{row.change}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="dcaption">{view.search.view.pagesNote}</p>
          </div>
        )}
        {view.search.view.lagNote && (
          <p class="dcaption">{view.search.view.lagNote}</p>
        )}
      </section>
    )
  }

  {
    view.visits && (
      <section data-section="visits" aria-labelledby="s-visits">
        <SectionHead
          head={view.visits.head}
          number={number("visits")}
          id="s-visits"
        />
        <div class="charts">
          <BarChart chart={view.visits.chart} />
        </div>
      </section>
    )
  }

  {
    view.reviews && (
      <section data-section="reviews" aria-labelledby="s-reviews">
        <SectionHead
          head={view.reviews.head}
          number={number("reviews")}
          id="s-reviews"
        />
        <div class="dreviewhead">
          {view.reviews.view.rating && (
            <div class="card rating">
              <p class="big">{view.reviews.view.rating}</p>
              <p class="dcaption">
                Average Google rating
                {view.reviews.view.total &&
                  ` across ${view.reviews.view.total} reviews`}
              </p>
            </div>
          )}
          {view.reviews.view.distribution && (
            <HorizontalChart
              title="Star ratings across all reviews"
              model={view.reviews.view.distribution}
              caption={view.reviews.view.caption}
            />
          )}
        </div>
        <div class="tiles">
          {view.reviews.view.stats.map((stat) => (
            <div>
              <p class="tilelabel">{stat.label}</p>
              <p class="tilevalue">{stat.value}</p>
              <p class="tileline">{stat.detail}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    view.work && (
      <section data-section="work" aria-labelledby="s-work">
        <SectionHead
          head={view.work.head}
          number={number("work")}
          id="s-work"
        />
        <ul class="work">
          {view.work.lines.map((line) => (
            <li class="card">
              <p class="worklabel">
                <strong>{line.count}</strong> {line.label}
              </p>
              {line.titles.length > 0 && (
                <ul class="titles">
                  {line.titles.map((title) => (
                    <li>{title}</li>
                  ))}
                  {line.more > 0 && (
                    <li class="more">
                      and {line.more.toLocaleString("en-US")} more
                    </li>
                  )}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    view.ahead && (
      <section data-section="ahead" aria-labelledby="s-ahead">
        <SectionHead
          head={view.ahead.head}
          number={number("ahead")}
          id="s-ahead"
        />
        <div class="card ahead">
          {view.ahead.paragraphs.map((text) => (
            <p class="prose">{text}</p>
          ))}
        </div>
      </section>
    )
  }

  <section class="notes" data-section="notes" aria-labelledby="s-notes">
    <SectionHead head={view.notes.head} number={number("notes")} id="s-notes" />
    <ul class="notelist">
      <li>
        <b>This report.</b>
        {view.notes.period}
        {view.notes.sync.join(" ")}
      </li>
      {
        view.notes.definitions.map((item) => (
          <li>
            <b>{item.term}.</b>
            {item.text}
          </li>
        ))
      }
      {view.notes.footnotes.map((text) => <li>{text}</li>)}
      {view.notes.dataNotes.map((text) => <li>{text}</li>)}
      {
        view.notes.notIncluded.length > 0 && (
          <li>
            <b>Not included in this report.</b>
            {view.notes.notIncluded.join("; ")}.
          </li>
        )
      }
    </ul>
  </section>
</article>
