---
import "../../styles/reports.css";
import type { ReportDetail } from "../../adapters/reports";
import {
  comparisonBody,
  comparisonQuery,
  comparisonSlug,
  periodSlug,
  reportHref,
} from "../../lib/report-period";
import {
  comparisonText,
  earliestSendDay,
  headline,
  headlineTiles,
  narrativeView,
  noteGroups,
  notesChip,
  periodLabel,
  periodRange,
  readinessChip,
  reportActions,
  reportChip,
  reportRef,
} from "../../lib/report-view";
import { scorecard } from "../../lib/report-document";
import { dateText } from "../../lib/present";
import MetricStrip from "../ui/MetricStrip.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
import EmptyState from "../ui/EmptyState.astro";
import DataTable from "../ui/DataTable.astro";
import ConfirmDialog from "../administration/ConfirmDialog.astro";
interface Props {
  report: ReportDetail;
  api: string;
  today: string;
}
const { report, api, today } = Astro.props;
const snap = report.snapshot;
const { period, comparison } = reportRef(report);
const tiles = headlineTiles(snap);
const card = scorecard(snap);
const narrative = narrativeView(report);
const actions = reportActions(report);
const notes = noteGroups(snap);
const chip = notesChip(snap);
const gbpWaiting = snap.gbp.availability === "unavailable";
const documentHref = reportHref(report.client_slug, period, comparison, {
  revision: report.revision,
  document: true,
});
const printHref = `${documentHref}${documentHref.includes("?") ? "&" : "?"}print=1`;
---

<article
  class="reportpage"
  data-report-page
  data-api={api}
  data-period={periodSlug(period)}
  data-comparison={comparisonSlug(comparison)}
  data-vs={comparisonQuery(comparison)}
  data-start={period.start}
  data-end={period.end}
  data-comparison-body={JSON.stringify(comparisonBody(comparison))}
  data-client-slug={report.client_slug}
  data-revision={report.revision}
  data-client={report.client_name}
>
  <div class="reporthead">
    <div class="eyebrow">{report.client_name}</div>
    <h1>{headline(report)}</h1>
    <p class="muted">
      {periodRange(period)} · compared with {comparisonText(snap)}
    </p>
    <div class="chipwrap">
      <StatusBadge
        text={reportChip(report.status).label}
        tone={reportChip(report.status).tone}
      />
      <StatusBadge
        text={readinessChip(report.readiness).label}
        tone={readinessChip(report.readiness).tone}
      />
      {
        report.delivery && (
          <span class="muted">Sent {dateText(report.delivery.sent_on)}</span>
        )
      }
      {
        !report.is_current && (
          <span class="muted">An earlier version of this report</span>
        )
      }
    </div>
    <div class="reportactions">
      <a class="control" href={`/clients/${report.client_slug}/reports/`}
        >All reports</a
      >
      <button
        type="button"
        class="control"
        data-dialog="report-notes"
        aria-label={`Details. Data status: ${chip.label}`}
      >
        Details
      </button>
      <a
        class="control"
        href={printHref}
        target="_blank"
        rel="noopener"
        data-report-download>Download PDF</a
      >
      {
        narrative.editable && (
          <button type="button" class="control" inert data-report-regenerate>
            Regenerate data
          </button>
        )
      }
      {
        report.status === "draft" && (
          <button
            type="button"
            class="control primary"
            inert
            disabled={!actions.approve.allowed}
            data-report-approve
          >
            Approve
          </button>
        )
      }
    </div>
    {
      actions.approve.why && report.status === "draft" && (
        <p class="muted">{actions.approve.why}</p>
      )
    }
    {
      report.status === "ready" && actions.send.allowed && (
        <div class="reportactions">
          <label>
            Sent on{" "}
            <input
              type="date"
              name="sent_on"
              min={earliestSendDay(period)}
              max={today}
            />
          </label>
          <button type="button" class="control primary" inert data-report-send>
            Mark as sent
          </button>
        </div>
      )
    }
    <p class="formstatus" role="status" aria-live="polite" data-report-status>
    </p>
  </div>

  {
    gbpWaiting ? (
      <section class="panel">
        <EmptyState title="Business Profile data is missing">
          No day of {periodRange(period)} has synced from Google yet. Reconnect
          Google, then regenerate this report.
          <a
            slot="action"
            class="control primary"
            href={`/clients/${report.client_slug}/integrations/`}
          >
            Open Integrations
          </a>
        </EmptyState>
      </section>
    ) : tiles.length ? (
      <MetricStrip items={tiles} />
    ) : (
      <section class="panel">
        <EmptyState title="No headline figures yet">
          None of the headline figures could be compared with the earlier
          period. Open Details to see why.
        </EmptyState>
      </section>
    )
  }

  {
    card.groups.length > 0 && (
      <section
        class="panel tablewrap"
        role="region"
        aria-label="Scorecard"
        tabindex="0"
      >
        <SectionHeading>
          <Fragment slot="title">Scorecard</Fragment>
        </SectionHeading>
        <DataTable>
          <thead>
            <tr>
              <th scope="col">Measure</th>
              <th scope="col">This period</th>
              <th scope="col">Compared with</th>
              <th scope="col">Change</th>
              {card.hasYear && <th scope="col">Same period last year</th>}
            </tr>
          </thead>
          {card.groups.map((group) => (
            <tbody>
              <tr>
                <th scope="colgroup" colspan={card.hasYear ? 5 : 4}>
                  {group.title}
                </th>
              </tr>
              {group.rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td>{row.current}</td>
                  <td>{row.compared}</td>
                  <td>{row.change}</td>
                  {card.hasYear && <td>{row.year ?? "No comparison"}</td>}
                </tr>
              ))}
            </tbody>
          ))}
        </DataTable>
        {card.footnotes.map((text) => (
          <p class="muted tablenote">{text}</p>
        ))}
        {card.rowNotes.map((text) => (
          <p class="muted tablenote">{text}</p>
        ))}
      </section>
    )
  }

  <section class="panel narrative" data-report-narrative>
    <SectionHeading>
      <Fragment slot="title">Summary and next steps</Fragment>
      <Fragment slot="actions">
        {
          narrative.editable && (
            <span>
              <button type="button" class="control" inert data-report-draft>
                Draft with Hermes
              </button>
              <button
                type="button"
                class="control primary"
                inert
                data-report-save
              >
                Save narrative
              </button>
            </span>
          )
        }
      </Fragment>
    </SectionHeading>
    {
      narrative.drafted && narrative.editable && (
        <p class="muted">
          Drafted by Hermes from this report’s numbers. Review and edit before
          approving.
        </p>
      )
    }
    {
      narrative.sections.map((section) => (
        <div>
          <h3>{section.title}</h3>
          {narrative.editable ? (
            <textarea
              name={section.field}
              rows="6"
              maxlength="4000"
              aria-label={section.title}
            >
              {section.paragraphs.join("\n\n")}
            </textarea>
          ) : section.paragraphs.length ? (
            section.paragraphs.map((text) => <p>{text}</p>)
          ) : (
            <p class="muted">Not written.</p>
          )}
        </div>
      ))
    }
    {
      narrative.cards.length > 0 && (
        <div>
          <h3>Result cards</h3>
          <p class="muted">
            The results at the top of the client document. The figures are
            fixed; edit the wording.
          </p>
          {narrative.cards.map((card, index) => (
            <div
              class="resultcard"
              data-result-card
              data-keys={card.keys}
              data-tone={card.tone}
              data-headline={String(card.headline)}
            >
              {narrative.editable ? (
                <>
                  <input
                    type="text"
                    name={`card_title_${index}`}
                    maxlength="80"
                    value={card.title}
                    aria-label={`Card ${index + 1} title`}
                  />
                  <textarea
                    name={`card_text_${index}`}
                    rows="3"
                    maxlength="500"
                    aria-label={`Card ${index + 1} sentence`}
                  >
                    {card.text}
                  </textarea>
                </>
              ) : (
                <>
                  <p>
                    <strong>{card.title}</strong>
                  </p>
                  <p>{card.text}</p>
                </>
              )}
            </div>
          ))}
        </div>
      )
    }
  </section>

  <dialog
    id="report-notes"
    aria-labelledby="report-notes-title"
    data-shell-dialog
  >
    <div class="panelhead">
      <span class="muted">{report.client_name}</span><button
        type="button"
        class="close"
        aria-label="Close details"
        data-close>×</button
      >
    </div>
    <div class="body">
      <h2 id="report-notes-title">Report details</h2>
      <p>
        <StatusBadge text={chip.label} tone={chip.tone} />
      </p>
      <p>
        Covers {periodLabel(period)}, compared with {comparisonText(snap)}.
      </p>
      {
        snap.sync.gbp && (
          <p class="muted">
            Business Profile last synced {dateText(snap.sync.gbp)}.
          </p>
        )
      }
      {
        snap.sync.search_console && (
          <p class="muted">
            Search Console last synced {dateText(snap.sync.search_console)}.
          </p>
        )
      }
      {
        snap.sync.analytics && (
          <p class="muted">
            Google Analytics last synced {dateText(snap.sync.analytics)}.
          </p>
        )
      }
      {
        notes.length ? (
          notes.map((group) => (
            <div class="listrow">
              <div>
                {group.section}
                {group.notes.map((text) => (
                  <small>{text}</small>
                ))}
              </div>
            </div>
          ))
        ) : (
          <p>Every source behind this report is complete.</p>
        )
      }
    </div>
    <div class="dialogfoot">
      <button type="button" class="control" data-close>Close</button>
    </div>
  </dialog>
  <ConfirmDialog id="report-confirm" />
</article>
<script>
  import "../../lib/report-actions";
</script>
