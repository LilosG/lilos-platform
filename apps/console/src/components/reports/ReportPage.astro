---
import "../../styles/reports.css";
import type { ReportDetail } from "../../adapters/reports";
import {
  analyticsView,
  comparisonRows,
  dailyCharts,
  headline,
  locationRows,
  monthRange,
  monthSlug,
  narrativeView,
  noteGroups,
  notesChip,
  profileTiles,
  readinessChip,
  reportActions,
  reportChip,
  reviewsView,
  searchView,
  sourceRows,
  splitViews,
  termRows,
  workRows,
  workTotal,
  reasonText,
} from "../../lib/report-view";
import { dateText } from "../../lib/present";
import MetricStrip from "../ui/MetricStrip.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
import EmptyState from "../ui/EmptyState.astro";
import DataTable from "../ui/DataTable.astro";
import VisibilityChart from "../local-search/VisibilityChart.astro";
import Stars from "../reviews/Stars.astro";
import ConfirmDialog from "../administration/ConfirmDialog.astro";
interface Props {
  report: ReportDetail;
  api: string;
  today: string;
}
const { report, api, today } = Astro.props;
const snap = report.snapshot;
const tiles = profileTiles(snap);
const charts = dailyCharts(snap);
const { splits, complete } = splitViews(snap);
const sources = sourceRows(snap);
const terms = termRows(snap);
const rows = comparisonRows(snap);
const places = locationRows(snap);
const reviews = reviewsView(snap);
const search = searchView(snap);
const visits = analyticsView(snap);
const work = workRows(snap);
const narrative = narrativeView(report);
const actions = reportActions(report);
const notes = noteGroups(snap);
const chip = notesChip(snap);
const gbpWaiting = snap.gbp.availability === "unavailable";
const slug = monthSlug(report.month);
---

<article
  class="reportpage"
  data-report-page
  data-api={api}
  data-slug={slug}
  data-client-slug={report.client_slug}
  data-revision={report.revision}
  data-client={report.client_name}
  data-month={report.month}
>
  <div class="reporthead">
    <div class="printbrand" aria-hidden="true">
      LILOs Growth · Monthly performance report
    </div>
    <div class="eyebrow">{report.client_name}</div>
    <h1>{headline(report)}</h1>
    <p class="muted">{monthRange(report.month)}</p>
    <div class="chipwrap">
      <StatusBadge
        text={reportChip(report.status).label}
        tone={reportChip(report.status).tone}
      />
      <StatusBadge
        text={readinessChip(report.readiness).label}
        tone={readinessChip(report.readiness).tone}
      />
      <button
        type="button"
        class="statuschip noprint"
        data-dialog="report-notes"
        aria-label={`Data status: ${chip.label}. Open details`}
      >
        <StatusBadge text={chip.label} tone={chip.tone} />
      </button>
      {
        report.delivery && (
          <span class="muted">Sent {dateText(report.delivery.sent_on)}</span>
        )
      }
      {
        !report.is_current && (
          <span class="muted">An earlier version of this report</span>
        )
      }
    </div>
    <div class="reportactions noprint">
      <a class="control" href={`/clients/${report.client_slug}/reports/`}
        >All reports</a
      >
      <button type="button" class="control" inert data-report-print
        >Download</button
      >
      {
        narrative.editable && (
          <button type="button" class="control" inert data-report-regenerate>
            Regenerate data
          </button>
        )
      }
      {
        report.status === "draft" && (
          <button
            type="button"
            class="control primary"
            inert
            disabled={!actions.approve.allowed}
            data-report-approve
          >
            Approve
          </button>
        )
      }
    </div>
    {
      actions.approve.why && report.status === "draft" && (
        <p class="muted noprint">{actions.approve.why}</p>
      )
    }
    {
      report.status === "ready" && actions.send.allowed && (
        <div class="reportactions noprint">
          <label>
            Sent on{" "}
            <input type="date" name="sent_on" min={report.month} max={today} />
          </label>
          <button type="button" class="control primary" inert data-report-send>
            Mark as sent
          </button>
        </div>
      )
    }
    <p
      class="formstatus noprint"
      role="status"
      aria-live="polite"
      data-report-status
    >
    </p>
  </div>

  {
    gbpWaiting ? (
      <section class="panel">
        <EmptyState title="Business Profile data is missing">
          No day of {monthRange(report.month)} has synced from Google yet.
          Reconnect Google, then regenerate this report.
          <a
            slot="action"
            class="control primary"
            href={`/clients/${report.client_slug}/integrations/`}
          >
            Open Integrations
          </a>
        </EmptyState>
      </section>
    ) : (
      <Fragment>
        <MetricStrip items={tiles.headline} />
        <MetricStrip
          items={[...tiles.optional, tiles.rate]}
          columns={tiles.optional.length >= 3 ? 4 : 3}
        />
        <div class="splitgrid">
          <section class="panel">
            <SectionHeading>
              <Fragment slot="title">Profile views per day</Fragment>
            </SectionHeading>
            {charts.views ? (
              <div class="chartbody">
                <VisibilityChart
                  chart={charts.views}
                  label="Daily profile views across the month"
                />
              </div>
            ) : (
              <EmptyState title="Not enough days to chart">
                A trend appears once at least two days have synced.
              </EmptyState>
            )}
          </section>
          <section class="panel">
            <SectionHeading>
              <Fragment slot="title">Actions per day</Fragment>
            </SectionHeading>
            {charts.actions ? (
              <div class="chartbody">
                <VisibilityChart
                  chart={charts.actions}
                  label="Daily calls, website clicks and direction requests"
                />
              </div>
            ) : (
              <EmptyState title="Not enough days to chart">
                A trend appears once at least two days have synced.
              </EmptyState>
            )}
          </section>
        </div>
        {charts.note && <p class="muted">{charts.note}</p>}
        <div class="splitgrid">
          {complete ? (
            splits.map((split) => (
              <section class="panel">
                <SectionHeading>
                  <Fragment slot="title">{split.title}</Fragment>
                </SectionHeading>
                <div class="chartbody">
                  {split.rows.map((row) => (
                    <div class="splitrow">
                      <div>
                        <span>{row.label}</span>
                        <b>
                          {row.value} · {row.share}%
                        </b>
                      </div>
                      <div class="splitbar">
                        <i style={`width:${row.share}%`} />
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            ))
          ) : (
            <section class="panel">
              <EmptyState title="Where views came from">
                The split appears once every day of the month has synced.
              </EmptyState>
            </section>
          )}
          <section class="panel">
            <SectionHeading>
              <Fragment slot="title">Where profile views came from</Fragment>
            </SectionHeading>
            <div class="chartbody">
              {sources.map((row) => (
                <div class="splitrow">
                  <div>
                    <span>{row.label}</span>
                    <b>
                      {row.value} · {row.share}%
                    </b>
                  </div>
                  <div class="splitbar">
                    <i style={`width:${row.share}%`} />
                  </div>
                </div>
              ))}
            </div>
          </section>
        </div>
        <section
          class="panel tablewrap"
          role="region"
          aria-label="Every profile figure"
          tabindex="0"
        >
          <SectionHeading>
            <Fragment slot="title">Every profile figure, compared</Fragment>
          </SectionHeading>
          <DataTable>
            <thead>
              <tr>
                <>
                  <th scope="col">Figure</th>
                  <th class="num" scope="col">
                    This month
                  </th>
                </>
                <>
                  <th class="num" scope="col">
                    Last month
                  </th>
                  <th class="num" scope="col">
                    Change
                  </th>
                </>
                <>
                  <th class="num" scope="col">
                    Same month last year
                  </th>
                  <th class="num" scope="col">
                    Change
                  </th>
                </>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td>
                    {row.label}
                    {row.partial && (
                      <small class="muted"> · partial month</small>
                    )}
                  </td>
                  <td class="num">{row.current}</td>
                  <td class="num">{row.previous}</td>
                  <td class="num">{row.change}</td>
                  <td class="num">{row.year}</td>
                  <td class="num">{row.yearChange}</td>
                </tr>
              ))}
            </tbody>
          </DataTable>
        </section>
        {places.length > 0 && (
          <section
            class="panel tablewrap"
            role="region"
            aria-label="By location"
            tabindex="0"
          >
            <SectionHeading>
              <Fragment slot="title">By location</Fragment>
            </SectionHeading>
            <DataTable>
              <thead>
                <tr>
                  <th scope="col">Location</th>
                  <th class="num" scope="col">
                    Profile views
                  </th>
                  <th class="num" scope="col">
                    Calls
                  </th>
                  <th class="num" scope="col">
                    Website clicks
                  </th>
                  <th class="num" scope="col">
                    Directions
                  </th>
                  <th class="num" scope="col">
                    Views change
                  </th>
                </tr>
              </thead>
              <tbody>
                {places.map((row) => (
                  <tr>
                    <td>
                      {row.name}
                      {!row.mapped && (
                        <small class="muted"> · not connected</small>
                      )}
                    </td>
                    <td class="num">{row.views}</td>
                    <td class="num">{row.calls}</td>
                    <td class="num">{row.website}</td>
                    <td class="num">{row.directions}</td>
                    <td class="num">{row.change}</td>
                  </tr>
                ))}
              </tbody>
            </DataTable>
          </section>
        )}
      </Fragment>
    )
  }

  <section
    class="panel tablewrap"
    role="region"
    aria-label="Search terms"
    tabindex="0"
  >
    <SectionHeading
      ><Fragment slot="title">How people searched for the business</Fragment
      ></SectionHeading
    >
    {
      terms.length ? (
        <DataTable>
          <thead>
            <tr>
              <>
                <th scope="col">Search term</th>
                <th class="num" scope="col">
                  Times shown
                </th>
              </>
            </tr>
          </thead>
          <tbody>
            {terms.map((row) => (
              <tr>
                <td>{row.keyword}</td>
                <td class="num">{row.value}</td>
              </tr>
            ))}
          </tbody>
        </DataTable>
      ) : (
        <EmptyState title="No search terms yet">
          {snap.gbp.search_terms.reason
            ? reasonText[snap.gbp.search_terms.reason] + ". "
            : ""}
          Google reports search terms once a month.
        </EmptyState>
      )
    }
    <div class="insight">
      For rare searches Google reports a limit such as “&lt; 15” instead of a
      count. That is shown as the limit, never as zero.
    </div>
  </section>

  <section class="panel">
    <SectionHeading><Fragment slot="title">Reviews</Fragment></SectionHeading>
    {
      reviews.available ? (
        <Fragment>
          <div class="reviewsummary">
            <div class="bigrating">
              <>
                <strong>{reviews.ratingText}</strong>
                <Stars rating={reviews.rating} />
                <small>{reviews.total} reviews</small>
              </>
            </div>
            <div class="distribution">
              {reviews.distribution.map((row) => (
                <div class="splitrow">
                  <div>
                    <span>
                      {row.stars} {row.stars === 1 ? "star" : "stars"}
                    </span>
                    <b>{row.count}</b>
                  </div>
                  <div class="splitbar">
                    <i style={`width:${row.share}%`} />
                  </div>
                </div>
              ))}
            </div>
          </div>
          <MetricStrip items={reviews.stats} />
        </Fragment>
      ) : (
        <EmptyState title="Reviews are not available yet">
          {reviews.gap}. Review figures appear once reviews have synced.
        </EmptyState>
      )
    }
  </section>

  <section class="panel">
    <SectionHeading
      ><Fragment slot="title">Search Console and website visits</Fragment
      ></SectionHeading
    >
    {
      search.available ? (
        <Fragment>
          <MetricStrip items={[...search.tiles, visits.tile]} columns={5} />
          {search.partialNote && <p class="muted">{search.partialNote}</p>}
        </Fragment>
      ) : (
        <Fragment>
          <EmptyState title="Search Console is not available">
            {search.gap}. Search clicks and queries appear once it has synced.
          </EmptyState>
          <MetricStrip items={[visits.tile]} columns={3} />
        </Fragment>
      )
    }
    {
      search.available && search.queries.length > 0 && (
        <div
          class="tablewrap"
          role="region"
          aria-label="Top search queries"
          tabindex="0"
        >
          <DataTable>
            <thead>
              <tr>
                <>
                  <th scope="col">Top queries</th>
                  <th class="num" scope="col">
                    Clicks
                  </th>
                  <th class="num" scope="col">
                    Impressions
                  </th>
                  <th class="num" scope="col">
                    CTR
                  </th>
                  <th class="num" scope="col">
                    Position
                  </th>
                  <th class="num" scope="col">
                    Clicks vs last month
                  </th>
                </>
              </tr>
            </thead>
            <tbody>
              {search.queries.map((row) => (
                <tr>
                  <td>{row.label}</td>
                  <td class="num">{row.clicks}</td>
                  <td class="num">{row.impressions}</td>
                  <td class="num">{row.ctr}</td>
                  <td class="num">{row.position}</td>
                  <td class="num">{row.change}</td>
                </tr>
              ))}
            </tbody>
          </DataTable>
        </div>
      )
    }
    {
      search.available && search.pages.length > 0 && (
        <div
          class="tablewrap"
          role="region"
          aria-label="Top pages"
          tabindex="0"
        >
          <DataTable>
            <thead>
              <tr>
                <>
                  <th scope="col">Top pages</th>
                  <th class="num" scope="col">
                    Clicks
                  </th>
                  <th class="num" scope="col">
                    Impressions
                  </th>
                  <th class="num" scope="col">
                    CTR
                  </th>
                  <th class="num" scope="col">
                    Position
                  </th>
                  <th class="num" scope="col">
                    Clicks vs last month
                  </th>
                </>
              </tr>
            </thead>
            <tbody>
              {search.pages.map((row) => (
                <tr>
                  <td>{row.label}</td>
                  <td class="num">{row.clicks}</td>
                  <td class="num">{row.impressions}</td>
                  <td class="num">{row.ctr}</td>
                  <td class="num">{row.position}</td>
                  <td class="num">{row.change}</td>
                </tr>
              ))}
            </tbody>
          </DataTable>
        </div>
      )
    }
  </section>

  <section class="panel">
    <SectionHeading
      ><Fragment slot="title">Local ranking</Fragment></SectionHeading
    >
    <EmptyState title="Not tracked yet"
      >Local ranking scans are not part of this report yet. Nothing is estimated
      in the meantime.</EmptyState
    >
  </section>

  <section class="panel">
    <SectionHeading
      ><Fragment slot="title">Work completed</Fragment><Fragment slot="actions"
        ><span class="muted">{workTotal(snap)} items</span></Fragment
      ></SectionHeading
    >
    {
      work.map((row) => (
        <div class="listrow">
          <div>
            {row.label}
            {row.titles.length > 0 && <small>{row.titles.join(" · ")}</small>}
          </div>
          <strong>{row.count}</strong>
        </div>
      ))
    }
  </section>

  <section class="panel narrative" data-report-narrative>
    <SectionHeading>
      <Fragment slot="title">Summary and next steps</Fragment>
      <Fragment slot="actions">
        {
          narrative.editable && (
            <span class="noprint">
              <button type="button" class="control" inert data-report-draft>
                Draft with Hermes
              </button>
              <button
                type="button"
                class="control primary"
                inert
                data-report-save
              >
                Save narrative
              </button>
            </span>
          )
        }
      </Fragment>
    </SectionHeading>
    {
      narrative.drafted && narrative.editable && (
        <p class="muted noprint">
          Drafted by Hermes from this month’s numbers. Review and edit before
          approving.
        </p>
      )
    }
    {
      narrative.sections.map((section) => (
        <div>
          <h3>{section.title}</h3>
          {narrative.editable ? (
            <textarea
              name={section.field}
              rows="6"
              maxlength="4000"
              aria-label={section.title}
            >
              {section.paragraphs.join("\n\n")}
            </textarea>
          ) : section.paragraphs.length ? (
            section.paragraphs.map((text) => <p>{text}</p>)
          ) : (
            <p class="muted">Not written.</p>
          )}
        </div>
      ))
    }
  </section>

  <dialog
    id="report-notes"
    aria-labelledby="report-notes-title"
    data-shell-dialog
  >
    <div class="panelhead">
      <span class="muted">{report.client_name}</span><button
        type="button"
        class="close"
        aria-label="Close details"
        data-close>×</button
      >
    </div>
    <div class="body">
      <h2 id="report-notes-title">Data notes</h2>
      {
        notes.length ? (
          notes.map((group) => (
            <div class="listrow">
              <div>
                {group.section}
                {group.notes.map((text) => (
                  <small>{text}</small>
                ))}
              </div>
            </div>
          ))
        ) : (
          <p>Every source behind this report is complete.</p>
        )
      }
    </div>
    <div class="dialogfoot">
      <button type="button" class="control" data-close>Close</button>
    </div>
  </dialog>
  <ConfirmDialog id="report-confirm" />
</article>
<script>
  import "../../lib/report-actions";
</script>
