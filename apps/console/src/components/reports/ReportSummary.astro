---
import type { ReportDetail } from "../../adapters/reports";
import {
  figureText,
  monthRange,
  noteGroups,
  profileTiles,
  readinessChip,
  reportChip,
  reportHref,
  reviewsView,
  searchView,
  headline,
} from "../../lib/report-view";
import { dateText } from "../../lib/present";
import DialogFrame from "../ui/DialogFrame.astro";
import StatusBadge from "../ui/StatusBadge.astro";
interface Props {
  report: ReportDetail;
}
const { report } = Astro.props;
const snap = report.snapshot;
const tiles = profileTiles(snap);
const reviews = reviewsView(snap);
const search = searchView(snap);
const notes = noteGroups(snap);
const back = `/clients/${report.client_slug}/reports/`;
const full = reportHref(report.client_slug, report.month, report.revision);
---

<DialogFrame id="report-summary" returnTo={back} returnLabel="All reports">
  <Fragment slot="body">
    <div class="eyebrow">{report.client_name} · Monthly report</div>
    <h2 id="report-summary-title">{headline(report)}</h2>
    <p>
      <StatusBadge
        text={reportChip(report.status).label}
        tone={reportChip(report.status).tone}
      />
      <StatusBadge
        text={readinessChip(report.readiness).label}
        tone={readinessChip(report.readiness).tone}
      />
      · {monthRange(report.month)}
      {report.delivery && ` · Sent ${dateText(report.delivery.sent_on)}`}
    </p>
    <div class="reportpreview">
      <h3>Saved measurements</h3>
      <ul>
        {
          tiles.headline.map((tile) => (
            <li>
              {tile.label}: {tile.value}
            </li>
          ))
        }
        <li>Search clicks: {figureText(snap.search_console.clicks.current)}</li>
        <li>
          Organic website visits: {
            figureText(snap.analytics.organic_sessions.current)
          }
        </li>
        <li>
          Google reviews: {reviews.ratingText} average · {
            figureText(snap.reviews.new_in_month)
          } new
        </li>
      </ul>
      {search.partialNote && <p>{search.partialNote}</p>}
      {
        report.narrative.what_changed && (
          <Fragment>
            <>
              <h3>What changed and why</h3>
              <p>{report.narrative.what_changed}</p>
            </>
          </Fragment>
        )
      }
      {
        report.narrative.next_work && (
          <Fragment>
            <>
              <h3>Next work</h3>
              <p>{report.narrative.next_work}</p>
            </>
          </Fragment>
        )
      }
      {
        notes.length > 0 && (
          <Fragment>
            <h3>Data notes</h3>
            {notes
              .flatMap((group) => group.notes)
              .map((text) => (
                <p>{text}</p>
              ))}
          </Fragment>
        )
      }
    </div>
  </Fragment>
  <Fragment slot="footer">
    <a class="control" href={`${full}${full.includes("?") ? "&" : "?"}print=1`}
      >Download</a
    >
    <a class="control primary" href={full}>Open full report</a>
  </Fragment>
</DialogFrame>
