---
import type { ProfileView } from "../../adapters/local-search";
import { value } from "../../adapters/local-search";
interface Props {
  view: ProfileView;
  slug: string;
}
const { view: v, slug } = Astro.props;
const api = `/api/organizations/${v.organization_id}/locations/${v.location_id}/gbp/operations/`;
---

<h1 id="profile-detail-title">Business Profile</h1>
<section class="panel">
  <h2>Provider-observed profile</h2><p>
    Observed: {v.observed_at ?? "Unavailable"}
  </p>{
    v.profile ? (
      <dl>
        {Object.entries(v.profile).map(([key, val]) => (
          <div class="listrow">
            <dt>{key}</dt>
            <dd>{value(val)}</dd>
          </div>
        ))}
      </dl>
    ) : (
      <p>No provider snapshot available.</p>
    )
  }<p>Health: {value(v.health)}</p><p>
    Completeness: {value(v.completeness)}
    {v.completeness_code ?? ""}
  </p><a href={`/clients/${slug}/integrations/`}>Manage Integration</a>
</section>
<section class="panel">
  <h2>Post operations</h2><p>
    Approval, publication and provider read-back remain separate states. Saving
    a draft does not publish it.
  </p>
  <form
    inert
    data-post-form
    data-action={api + `locations/${v.profile_id}/posts/`}
  >
    <label
      >Post content<textarea
        name="content"
        maxlength="1500"
        required
        disabled={!v.can_propose}></textarea></label
    >
    <button disabled={!v.can_propose} type="submit">Save post draft</button>
  </form>
  {
    v.posts.length ? (
      v.posts.map((p) => (
        <article class="panel">
          <>
            <h3>
              Revision {p.revision} · {p.post_type}
            </h3>
            <p>{p.content}</p>
            <p>Revision: {p.status}</p>
            <p>
              Publication: {p.publication?.status ?? "Not reserved"} · Provider
              post: {p.publication?.provider_post_id ?? "Unavailable"} ·
              Verified: {p.publication?.verified_at ?? "Unavailable"}
            </p>
          </>
          <button
            inert
            disabled={!v.can_approve || p.status !== "awaiting_approval"}
            data-action={api + `posts/${p.id}/decision/`}
            data-body={JSON.stringify({ approve: true })}
          >
            Approve exact post revision {p.revision}
          </button>
          <button
            inert
            disabled={!v.can_approve || p.status !== "awaiting_approval"}
            data-action={api + `posts/${p.id}/decision/`}
            data-body={JSON.stringify({ approve: false })}
          >
            Reject post revision {p.revision}
          </button>
          <button
            inert
            disabled={
              !v.can_publish || p.status !== "approved" || !!p.publication
            }
            data-action={api + `posts/${p.id}/dispatch/`}
            data-key
          >
            Publish approved post revision {p.revision}
          </button>
          {p.publication && (
            <button
              inert
              disabled={!v.can_publish || !p.publication.recovery_allowed}
              data-action={
                api + `posts/publications/${p.publication.id}/recover/`
              }
              data-body="{}"
            >
              Recover publication
            </button>
          )}
        </article>
      ))
    ) : (
      <p>No persisted post drafts or publications.</p>
    )
  }
  {
    !v.can_approve && (
      <a href={`/mfa/?return=${encodeURIComponent(Astro.url.pathname)}`}>
        Verify authenticator for approval access
      </a>
    )
  }
</section>
<section class="panel">
  <h2>Provider-observed posts</h2>{
    v.provider_posts.length ? (
      v.provider_posts.map((p) => (
        <div class="listrow">
          <div>
            <>
              <h3>{p.summary ?? "Content unavailable"}</h3>
              <p>
                {p.status} · {p.state} · {p.observed_at}
              </p>
            </>
          </div>
        </div>
      ))
    ) : (
      <p>No provider posts observed.</p>
    )
  }
</section>
<p role="status" aria-live="polite" data-search-status></p>
<script>
  import "../../lib/search-actions";
</script>
