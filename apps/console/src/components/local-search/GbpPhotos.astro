---
import type { PhotoRow } from "../../lib/gbp-view";
import SectionHeading from "../ui/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
import EmptyState from "../ui/EmptyState.astro";
interface Props {
  rows: PhotoRow[];
  canPropose: boolean;
  canApprove: boolean;
  verifyHref: string;
}
const { rows, canPropose, canApprove, verifyHref } = Astro.props;
const rights = [
  "Owned by the business",
  "Supplied by the client with permission",
  "Licensed for business use",
];
---

<section class="panel">
  <SectionHeading>
    <Fragment slot="title">
      Photos <span class="count">{rows.length}</span>
    </Fragment>
    <Fragment slot="actions">
      {
        canPropose && (
          <button
            type="button"
            class="control primary"
            data-dialog="photo-dialog"
          >
            Add photo
          </button>
        )
      }
    </Fragment>
  </SectionHeading>
  {
    !canApprove &&
      rows.some((row) => row.chip.label === "Awaiting approval") && (
        <div class="insight">
          Approving needs a verified authenticator.{" "}
          <a class="link" href={verifyHref}>
            Verify to approve
          </a>
        </div>
      )
  }
  {
    rows.length ? (
      <div class="photogrid">
        {rows.map((row) => (
          <figure class="photo" data-photo={row.id}>
            <div class="frame">
              {row.url ? (
                <img src={row.url} alt={row.kind} loading="lazy" />
              ) : (
                <span>Preview unavailable</span>
              )}
            </div>
            <figcaption class="caption">
              <div class="postmeta">
                <StatusBadge text={row.chip.label} tone={row.chip.tone} />
                <span>{row.kind}</span>
              </div>
              <div class="sub">{row.rights}</div>
              {row.verified && <div class="sub">{row.verified}</div>}
              <div class="rowactions">
                {row.actions.map((action) => (
                  <button
                    type="button"
                    class:list={["control", { primary: action !== "reject" }]}
                    data-gbp-action={`photo-${action}`}
                    data-id={row.id}
                  >
                    {action === "approve"
                      ? "Approve"
                      : action === "reject"
                        ? "Reject"
                        : "Publish"}
                  </button>
                ))}
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <EmptyState title="No photos yet">
        Fresh photos help people choose the business. Upload one from your
        computer and confirm who may use it.
        {canPropose && (
          <button
            slot="action"
            type="button"
            class="control primary"
            data-dialog="photo-dialog"
          >
            Add the first photo
          </button>
        )}
      </EmptyState>
    )
  }
</section>
<dialog
  id="photo-dialog"
  aria-labelledby="photo-dialog-title"
  data-shell-dialog
  data-gbp-dialog="photo"
>
  <form data-gbp-form="photo" class="formgrid" novalidate>
    <div class="panelhead">
      <span class="muted">Google Business Profile</span>
      <button type="button" class="close" aria-label="Close" data-close
        >×</button
      >
    </div>
    <div class="body formgrid">
      <div>
        <div class="eyebrow">New photo</div>
        <h2 id="photo-dialog-title">Add a photo</h2>
      </div>
      <div class="field">
        <span class="label" id="photo-file-label">Photo</span>
        <div class="dropzone" data-dropzone>
          <input
            id="photo-file"
            type="file"
            name="file"
            accept="image/jpeg,image/png"
            data-photo-input
            aria-labelledby="photo-file-label"
            aria-describedby="photo-file-hint"
          />
          <label for="photo-file" class="dropbody" data-photo-drop>
            <strong>Drag a photo here</strong>
            <span>or choose a file</span>
          </label>
          <div class="photochosen" data-photo-chosen hidden>
            <img alt="Preview of the chosen photo" data-photo-preview />
            <div>
              <b data-photo-facts></b>
              <button type="button" class="link" data-photo-clear>
                Choose a different photo
              </button>
            </div>
          </div>
        </div>
        <span class="hint" id="photo-file-hint">
          JPG or PNG, 10 KB to 5 MB, at least 250 × 250 pixels.
        </span>
      </div>
      <div class="field">
        <label for="photo-type">Type</label>
        <select id="photo-type" name="media_type">
          <option value="photo">Photo</option>
          <option value="cover">Cover photo</option>
          <option value="logo">Logo</option>
        </select>
      </div>
      <div class="field">
        <label for="photo-rights">Who may use it</label>
        <select id="photo-rights" name="rights_authority" required>
          <option value="" selected disabled>Choose one</option>
          {rights.map((text) => <option value={text}>{text}</option>)}
        </select>
      </div>
      <p class="hint">
        The photo is held privately and sent for approval before anything
        reaches Google.
      </p>
      <div
        class="progress"
        role="progressbar"
        aria-label="Upload progress"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-upload-progress
        hidden
      >
        <i></i>
      </div>
      <p class="formstatus" role="alert" data-form-status></p>
    </div>
    <div class="dialogfoot">
      <button type="button" class="control" data-close>Cancel</button>
      <button type="submit" class="control primary" disabled>
        Upload for approval
      </button>
    </div>
  </form>
</dialog>
