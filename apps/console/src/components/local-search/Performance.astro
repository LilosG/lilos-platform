---
import type { LocalSearchView } from "../../adapters/local-search";
import { value } from "../../adapters/local-search";
interface Props {
  report: LocalSearchView["search_console"];
  title: string;
}
const { report, title } = Astro.props;
---

<section class="panel">
  <h2>{title}</h2>
  <p>
    Period: {
      report?.range
        ? `${report.range.start} – ${report.range.end} (${report.range.days} days)`
        : "Unavailable"
    } · Comparison: {
      report?.comparison_range
        ? `${report.comparison_range.start} – ${report.comparison_range.end} (${report.comparison_range.days} days)`
        : "Unavailable"
    }
  </p>
  <p>
    Freshness: {report?.freshness.status ?? "Unavailable"} · Last sync: {
      report?.freshness.last_synced_at ?? "Never synced"
    }
  </p>
  <div class="metrics">
    {
      report && Object.entries(report.metrics).length ? (
        Object.entries(report.metrics).map(([key, metric]) => (
          <div class="metric">
            <>
              <span>{metric.label ?? key}</span>
              <strong>{value(metric.current)}</strong>
              <small>
                Previous: {value(metric.previous)} · Change:{" "}
                {value(metric.delta)} · Quality: {metric.quality}
              </small>
            </>
          </div>
        ))
      ) : (
        <p>
          No authoritative observations for this period. Missing data is
          unavailable.
        </p>
      )
    }
  </div>
  {
    report?.series.length ? (
      <details>
        <>
          <summary>Daily observations</summary>
          <div class="tablewrap">
            <table>
              <>
                <caption>{title} daily source observations</caption>
                <thead>
                  <tr>
                    <>
                      <th scope="col">Date</th>
                      <th scope="col">Observed values</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {report.series.map((row) => (
                    <tr>
                      <td>{value(row.date)}</td>
                      <td>{value(row)}</td>
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
        </>
      </details>
    ) : null
  }
</section>
