---
import type { LocalSearchView } from "../../adapters/local-search";
import type { GbpPerformanceView } from "../../adapters/gbp";
import type { GbpTabData, GbpViewKey } from "../../lib/gbp-view";
import { dailyCharts } from "../../lib/gbp-view";
import {
  TABS,
  momentum,
  overviewTiles,
  queryRows,
  rankingTiles,
  searchTiles,
  sourceDetails,
} from "../../lib/local-search-view";
import { periodText } from "../../lib/present";
import PageHeader from "../ui/PageHeader.astro";
import MetricStrip from "../ui/MetricStrip.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
import DataTable from "../ui/DataTable.astro";
import EmptyState from "../ui/EmptyState.astro";
import ErrorState from "../ui/ErrorState.astro";
import MomentumPanel from "./MomentumPanel.astro";
import QueryTable from "./QueryTable.astro";
import VisibilityChart from "./VisibilityChart.astro";
import SearchPerformance from "./SearchPerformance.astro";
import RankingDistribution from "./RankingDistribution.astro";
import RankingRows from "./RankingRows.astro";
import GbpTab from "./GbpTab.astro";
import CrawlEvidence from "./CrawlEvidence.astro";
interface Props {
  view: LocalSearchView;
  slug: string;
  clientName: string;
  tab: string;
  days: number;
  offset: number;
  /** The Business Profile read for the Overview's tiles; null when it failed to load. */
  gbp: GbpPerformanceView | null;
  /** The Business Profile tab's data, loaded only for that tab. */
  gbpTab: GbpTabData | null;
}
const {
  view: v,
  slug,
  clientName,
  tab,
  days,
  offset,
  gbp,
  gbpTab,
} = Astro.props;
const base = `/clients/${slug}/local-search/`;
const integrationsHref = `/clients/${slug}/integrations/`;
const source = sourceDetails(v);
const connected = Boolean(v.search_console?.connected);
const period = periodText(days);
const query = (extra: Record<string, string> = {}) => {
  const params = new URLSearchParams({
    days: String(days),
    ...(v.website_id ? { website_id: v.website_id } : {}),
    ...extra,
  });
  return params.toString();
};
const gbpHref = (view: GbpViewKey, location?: string) => {
  const place = location ?? gbpTab?.selected?.locationId;
  return `${base}google-business-profile/?${query({
    ...(view === "performance" ? {} : { view }),
    ...(place ? { location: place } : {}),
  })}`;
};
const overview = tab === "" ? overviewTiles(v, gbp, days) : [];
const gbpActions = gbp ? dailyCharts(gbp).actions : null;
---

<PageHeader title="Local Search" subtitle={clientName} client days={days}>
  <Fragment slot="actions">
    {
      v.websites.length > 1 && (
        <select aria-label="Website" data-query-select="website_id">
          {v.websites.map((site) => (
            <option value={site.id} selected={site.id === v.website_id}>
              {site.name}
            </option>
          ))}
        </select>
      )
    }
    <button
      type="button"
      class="statuschip"
      data-dialog="source-details"
      aria-label={`Data status: ${source.chip.label}. Open details`}
    >
      <StatusBadge text={source.chip.label} tone={source.chip.tone} />
    </button>
  </Fragment>
</PageHeader>
<nav class="sectiontabs" aria-label="Local Search sections">
  {
    TABS.map(([label, path]) => (
      <a
        class:list={{ active: tab === path }}
        aria-current={tab === path ? "page" : undefined}
        href={`${base}${path ? path + "/" : ""}?${query()}`}
      >
        {label}
      </a>
    ))
  }
</nav>
{
  tab === "" ? (
    <Fragment>
      <MetricStrip items={overview} columns={5} />
      <div class="grid">
        <MomentumPanel
          momentum={momentum(v)}
          integrationsHref={integrationsHref}
        />
        <section class="panel">
          <SectionHeading>
            <Fragment slot="title">Business Profile actions</Fragment>
            <Fragment slot="actions">
              <a class="link" href={gbpHref("performance")}>
                View details
              </a>
            </Fragment>
          </SectionHeading>
          {gbpActions ? (
            <div class="chartbody">
              <VisibilityChart
                chart={gbpActions}
                label="Daily calls, website clicks and direction requests"
              />
              <div class="legend">
                <span>
                  <i />
                  Calls, website clicks and directions
                </span>
              </div>
            </div>
          ) : gbp ? (
            <EmptyState
              title={
                gbp.availability === "not_connected"
                  ? "Business Profile is not connected"
                  : gbp.availability === "not_synced"
                    ? "First sync scheduled"
                    : "No daily activity to chart yet"
              }
            >
              {gbp.availability === "not_connected"
                ? "Connect a profile to see calls, website clicks and directions."
                : "Profile activity appears here once Google has reported at least two days."}
              {gbp.availability === "not_connected" && (
                <a
                  slot="action"
                  class="control primary"
                  href={integrationsHref}
                >
                  Open Integrations
                </a>
              )}
            </EmptyState>
          ) : (
            <ErrorState title="Business Profile data could not be loaded">
              Refresh to try again.
            </ErrorState>
          )}
        </section>
      </div>
      <QueryTable
        rows={queryRows(v, 10)}
        title="Top search queries"
        period={period}
        moreHref={`${base}search-console/?${query()}`}
        connected={connected}
        integrationsHref={integrationsHref}
      />
    </Fragment>
  ) : tab === "search-console" ? (
    <SearchPerformance
      view={v}
      tiles={searchTiles(v, days)}
      days={days}
      integrationsHref={integrationsHref}
    />
  ) : tab === "rankings" ? (
    <Fragment>
      <MetricStrip items={rankingTiles()} columns={3} />
      <RankingDistribution bands={null} />
      <section
        class="panel tablewrap spaced-section"
        role="region"
        aria-label="Priority keywords"
        tabindex="0"
      >
        <SectionHeading>
          <Fragment slot="title">Priority keywords</Fragment>
        </SectionHeading>
        <DataTable>
          <thead>
            <tr>
              <th scope="col">Keyword</th>
              <th scope="col">Average rank</th>
              <th scope="col">Top 3</th>
              <th scope="col">Top 10</th>
            </tr>
          </thead>
          <tbody>
            <RankingRows rows={[]} />
          </tbody>
        </DataTable>
      </section>
    </Fragment>
  ) : tab === "google-business-profile" ? (
    gbpTab && (
      <GbpTab
        data={gbpTab}
        days={days}
        href={gbpHref}
        integrationsHref={integrationsHref}
      />
    )
  ) : (
    <CrawlEvidence view={v} slug={slug} tab={tab} offset={offset} />
  )
}
<dialog
  id="source-details"
  aria-labelledby="source-details-title"
  data-shell-dialog
>
  <div class="panelhead">
    <span class="muted">Local Search</span>
    <button type="button" class="close" aria-label="Close details" data-close>
      ×
    </button>
  </div>
  <div class="body">
    <h2 id="source-details-title">Data sources</h2>
    <div class="listrow">
      <div>Google connection</div>
      <StatusBadge
        text={source.connection.chip.label}
        tone={source.connection.chip.tone}
      />
    </div>
    {
      source.sources.map((item) => (
        <div class="listrow">
          <div>
            {item.name}
            <small>{item.detail}</small>
          </div>
          <StatusBadge text={item.chip.label} tone={item.chip.tone} />
        </div>
      ))
    }
    <h3 class="subhead">Recent syncs</h3>
    {
      source.syncs.length ? (
        source.syncs.map((sync) => (
          <div class="listrow">
            <div>
              {sync.name}
              <small>
                {sync.when}
                {sync.note && ` · ${sync.note}`}
              </small>
            </div>
            <StatusBadge text={sync.chip.label} tone={sync.chip.tone} />
          </div>
        ))
      ) : (
        <EmptyState title="No syncs yet">
          Syncs appear here once a source has been connected and run.
        </EmptyState>
      )
    }
  </div>
  <div class="dialogfoot">
    <a class="control" href={integrationsHref}>Manage connections</a>
    <button type="button" class="control" data-close>Close</button>
  </div>
</dialog>
