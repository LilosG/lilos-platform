---
interface Props {
  text: string;
  /** A typed chip passes its own tone; a bare label falls back to the label's wording. */
  tone?: "error" | "warn" | "neutral" | "";
}
const { text, tone: given } = Astro.props;
import { statusTone } from "../../lib/status";
const tone = given ?? statusTone(text);
---

<span class:list={["badge", tone]}>{text}</span>
