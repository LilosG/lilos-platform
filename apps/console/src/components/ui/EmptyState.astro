---
interface Props {
  /** What is missing, in a few words. */
  title?: string;
  /** The heading level; h2 when the state stands alone under the page title. */
  heading?: "h2" | "h3";
}
const { title, heading: Heading = "h3" } = Astro.props;
---

<div class="empty">
  {title && <Heading class="emptytitle">{title}</Heading>}
  <p class="emptytext"><slot /></p>
  <div class="emptyaction"><slot name="action" /></div>
</div>
