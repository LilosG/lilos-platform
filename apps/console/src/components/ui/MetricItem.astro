---
import Trend from "./Trend.astro";
interface Props {
  label: string;
  value: string;
  description: string;
  /** Not a number: rendered muted so a missing value is never read as a result. */
  missing?: boolean;
  /** Whole-percent change against the previous period, when there is one. */
  trend?: number | null;
}
const {
  label,
  value,
  description,
  missing = false,
  trend = null,
} = Astro.props;
---

<div class="metric">
  <div class="metricLabel">{label}</div>
  <strong
    class:list={{ muted: missing }}
    data-availability={missing ? "missing" : undefined}>{value}</strong
  >
  <small>
    {trend !== null && <Trend value={trend} />}{" "}{description}
  </small>
</div>
