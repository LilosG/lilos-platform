---
import type { OpportunityDetail } from "../../adapters/opportunities";
import { displayEvidence } from "../../adapters/opportunities";
import {
  SITE_CHANGES_NOT_CONFIGURED,
  bandLabel,
  discovered,
  historyLabel,
  kindLabel,
  metricText,
  nextAction,
  sourceText,
  statusLabel,
  title,
  whyItMatters,
} from "../../lib/opportunity-view";
import { when } from "../../lib/present";
import StatusBadge from "../ui/StatusBadge.astro";
interface Props {
  detail: OpportunityDetail;
}
const { detail: d } = Astro.props;
const o = d.data;
const now = new Date();
const current = d.recommendations[0];
const scope = `/api/organizations/${o.organization_id}/`;
const metrics = (o.evidence_summary?.metrics ?? []).map((m) =>
  metricText(m.key, m.value),
);
const siteDisabled = o.site_change === "not_configured";
const effort = current?.effort ?? d.growth?.actions[0]?.effort ?? null;
const post = (url: string, body: unknown) => ({
  "data-post": url,
  "data-body": JSON.stringify(body),
});
---

<div class="eyebrow">
  <span data-entity="client" data-record-id={o.organization_id}>
    {o.client?.name ?? ""}
  </span>
  · {kindLabel[o.kind]}
</div>
<h2 id="opportunity-detail-title">{title(o)}</h2>
<p>
  <span class="badge neutral">{o.classification}</span>{" "}
  <StatusBadge
    text={o.priority_band
      ? `${bandLabel[o.priority_band]} priority`
      : "Priority unavailable"}
  />
  <StatusBadge text={statusLabel(o.status)} />
</p>
<h3>Why it was discovered</h3>
<p>{discovered(d)}</p>
<h3>Why it matters</h3>
<p>{whyItMatters(o)}</p>
<div class="reportpreview">
  <h3>Supporting evidence</h3>
  <p>
    {
      o.evidence_summary
        ? `Source: ${sourceText(o.evidence_summary.source)} · Quality: ${o.evidence_context.quality ?? "Unavailable"}`
        : "Evidence unavailable."
    }
  </p>
  {
    metrics.length > 0 && (
      <div class="evidencemetrics">
        {metrics.map(([value, label]) => (
          <div>
            <strong>{value}</strong>
            <small>{label}</small>
          </div>
        ))}
      </div>
    )
  }
  {o.kind === "seo" && <p>Target page: {d.page_url ?? "No attributed page"}</p>}
  <small class="sub">
    Observed {when(o.observed_at, now)}
    {
      o.evidence_context.period_start &&
        ` · Period ${o.evidence_context.period_start} – ${o.evidence_context.period_end ?? "Unavailable"}`
    }
  </small>
  {
    o.evidence_context.limitation_code && (
      <p role="status">
        Evidence availability: {o.evidence_context.limitation_code}
      </p>
    )
  }
</div>
<h3 class="mt-panel">Recommended next action</h3>
<p>{nextAction(o)}</p>
{effort && <small class="sub">Estimated effort · {effort}</small>}
{
  o.kind === "seo" && !current && (
    <section class="panel">
      <h2>Recommendation</h2>
      <p>No recommendation has been created.</p>
      <button
        disabled={!d.can_recommend}
        {...post(scope + `seo/opportunities/${o.source_id}/hermes-run/`, {})}
      >
        Request recommendation
      </button>
    </section>
  )
}
{
  d.recommendations.map((r, index) => (
    <section class="panel" data-revision-id={r.id}>
      <h2>Recommendation revision {r.revision_number}</h2>
      <p>Status: {r.status}</p>
      <p>{r.proposed_action}</p>
      <p>Expected result: {r.expected_result_hypothesis}</p>
      <p>
        Risk: {r.risk} · Effort: {r.effort}
      </p>
      <p>Deterministic quality: {r.quality.state}</p>
      <p>
        Protected query: {r.quality.target_query ?? "Unavailable"} · Top
        queries: {r.quality.top_queries.join(", ") || "Unavailable"} ·
        Locations: {r.quality.location_terms.join(", ") || "Unavailable"}
      </p>
      {r.quality.problems.map((p) => (
        <p>
          {p.code}: {p.reason}
        </p>
      ))}
      <p>
        Current repository values and the approved fingerprint are rechecked by
        the executor before writing. A displayed proposal alone is not live
        verification.
      </p>
      {r.change_set.map((edit) => (
        <div>
          <h3>{edit.field}</h3>
          <p>Target page: {d.page_url ?? "Unavailable"}</p>
          <div class="beforeafter">
            <div>
              <h4>Current value</h4>
              <pre>{edit.current_value || "(empty)"}</pre>
            </div>
            <div>
              <h4>Proposed value</h4>
              <pre>{edit.proposed_value}</pre>
            </div>
          </div>
          <p>{edit.rationale}</p>
        </div>
      ))}
      {index === 0 && r.status === "awaiting_approval" && (
        <Fragment>
          {d.can_recommend && r.change_set.length > 0 && (
            <form data-revise={scope + `seo/recommendations/${r.id}/revise/`}>
              {r.change_set.map((edit) => (
                <label>
                  {edit.field}
                  <textarea name={edit.field} required>
                    {edit.proposed_value}
                  </textarea>
                </label>
              ))}
              <button type="submit">Save new revision</button>
            </form>
          )}
          {!d.can_approve && (
            <a href={`/mfa/?return=${encodeURIComponent(Astro.url.pathname)}`}>
              Verify authenticator to request approval access
            </a>
          )}
          {siteDisabled && r.change_set.length > 0 && (
            <p
              role="status"
              data-site-change-reason="SITE_CHANGES_NOT_CONFIGURED"
            >
              {SITE_CHANGES_NOT_CONFIGURED}
            </p>
          )}
          <button
            {...post(scope + `seo/recommendations/${r.id}/decision/`, {
              approve: true,
            })}
            disabled={
              !d.can_approve ||
              r.quality.state === "blocked" ||
              (siteDisabled && r.change_set.length > 0)
            }
          >
            Approve exact revision {r.revision_number}
          </button>
          <button
            {...post(scope + `seo/recommendations/${r.id}/decision/`, {
              approve: false,
            })}
            disabled={!d.can_approve}
          >
            Reject revision
          </button>
        </Fragment>
      )}
      {r.change_set_limitation_code && (
        <p role="status">{r.change_set_limitation_code}</p>
      )}
      {r.site_change && (
        <div>
          <h3>Publication</h3>
          <p>Deployment: {r.site_change.deployment_status ?? "Unavailable"}</p>
          <p>
            Live verification observed:{" "}
            {r.site_change.verified_at ?? "Unavailable"}
          </p>
          <p>
            Mapping: {r.site_change.mapping_state ?? "Unavailable"} · State:{" "}
            {r.site_change.publication_status ?? "Not reserved"}
          </p>
          <p>
            Build: {r.site_change.build_gate ?? "Unavailable"} /{" "}
            {r.site_change.build_state ?? "Unavailable"} · Verification:{" "}
            {r.site_change.verification_state ?? "Unavailable"}
          </p>
          {r.site_change.pull_request_url && (
            <a href={r.site_change.pull_request_url} rel="noreferrer">
              Open pull request
            </a>
          )}
          {r.site_change.blocked_code && (
            <p role="status">{r.site_change.blocked_code}</p>
          )}
        </div>
      )}
    </section>
  ))
}
{
  d.growth && (
    <section class="panel" data-growth-plan>
      <h2>Growth plan</h2>
      <p>{d.growth.objective}</p>
      <p>Confidence: {Math.round(d.growth.confidence * 100)}%</p>
      <ol>
        {d.growth.actions.map((a) => (
          <li data-action-id={a.id}>
            <b>{statusLabel(a.action_type)}</b> · {statusLabel(a.status)}
            <span class="sub">
              {statusLabel(a.execution_mode)} · Risk {a.risk} · Effort{" "}
              {a.effort}
              {a.safe_error_code ? ` · ${a.safe_error_code}` : ""}
            </span>
            <p>{a.expected_result_hypothesis}</p>
          </li>
        ))}
      </ol>
      {o.status === "proposed" && (
        <Fragment>
          {!d.can_approve && (
            <a href={`/mfa/?return=${encodeURIComponent(Astro.url.pathname)}`}>
              Verify authenticator to request approval access
            </a>
          )}
          <button
            {...post(scope + `growth/${o.source_id}/decision/`, {
              approve: true,
            })}
            disabled={!d.can_approve}
          >
            Approve growth plan
          </button>
          <button
            {...post(scope + `growth/${o.source_id}/decision/`, {
              approve: false,
            })}
            disabled={!d.can_approve}
          >
            Reject growth plan
          </button>
        </Fragment>
      )}
    </section>
  )
}
{
  d.content && (
    <section class="panel" data-content-opportunity>
      <h2>Content opportunity</h2>
      <p>Target: {d.content.target_reference}</p>
      {d.content.items.length > 0 ? (
        <ul>
          {d.content.items.map((item) => (
            <li>
              {item.title} · {statusLabel(item.content_type)} ·{" "}
              {statusLabel(item.status)}
            </li>
          ))}
        </ul>
      ) : (
        <p>No content has been drafted from this opportunity yet.</p>
      )}
      {["identified", "validated"].includes(o.status) && (
        <Fragment>
          <button
            {...post(scope + `content/opportunities/${o.source_id}/decision/`, {
              accept: true,
            })}
            disabled={!d.can_approve}
          >
            Accept opportunity
          </button>
          <button
            {...post(scope + `content/opportunities/${o.source_id}/decision/`, {
              accept: false,
            })}
            disabled={!d.can_approve}
          >
            Reject opportunity
          </button>
        </Fragment>
      )}
    </section>
  )
}
{
  d.runs.length > 0 && (
    <section class="panel">
      <h2>Workflow and implementation</h2>
      {d.runs.map((run) => (
        <p>
          Workflow: {run.status} · Implementation: {run.task_status}
        </p>
      ))}
    </section>
  )
}
<h3>Live check</h3>
{
  d.live_check ? (
    <Fragment>
      <p data-live-check={d.live_check.state ?? "unavailable"}>
        {statusLabel(d.live_check.state ?? "unavailable")}
        {d.live_check.verified_at &&
          ` · ${when(d.live_check.verified_at, now)}`}
      </p>
      {d.live_check.checks.length ? (
        d.live_check.checks.map((check) => (
          <p>
            {check.field}: {check.state} · Expected{" "}
            {displayEvidence(check.expected)} · Observed{" "}
            {displayEvidence(check.observed)}
          </p>
        ))
      ) : (
        <p>Live read-back unavailable.</p>
      )}
    </Fragment>
  ) : (
    <p>
      {o.kind === "seo"
        ? "No change has been published, so there is nothing to check live."
        : "Live checks apply to approved website changes."}
    </p>
  )
}
<h3>Status history</h3>
{
  d.history === null ? (
    <p>Status history is not available to your role.</p>
  ) : d.history.length ? (
    <ol data-status-history>
      {d.history.map((event) => (
        <li>
          {historyLabel(event)}
          <span class="sub">{when(event.occurred_at, now)}</span>
        </li>
      ))}
    </ol>
  ) : (
    <p>No status changes recorded.</p>
  )
}
<p id="action-status" role="status" aria-live="polite"></p>
<script>
  async function mutate(url: string, body: unknown) {
    const status = document.getElementById("action-status")!;
    try {
      const response = await fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token":
            document.querySelector<HTMLMetaElement>('meta[name="csrf-token"]')
              ?.content ?? "",
          "X-Correlation-ID": crypto.randomUUID(),
        },
        body: JSON.stringify(body),
      });
      if (!response.ok) {
        const error = await response.json();
        status.textContent = `Action unavailable (${error.code ?? error.error?.code ?? response.status}). Refresh to inspect current state.`;
        return;
      }
      window.location.reload();
    } catch {
      status.textContent =
        "Action outcome uncertain. Refresh to inspect current state before trying again.";
    }
  }
  document
    .querySelectorAll<HTMLButtonElement>("[data-post]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        button.disabled = true;
        void mutate(button.dataset.post!, JSON.parse(button.dataset.body!));
      }),
    );
  document.querySelectorAll<HTMLFormElement>("[data-revise]").forEach((form) =>
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void mutate(form.dataset.revise!, {
        edits: [...new FormData(form)].map(([field, proposed_value]) => ({
          field,
          proposed_value,
        })),
      });
    }),
  );
</script>
