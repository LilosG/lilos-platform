---
import type { ReviewDetailView } from "../../adapters/reviews";
import { dateText, humanize, reviewDate } from "../../lib/present";
import {
  actorLabel,
  eventLabel,
  factLabel,
  resultLabel,
  responseChip,
  responseNote,
  reviewer,
} from "../../lib/review-view";
import { reviewChip } from "../../lib/status";
import StatusBadge from "../ui/StatusBadge.astro";
import ReviewerAvatar from "./ReviewerAvatar.astro";
import Stars from "./Stars.astro";
interface Props {
  view: ReviewDetailView;
}
const { view: v } = Astro.props;
const api = `/api/organizations/${v.organization_id}/locations/${v.location_id}/reviews/${v.review.id}/responses/`;
const who = reviewer(v.review);
const chip = reviewChip(v.review.status, v.review.response_status);
const [latest, ...earlier] = v.responses;
const waitingOnVerify = v.responses.some(
  (r) =>
    (r.status === "awaiting_approval" && !r.can_approve) ||
    (r.status === "approved" && !r.can_publish),
);
const mfa = `/mfa/?return=${encodeURIComponent(Astro.url.pathname)}`;
const draftable = latest?.status !== "published";
---

<div class="eyebrow">Google review</div>
<div class="reviewhead detailhead">
  <ReviewerAvatar who={who} />
  <div class="reviewwho">
    <h2 id="review-detail-title">Reply to {who.name}</h2>
    <small>
      <Stars rating={v.review.rating} />
      <time datetime={v.review.created_at}>
        {reviewDate(v.review.created_at, new Date())}
      </time>
    </small>
  </div>
  <StatusBadge text={chip.label} tone={chip.tone} />
</div>
{
  v.review.body ? (
    <p class="reviewtext">
      {v.review.title && <b>{v.review.title} </b>}
      {v.review.body}
    </p>
  ) : (
    <p class="reviewtext muted">This review has a star rating and no text.</p>
  )
}
<p class="formstatus" role="status" aria-live="polite" data-review-status></p>
{
  waitingOnVerify && (
    <div class="insight">
      Approving and publishing need a verified authenticator.{" "}
      <a class="link" href={mfa}>
        Verify to continue
      </a>
    </div>
  )
}
{
  latest && (
    <section class="replyblock" aria-label="Current response">
      <div class="postmeta">
        <StatusBadge
          text={responseChip(latest.status).label}
          tone={responseChip(latest.status).tone}
        />
        <span>
          {latest.generated_by === "imported"
            ? "Written on Google"
            : latest.generated_by === "user"
              ? "Written by a person"
              : "Drafted by LILOs"}
        </span>
        {latest.approved_at && (
          <span>Approved {dateText(latest.approved_at)}</span>
        )}
        {latest.published_at && (
          <span>Published {dateText(latest.published_at)}</span>
        )}
      </div>
      <blockquote class="quote">{latest.text}</blockquote>
      {responseNote[latest.status] && (
        <p class="hint">{responseNote[latest.status]}</p>
      )}
      <div class="rowactions">
        <button
          type="button"
          class="control primary"
          inert
          data-review-action={api + latest.id + "/approve/"}
          disabled={!latest.can_approve}
        >
          Approve this response
        </button>
        <button
          type="button"
          class="control primary"
          inert
          data-review-action={api + latest.id + "/publish/"}
          data-key={`console-review-${latest.id}`}
          disabled={!latest.can_publish}
        >
          Publish to Google
        </button>
      </div>
    </section>
  )
}
{
  draftable && (
    <form
      inert
      class="formgrid"
      data-review-draft
      data-action={api}
      data-revision={v.review.revision_id}
    >
      {!v.can_draft && (
        <p class="hint">
          Drafting is unavailable right now. It needs permission and at least
          one approved business fact.
        </p>
      )}
      <fieldset disabled={!v.can_draft}>
        <legend>Facts this response may use</legend>
        {v.facts.length ? (
          v.facts.map((f) => (
            <label class="factpick">
              <input type="checkbox" name="fact" value={f.id} />
              {humanize(f.key)}: {factLabel(f.value)}
            </label>
          ))
        ) : (
          <p class="hint">No approved business facts yet.</p>
        )}
      </fieldset>
      <div class="field">
        <label for="review-response-text">
          {latest ? "Edit the response" : "Write a response"}
        </label>
        <textarea
          id="review-response-text"
          name="response_text"
          maxlength="5000"
          rows="5"
          disabled={!v.can_draft}
          set:text={latest?.text ?? ""}
        />
        <span class="hint">
          Saving sends the wording for approval. Nothing is posted to Google
          until it is approved and published.
        </span>
      </div>
      <div class="rowactions">
        <button type="submit" class="control" disabled={!v.can_draft}>
          {latest ? "Save changes" : "Save draft"}
        </button>
        <button
          type="submit"
          class="control"
          name="mode"
          value="ai"
          disabled={!v.can_ai_draft}
        >
          Generate a draft
        </button>
      </div>
    </form>
  )
}
{
  earlier.length > 0 && (
    <details class="activity">
      <summary>Earlier versions ({earlier.length})</summary>
      {earlier.map((r) => (
        <div class="listrow">
          <div>
            {r.text}
            <small>
              Version {r.revision}
              {r.published_at ? ` · Published ${dateText(r.published_at)}` : ""}
            </small>
          </div>
          <StatusBadge
            text={responseChip(r.status).label}
            tone={responseChip(r.status).tone}
          />
        </div>
      ))}
    </details>
  )
}
{
  v.can_read_audit &&
    (v.history.length > 0 || v.responses.some((r) => r.history.length > 0)) && (
      <details class="activity">
        <summary>Activity</summary>
        {[...v.history, ...v.responses.flatMap((r) => r.history)]
          .sort((a, b) => b.occurred_at.localeCompare(a.occurred_at))
          .map((h) => (
            <div class="listrow">
              <div>
                {eventLabel(h.event_type)}
                <small>
                  {actorLabel(h.actor_type)} · {dateText(h.occurred_at)}
                  {resultLabel(h.result) ? ` · ${resultLabel(h.result)}` : ""}
                </small>
              </div>
            </div>
          ))}
      </details>
    )
}
<script>
  import "../../lib/review-actions";
</script>
