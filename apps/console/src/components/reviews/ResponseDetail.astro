---
import type { ReviewDetailView } from "../../adapters/reviews";
interface Props {
  view: ReviewDetailView;
  slug: string;
}
const { view: v, slug } = Astro.props;
const api = `/api/organizations/${v.organization_id}/locations/${v.location_id}/reviews/${v.review.id}/responses/`;
---

<h1 id="review-detail-title">Review response</h1>
<div class="eyebrow">
  {v.review.provider} · Review revision {v.review.revision}
</div>
<p>{v.review.body ?? "Review text unavailable"}</p>
<p>
  Review: {v.review.status} · Risk: {v.review.risk_level} · Last synced: {
    v.review.last_synced_at
  }
</p>
<a href={`/clients/${slug}/integrations/`}>Manage Integration</a>
<section class="panel">
  <h2>Source health</h2><p>
    Google authorization: {v.source.connection_status} · Mapping: {
      v.source.mapping_status
    }
  </p><p>
    Last review import: {v.source.last_ingested_at ?? "Unavailable"} · Freshness:
    {v.source.freshness} · Quality: {v.source.quality}
  </p>
</section>
<section class="panel">
  <h2>Draft response</h2>
  <p>
    Saving creates a new canonical response revision. Current backend policy
    requires exact approval for local drafts. Approval-free client overrides are
    unavailable in the canonical service.
  </p>
  {
    !v.can_draft && (
      <p>
        Drafting unavailable: permission, current review revision or approved
        business facts are missing.
      </p>
    )
  }
  <form
    inert
    data-review-draft
    data-action={api}
    data-revision={v.review.revision_id}
  >
    <fieldset disabled={!v.can_draft}>
      <legend>Approved facts grounding this response</legend>{
        v.facts.map((f) => (
          <label>
            <input type="checkbox" name="fact" value={f.id} />
            {f.key} · {JSON.stringify(f.value)}
          </label>
        ))
      }
    </fieldset>
    <label for="review-response-text">Response</label>
    <textarea
      id="review-response-text"
      name="response_text"
      maxlength="5000"
      rows="5"
      disabled={!v.can_draft}>{v.responses[0]?.text ?? ""}</textarea
    >
    <button type="submit" disabled={!v.can_draft}
      >Save new response revision</button
    >
    <button type="submit" name="mode" value="ai" disabled={!v.can_ai_draft}
      >Generate canonical AI draft</button
    >
  </form>
</section>
<section class="panel">
  <h2>Response revisions</h2>
  <p>
    To revise a response, save a new draft above. Editing in place, rejection,
    deletion and manual response retry are unavailable in the canonical API.
  </p>
  {
    v.responses.length ? (
      v.responses.map((r) => (
        <article class="reviewrow">
          <>
            <h3>
              Response revision {r.revision} · {r.status}
            </h3>
            <p class="savedresponse">{r.text}</p>
          </>
          <p>
            Source: {r.generated_by} · Approval required:{" "}
            {r.approval_required
              ? "Yes — canonical local response policy"
              : "No — provider-observed reply"}
          </p>
          <p>
            Approved: {r.approved_at ?? "Not approved"} · Published/read-back:{" "}
            {r.published_at ?? "Not confirmed"}
          </p>
          <p>
            Provider reference: {r.external_response_id ?? "Unavailable"} ·
            Error: {r.safe_error_code ?? "None recorded"}
          </p>
          <p>
            Workflow: {r.workflow_status ?? "Not dispatched"} ·{" "}
            {r.workflow_failure ?? ""} · {r.workflow_id ?? ""}
          </p>
          <button
            inert
            data-review-action={api + r.id + "/approve/"}
            disabled={!r.can_approve}
          >
            Approve exact response revision {r.revision}
          </button>
          <button
            inert
            data-review-action={api + r.id + "/publish/"}
            data-key={`console-review-${r.id}`}
            disabled={!r.can_publish}
          >
            Dispatch approved response revision {r.revision}
          </button>
          <details>
            <summary>Response audit history</summary>
            {v.can_read_audit ? (
              r.history.map((h) => (
                <p>
                  {h.occurred_at} · {h.event_type} · {h.result} · {h.actor_type}{" "}
                  · {h.summary}
                </p>
              ))
            ) : (
              <p>Audit permission unavailable.</p>
            )}
          </details>
        </article>
      ))
    ) : (
      <p>No persisted response revisions.</p>
    )
  }
</section>
<section class="panel">
  <h2>Review history and recovery</h2>
  <p>
    Queued or retry scheduled work is not published. Published responses require
    canonical provider read-back. Ambiguous writes remain reconciliation
    required. Worker retries and review imports use canonical recovery; a manual
    response retry endpoint is unavailable.
  </p>
  {
    v.can_read_audit ? (
      v.history.map((h) => (
        <p>
          {h.occurred_at} · {h.event_type} · {h.result} · {h.actor_type} ·{" "}
          {h.summary}
        </p>
      ))
    ) : (
      <p>Audit permission unavailable.</p>
    )
  }
  <a href={`/mfa/?return=${encodeURIComponent(Astro.url.pathname)}`}
    >Verify authenticator for protected actions</a
  >
</section>
<p role="status" aria-live="polite" data-review-status></p>
<script>
  import "../../lib/review-actions";
</script>
