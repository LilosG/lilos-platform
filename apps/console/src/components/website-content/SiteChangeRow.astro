---
import type { SiteChange } from "../../lib/website-view";
import StatusBadge from "../ui/StatusBadge.astro";
interface Props {
  change: SiteChange;
}
const { change: c } = Astro.props;
---

<div class="listrow opportunitycard" data-site-change={c.id}>
  <div>
    <a class="link opportunity-activation" href={c.href}>{c.title}</a>
    <small>{c.classification} · {c.status}</small>
    <small>{c.next}</small>
  </div>
  <StatusBadge text={c.priority} />
</div>
