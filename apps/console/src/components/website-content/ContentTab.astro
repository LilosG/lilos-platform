---
import type { WebsiteView } from "../../adapters/website-content";
// The Content tab is carried over unchanged; Step 5b rebuilds it.
interface Props {
  view: WebsiteView;
  base: string;
  api: string;
  query: string;
  offset: number;
}
const { view: v, base, api, query, offset } = Astro.props;
---

<>
  <section class="panel">
    <>
      <h2>Content operations</h2>
      <p>
        These canonical items belong to the organization. Website association is
        unavailable unless established by a canonical publication target;
        selecting a website does not assign content to it.
      </p>
      {
        v.content.length ? (
          v.content.map((c) => (
            <div class="listrow">
              <div>
                <h3>{c.title}</h3>
                <p>
                  {c.stage} · Revision:{" "}
                  {c.latest_revision_status ?? "Unavailable"} · Publication:{" "}
                  {c.publication_status ?? "Not started"} · Job:{" "}
                  {c.publication_job_status ?? "Unavailable"}
                </p>
                <small>Published: {c.published_at ?? "Not confirmed"}</small>
              </div>
              <a class="control" href={`${base}content/${c.id}/`}>
                Inspect content
              </a>
            </div>
          ))
        ) : (
          <p>No canonical content items in this page of the organization.</p>
        )
      }
    </>
  </section>
  {
    v.can_create && (
      <section class="panel">
        <h2>New content item</h2>
        <form
          inert
          data-detail-base={base + "content/"}
          data-content-form="create"
          data-action={api + "content/"}
        >
          <label for="content-title">Title</label>
          <input id="content-title" name="title" required maxlength="300" />
          <label for="content-slug">Slug</label>
          <input
            id="content-slug"
            name="slug"
            required
            maxlength="200"
            pattern="[a-z0-9]+(-[a-z0-9]+)*"
          />
          <label for="content-type">Content type</label>
          <input
            id="content-type"
            name="content_type"
            required
            maxlength="32"
          />
          <button type="submit">Create content item</button>
        </form>
      </section>
    )
  }
</>

{
  offset > 0 && (
    <a href={`?${query}&offset=${Math.max(0, offset - 50)}`}>Previous page</a>
  )
}{
  v.next_content_offset !== null && (
    <a href={`?${query}&offset=${v.next_content_offset}`}>Next page</a>
  )
}
<p role="status" aria-live="polite" data-content-status></p>
<script>
  import "../../lib/content-actions";
</script>
