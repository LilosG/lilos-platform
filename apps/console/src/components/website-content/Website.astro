---
import type { WebsiteView } from "../../adapters/website-content";
import {
  WEBSITE_TABS,
  overviewTiles,
  pageGap,
  pageRows,
  siteChanges,
  siteStatus,
  websiteDetails,
  websiteInsight,
} from "../../lib/website-view";
import PageHeader from "../ui/PageHeader.astro";
import MetricStrip from "../ui/MetricStrip.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import StatusBadge from "../ui/StatusBadge.astro";
import EmptyState from "../ui/EmptyState.astro";
import TabNav from "../navigation/TabNav.astro";
import PerformanceInsight from "../client/PerformanceInsight.astro";
import PageTable from "./PageTable.astro";
import Technical from "./Technical.astro";
import Conversions from "./Conversions.astro";
import ContentTab from "./ContentTab.astro";
import SiteChangeRow from "./SiteChangeRow.astro";
import WebsiteDetails from "./WebsiteDetails.astro";
interface Props {
  view: WebsiteView;
  slug: string;
  clientName: string;
  tab: string;
  offset: number;
  now: Date;
}
const { view: v, slug, clientName, tab, offset, now } = Astro.props;
const base = `/clients/${slug}/website-content/`;
const api = `/api/organizations/${v.organization_id}/`;
const query = v.website_id ? `website_id=${v.website_id}` : "";
const integrationsHref = `/clients/${slug}/integrations/`;
const pageHref = (websiteId: string, pageId: string) =>
  `${base}pages/${websiteId}/${pageId}/${query ? "?" + query : ""}`;
const tabs = WEBSITE_TABS.map(([label, path]) => ({
  label,
  href: `${base}${path ? path + "/" : ""}${query ? "?" + query : ""}`,
  current: tab === path,
}));
const status = siteStatus(v, now);
const details = websiteDetails(v, now);
const gap = pageGap(v);
const canCheck = v.can_crawl && Boolean(v.website_id);
// One button starts a website check wherever the screen offers it.
const checkAttributes: Record<string, string | undefined> | null = canCheck
  ? { "data-website-check": api + `seo/websites/${v.website_id}/check/` }
  : null;
const insight = websiteInsight(v, now);
const insightHref: Record<string, string> = {
  integrations: integrationsHref,
  technical: `${base}technical/${query ? "?" + query : ""}`,
  pages: `${base}pages/${query ? "?" + query : ""}`,
};
const rows = pageRows(v, now, pageHref);
const changes = siteChanges(v.opportunities, slug, now);
const pagerHref = (to: number) =>
  `${base}pages/?${query}${query ? "&" : ""}offset=${to}`;
---

<PageHeader title="Website & Content" subtitle={clientName} client>
  <Fragment slot="actions">
    {
      v.websites.length > 1 ? (
        <select aria-label="Website" data-query-select="website_id">
          {v.websites.map((site) => (
            <option value={site.id} selected={site.id === v.website_id}>
              {site.name}
            </option>
          ))}
        </select>
      ) : (
        v.websites.length === 1 && (
          <span class="sitelabel" data-site-label>
            {v.websites[0].name}
          </span>
        )
      )
    }
    <button
      type="button"
      class="statuschip"
      data-dialog="website-details"
      aria-label={`Website data status: ${status.chip.label}. Open details`}
    >
      <StatusBadge text={status.chip.label} tone={status.chip.tone} />
    </button>
    {
      tab !== "content" &&
        (checkAttributes ? (
          <button
            type="button"
            class="control primary"
            inert
            {...checkAttributes}
          >
            Run website check
          </button>
        ) : (
          <button
            type="button"
            class="control primary"
            disabled
            title={
              v.can_crawl
                ? "Add a website in Integrations first"
                : "Your role cannot start website checks"
            }
          >
            Run website check
          </button>
        ))
    }
  </Fragment>
</PageHeader>
<TabNav label="Website & Content sections" tabs={tabs} />
<p class="formstatus" role="status" aria-live="polite" data-website-status></p>
{
  tab === "content" ? (
    <ContentTab view={v} base={base} api={api} query={query} offset={offset} />
  ) : tab === "conversions" ? (
    <Conversions
      integrationsHref={integrationsHref}
      pagesHref={insightHref.pages}
    />
  ) : tab === "technical" ? (
    <Technical
      view={v}
      slug={slug}
      now={now}
      pageHref={pageHref}
      integrationsHref={integrationsHref}
      checkAction={checkAttributes}
      query={query}
    />
  ) : tab === "pages" ? (
    <PageTable
      rows={rows}
      compact={false}
      gap={gap}
      partial={v.next_page_offset !== null}
      pagesHref={insightHref.pages}
      integrationsHref={integrationsHref}
      prevHref={offset > 0 ? pagerHref(Math.max(0, offset - 50)) : null}
      nextHref={
        v.next_page_offset !== null ? pagerHref(v.next_page_offset) : null
      }
      checkAction={checkAttributes}
    />
  ) : (
    <Fragment>
      <MetricStrip items={overviewTiles(v, now)} columns={5} />
      <section class="panel contextual" data-website-insight={insight.reason}>
        <SectionHeading>
          <Fragment slot="title">What needs attention</Fragment>
        </SectionHeading>
        <PerformanceInsight
          title={insight.title}
          detail={insight.detail}
          action={
            insight.action.target === "check"
              ? undefined
              : {
                  label: insight.action.label,
                  href: insightHref[insight.action.target],
                }
          }
          button={
            insight.action.target === "check" && checkAttributes
              ? { label: insight.action.label, attributes: checkAttributes }
              : undefined
          }
        />
      </section>
      <PageTable
        rows={rows}
        compact
        gap={gap}
        partial={v.next_page_offset !== null}
        pagesHref={insightHref.pages}
        integrationsHref={integrationsHref}
        prevHref={null}
        nextHref={null}
        checkAction={checkAttributes}
      />
      <section class="panel" data-site-changes>
        <SectionHeading>
          <Fragment slot="title">
            Proposed site changes <span class="count">{changes.length}</span>
          </Fragment>
        </SectionHeading>
        {changes.length ? (
          changes.map((change) => <SiteChangeRow change={change} />)
        ) : (
          <EmptyState title="No proposed changes">
            When a finding can be fixed on the site, the proposed change appears
            here for approval.
          </EmptyState>
        )}
        {v.next_opportunity_offset !== null && (
          <div class="rowactions pager">
            <a
              class="control"
              href={`?${query}&offset=${v.next_opportunity_offset}`}
            >
              More proposed changes
            </a>
          </div>
        )}
      </section>
    </Fragment>
  )
}
<WebsiteDetails details={details} integrationsHref={integrationsHref} />
<script>
  import "../../lib/website-actions";
</script>
