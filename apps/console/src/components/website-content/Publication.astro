---
import type { ContentView } from "../../adapters/website-content";
import { value } from "../../adapters/local-search";
interface Props {
  publication: ContentView["publications"][number];
  itemId: string;
  organizationId: string;
}
const { publication: p, itemId, organizationId } = Astro.props;
const api = `/api/organizations/${organizationId}/content-operations/${itemId}/publications/${p.id}/recover/`;
---

<article>
  <h3>Publication: {p.status}</h3>
  <p>
    Target path: {p.target_path} · Exact revision: {
      p.revision_id ?? "Unavailable"
    }
  </p>
  <p>
    Workflow: {p.workflow_status ?? "Unavailable"} · Failure: {
      p.workflow_failure ?? "None recorded"
    } · Correlation: {p.correlation_id ?? "Unavailable"}
  </p>
  <p>
    PR: {p.external_pull_request_id ?? "Not created"} · Checks/build: {
      p.build_status ?? "Unavailable"
    }
  </p>
  <p>
    Deployment: {p.deployment_status ?? "Not confirmed"} · Merged revision: {
      p.external_revision_id ?? "Unavailable"
    } · Approved head: {p.approved_head_sha ?? "Unavailable"}
  </p>
  <p>
    Live verification: {p.verification_status ?? "Not confirmed"} · Verified at: {
      p.verified_at ?? "Not confirmed"
    } · URL: {p.published_url ?? "Unavailable"}
  </p>
  <details>
    <summary>Live read-back evidence</summary>
    <p>{value(p.verification_evidence)}</p>
  </details>
  <p>Error: {p.safe_error_code ?? "None recorded"}</p>
  {
    p.can_recover && (
      <button inert data-content-action={api}>
        Resume canonical reconciliation
      </button>
    )
  }
</article>
