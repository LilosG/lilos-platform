---
import type { Organization } from "../../server/context";
import { clientNavigation, clientRoute } from "../../config/routes";
import { initials } from "../../lib/present";
interface Props {
  client: Organization;
  area: string;
}
const { client, area } = Astro.props;
---

<div class="contextlabel">
  <span class="clientmark">{initials(client.organization_name)}</span>
  <div>
    <strong>{client.organization_name}</strong>
    <small>Client workspace</small>
  </div>
</div>
<a class="backlink" href="/"> ‹ Entire Portfolio </a>
{
  clientNavigation.map((group) => (
    <Fragment>
      {group.label && <div class="navlabel">{group.label}</div>}
      <nav
        aria-label={
          group.label
            ? `Client ${group.label.toLowerCase()}`
            : "Client overview"
        }
      >
        {group.items.map(([label, icon]) => (
          <a
            href={clientRoute(client.organization_slug, label)}
            class:list={{ active: label === area }}
            aria-current={label === area ? "page" : undefined}
          >
            <span class="navicon" aria-hidden="true">
              {icon}
            </span>
            {label}
          </a>
        ))}
      </nav>
    </Fragment>
  ))
}
