---
import "../styles/theme.css";
import "../styles/app.css";
import Sidebar from "../components/app/Sidebar.astro";
import TopBar from "../components/app/TopBar.astro";
import { workspace, type Organization } from "../server/context";
import { areaFamily, areaOfPath } from "../lib/shell-paths";
interface Props {
  title: string;
  /** Kept for existing screens; the shell resolves the same list itself. */
  organizations?: Organization[];
  client?: Organization;
  surface?:
    "local-search" | "integrations" | "reviews" | "website-content" | "leads";
  /** Pre-sign-in screens render without navigation. */
  bare?: boolean;
  /** Screens drawn by the approved design render with its exact panel spacing. */
  reference?: boolean;
  /** Open attention items, when the screen has loaded them. Unknown is not zero. */
  attentionCount?: number | null;
  /** Client attention list is rendered on this screen as a dialog. */
  attentionDialog?: boolean;
  /** Open opportunities across the portfolio, when loaded. */
  opportunities?: number | null;
  /** When the data on this screen was generated. */
  updatedAt?: string;
}
const {
  title,
  client,
  surface,
  bare = false,
  reference = false,
  attentionCount = null,
  attentionDialog = false,
  opportunities = null,
  updatedAt,
} = Astro.props;
const path = Astro.url.pathname;
const segments = path.split("/").filter(Boolean);
const page = client ? "client" : (segments[0] ?? "") || "dashboard";
const workspacePath = client ? segments.slice(2).join("/") : "";
const area = client ? (areaOfPath[workspacePath.split("/", 1)[0]] ?? "") : "";
const shell = bare ? null : await workspace(Astro.locals);
const email = Astro.locals.userEmail ?? "";
const role = shell?.platformAdministrator
  ? "Platform administrator"
  : "Client user";
const updated = updatedAt
  ? new Intl.DateTimeFormat("en-US", {
      timeZone: "America/Los_Angeles",
      month: "long",
      day: "numeric",
      year: "numeric",
    }).format(new Date(updatedAt))
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} | LILOs Growth</title>
    <meta name="description" content="LILOs Growth agency command center" />
    <meta name="csrf-token" content={Astro.locals.csrf} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231e443c'/%3E%3Cpath d='M9 7v18h15v-5H14V7' fill='%23d6f26b'/%3E%3C/svg%3E"
    />
  </head>
  <body
    class={surface ? "phase2-surface" : undefined}
    data-client-id={client?.organization_id}
    data-page={page}
    data-ref={reference ? "true" : undefined}
    data-area={area}
  >
    <a class="skiplink" href="#main">Skip to content</a>
    {
      bare ? (
        <main id="main" tabindex="-1" class="authmain">
          <a class="brand authbrand" href="/">
            <span class="logo">L</span>
            <span>
              LILOs<small>GROWTH</small>
            </span>
          </a>
          <slot />
        </main>
      ) : (
        <Fragment>
          <Sidebar
            client={client}
            page={page}
            area={area}
            email={email}
            role={role}
            opportunities={opportunities}
          />
          <div class="shell">
            <TopBar
              client={client}
              clients={shell?.clients ?? []}
              areaPath={areaFamily(workspacePath)}
              attentionCount={attentionCount}
              attentionDialog={attentionDialog}
            />
            <main id="main" tabindex="-1">
              <slot />
            </main>
            <footer>
              Source freshness and unavailable data are shown with each record.
              {updated && ` · Updated ${updated}`}
            </footer>
          </div>
          <div id="toast" role="status" aria-live="polite" />
        </Fragment>
      )
    }
    <script>
      import "../lib/shell";
    </script>
  </body>
</html>
