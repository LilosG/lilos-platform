---
import "../styles/theme.css";
import "../styles/app.css";
import "../styles/report-document.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="csrf-token" content={Astro.locals.csrf} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="docpage">
    <main id="main">
      <slot />
    </main>
    <script>
      // "Download PDF" opens this page with ?print: the browser's own print dialog saves the PDF.
      if (new URLSearchParams(window.location.search).has("print"))
        window.addEventListener("load", () => {
          const ready = document.fonts
            ? document.fonts.ready
            : Promise.resolve();
          void ready.then(() => window.print());
        });
    </script>
  </body>
</html>
