---
import AppLayout from "../layouts/AppLayout.astro";
import Dashboard from "../components/portfolio/Dashboard.astro";
import ClientTable from "../components/portfolio/ClientTable.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import ErrorState from "../components/ui/ErrorState.astro";
import NotBuilt from "../components/ui/NotBuilt.astro";
import DialogFrame from "../components/ui/DialogFrame.astro";
import Automations from "../components/automations/Automations.astro";
import RunDialog from "../components/automations/RunDialog.astro";
import RunFooter from "../components/automations/RunFooter.astro";
import HistoryDialog from "../components/automations/HistoryDialog.astro";
import {
  loadAutomationsPage,
  type AutomationsPage,
} from "../server/automation-loader";
import { dialogView, filterQuery } from "../lib/automation-view";
import Opportunities from "../components/opportunities/Opportunities.astro";
import {
  adaptOpportunityList,
  type OpportunityListView,
} from "../adapters/opportunities";
import { AREAS, type PortfolioArea } from "../lib/present";
import { clientRowView } from "../lib/portfolio-view";
import {
  loadPortfolio,
  reportingDays,
  type PortfolioOverview,
} from "../server/command-center";
import { organizations, workspace } from "../server/context";
import Administration from "../components/administration/Administration.astro";
import {
  loadClientsTable,
  type AdministrationClients,
} from "../server/admin-loader";
import { APIError, read } from "../server/bff";
const page = (Astro.params.page ?? "").replace(/\/$/, "");
const [area, sub] = page.split("/");
const administration =
  area === "administration" &&
  (sub === undefined || ["onboarding", "users", "platform"].includes(sub));
const builtArea =
  Object.hasOwn(AREAS, area) && (area !== "administration" || administration);
if (
  page.split("/").length >
  (area === "administration" || area === "automations" ? 2 : 1)
)
  return new Response("Page not found", { status: 404 });
if (page !== "" && page !== "clients" && !builtArea)
  return new Response("Page not found", { status: 404 });
if (page === "integrations" && Astro.url.searchParams.has("org")) {
  const rows = await organizations(Astro.locals);
  const org = rows.find(
    (row) => row.organization_id === Astro.url.searchParams.get("org"),
  );
  if (!org) return new Response("Client not found", { status: 404 });
  return Astro.redirect(`/clients/${org.organization_slug}/integrations/`);
}
let automationsPage: AutomationsPage | undefined;
if (area === "automations") {
  automationsPage = await loadAutomationsPage(
    Astro.locals,
    Astro.url.searchParams,
    { schedule: sub },
  );
  if (automationsPage.kind === "invalid")
    return new Response("Invalid filter", { status: 400 });
  if (automationsPage.kind === "notfound")
    return new Response("Page not found", { status: 404 });
  if (automationsPage.kind === "unauthenticated")
    return Astro.redirect("/login/", 303);
}
let administrationState: "ok" | "forbidden" | "error" | undefined;
let administrationClients: AdministrationClients | undefined;
if (area === "administration" && administration) {
  // The API decides who may administer; the shell only hides what it would refuse.
  if (!(await workspace(Astro.locals)).platformAdministrator)
    administrationState = "forbidden";
  else if (sub === undefined) {
    const loaded = await loadClientsTable(Astro.locals);
    if (loaded.kind === "unauthenticated")
      return Astro.redirect("/login/", 303);
    administrationState =
      loaded.kind === "ok"
        ? "ok"
        : loaded.kind === "forbidden"
          ? "forbidden"
          : "error";
    if (loaded.kind === "ok") administrationClients = loaded.clients;
  } else administrationState = "ok";
}
const days = reportingDays(Astro.url.searchParams.get("days"));
if (days === null) return new Response("Invalid period", { status: 400 });
const loadsData = page === "" || page === "clients";
let overview: PortfolioOverview | undefined;
let opportunities: OpportunityListView | undefined;
let failed = false;
const filters = {
  organization_id: Astro.url.searchParams.get("organization_id") ?? "",
  kind: Astro.url.searchParams.get("kind") ?? "",
  priority: Astro.url.searchParams.get("priority") ?? "",
  state: Astro.url.searchParams.get("state") ?? "",
};
const offset = Number(Astro.url.searchParams.get("offset") ?? 0);
const clientRows =
  page === "opportunities" ? await organizations(Astro.locals) : [];
if (page === "opportunities") {
  if (
    (filters.kind && !["seo", "content", "growth"].includes(filters.kind)) ||
    (filters.priority &&
      !["high", "medium", "low"].includes(filters.priority)) ||
    (filters.state && !["open", "done"].includes(filters.state)) ||
    (filters.organization_id &&
      !clientRows.some((c) => c.organization_id === filters.organization_id)) ||
    !Number.isInteger(offset) ||
    offset < 0 ||
    offset > 100000
  )
    return new Response("Invalid filter", { status: 400 });
  try {
    const params = new URLSearchParams({ offset: String(offset) });
    for (const [key, value] of Object.entries(filters))
      if (value) params.set(key, value);
    opportunities = adaptOpportunityList(
      await read(Astro.locals, `command-center/opportunities/?${params}`),
      null,
      clientRows.map((c) => c.organization_id),
    );
  } catch (e) {
    if (e instanceof APIError && e.status === 401)
      return Astro.redirect("/login/", 303);
    failed = true;
  }
}
if (loadsData) {
  try {
    overview = await loadPortfolio(Astro.locals, days);
  } catch (e) {
    if (e instanceof APIError && e.status === 401)
      return Astro.redirect("/login/", 303);
    failed = true;
  }
}
const title =
  page === ""
    ? "Dashboard"
    : page === "clients"
      ? "Client portfolio"
      : AREAS[area as PortfolioArea];
---

<AppLayout
  reference
  title={title}
  attentionCount={overview ? overview.attention.length : null}
  updatedAt={overview?.generated_at}
>
  {
    administrationState ? (
      <Administration
        state={administrationState}
        tab={sub}
        clients={administrationClients}
      />
    ) : automationsPage?.kind === "error" ? (
      <Fragment>
        <PageHeader
          title="Automations"
          subtitle="Exceptions, scheduled work, and meaningful outcomes across the portfolio."
        />
        <ErrorState title="Automations are temporarily unavailable">
          We could not read the schedule, so nothing is shown rather than a
          guess.
          <a
            slot="action"
            class="control primary"
            href={Astro.url.pathname + Astro.url.search}
          >
            Try again
          </a>
        </ErrorState>
      </Fragment>
    ) : automationsPage?.kind === "list" ? (
      <Automations
        view={automationsPage.view}
        filters={automationsPage.filters}
        now={new Date(automationsPage.view.generated_at)}
      />
    ) : automationsPage?.kind === "detail" ? (
      <Fragment>
        <DialogFrame
          id="automation-detail"
          returnLabel="All automations"
          returnTo={`/automations/${filterQuery(automationsPage.filters)}`}
        >
          <RunDialog
            slot="body"
            view={dialogView(
              automationsPage.detail,
              new Date(),
              automationsPage.multi,
            )}
          />
          <RunFooter
            slot="footer"
            view={dialogView(
              automationsPage.detail,
              new Date(),
              automationsPage.multi,
            )}
            runUrl={`/api/command-center/automations/${automationsPage.detail.id}/run/`}
          />
        </DialogFrame>
        <HistoryDialog
          view={dialogView(
            automationsPage.detail,
            new Date(),
            automationsPage.multi,
          )}
        />
      </Fragment>
    ) : failed ? (
      <Fragment>
        <PageHeader
          title={
            page === "opportunities"
              ? "Opportunities"
              : page === ""
                ? "Portfolio overview"
                : "Client portfolio"
          }
          subtitle={
            page === "opportunities"
              ? "Evidence-backed issues and growth opportunities, ready for action."
              : "Every client, one operational view."
          }
        />
        <ErrorState
          title={
            page === "opportunities"
              ? "Opportunities are temporarily unavailable"
              : "Portfolio data is temporarily unavailable"
          }
        >
          No sample data is substituted. Reload to try again.
        </ErrorState>
      </Fragment>
    ) : opportunities ? (
      <Opportunities
        view={opportunities}
        clients={clientRows}
        filters={filters}
        now={new Date()}
      />
    ) : overview && page === "" ? (
      <Dashboard overview={overview} />
    ) : overview ? (
      <Fragment>
        <PageHeader
          title="Client portfolio"
          subtitle="Every client, one operational view."
          days={overview.days}
        />
        <ClientTable
          rows={overview.clients.map((row) =>
            clientRowView(row, new Date(overview!.generated_at)),
          )}
          locationCount={overview.location_count}
        />
      </Fragment>
    ) : (
      <NotBuilt target={{ scope: "portfolio", area: area as PortfolioArea }} />
    )
  }
</AppLayout>
