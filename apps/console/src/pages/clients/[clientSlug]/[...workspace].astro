---
import Leads from "../../../components/leads/Leads.astro";
import LeadDetail from "../../../components/leads/LeadDetail.astro";
import { adaptLeads, adaptLeadDetail } from "../../../adapters/leads";
import type { LeadsView, LeadDetailView } from "../../../adapters/leads";
import Website from "../../../components/website-content/Website.astro";
import ContentDetail from "../../../components/website-content/ContentDetail.astro";
import WebsitePageDetail from "../../../components/website-content/PageDetail.astro";
import {
  adaptWebsite,
  adaptWebsitePage,
  adaptContent,
} from "../../../adapters/website-content";
import type {
  WebsiteView,
  WebsitePageView,
  ContentView,
} from "../../../adapters/website-content";
import Reviews from "../../../components/reviews/Reviews.astro";
import ResponseDetail from "../../../components/reviews/ResponseDetail.astro";
import {
  adaptReviews,
  adaptReviewDetail,
  reviewFilter,
} from "../../../adapters/reviews";
import type { ReviewFilter } from "../../../adapters/reviews";
import type { ReviewsView, ReviewDetailView } from "../../../adapters/reviews";
import Integrations from "../../../components/integrations/Integrations.astro";
import LocalSearch from "../../../components/local-search/LocalSearch.astro";
import PageIntelligence from "../../../components/local-search/PageIntelligence.astro";
import {
  adaptIntegrations,
  adaptLocalSearch,
  adaptPage,
} from "../../../adapters/local-search";
import type {
  IntegrationsView,
  LocalSearchView,
  PageIntelligence as PageView,
} from "../../../adapters/local-search";
import type { GbpPerformanceView } from "../../../adapters/gbp";
import type { GbpTabData } from "../../../lib/gbp-view";
import { loadGbpOverview, loadGbpTab } from "../../../server/gbp-loader";
import ErrorState from "../../../components/ui/ErrorState.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";
import DialogFrame from "../../../components/ui/DialogFrame.astro";
import AppLayout from "../../../layouts/AppLayout.astro";
import Opportunities from "../../../components/opportunities/Opportunities.astro";
import OpportunityDetail from "../../../components/opportunities/OpportunityDetail.astro";
import Overview from "../../../components/client/Overview.astro";
import NotBuilt from "../../../components/ui/NotBuilt.astro";
import Automations from "../../../components/automations/Automations.astro";
import RunDialog from "../../../components/automations/RunDialog.astro";
import RunFooter from "../../../components/automations/RunFooter.astro";
import HistoryDialog from "../../../components/automations/HistoryDialog.astro";
import {
  loadAutomationsPage,
  type AutomationsPage,
} from "../../../server/automation-loader";
import { dialogView, filterQuery } from "../../../lib/automation-view";
import { clientAreaSlugs } from "../../../config/routes";
import {
  loadOverview,
  reportingDays,
  type ClientOverview,
} from "../../../server/command-center";
import { organizations, resolveSlug } from "../../../server/context";
import { read, APIError } from "../../../server/bff";
import {
  adaptOpportunityList,
  adaptAttention,
  adaptDetail,
} from "../../../adapters/opportunities";
import { compactRows } from "../../../lib/opportunity-view";
import type { CompactOpportunity } from "../../../lib/opportunity-view";
import type {
  OpportunityListView,
  AttentionView,
  OpportunityDetail as Detail,
} from "../../../adapters/opportunities";
const rows = await organizations(Astro.locals);
let client;
try {
  client = resolveSlug(rows, Astro.params.clientSlug ?? "");
} catch {
  return new Response("Client not found", { status: 404 });
}
const path = (Astro.params.workspace ?? "").replace(/\/$/, "");
const section = path.split("/")[0];
const sourceId = path.split("/")[1];
let leads: LeadsView | undefined;
let leadDetail: LeadDetailView | undefined;
let website: WebsiteView | undefined;
let websitePage: WebsitePageView | undefined;
let websitePageSite: string | null = null;
let contentDetail: ContentView | undefined;
let reviews: ReviewsView | undefined;
let reviewDetail: ReviewDetailView | undefined;
let reviewStatus: ReviewFilter = "all";
let badReviewFilter = false;
let integrations: IntegrationsView | undefined;
let localSearch: LocalSearchView | undefined;
let pageView: PageView | undefined;
let gbpOverview: GbpPerformanceView | null = null;
let gbpTab: GbpTabData | null = null;
let overviewOpportunities: CompactOpportunity[] | null = null;
const segments = path.split("/");
const tab = segments[1] ?? "";
const days = Number(Astro.url.searchParams.get("days") ?? 28);
if (
  (section === "local-search" || section === "") &&
  ![7, 28, 90].includes(days)
)
  return new Response("Invalid period", { status: 400 });
const builtSections = [
  "leads",
  "website-content",
  "reviews",
  "integrations",
  "local-search",
  "opportunities",
  "attention",
  "automations",
];
const notBuilt = section in clientAreaSlugs;
if (section !== "" && !notBuilt && !builtSections.includes(section))
  return new Response("Page not found", { status: 404 });
if (notBuilt && segments.length > 1)
  return new Response("Page not found", { status: 404 });
let overview: ClientOverview | undefined;
let automationsPage: AutomationsPage | undefined;
const websiteId = Astro.url.searchParams.get("website_id") ?? undefined;
if (
  section === "local-search" &&
  ![
    "",
    "rankings",
    "google-business-profile",
    "search-console",
    "pages",
    "technical",
  ].includes(tab)
)
  return new Response("Page not found", { status: 404 });
let opportunities: OpportunityListView | undefined;
let attention: AttentionView[] = [];
let detail: Detail | undefined;
let error: string | undefined;
let next: number | null = null;
const offset = Number(Astro.url.searchParams.get("offset") ?? 0);
if (!Number.isInteger(offset) || offset < 0 || offset > 100000)
  return new Response("Invalid page", { status: 400 });
const oppFilters = {
  organization_id: "",
  kind: Astro.url.searchParams.get("kind") ?? "",
  priority: Astro.url.searchParams.get("priority") ?? "",
  state: Astro.url.searchParams.get("state") ?? "",
};
if (
  (oppFilters.state && !["open", "done"].includes(oppFilters.state)) ||
  (oppFilters.kind &&
    !["seo", "content", "growth"].includes(oppFilters.kind)) ||
  (oppFilters.priority &&
    !["high", "medium", "low"].includes(oppFilters.priority))
)
  return new Response("Invalid filter", { status: 400 });
const fromPortfolio = Astro.url.searchParams.get("from") === "portfolio";
const scope = `organizations/${client.organization_id}/command-center/`;
try {
  if (section === "") {
    if (segments.length > 1 || path !== "")
      return new Response("Page not found", { status: 404 });
    overview = await loadOverview(
      Astro.locals,
      client.organization_id,
      reportingDays(String(days)) ?? 28,
    );
  } else if (section === "leads") {
    const location = Astro.url.searchParams.get("location_id") || undefined;
    const params = new URLSearchParams(
      location ? { location_id: location } : {},
    );
    if (segments.length === 2 && tab && tab !== "outcomes")
      leadDetail = adaptLeadDetail(
        await read(Astro.locals, scope + `leads/${tab}/?${params}`),
        client.organization_id,
        tab,
        location,
      );
    else {
      if (segments.length > 2 || !["", "outcomes"].includes(tab))
        return new Response("Page not found", { status: 404 });
      params.set("offset", String(offset));
      leads = adaptLeads(
        await read(Astro.locals, scope + `leads/?${params}`),
        client.organization_id,
        location,
      );
    }
  } else if (section === "website-content") {
    if (segments.length === 4 && tab === "pages") {
      websitePage = adaptWebsitePage(
        await read(
          Astro.locals,
          scope +
            `website-content/websites/${segments[2]}/pages/${segments[3]}/`,
        ),
        client.organization_id,
        segments[2],
        segments[3],
      );
      websitePageSite = await read<{
        websites?: { id: string; name: string }[];
      }>(Astro.locals, scope + `website-content/?website_id=${segments[2]}`)
        .then(
          (payload) =>
            payload.websites?.find((site) => site.id === segments[2])?.name ??
            null,
        )
        .catch(() => null);
    } else if (segments.length === 3 && tab === "content")
      contentDetail = adaptContent(
        await read(
          Astro.locals,
          scope + `website-content/content/${segments[2]}/`,
        ),
        client.organization_id,
        segments[2],
      );
    else {
      if (
        segments.length > 2 ||
        !["", "pages", "content", "technical", "conversions"].includes(tab)
      )
        return new Response("Page not found", { status: 404 });
      const params = new URLSearchParams({
        offset: String(offset),
        ...(websiteId ? { website_id: websiteId } : {}),
      });
      website = adaptWebsite(
        await read(Astro.locals, scope + `website-content/?${params}`),
        client.organization_id,
        websiteId,
      );
    }
  } else if (section === "reviews") {
    if (segments.length === 4 && tab === "locations")
      reviewDetail = adaptReviewDetail(
        await read(
          Astro.locals,
          scope + `reviews/locations/${segments[2]}/${segments[3]}/`,
        ),
        client.organization_id,
        segments[2],
        segments[3],
      );
    else {
      if (
        segments.length > 2 ||
        !["", "requests", "opportunities"].includes(tab)
      )
        return new Response("Page not found", { status: 404 });
      const location = Astro.url.searchParams.get("location_id") ?? undefined;
      const status = reviewFilter(Astro.url.searchParams.get("status"));
      if (status === null) {
        badReviewFilter = true;
        Astro.response.status = 400;
      } else {
        reviewStatus = status;
        const params = new URLSearchParams({
          offset: String(offset),
          ...(location ? { location_id: location } : {}),
          ...(status === "all" ? {} : { status }),
        });
        reviews = adaptReviews(
          await read(Astro.locals, scope + `reviews/?${params}`),
          client.organization_id,
          location,
        );
      }
    }
  } else if (section === "integrations") {
    if (sourceId) return new Response("Page not found", { status: 404 });
    integrations = adaptIntegrations(
      await read(Astro.locals, scope + "integrations/"),
      client.organization_id,
    );
  } else if (section === "local-search") {
    if (segments.length === 4 && tab === "pages")
      pageView = adaptPage(
        await read(
          Astro.locals,
          scope + `local-search/websites/${segments[2]}/pages/${segments[3]}/`,
        ),
        client.organization_id,
        segments[2],
        segments[3],
      );
    else {
      if (segments.length > 2)
        return new Response("Page not found", { status: 404 });
      const params = new URLSearchParams({
        days: String(days),
        offset: String(offset),
        ...(websiteId ? { website_id: websiteId } : {}),
      });
      localSearch = adaptLocalSearch(
        await read(Astro.locals, scope + `local-search/?${params}`),
        client.organization_id,
        websiteId,
      );
      if (tab === "") {
        gbpOverview = await loadGbpOverview(
          Astro.locals,
          client.organization_id,
          days,
        );
        // Findings for the Overview's panel; a failure shows its own state, not a page error.
        overviewOpportunities = await read(
          Astro.locals,
          scope + "opportunities/?limit=20",
        )
          .then((payload) =>
            compactRows(
              adaptOpportunityList(payload, client.organization_id, null).items,
              new Date(),
            ),
          )
          .catch(() => null);
      } else if (tab === "google-business-profile")
        gbpTab = await loadGbpTab(
          Astro.locals,
          localSearch,
          Astro.url.searchParams,
          days,
          Astro.url.pathname,
        );
    }
  } else if (section === "opportunities") {
    if (sourceId)
      detail = adaptDetail(
        await read(Astro.locals, scope + `opportunities/${sourceId}/`),
        client.organization_id,
        sourceId,
      );
    else {
      const params = new URLSearchParams({ offset: String(offset) });
      for (const key of ["kind", "priority", "state"] as const)
        if (oppFilters[key]) params.set(key, oppFilters[key]);
      opportunities = adaptOpportunityList(
        await read(Astro.locals, scope + `opportunities/?${params}`),
        client.organization_id,
        null,
      );
    }
  } else if (section === "automations") {
    if (segments.length > 2)
      return new Response("Page not found", { status: 404 });
    automationsPage = await loadAutomationsPage(
      Astro.locals,
      Astro.url.searchParams,
      { client: client.organization_id, schedule: sourceId },
    );
    if (automationsPage.kind === "invalid")
      return new Response("Invalid filter", { status: 400 });
    if (automationsPage.kind === "notfound")
      return new Response("Page not found", { status: 404 });
    if (automationsPage.kind === "unauthenticated")
      return Astro.redirect("/login/", 303);
    if (automationsPage.kind === "error") error = "AUTOMATIONS_UNAVAILABLE";
  } else if (section === "attention") {
    const payload = await read<{ data: unknown[]; next_offset: number | null }>(
      Astro.locals,
      scope + `attention/?offset=${offset}`,
    );
    attention = adaptAttention(payload);
    next = payload.next_offset;
  }
} catch (e) {
  if (e instanceof APIError && [403, 404].includes(e.status))
    return new Response("Source not found", { status: 404 });
  error =
    "This source is temporarily unavailable. No sample data is substituted.";
}
const title =
  section === "automations"
    ? "Automations"
    : section === "website-content"
      ? "Website & Content"
      : section === "leads"
        ? "Leads"
        : section === "reviews"
          ? "Reviews"
          : section === "local-search"
            ? "Local Search"
            : section === "integrations"
              ? "Integrations"
              : section === "opportunities"
                ? "Opportunities"
                : section === "attention"
                  ? "Requires attention"
                  : section
                    ? section.replaceAll("-", " ")
                    : client.organization_name;
---

<AppLayout
  reference={overview !== undefined ||
    notBuilt ||
    (section === "automations" && error === undefined) ||
    (section === "integrations" && error === undefined) ||
    (section === "opportunities" && error === undefined) ||
    (localSearch !== undefined && error === undefined)}
  title={title}
  organizations={rows}
  client={client}
  attentionCount={overview ? overview.attention.length : null}
  attentionDialog={overview !== undefined}
  updatedAt={overview?.generated_at}
  surface={section === "local-search" ||
  section === "integrations" ||
  section === "reviews" ||
  section === "website-content" ||
  section === "leads"
    ? section
    : undefined}
>
  {
    overview ? (
      <Overview overview={overview} />
    ) : automationsPage?.kind === "detail" ? (
      <Fragment>
        <DialogFrame
          id="automation-detail"
          returnLabel="All automations"
          returnTo={`/clients/${client.organization_slug}/automations/${filterQuery(automationsPage.filters)}`}
        >
          <RunDialog
            slot="body"
            view={dialogView(
              automationsPage.detail,
              new Date(),
              automationsPage.multi,
            )}
          />
          <RunFooter
            slot="footer"
            view={dialogView(
              automationsPage.detail,
              new Date(),
              automationsPage.multi,
            )}
            runUrl={`/api/command-center/automations/${automationsPage.detail.id}/run/`}
          />
        </DialogFrame>
        <HistoryDialog
          view={dialogView(
            automationsPage.detail,
            new Date(),
            automationsPage.multi,
          )}
        />
      </Fragment>
    ) : notBuilt ? (
      <NotBuilt
        target={{
          scope: "client",
          area: section as keyof typeof clientAreaSlugs,
        }}
        subtitle={`${client.organization_name} · This screen is not part of the Command Center yet.`}
      />
    ) : leadDetail ? (
      <DialogFrame
        id="lead-detail"
        returnLabel="All leads"
        returnTo={`/clients/${client.organization_slug}/leads/${leadDetail.lead.location_id ? `?location_id=${leadDetail.lead.location_id}` : ""}`}
      >
        <LeadDetail
          slot="body"
          view={leadDetail}
          slug={client.organization_slug}
        />
      </DialogFrame>
    ) : contentDetail ? (
      <DialogFrame
        id="content-detail"
        returnLabel="All content"
        returnTo={`/clients/${client.organization_slug}/website-content/content/`}
      >
        <ContentDetail
          slot="body"
          view={contentDetail}
          slug={client.organization_slug}
        />
      </DialogFrame>
    ) : websitePage ? (
      <DialogFrame
        id="website-page-detail"
        returnLabel="All pages"
        returnTo={`/clients/${client.organization_slug}/website-content/pages/?website_id=${websitePage.evidence.identity.website_id}`}
      >
        <WebsitePageDetail
          slot="body"
          view={websitePage}
          slug={client.organization_slug}
          siteName={websitePageSite}
          now={new Date()}
        />
      </DialogFrame>
    ) : reviewDetail ? (
      <DialogFrame
        id="review-detail"
        returnLabel="All reviews"
        returnTo={`/clients/${client.organization_slug}/reviews/?location_id=${reviewDetail.location_id}`}
      >
        <ResponseDetail slot="body" view={reviewDetail} />
      </DialogFrame>
    ) : pageView ? (
      <DialogFrame
        id="page-intelligence"
        returnLabel="All pages"
        returnTo={`/clients/${client.organization_slug}/local-search/pages/`}
      >
        <PageIntelligence
          slot="body"
          view={pageView}
          slug={client.organization_slug}
        />
      </DialogFrame>
    ) : detail ? (
      <DialogFrame
        id="opportunity-detail"
        returnTo={
          fromPortfolio
            ? "/opportunities/"
            : `/clients/${client.organization_slug}/opportunities/`
        }
      >
        <OpportunityDetail slot="body" detail={detail} />
        <a
          slot="footer"
          class="control"
          href={
            detail.kind === "content"
              ? `/clients/${client.organization_slug}/website-content/content/`
              : detail.kind === "seo"
                ? `/clients/${client.organization_slug}/local-search/pages/`
                : `/clients/${client.organization_slug}/`
          }
        >
          Open source area
        </a>
      </DialogFrame>
    ) : (
      <Fragment>
        {!opportunities &&
          !localSearch &&
          !reviews &&
          !website &&
          !integrations &&
          section !== "integrations" &&
          !automationsPage && (
            <div class="pagehead">
              <div>
                <>
                  <h1>{title}</h1>
                  <p>{client.organization_name}</p>
                </>
              </div>
            </div>
          )}
        {error && section === "website-content" ? (
          <Fragment>
            <PageHeader
              title="Website & Content"
              subtitle={client.organization_name}
              client
            />
            <ErrorState title="Website data could not be loaded">
              We could not read this website's data, so nothing is shown rather
              than a guess.
              <a
                slot="action"
                class="control primary"
                href={Astro.url.pathname + Astro.url.search}
              >
                Try again
              </a>
            </ErrorState>
          </Fragment>
        ) : error && section === "integrations" ? (
          <Fragment>
            <PageHeader
              title="Integrations"
              subtitle={client.organization_name}
              client
            />
            <ErrorState title="Integrations could not be loaded">
              We could not read this client's connections, so nothing is shown
              rather than a guess.
              <a
                slot="action"
                class="control primary"
                href={Astro.url.pathname + Astro.url.search}
              >
                Try again
              </a>
            </ErrorState>
          </Fragment>
        ) : error === "AUTOMATIONS_UNAVAILABLE" ? (
          <Fragment>
            <PageHeader
              title="Automations"
              subtitle={client.organization_name}
              client
            />
            <ErrorState title="Automations are temporarily unavailable">
              We could not read this client's schedule, so nothing is shown
              rather than a guess.
              <a
                slot="action"
                class="control primary"
                href={Astro.url.pathname + Astro.url.search}
              >
                Try again
              </a>
            </ErrorState>
          </Fragment>
        ) : error ? (
          <ErrorState title="This page could not be loaded">{error}</ErrorState>
        ) : badReviewFilter ? (
          <ErrorState title="Invalid filter">
            That view is not one of the review filters.
            <a
              slot="action"
              class="control"
              href={`/clients/${client.organization_slug}/reviews/`}
            >
              All reviews
            </a>
          </ErrorState>
        ) : automationsPage?.kind === "list" ? (
          <Automations
            view={automationsPage.view}
            filters={automationsPage.filters}
            now={new Date(automationsPage.view.generated_at)}
            client={{
              slug: client.organization_slug,
              name: client.organization_name,
            }}
          />
        ) : leads ? (
          <Leads view={leads} slug={client.organization_slug} tab={tab} />
        ) : website ? (
          <Website
            view={website}
            slug={client.organization_slug}
            clientName={client.organization_name}
            tab={tab}
            offset={offset}
            now={new Date()}
          />
        ) : reviews ? (
          <Reviews
            view={reviews}
            slug={client.organization_slug}
            clientName={client.organization_name}
            filter={reviewStatus}
            tab={tab as "" | "requests" | "opportunities"}
            offset={offset}
            now={new Date()}
          />
        ) : integrations ? (
          <Integrations
            view={integrations}
            slug={client.organization_slug}
            clientName={client.organization_name}
            now={new Date()}
          />
        ) : localSearch ? (
          <LocalSearch
            view={localSearch}
            slug={client.organization_slug}
            clientName={client.organization_name}
            tab={tab}
            days={days}
            offset={offset}
            gbp={gbpOverview}
            gbpTab={gbpTab}
            opportunities={overviewOpportunities}
          />
        ) : opportunities ? (
          <Opportunities
            view={opportunities}
            client={client}
            filters={oppFilters}
            now={new Date()}
          />
        ) : section === "attention" ? (
          <div class="panel">
            <h2>Operational attention</h2>
            {attention.length ? (
              attention.map((item) => (
                <div class="listrow">
                  <div>
                    <a
                      href={`/clients/${client.organization_slug}/opportunities/${item.opportunity_id}/`}
                    >
                      {item.reason.replaceAll("_", " ")}
                    </a>
                    <small>
                      {item.status}
                      {item.code ? ` · ${item.code}` : ""}
                    </small>
                  </div>
                </div>
              ))
            ) : (
              <p>No attention items in this page of canonical SEO work.</p>
            )}
          </div>
        ) : null}
        {next !== null && <a href={`?offset=${next}`}>Next page</a>}
      </Fragment>
    )
  }
</AppLayout>
