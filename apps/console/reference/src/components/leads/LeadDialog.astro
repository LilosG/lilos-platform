---
import type { ViewContext, Client } from "../../types/domain";
import { clients } from "../../data/fixtures";
import { required } from "../../lib/view";

import StatusBadge from "../ui/StatusBadge.astro";

import DialogFrame from "../ui/DialogFrame.astro";

import { leads } from "../../data/fixtures/leads";
interface Props {
  context: ViewContext;
  c?: Client | null;
  id: string;
  i: number;
}

const id = Astro.props.id;
const i = Astro.props.i;
const dialogId = "lead" + "-" + id + "-" + i;
const c = required(
  clients.find((c) => c.id === id),
  "Fixture record",
);
const lead = required(
  leads.find((lead) => lead.id === id + "-" + i),
  "lead",
);
const n = lead.contact;
---

<DialogFrame id={dialogId}>
  <Fragment slot="body">
    <div class="eyebrow">
      <span data-entity="client" data-record-id={c.id} data-field="name">
        {c.name}
      </span>{" "}
      · Sample inquiry
    </div>
    <h2 id={dialogId + "-title"}>{n}</h2>
    <p>
      <span
        data-entity="lead"
        data-record-id={id + "-" + i}
        data-field="status"
      >
        <StatusBadge text={lead.status} />
      </span>
    </p>
    <h3>Inquiry</h3>
    <p>{lead.message}</p>
    <p>
      Source: {lead.source} · Received September {29 - i}
    </p>
  </Fragment>
  <Fragment slot="footer">
    <button data-close>Close</button>
    <button
      class="primary"
      data-command="markLead"
      data-args={JSON.stringify([id, i])}
    >
      Mark contacted
    </button>
  </Fragment>
</DialogFrame>
