---
import type { ViewContext, Client } from "../../types/domain";
import { clients } from "../../data/fixtures";
import { required } from "../../lib/view";

import DialogFrame from "../ui/DialogFrame.astro";

interface Props {
  context: ViewContext;
  c?: Client | null;
  id: string;
}

const id = Astro.props.id;
const dialogId = "post" + "-" + id;
const c = required(
  clients.find((x) => x.id === id),
  "Fixture record",
);
---

<DialogFrame id={dialogId}>
  <Fragment slot="body">
    <div class="eyebrow">
      <span data-entity="client" data-record-id={c.id} data-field="name">
        {c.name}
      </span>{" "}
      · Scheduled GBP post
    </div>
    <h2 id={dialogId + "-title"}>Service highlight</h2>
    <p>Scheduled September 30 · 10:00 AM Pacific</p>
    <label for={dialogId + "-postcopy"}>Post copy</label>
    <textarea
      data-entity="client"
      data-record-id={c.id}
      data-field="postCopy"
      id={dialogId + "-postcopy"}
      data-editor="postcopy"
      rows="4"
    >{String(c.postCopy || `Explore ${c.name} in ${c.location.split(',')[0]}. Learn more about our ${c.category.toLowerCase()} offerings and contact the team for details.`)}</textarea>
  </Fragment>
  <Fragment slot="footer">
    <button data-close>Close</button>
    <button
      class="primary"
      data-command="savePost"
      data-args={JSON.stringify([id])}
    >
      Save scheduled post
    </button>
  </Fragment>
</DialogFrame>
