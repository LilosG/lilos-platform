---
import type { ViewContext, Client } from "../../types/domain";
import { clients, reviewRecords } from "../../data/fixtures";
import { required } from "../../lib/view";

import StatusBadge from "../ui/StatusBadge.astro";

import DialogFrame from "../ui/DialogFrame.astro";

interface Props {
  context: ViewContext;
  c?: Client | null;
  id: string;
}

const id = Astro.props.id;
const dialogId = "review" + "-" + id;
const r = required(
  reviewRecords.find((r) => r.id === id),
  "Fixture record",
);
const c = required(
  clients.find((c) => c.id === r.client),
  "Fixture record",
);
---

<DialogFrame id={dialogId}>
  <Fragment slot="body">
    <div class="eyebrow">
      <span data-entity="client" data-record-id={c.id} data-field="name">
        {c.name}
      </span>{" "}
      · Google review
    </div>
    <h2 id={dialogId + "-title"}>
      {r.author} · {r.stars} stars
    </h2>
    <p>{String(r.text)}</p>
    <p>
      <span data-entity="review" data-record-id={r.id} data-field="status">
        <StatusBadge text={r.status} />
      </span>
    </p>
    <label for={dialogId + "-reviewcopy"}>Response</label>
    <textarea
      data-entity="review"
      data-record-id={r.id}
      data-field="response"
      id={dialogId + "-reviewcopy"}
      data-editor="reviewcopy"
      rows="5"
      readonly={r.status === "Published"}
    >{String(r.response)}</textarea>
    {r.status === "Published" ? (
      ""
    ) : (
      <Fragment>
        <button
          class="link"
          data-command="generateReviewResponse"
          data-args={JSON.stringify([id])}
        >
          Generate response draft
        </button>
      </Fragment>
    )}
    <p data-review-instructions={r.id}>
      {r.status === "Awaiting approval"
        ? "This client has requested review of this response. Approval is required only for this saved draft."
        : "Responses can be edited and published directly when ready."}
    </p>
  </Fragment>
  <Fragment slot="footer">
    <button data-close>Close</button>
    {r.status === "Published" ? (
      ""
    ) : (
      <Fragment>
        <button
          data-command="saveReview"
          data-args={JSON.stringify([id, "Draft"])}
        >
          Save draft
        </button>
        <button
          class="primary"
          data-command="saveReview"
          data-args={JSON.stringify([id, "Published"])}
        >
          {r.status === "Awaiting approval"
            ? "Approve & publish sample"
            : "Publish sample response"}
        </button>
      </Fragment>
    )}
  </Fragment>
</DialogFrame>
