---
import type { ViewContext, Client } from "../../types/domain";
import { clients } from "../../data/fixtures";
import { required } from "../../lib/view";

import DialogFrame from "../ui/DialogFrame.astro";

interface Props {
  context: ViewContext;
  c?: Client | null;
  id: string;
}

const id = Astro.props.id;
const dialogId = "request" + "-" + id;
const c = required(
  clients.find((c) => c.id === id),
  "Fixture record",
);
---

<DialogFrame id={dialogId}>
  <Fragment slot="body">
    <div class="eyebrow">
      <span data-entity="client" data-record-id={c.id} data-field="name">
        {c.name}
      </span>{" "}
      · Review requests
    </div>
    <h2 id={dialogId + "-title"}>Post-service review request</h2>
    <label for={dialogId + "-requestcopy"}>Request message</label>
    <textarea
      data-entity="client"
      data-record-id={c.id}
      data-field="requestCopy"
      id={dialogId + "-requestcopy"}
      data-editor="requestcopy"
      rows="5"
    >{String(c.requestCopy || `Thank you for choosing ${c.name}. If you have a moment, please share your experience in a Google review. Your feedback helps our team and future customers.`)}</textarea>
    <p>Sample recipient: Alex Morgan · Completed service · September 28</p>
  </Fragment>
  <Fragment slot="footer">
    <button data-close>Close</button>
    <button
      class="primary"
      data-command="stageReviewRequest"
      data-args={JSON.stringify([id])}
    >
      Stage sample request
    </button>
  </Fragment>
</DialogFrame>
