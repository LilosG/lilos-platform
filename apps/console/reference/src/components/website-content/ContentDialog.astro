---
import type { ViewContext, Client } from "../../types/domain";
import { clients, pageRecords } from "../../data/fixtures";
import { required } from "../../lib/view";

import DialogFrame from "../ui/DialogFrame.astro";

interface Props {
  context: ViewContext;
  c?: Client | null;
  id: string;
}

const id = Astro.props.id;
const dialogId = "content" + "-" + id;
const p = required(
  pageRecords.find((x) => x.id === id),
  "Fixture record",
);
---

<DialogFrame id={dialogId}>
  <Fragment slot="body">
    <div class="eyebrow">{clients[+p.client - 1].name} · Content draft</div>
    <h2 id={dialogId + "-title"}>
      <span data-entity="page" data-record-id={p.id} data-field="name">
        {p.name}
      </span>
    </h2>
    <label for={dialogId + "-contentcopy"}>Content notes</label>
    <textarea
      data-entity="page"
      data-record-id={p.id}
      data-field="content"
      id={dialogId + "-contentcopy"}
      data-editor="contentcopy"
      rows="6"
    >{String(p.content || 'Answer the highest-demand customer questions with specific services, local examples, and a clear contact action.')}</textarea>
    <p>Target publication: October 2 · Shared resource template</p>
  </Fragment>
  <Fragment slot="footer">
    <button data-close>Close</button>
    <button
      class="primary"
      data-command="saveContent"
      data-args={JSON.stringify([id])}
    >
      Save draft
    </button>
  </Fragment>
</DialogFrame>
