{
  "name": "@lilos/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "browser:test": "playwright test",
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --write tests/production/hermes.acceptance.spec.ts && git diff --exit-code -- tests/production/hermes.acceptance.spec.ts",
    "lint": "eslint . && npm run lint:styles",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "visual:test": "playwright test --config playwright.visual.config.ts",
    "production:auth": "playwright test --config playwright.production.config.ts --project=auth-setup --headed",
    "production:test": "playwright test --config playwright.production.config.ts --project=production-acceptance",
    "production:hermes": "playwright test tests/production/hermes.acceptance.spec.ts --config playwright.production.config.ts --project=production-acceptance",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@lucide/astro": "^1.31.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "chart.js": "^4.5.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^1.62.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^1.7.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
