---
interface Props {
  label: string;
  value: string | null;
  unit?: string;
  meta?: string;
  state?: "valid" | "missing" | "partial" | "stale";
  range?: string;
  freshness?: string;
}
const { label, value, unit, meta, state, range, freshness } = Astro.props;
---
<article class="metric-card">
  <p class="metric-card__label">{label}</p>
  <p class="metric-card__value">
    {value ?? "—"}{unit && value ? <span>{unit}</span> : null}
  </p>
  {
    meta ? (
      <p class="metric-card__meta">{meta}</p>
    ) : state ? (
      <p class="metric-card__meta">
        {range} · {freshness} · <strong>{state}</strong>
      </p>
    ) : null
  }
</article>
