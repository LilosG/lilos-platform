---
import { navigation } from "../lib/platform";
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="app-shell">
  <aside class="sidebar" aria-label="Primary">
    <a class="brand" href="#overview" aria-label="LILOs workspace home"
      ><span>L</span><strong>LILOs</strong></a
    >
    <nav aria-label="Workspace navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="sidebar__footer">
      <span aria-hidden="true" class="avatar" id="current-user-initial">·</span
      ><div>
        <strong id="current-user-label">Loading…</strong><small
          >Assurance · <span id="current-assurance-label">unknown</span></small
        >
      </div>
    </div>
  </aside>
  <div class="workspace">
    <header class="topbar">
      <div>
        <p class="eyebrow">Active organization</p><strong
          id="active-organization-name">Loading…</strong
        >
      </div><div class="topbar__actions">
        <label class="sr-only" for="organization-switcher"
          >Switch organization</label
        ><select
          id="organization-switcher"
          class="button button--secondary"
          hidden></select><button type="button" id="sign-out-button" hidden
          >Sign out</button
        >
      </div>
    </header><main id="main-content" tabindex="-1"><slot /></main>
  </div>
</div>
