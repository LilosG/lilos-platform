---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="page-head">
  <div class="page-head__intro">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <p>{description}</p>}
  </div>
  <div class="page-head__meta">
    <div class="page-head__actions">
      <slot name="actions" />
    </div>
  </div>
</div>
