---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs operational workspace" />
    <title>LILOs · Overview</title>
  </head>
  <body>
    <AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1>
        <p>
          No Supabase or API connection is configured for this build. Set
          <code>PUBLIC_LILOS_SUPABASE_URL</code>,
          <code>PUBLIC_LILOS_SUPABASE_ANON_KEY</code>, and
          <code>PUBLIC_LILOS_API_BASE_URL</code> to enable sign-in.
        </p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p class="loading-state">Loading your workspace…</p>
      </div>

      <div id="boot-error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <div class="empty-state">
          <span class="empty-state__icon" aria-hidden="true">○</span>
          <h3>No organization access yet</h3>
          <p>
            Your account is not a member of any organization. Ask an
            administrator to invite you.
          </p>
        </div>
      </div>

      <div id="workspace-content" hidden>
        <div class="page-head">
          <div class="page-head__intro">
            <p class="eyebrow" id="active-organization-status"></p>
            <h1 id="overview-title">Operating overview</h1>
            <p id="overview-description">
              Current performance, urgent work, and recent results for this
              organization.
            </p>
          </div>
        </div>

        <div id="kpi-section">
          <div class="metric-grid" id="kpi-grid">
            <div class="metric-card">
              <p class="metric-card__label">Loading…</p><p
                class="metric-card__value"
              >
                —
              </p>
            </div>
          </div>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Actionable work</p>
            <h2>Needs attention</h2>
          </div>
        </div>
        <div id="attention-panel">
          <div class="loading-state">Loading work queue…</div>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow" id="work-eyebrow">Priority queue</p>
            <h2 id="work-title">Today's work</h2>
          </div>
        </div>
        <div id="work-panel">
          <div class="loading-state">Loading current work…</div>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Performance</p>
            <h2>Latest connected results</h2>
          </div>
        </div>
        <div id="performance-panel">
          <div class="loading-state">Loading performance…</div>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Across products</p>
            <h2>Operational activity</h2>
          </div>
        </div>
        <div id="activity-panel">
          <div class="loading-state">Loading activity…</div>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Account health</p>
            <h2>Locations and product status</h2>
          </div>
        </div>
        <div class="dashboard-health-grid">
          <div id="locations-panel">
            <div class="loading-state">Loading locations…</div>
          </div>
          <div id="products-panel">
            <div class="loading-state">Loading products…</div>
          </div>
        </div>
      </div>
    </AppShell>
    <script>
      import {
        fetchLocations,
        fetchProductReadiness,
        fetchInsightsSummary,
        PRODUCT_KEYS,
        PRODUCT_LABELS,
      } from "../lib/workspace";
      import { summarizeReadiness } from "../lib/dashboard-logic";
      import {
        dashboardMetrics,
        requiresAttention,
        todaysWork,
        type WorkItem,
      } from "../lib/operating-dashboard";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        metricCard,
        emptyState,
        errorAlert,
        describeFailure,
        type BootRegions,
      } from "../lib/ui";

      let organizationId = "";

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("workspace-content")!,
      };

      async function loadOrganization(
        organization: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(organization);
        document.getElementById("active-organization-status")!.textContent =
          organization.organization_status.replace(/_/g, " ");
        const isAgency = ["internal", "partner", "support"].includes(
          organization.membership_type,
        );
        document.getElementById("overview-title")!.textContent = isAgency
          ? "Operating overview"
          : "Your account overview";
        document.getElementById("overview-description")!.textContent = isAgency
          ? "Current performance, urgent work, and today’s priorities for this client."
          : "Account status, current results, and anything that needs your attention.";
        document.getElementById("work-eyebrow")!.textContent = isAgency
          ? "Priority queue"
          : "Upcoming";
        document.getElementById("work-title")!.textContent = isAgency
          ? "Today’s work"
          : "Work in progress";
        organizationId = organization.organization_id;

        const [locationsResult, readinessPromises, insightsResult] =
          await Promise.all([
            fetchLocations(organizationId),
            Promise.all(
              PRODUCT_KEYS.map((key) =>
                fetchProductReadiness(organizationId, key),
              ),
            ),
            fetchInsightsSummary(organizationId),
          ]);

        const summaries: Record<string, { status: string; detail: string }> =
          {};
        PRODUCT_KEYS.forEach((key, index) => {
          summaries[key] = summarizeReadiness(readinessPromises[index]);
        });

        const insightData =
          insightsResult.kind === "ok" ? insightsResult.data : null;
        renderKPIs(insightData);
        renderAttention(insightData, summaries, isAgency);
        renderWork(insightData, isAgency);
        renderPerformance(insightData);
        renderLocations(locationsResult);
        renderProducts(summaries);
        renderActivity(insightsResult);
      }

      function renderKPIs(
        summary: import("../lib/workspace").InsightsSummary | null,
      ): void {
        const grid = document.getElementById("kpi-grid")!;
        grid.replaceChildren();
        for (const item of dashboardMetrics(summary)) {
          const link = document.createElement("a");
          link.className = "metric-card metric-card--link";
          link.href = item.href;
          link.append(
            Object.assign(document.createElement("p"), {
              className: "metric-card__label",
              textContent: item.label,
            }),
            Object.assign(document.createElement("p"), {
              className: "metric-card__value",
              textContent: item.value === null ? "—" : String(item.value),
            }),
            Object.assign(document.createElement("p"), {
              className: "metric-card__meta",
              textContent: item.meta,
            }),
          );
          grid.append(link);
        }
      }

      function renderAttention(
        insightData: import("../lib/workspace").InsightsSummary | null,
        summaries: Record<string, { status: string; detail: string }>,
        isAgency: boolean,
      ): void {
        const panel = document.getElementById("attention-panel")!;
        panel.replaceChildren();
        const operational = requiresAttention(insightData).filter(
          (item) => isAgency || item.href !== "/administration",
        );
        const blocked = PRODUCT_KEYS.filter(
          (key) => summaries[key].status === "blocked",
        ).map<WorkItem>((key) => ({
          key: `readiness-${key}`,
          label: PRODUCT_LABELS[key],
          detail: summaries[key].detail,
          count: 1,
          severity: "urgent",
          href: `/${key}`,
        }));
        const items = [...operational, ...blocked].filter(
          (item, index, all) =>
            all.findIndex((candidate) => candidate.href === item.href) ===
            index,
        );

        if (items.length === 0) {
          panel.append(
            emptyState(
              "Everything is on track",
              "No failures, unresolved provider actions, or blocking product issues are recorded.",
            ),
          );
          return;
        }
        panel.append(renderWorkItems(items, isAgency ? "Resolve" : "Review"));
      }

      function renderWork(
        summary: import("../lib/workspace").InsightsSummary | null,
        isAgency: boolean,
      ): void {
        const panel = document.getElementById("work-panel")!;
        panel.replaceChildren();
        const items = todaysWork(summary);
        if (items.length === 0) {
          panel.append(
            emptyState(
              isAgency
                ? "No queued work right now"
                : "Nothing is waiting on you",
              isAgency
                ? "New reviews, leads, publishing work, and SEO opportunities will appear here."
                : "Approvals and other account actions will appear here when they are ready.",
            ),
          );
          return;
        }
        panel.append(renderWorkItems(items, isAgency ? "Open queue" : "View"));
      }

      function renderWorkItems(
        items: WorkItem[],
        actionLabel: string,
      ): HTMLDivElement {
        const grid = document.createElement("div");
        grid.className = "attention-grid";
        for (const item of items) {
          const card = document.createElement("article");
          card.className = `attention-card${item.severity === "urgent" ? " attention-card--urgent" : ""}`;
          const header = document.createElement("div");
          header.className = "attention-card__header";
          const title = document.createElement("h3");
          title.textContent = item.label;
          header.append(
            title,
            statusBadge(
              item.severity === "urgent" ? "blocked" : "setup",
              String(item.count),
            ),
          );
          const body = document.createElement("p");
          body.className = "text-sm muted";
          body.textContent = item.detail;
          const action = document.createElement("a");
          action.className = "button button--secondary button--sm";
          action.href = item.href;
          action.textContent = actionLabel;
          card.append(header, body, action);
          grid.append(card);
        }
        return grid;
      }

      function renderPerformance(
        summary: import("../lib/workspace").InsightsSummary | null,
      ): void {
        const panel = document.getElementById("performance-panel")!;
        panel.replaceChildren();
        const ga4 = summary?.ga4;
        if (!ga4?.connected || Object.keys(ga4.metrics ?? {}).length === 0) {
          panel.append(
            emptyState(
              "No connected performance data yet",
              "Connect and sync Google Analytics to show real website results. Period comparisons will appear only when the API supplies comparable history.",
              "Manage data sources",
              "/integrations",
            ),
          );
          return;
        }
        const labels: Record<string, string> = {
          "ga4.sessions": "Sessions",
          "ga4.totalUsers": "Users",
          "ga4.screenPageViews": "Page views",
          "ga4.conversions": "Conversions",
        };
        const grid = document.createElement("div");
        grid.className = "metric-grid";
        const synced = ga4.properties
          .map((property) => property.last_synced_at)
          .filter((value): value is string => Boolean(value))
          .sort()
          .at(-1);
        for (const [key, value] of Object.entries(ga4.metrics)) {
          grid.append(
            metricCard(
              labels[key] ?? key.replace(/^ga4\./, "").replace(/_/g, " "),
              String(value),
              synced
                ? `Latest sync ${new Date(synced).toLocaleString()}`
                : "Latest synced observation",
            ),
          );
        }
        panel.append(grid);
      }

      function renderLocations(
        locationsResult: Awaited<ReturnType<typeof fetchLocations>>,
      ): void {
        const panel = document.getElementById("locations-panel")!;
        panel.replaceChildren();

        if (locationsResult.kind !== "ok") {
          panel.append(
            errorAlert(describeFailure(locationsResult, "Locations")),
          );
          return;
        }

        if (locationsResult.data.length === 0) {
          panel.append(
            emptyState(
              "No locations yet",
              "Add locations for this organization to start managing business profiles and operations.",
              "Manage in Settings",
              "/settings",
            ),
          );
          return;
        }

        const list = document.createElement("ul");
        list.className = "product-list";
        for (const location of locationsResult.data) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = location.name;
          const detail = document.createElement("p");
          detail.textContent = location.is_primary
            ? `${location.status} · Primary`
            : location.status;
          info.append(name, detail);
          const badge = statusBadge(
            location.status === "active" ? "ready" : location.status,
            location.is_primary
              ? `${location.status.replace(/_/g, " ")} · Primary`
              : location.status.replace(/_/g, " "),
          );
          item.append(info, badge);
          list.append(item);
        }
        panel.append(list);
      }

      function renderProducts(
        summaries: Record<string, { status: string; detail: string }>,
      ): void {
        const panel = document.getElementById("products-panel")!;
        panel.replaceChildren();

        const list = document.createElement("ul");
        list.className = "product-list";
        for (const key of PRODUCT_KEYS) {
          const summary = summaries[key];
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = PRODUCT_LABELS[key];
          const detail = document.createElement("p");
          detail.textContent = summary.detail;
          info.append(name, detail);
          const actions = document.createElement("div");
          actions.className = "list-actions";
          actions.append(
            statusBadge(
              summary.status,
              summary.status === "ready"
                ? "Operational"
                : summary.status === "blocked"
                  ? "Needs attention"
                  : "Setup required",
            ),
          );
          const link = document.createElement("a");
          link.className = "button button--secondary button--sm";
          link.href = `/${key}`;
          link.textContent = "Open";
          actions.append(link);
          item.append(info, actions);
          list.append(item);
        }
        panel.append(list);
      }

      function renderActivity(
        insightsResult: Awaited<ReturnType<typeof fetchInsightsSummary>>,
      ): void {
        const panel = document.getElementById("activity-panel")!;
        panel.replaceChildren();

        if (insightsResult.kind !== "ok") {
          panel.append(
            emptyState(
              "Activity unavailable",
              "Connect the insights product to see cross-product activity.",
              "Set up Insights",
              "/insights",
            ),
          );
          return;
        }

        const data = insightsResult.data;
        const groups: {
          title: string;
          items: { label: string; value: number }[];
        }[] = [];

        const gbpItems: { label: string; value: number }[] = [];
        gbpItems.push({ label: "Locations", value: data.gbp?.locations ?? 0 });
        gbpItems.push({
          label: "Profile snapshots",
          value: data.gbp?.profile_snapshots ?? 0,
        });
        const gbpPubs = Object.values(data.gbp?.publications ?? {}).reduce(
          (a, b) => a + b,
          0,
        );
        gbpItems.push({ label: "Publications", value: gbpPubs });
        groups.push({ title: "Business Profile", items: gbpItems });

        const reviewItems = Object.entries(data.reviews ?? {}).map(
          ([label, value]) => ({
            label: label.replace(/_/g, " "),
            value,
          }),
        );
        if (reviewItems.length > 0)
          groups.push({ title: "Reviews", items: reviewItems });

        const leadItems = Object.entries(data.leads ?? {}).map(
          ([label, value]) => ({ label: label.replace(/_/g, " "), value }),
        );
        if (leadItems.length > 0)
          groups.push({ title: "Leads", items: leadItems });

        const contentItems = Object.entries(
          data.content_publications ?? {},
        ).map(([label, value]) => ({
          label: label.replace(/_/g, " "),
          value,
        }));
        if (contentItems.length > 0)
          groups.push({ title: "Content", items: contentItems });

        const crawlItems = Object.entries(data.seo?.crawl_runs ?? {}).map(
          ([label, value]) => ({ label: label.replace(/_/g, " "), value }),
        );
        const oppItems = Object.entries(data.seo?.opportunities ?? {}).map(
          ([label, value]) => ({ label: label.replace(/_/g, " "), value }),
        );
        const seoItems = [...crawlItems, ...oppItems];
        if (seoItems.length > 0) groups.push({ title: "SEO", items: seoItems });

        if (groups.length === 0) {
          panel.append(
            emptyState(
              "No activity recorded yet",
              "Once operations start running, activity from all products will appear here.",
            ),
          );
          return;
        }

        const grid = document.createElement("div");
        grid.className = "split";
        for (const group of groups) {
          const card = document.createElement("article");
          card.className = "card";
          const header = document.createElement("div");
          header.className = "card__header";
          const title = document.createElement("h3");
          title.className = "card__title";
          title.textContent = group.title;
          header.append(title);
          card.append(header);
          const body = document.createElement("div");
          body.className = "card__body";
          for (const item of group.items) {
            const row = document.createElement("div");
            row.className = "flex-row";
            row.style.justifyContent = "space-between";
            const label = document.createElement("span");
            label.className = "text-sm";
            label.textContent = item.label.replace(/\b\w/g, (c) =>
              c.toUpperCase(),
            );
            const value = document.createElement("strong");
            value.textContent = String(item.value);
            row.append(label, value);
            body.append(row);
          }
          card.append(body);
          grid.append(card);
        }
        panel.append(grid);
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Workspace");
        if (!applyBootResult(regions, result)) return;

        populateSwitcher(
          result.organizations,
          (org) => void loadOrganization(org),
        );
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
