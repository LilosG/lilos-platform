---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs operational workspace" />
    <title>LILOs · Overview</title>
  </head>
  <body>
    <AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1>
        <p>
          No Supabase or API connection is configured for this build. Set
          <code>PUBLIC_LILOS_SUPABASE_URL</code>,
          <code>PUBLIC_LILOS_SUPABASE_ANON_KEY</code>, and
          <code>PUBLIC_LILOS_API_BASE_URL</code> to enable sign-in.
        </p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p class="loading-state">Loading your workspace…</p>
      </div>

      <div id="boot-error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <div class="empty-state">
          <span class="empty-state__icon" aria-hidden="true">○</span>
          <h3>No organization access yet</h3>
          <p>
            Your account is not a member of any organization. Ask an
            administrator to invite you.
          </p>
        </div>
        <button
          type="button"
          class="button button--secondary"
          id="empty-sign-out"
          style="margin-top:1rem">Sign out</button
        >
      </div>

      <div id="workspace-content" hidden>
        <div class="page-head">
          <div class="page-head__intro">
            <p class="eyebrow" id="active-organization-status"></p>
            <h1>Overview</h1>
            <p>
              Operational health and activity for your selected organization.
            </p>
          </div>
        </div>

        <div id="kpi-section">
          <div class="metric-grid" id="kpi-grid">
            <div class="metric-card">
              <p class="metric-card__label">Loading…</p><p
                class="metric-card__value"
              >
                —
              </p>
            </div>
          </div>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Actionable work</p>
            <h2>Needs attention</h2>
          </div>
        </div>
        <div id="attention-panel">
          <div class="loading-state">Loading work queue…</div>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Organization</p>
            <h2>Locations</h2>
          </div>
        </div>
        <div id="locations-panel">
          <div class="loading-state">Loading locations…</div>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Shared operations</p>
            <h2>Product readiness</h2>
          </div>
        </div>
        <div id="products-panel">
          <div class="loading-state">Loading products…</div>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Reporting</p>
            <h2>Cross-product activity</h2>
          </div>
        </div>
        <div id="activity-panel">
          <div class="loading-state">Loading activity…</div>
        </div>
      </div>
    </AppShell>
    <script>
      import {
        fetchLocations,
        fetchProductReadiness,
        fetchInsightsSummary,
        PRODUCT_KEYS,
        PRODUCT_LABELS,
      } from "../lib/workspace";
      import { summarizeReadiness } from "../lib/dashboard-logic";
      import { signOut } from "../lib/session";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        metricCard,
        emptyState,
        errorAlert,
        describeFailure,
        goToLogin,
        type BootRegions,
      } from "../lib/ui";

      let organizationId = "";

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
      };

      async function loadOrganization(
        organization: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(organization);
        document.getElementById("active-organization-status")!.textContent =
          `${organization.organization_status} · ${organization.membership_type}`;
        organizationId = organization.organization_id;

        const [locationsResult, readinessPromises, insightsResult] =
          await Promise.all([
            fetchLocations(organizationId),
            Promise.all(
              PRODUCT_KEYS.map((key) =>
                fetchProductReadiness(organizationId, key),
              ),
            ),
            fetchInsightsSummary(organizationId),
          ]);

        const summaries: Record<string, { status: string; detail: string }> =
          {};
        PRODUCT_KEYS.forEach((key, index) => {
          summaries[key] = summarizeReadiness(readinessPromises[index]);
        });

        renderKPIs(summaries, locationsResult, insightsResult);
        renderAttention(summaries);
        renderLocations(locationsResult);
        renderProducts(summaries);
        renderActivity(insightsResult);
      }

      function renderKPIs(
        summaries: Record<string, { status: string; detail: string }>,
        locationsResult: typeof fetchLocations extends never
          ? never
          : Awaited<ReturnType<typeof fetchLocations>>,
        insightsResult: Awaited<ReturnType<typeof fetchInsightsSummary>>,
      ): void {
        const grid = document.getElementById("kpi-grid")!;
        grid.replaceChildren();

        const readyCount = Object.values(summaries).filter(
          (s) => s.status === "ready",
        ).length;
        const blockedCount = Object.values(summaries).filter(
          (s) => s.status === "blocked",
        ).length;
        const setupCount = Object.values(summaries).filter(
          (s) => s.status === "setup",
        ).length;

        grid.append(
          metricCard(
            "Products ready",
            String(readyCount),
            `of ${PRODUCT_KEYS.length} products`,
          ),
        );
        grid.append(
          metricCard(
            "Needs attention",
            String(blockedCount + setupCount),
            blockedCount > 0 ? `${blockedCount} blocked` : "All on track",
          ),
        );

        const locationCount =
          locationsResult.kind === "ok" ? locationsResult.data.length : 0;
        grid.append(
          metricCard(
            "Locations",
            String(locationCount),
            locationsResult.kind === "ok"
              ? `${locationsResult.data.filter((l) => l.is_primary).length} primary`
              : "Unable to load",
          ),
        );

        if (insightsResult.kind === "ok") {
          const reviewCount = Object.values(
            insightsResult.data.reviews ?? {},
          ).reduce((a, b) => a + b, 0);
          grid.append(
            metricCard(
              "Total reviews",
              String(reviewCount),
              "Across all locations",
            ),
          );
          const leadCount = Object.values(
            insightsResult.data.leads ?? {},
          ).reduce((a, b) => a + b, 0);
          grid.append(metricCard("Total leads", String(leadCount), "All time"));
          const contentCount = Object.values(
            insightsResult.data.content_publications ?? {},
          ).reduce((a, b) => a + b, 0);
          grid.append(
            metricCard(
              "Content published",
              String(contentCount),
              "Pipeline output",
            ),
          );
          const seoOpps = Object.values(
            insightsResult.data.seo?.opportunities ?? {},
          ).reduce((a, b) => a + b, 0);
          grid.append(
            metricCard(
              "SEO opportunities",
              String(seoOpps),
              "Open and resolved",
            ),
          );
        } else {
          grid.append(
            metricCard("Activity", "—", "Connect insights to see activity"),
          );
        }
      }

      function renderAttention(
        summaries: Record<string, { status: string; detail: string }>,
      ): void {
        const panel = document.getElementById("attention-panel")!;
        panel.replaceChildren();

        const blocked = PRODUCT_KEYS.filter(
          (key) => summaries[key].status === "blocked",
        );
        const setup = PRODUCT_KEYS.filter(
          (key) => summaries[key].status === "setup",
        );

        if (blocked.length === 0 && setup.length === 0) {
          panel.append(
            emptyState(
              "Everything is on track",
              "No products need immediate attention. All products are ready or in progress.",
            ),
          );
          return;
        }

        const grid = document.createElement("div");
        grid.className = "attention-grid";

        for (const key of blocked) {
          const card = document.createElement("div");
          card.className = "attention-card attention-card--urgent";
          const header = document.createElement("div");
          header.className = "flex-row";
          header.append(statusBadge("blocked", PRODUCT_LABELS[key]));
          const body = document.createElement("p");
          body.className = "text-sm muted";
          body.textContent = summaries[key].detail;
          const action = document.createElement("a");
          action.className = "button button--secondary button--sm";
          action.href = `/${key}`;
          action.textContent = "Resolve";
          card.append(header, body, action);
          grid.append(card);
        }

        for (const key of setup) {
          const card = document.createElement("div");
          card.className = "attention-card";
          const header = document.createElement("div");
          header.className = "flex-row";
          header.append(statusBadge("setup", PRODUCT_LABELS[key]));
          const body = document.createElement("p");
          body.className = "text-sm muted";
          body.textContent = summaries[key].detail;
          const action = document.createElement("a");
          action.className = "button button--secondary button--sm";
          action.href = `/onboarding`;
          action.textContent = "Complete setup";
          card.append(header, body, action);
          grid.append(card);
        }

        panel.append(grid);
      }

      function renderLocations(
        locationsResult: Awaited<ReturnType<typeof fetchLocations>>,
      ): void {
        const panel = document.getElementById("locations-panel")!;
        panel.replaceChildren();

        if (locationsResult.kind !== "ok") {
          panel.append(
            errorAlert(describeFailure(locationsResult, "Locations")),
          );
          return;
        }

        if (locationsResult.data.length === 0) {
          panel.append(
            emptyState(
              "No locations yet",
              "Add locations for this organization to start managing business profiles and operations.",
              "Manage in Settings",
              "/settings",
            ),
          );
          return;
        }

        const list = document.createElement("ul");
        list.className = "product-list";
        for (const location of locationsResult.data) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = location.name;
          const detail = document.createElement("p");
          detail.textContent = location.is_primary
            ? `${location.status} · Primary`
            : location.status;
          info.append(name, detail);
          const badge = statusBadge(
            location.is_primary ? "primary" : "neutral",
            location.status,
          );
          item.append(info, badge);
          list.append(item);
        }
        panel.append(list);
      }

      function renderProducts(
        summaries: Record<string, { status: string; detail: string }>,
      ): void {
        const panel = document.getElementById("products-panel")!;
        panel.replaceChildren();

        const list = document.createElement("ul");
        list.className = "product-list";
        for (const key of PRODUCT_KEYS) {
          const summary = summaries[key];
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = PRODUCT_LABELS[key];
          const detail = document.createElement("p");
          detail.textContent = summary.detail;
          info.append(name, detail);
          const link = document.createElement("a");
          link.href = `/${key}`;
          link.textContent = "Open →";
          item.append(info, link);
          list.append(item);
        }
        panel.append(list);
      }

      function renderActivity(
        insightsResult: Awaited<ReturnType<typeof fetchInsightsSummary>>,
      ): void {
        const panel = document.getElementById("activity-panel")!;
        panel.replaceChildren();

        if (insightsResult.kind !== "ok") {
          panel.append(
            emptyState(
              "Activity unavailable",
              "Connect the insights product to see cross-product activity.",
              "Set up Insights",
              "/insights",
            ),
          );
          return;
        }

        const data = insightsResult.data;
        const groups: {
          title: string;
          items: { label: string; value: number }[];
        }[] = [];

        const gbpItems: { label: string; value: number }[] = [];
        gbpItems.push({ label: "Locations", value: data.gbp?.locations ?? 0 });
        gbpItems.push({
          label: "Profile snapshots",
          value: data.gbp?.profile_snapshots ?? 0,
        });
        const gbpPubs = Object.values(data.gbp?.publications ?? {}).reduce(
          (a, b) => a + b,
          0,
        );
        gbpItems.push({ label: "Publications", value: gbpPubs });
        groups.push({ title: "Business Profile", items: gbpItems });

        const reviewItems = Object.entries(data.reviews ?? {}).map(
          ([label, value]) => ({
            label: label.replace(/_/g, " "),
            value,
          }),
        );
        if (reviewItems.length > 0)
          groups.push({ title: "Reviews", items: reviewItems });

        const leadItems = Object.entries(data.leads ?? {}).map(
          ([label, value]) => ({ label: label.replace(/_/g, " "), value }),
        );
        if (leadItems.length > 0)
          groups.push({ title: "Leads", items: leadItems });

        const contentItems = Object.entries(
          data.content_publications ?? {},
        ).map(([label, value]) => ({
          label: label.replace(/_/g, " "),
          value,
        }));
        if (contentItems.length > 0)
          groups.push({ title: "Content", items: contentItems });

        const crawlItems = Object.entries(data.seo?.crawl_runs ?? {}).map(
          ([label, value]) => ({ label: label.replace(/_/g, " "), value }),
        );
        const oppItems = Object.entries(data.seo?.opportunities ?? {}).map(
          ([label, value]) => ({ label: label.replace(/_/g, " "), value }),
        );
        const seoItems = [...crawlItems, ...oppItems];
        if (seoItems.length > 0) groups.push({ title: "SEO", items: seoItems });

        if (groups.length === 0) {
          panel.append(
            emptyState(
              "No activity recorded yet",
              "Once operations start running, activity from all products will appear here.",
            ),
          );
          return;
        }

        const grid = document.createElement("div");
        grid.className = "split";
        for (const group of groups) {
          const card = document.createElement("article");
          card.className = "card";
          const header = document.createElement("div");
          header.className = "card__header";
          const title = document.createElement("h3");
          title.className = "card__title";
          title.textContent = group.title;
          header.append(title);
          card.append(header);
          const body = document.createElement("div");
          body.className = "card__body";
          for (const item of group.items) {
            const row = document.createElement("div");
            row.className = "flex-row";
            row.style.justifyContent = "space-between";
            const label = document.createElement("span");
            label.className = "text-sm";
            label.textContent = item.label.replace(/\b\w/g, (c) =>
              c.toUpperCase(),
            );
            const value = document.createElement("strong");
            value.textContent = String(item.value);
            row.append(label, value);
            body.append(row);
          }
          card.append(body);
          grid.append(card);
        }
        panel.append(grid);
      }

      function wireSignOut(button: HTMLElement | null): void {
        button?.addEventListener("click", async () => {
          await signOut();
          goToLogin();
        });
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Workspace");
        if (result.kind === "empty") {
          wireSignOut(document.getElementById("empty-sign-out"));
        }
        if (!applyBootResult(regions, result)) return;
        wireSignOut(document.getElementById("sign-out-button"));

        populateSwitcher(
          result.organizations,
          (org) => void loadOrganization(org),
        );
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
