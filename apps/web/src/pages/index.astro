---
import AppShell from "../components/AppShell.astro";
import StatusBadge from "../components/StatusBadge.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content="LILOs operational workspace" /><title>
      LILOs · Operational workspace
    </title></head
  >
  <body
    ><AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1><p>
          No Supabase or API connection is configured for this build. Set
          <code>PUBLIC_LILOS_SUPABASE_URL</code>,
          <code>PUBLIC_LILOS_SUPABASE_ANON_KEY</code>, and
          <code>PUBLIC_LILOS_API_BASE_URL</code> to enable sign-in.
        </p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p>Loading your workspace…</p>
      </div>

      <div id="boot-error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <h1>No organization access yet</h1><p>
          Your account is not a member of any organization. Ask an administrator
          to invite you.
        </p><button type="button" class="button" id="empty-sign-out"
          >Sign out</button
        >
      </div>

      <div id="workspace-content" hidden>
        <section id="overview" aria-labelledby="page-title">
          <p class="eyebrow" id="active-organization-status"></p><h1
            id="page-title"
          >
            Workspace overview
          </h1>
        </section>

        <section aria-labelledby="products-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Shared operations</p><h2 id="products-title">
                Product readiness
              </h2>
            </div>
          </div><ul class="product-list" id="products-list"></ul>
        </section>

        <section aria-labelledby="locations-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Organization</p><h2 id="locations-title">
                Locations
              </h2>
            </div>
          </div><ul class="product-list" id="locations-list"></ul>
        </section>

        <section aria-labelledby="unavailable-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Reporting</p><h2 id="unavailable-title">
                Metrics, activity, and recommendations
              </h2>
            </div>
          </div><div class="attention-card">
            <StatusBadge
              status="missing"
              label="Not available in this release"
            /><p>
              Insights, activity history, and SEO recommendations have no
              backing API yet. This section intentionally shows no simulated
              data.
            </p>
          </div>
        </section>

        <section
          id="administration"
          class="sr-only"
          aria-label="Administration availability"
        >
          Administration actions remain protected by server permissions and AAL
          policies.
        </section>
      </div>
    </AppShell>
    <script>
      import {
        fetchLocations,
        fetchMyOrganizations,
        fetchPrincipal,
        fetchProductReadiness,
        PRODUCT_KEYS,
        PRODUCT_LABELS,
        type LocationSummary,
        type MyOrganization,
      } from "../lib/workspace";
      import {
        selectDefaultOrganization,
        summarizeReadiness,
      } from "../lib/dashboard-logic";
      import { getCurrentSession, signOut } from "../lib/session";
      import { readPublicConfig } from "../lib/config";
      import type { ApiOutcome } from "../lib/api-client";

      const regions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("workspace-content")!,
      };

      function showOnly(region: HTMLElement): void {
        for (const key of Object.keys(regions) as (keyof typeof regions)[]) {
          regions[key].hidden = regions[key] !== region;
        }
      }

      function describeFailure(outcome: ApiOutcome<unknown>): string {
        switch (outcome.kind) {
          case "forbidden":
            return "You do not have permission to view this workspace.";
          case "not-found":
            return "The requested resource could not be found.";
          case "disconnected":
            return "Could not reach the platform API.";
          case "unauthenticated":
            return "Your session has expired. Sign in again.";
          case "not-configured":
            return "This deployment is not configured.";
          case "error":
            return outcome.message;
          case "ok":
            return "";
        }
      }

      function goToLogin(): void {
        const next = encodeURIComponent(window.location.pathname);
        window.location.assign(`/login?next=${next}`);
      }

      function wireSignOut(button: HTMLElement | null): void {
        button?.addEventListener("click", async () => {
          await signOut();
          goToLogin();
        });
      }

      function renderLocations(locations: LocationSummary[]): void {
        const list = document.getElementById("locations-list")!;
        list.replaceChildren();
        if (locations.length === 0) {
          const empty = document.createElement("li");
          empty.textContent = "No locations yet.";
          list.append(empty);
          return;
        }
        for (const location of locations) {
          const item = document.createElement("li");
          const summary = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = location.name;
          const status = document.createElement("p");
          status.textContent = location.is_primary
            ? `${location.status} · primary`
            : location.status;
          summary.append(name, status);
          item.append(summary);
          list.append(item);
        }
      }

      async function renderProductReadiness(
        organizationId: string,
      ): Promise<void> {
        const list = document.getElementById("products-list")!;
        list.replaceChildren();
        const results = await Promise.all(
          PRODUCT_KEYS.map((key) => fetchProductReadiness(organizationId, key)),
        );
        PRODUCT_KEYS.forEach((key, index) => {
          const readinessOutcome = summarizeReadiness(results[index]);
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = PRODUCT_LABELS[key];
          const detail = document.createElement("p");
          detail.textContent = readinessOutcome.detail;
          info.append(name, detail);
          const badge = document.createElement("span");
          badge.className = `status status--${readinessOutcome.status}`;
          const dot = document.createElement("span");
          dot.setAttribute("aria-hidden", "true");
          dot.className = "status__dot";
          badge.append(dot, document.createTextNode(readinessOutcome.status));
          item.append(info, badge);
          list.append(item);
        });
      }

      async function loadOrganization(
        organization: MyOrganization,
      ): Promise<void> {
        const activeId = organization.organization_id || organization.id;
        if (activeId && typeof window !== "undefined") {
          localStorage.setItem("selected_org_id", activeId);
          const url = new URL(window.location.href);
          if (url.searchParams.get("org") !== activeId) {
            url.searchParams.set("org", activeId);
            window.history.replaceState({}, "", url.toString());
          }
        }
        document.getElementById("active-organization-name")!.textContent =
          organization.organization_name;
        document.getElementById("active-organization-status")!.textContent =
          `${organization.organization_status} · ${organization.membership_type}`;

        const locations = await fetchLocations(organization.organization_id);
        if (locations.kind === "ok") {
          renderLocations(locations.data);
        } else {
          renderLocations([]);
        }
        await renderProductReadiness(organization.organization_id);
      }

      function populateSwitcher(organizations: MyOrganization[]): void {
        const select = document.getElementById(
          "organization-switcher",
        ) as HTMLSelectElement;
        select.replaceChildren();
        for (const organization of organizations) {
          const option = document.createElement("option");
          option.value = organization.organization_id;
          option.textContent = organization.organization_name;
          select.append(option);
        }
        select.hidden = organizations.length <= 1;
        select.addEventListener("change", () => {
          const chosen = organizations.find(
            (item) => item.organization_id === select.value,
          );
          if (chosen) void loadOrganization(chosen);
        });
      }

      async function boot(): Promise<void> {
        if (!readPublicConfig()) {
          showOnly(regions.notConfigured);
          return;
        }
        showOnly(regions.loading);

        const session = await getCurrentSession();
        if (session.status !== "signed-in") {
          goToLogin();
          return;
        }

        const principal = await fetchPrincipal();
        if (principal.kind === "unauthenticated") {
          goToLogin();
          return;
        }
        if (principal.kind !== "ok") {
          regions.error.textContent = describeFailure(principal);
          showOnly(regions.error);
          return;
        }
        document.getElementById("current-user-label")!.textContent =
          principal.data.auth_user_id;
        document.getElementById("current-user-initial")!.textContent =
          principal.data.auth_user_id.slice(0, 1).toUpperCase();
        document.getElementById("current-assurance-label")!.textContent =
          principal.data.assurance_level;

        const signOutButton = document.getElementById("sign-out-button")!;
        signOutButton.hidden = false;
        wireSignOut(signOutButton);
        wireSignOut(document.getElementById("empty-sign-out"));

        const organizations = await fetchMyOrganizations();
        if (organizations.kind === "unauthenticated") {
          goToLogin();
          return;
        }
        if (organizations.kind !== "ok") {
          regions.error.textContent = describeFailure(organizations);
          showOnly(regions.error);
          return;
        }
        if (organizations.data.length === 0) {
          showOnly(regions.empty);
          return;
        }

        populateSwitcher(organizations.data);

        const initial = selectDefaultOrganization(organizations.data);
        if (initial) {
          await loadOrganization(initial);
        }
        showOnly(regions.content);
      }

      void boot();
    </script>
  </body>
</html>
