---
import { developmentPhase, platformName } from "../lib/platform";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="The local development foundation for the LILOs Platform."
    />
    <title>{platformName}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="mx-auto flex min-h-screen max-w-3xl items-center px-6 py-16">
      <section aria-labelledby="page-title" class="space-y-4">
        <p
          class="text-sm font-semibold tracking-widest text-cyan-300 uppercase"
        >
          {developmentPhase}
        </p>
        <h1
          id="page-title"
          class="text-4xl font-bold tracking-tight sm:text-6xl"
        >
          {platformName}
        </h1>
        <p class="max-w-2xl text-lg leading-8 text-slate-300">
          The development-tooling baseline is active. Product functionality is
          intentionally excluded from this phase.
        </p>
      </section>
    </main>
  </body>
</html>
