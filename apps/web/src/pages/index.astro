---
import AppShell from "../components/AppShell.astro";
import Button from "../lib/ui/Button.astro";
import CardGrid from "../lib/ui/CardGrid.astro";
import EmptyState from "../lib/ui/EmptyState.astro";
import MetricCard from "../lib/ui/MetricCard.astro";
import PageHeader from "../lib/ui/PageHeader.astro";
import PageSection from "../lib/ui/PageSection.astro";
import PageShell from "../lib/ui/PageShell.astro";
import Region from "../lib/ui/Region.astro";
import Skeleton from "../lib/ui/Skeleton.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs operational workspace" />
    <title>LILOs · Overview</title>
  </head>
  <body>
    <AppShell>
      <PageShell id="boot-not-configured">
        <EmptyState
          heading="This deployment is not configured"
          description="Connect the platform runtime configuration to enable sign-in."
        />
      </PageShell>
      <PageShell id="boot-loading" hidden
        ><Skeleton lines={3} label="Loading your workspace" /></PageShell
      >
      <PageShell id="boot-error" hidden><Region role="alert" /></PageShell>
      <PageShell id="workspace-empty" hidden>
        <EmptyState
          heading="No organization access yet"
          description="Ask an administrator to invite your account to an organization."
        />
      </PageShell>

      <PageShell id="workspace-content" hidden>
        <PageHeader
          title="Account overview"
          titleId="overview-title"
          description="Performance, current work, and recent results."
          descriptionId="overview-description"
        >
          <Button slot="actions" href="/insights" variant="secondary" size="sm"
            >View reporting</Button
          >
        </PageHeader>

        <PageSection id="kpi-section" title="Performance">
          <CardGrid id="kpi-grid" minimum="sm" class="ui-metric-strip"
            ><MetricCard label="Loading" value="—" missing /></CardGrid
          >
        </PageSection>

        <PageSection id="attention-section" title="Needs attention">
          <Region id="attention-panel"
            ><Skeleton lines={2} label="Loading work queue" /></Region
          >
        </PageSection>

        <PageSection
          title="Today’s work"
          titleId="work-title"
          id="work-section"
        >
          <Region id="work-panel"
            ><Skeleton lines={2} label="Loading current work" /></Region
          >
        </PageSection>

        <PageSection
          id="activity-section"
          title="Current LILOs activity"
          titleId="activity-title"
        >
          <Region id="activity-panel"
            ><Skeleton lines={2} label="Loading activity" /></Region
          >
        </PageSection>

        <PageSection id="results-section" title="Recent results" hidden>
          <Region id="results-panel" />
        </PageSection>

        <PageSection title="Locations" density="compact">
          <Region id="locations-panel"
            ><Skeleton lines={2} label="Loading locations" /></Region
          >
        </PageSection>
      </PageShell>
    </AppShell>
    <script>
      import { fetchLocations, fetchInsightsSummary } from "../lib/workspace";
      import {
        dashboardMetrics,
        hasRecordedActivity,
        requiresAttention,
        todaysWork,
        type WorkItem,
      } from "../lib/operating-dashboard";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        emptyState,
        errorAlert,
        describeFailure,
        type BootRegions,
      } from "../lib/ui";
      import { statusLabel, statusTone } from "../lib/status-language";
      import { listWorkflowRuns } from "../lib/workflows";

      let organizationId = "";

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("workspace-content")!,
      };

      async function loadOrganization(
        organization: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(organization);
        const isAgency = ["internal", "partner", "support"].includes(
          organization.membership_type,
        );
        document.getElementById("overview-title")!.textContent = isAgency
          ? "Account overview"
          : "Your account";
        document.getElementById("overview-description")!.textContent = isAgency
          ? "Current performance, urgent work, and today’s priorities for this client."
          : "Account status, current results, and anything that needs your attention.";
        document.getElementById("work-title")!.textContent = isAgency
          ? "Today’s work"
          : "Work in progress";
        document.getElementById("activity-title")!.textContent = isAgency
          ? "Current LILOs activity"
          : "What LILOs is working on";
        organizationId = organization.organization_id;

        const [locationsResult, insightsResult, runsResult] = await Promise.all(
          [
            fetchLocations(organizationId),
            fetchInsightsSummary(organizationId),
            listWorkflowRuns(organizationId, { limit: 12 }),
          ],
        );

        const insightData =
          insightsResult.kind === "ok" ? insightsResult.data : null;
        const activityRecorded = hasRecordedActivity(insightData);
        document.getElementById("attention-section")!.hidden =
          !activityRecorded;
        document.getElementById("work-section")!.hidden = !activityRecorded;
        document.getElementById("activity-section")!.hidden = !activityRecorded;
        renderKPIs(insightData);
        renderAttention(insightData, isAgency);
        renderWork(insightData, isAgency);
        renderLocations(locationsResult);
        renderActivity(insightsResult);
        renderRecentResults(runsResult);
      }

      function renderKPIs(
        summary: import("../lib/workspace").InsightsSummary | null,
      ): void {
        const grid = document.getElementById("kpi-grid")!;
        grid.replaceChildren();
        const metrics = dashboardMetrics(summary)
          .filter((item) => item.key !== "gbp")
          .slice(0, 5);
        if (metrics.length === 0) {
          const hasActivity = hasRecordedActivity(summary);
          grid.append(
            overviewEmptyState(
              hasActivity
                ? "No outcome metrics recorded yet"
                : "No outcome data yet",
              hasActivity
                ? "Complete the next available product task to start building outcome metrics here."
                : "Products have not recorded activity yet. Open a product workspace and complete the next available task.",
              "Open Business Profile",
              "/gbp",
            ),
          );
          return;
        }
        for (const item of metrics) {
          const link = document.createElement("a");
          link.className = "ui-card ui-card--interactive ui-metric-card";
          link.href = item.href;
          const body = document.createElement("div");
          body.className = "ui-card__body";
          body.append(
            Object.assign(document.createElement("p"), {
              className: "ui-metric-card__label",
              textContent: item.label,
            }),
            Object.assign(document.createElement("p"), {
              className: "ui-metric-card__value",
              textContent: item.value === null ? "—" : String(item.value),
            }),
            Object.assign(document.createElement("p"), {
              className: "ui-metric-card__meta",
              textContent: item.meta,
            }),
          );
          link.append(body);
          grid.append(link);
        }
      }

      function renderAttention(
        insightData: import("../lib/workspace").InsightsSummary | null,
        isAgency: boolean,
      ): void {
        const panel = document.getElementById("attention-panel")!;
        panel.replaceChildren();
        if (!insightData) {
          document.getElementById("attention-section")!.hidden = true;
          panel.append(
            overviewEmptyState(
              "Nothing needs attention yet",
              "Products have not recorded activity yet. Open a product workspace and complete the next available task.",
              "Open Business Profile",
              "/gbp",
            ),
          );
          return;
        }
        if (!hasRecordedActivity(insightData)) {
          document.getElementById("attention-section")!.hidden = true;
          panel.append(
            overviewEmptyState(
              "Nothing needs attention yet",
              "Products have not recorded activity yet. Complete the next available product task to start this queue.",
              "Open Business Profile",
              "/gbp",
            ),
          );
          return;
        }
        const operational = requiresAttention(insightData).filter(
          (item) =>
            isAgency ||
            (item.href !== "/administration" && item.key !== "workflows"),
        );
        const items = operational.filter(
          (item, index, all) =>
            all.findIndex((candidate) => candidate.href === item.href) ===
            index,
        );

        if (items.length === 0) {
          document.getElementById("attention-section")!.hidden = true;
          return;
        }
        document.getElementById("attention-section")!.hidden = false;
        panel.append(renderWorkItems(items, isAgency ? "Resolve" : "Review"));
      }

      function renderWork(
        summary: import("../lib/workspace").InsightsSummary | null,
        isAgency: boolean,
      ): void {
        const panel = document.getElementById("work-panel")!;
        panel.replaceChildren();
        if (!summary) {
          panel.append(
            overviewEmptyState(
              "No work in progress yet",
              "Products have not recorded activity yet. Complete the next available product task to start this queue.",
              "Open Business Profile",
              "/gbp",
            ),
          );
          return;
        }
        if (!hasRecordedActivity(summary)) {
          panel.append(
            overviewEmptyState(
              "No work in progress yet",
              "Products have not recorded activity yet. Complete the next available product task to start this queue.",
              "Open Business Profile",
              "/gbp",
            ),
          );
          return;
        }
        const items = todaysWork(summary);
        if (items.length === 0) {
          panel.append(
            overviewEmptyState(
              isAgency
                ? "No queued work right now"
                : "Nothing is waiting on you",
              isAgency
                ? "New reviews, leads, publishing work, and SEO opportunities will appear here."
                : "Approvals and other account actions will appear here when they are ready.",
            ),
          );
          return;
        }
        panel.append(renderWorkItems(items, isAgency ? "Open queue" : "View"));
      }

      function renderWorkItems(
        items: WorkItem[],
        actionLabel: string,
      ): HTMLDivElement {
        const grid = document.createElement("div");
        grid.className = "ui-work-queue";
        for (const item of items) {
          const card = document.createElement("article");
          card.className = "ui-work-queue__row";
          card.dataset.state = item.severity === "urgent" ? "error" : "default";
          const header = document.createElement("header");
          header.className = "ui-card__header";
          const title = document.createElement("h3");
          title.className = "ui-card__heading";
          title.textContent = item.label;
          header.append(
            title,
            statusBadge(
              item.severity === "urgent" ? "blocked" : "setup",
              String(item.count),
            ),
          );
          const body = document.createElement("p");
          body.className = "ui-card__body";
          body.textContent = item.detail;
          const action = document.createElement("a");
          action.className = "ui-button ui-button--secondary ui-button--sm";
          action.href = item.href;
          action.textContent = actionLabel;
          const footer = document.createElement("footer");
          footer.className = "ui-card__footer";
          footer.append(action);
          card.append(header, body, footer);
          grid.append(card);
        }
        return grid;
      }

      function renderLocations(
        locationsResult: Awaited<ReturnType<typeof fetchLocations>>,
      ): void {
        const panel = document.getElementById("locations-panel")!;
        panel.replaceChildren();

        if (locationsResult.kind !== "ok") {
          panel.append(
            errorAlert(describeFailure(locationsResult, "Locations")),
          );
          return;
        }

        if (locationsResult.data.length === 0) {
          panel.append(
            overviewEmptyState(
              "No locations yet",
              "Add locations for this organization to start managing business profiles and operations.",
              "Manage in Settings",
              "/settings",
            ),
          );
          return;
        }

        const list = document.createElement("ul");
        list.className = "ui-record-list";
        for (const location of locationsResult.data) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = location.name;
          const detail = document.createElement("p");
          detail.textContent = location.is_primary
            ? `${statusLabel(location.status)} · Primary`
            : statusLabel(location.status);
          info.append(name, detail);
          const badge = statusBadge(
            statusTone(location.status),
            location.is_primary
              ? `${statusLabel(location.status)} · Primary`
              : statusLabel(location.status),
          );
          item.append(info, badge);
          list.append(item);
        }
        panel.append(list);
      }

      function activityLabel(product: string, key: string): string {
        const labels: Record<string, Record<string, string>> = {
          reviews: {
            classified: "Reviews processed",
            responded: "Responses published",
            pending: "Awaiting response",
            needs_response: "Awaiting response",
          },
          content: {
            published: "Published",
            deployed: "Published",
            needs_attention: "Needs attention",
            failed: "Needs attention",
          },
          seo: {
            success: "Crawls completed",
            completed: "Crawls completed",
            approved: "Opportunities approved",
            open: "Open opportunities",
          },
          leads: {
            new: "New leads",
            open: "Open leads",
            won: "Won leads",
          },
        };
        return labels[product]?.[key] ?? statusLabel(key);
      }

      function renderActivity(
        insightsResult: Awaited<ReturnType<typeof fetchInsightsSummary>>,
      ): void {
        const panel = document.getElementById("activity-panel")!;
        panel.replaceChildren();

        if (insightsResult.kind !== "ok") {
          panel.append(
            overviewEmptyState(
              "Activity unavailable",
              "Connect the insights product to see cross-product activity.",
              "Set up Insights",
              "/insights",
            ),
          );
          return;
        }

        const data = insightsResult.data;
        const groups: {
          title: string;
          items: { label: string; value: number }[];
        }[] = [];

        const gbpPubs = Object.values(data.gbp?.publications ?? {}).reduce(
          (a, b) => a + b,
          0,
        );
        if ((data.gbp?.profile_snapshots ?? 0) > 0 || gbpPubs > 0) {
          groups.push({
            title: "Business Profile",
            items: [
              { label: "Locations managed", value: data.gbp?.locations ?? 0 },
              {
                label: "Profile checks completed",
                value: data.gbp?.profile_snapshots ?? 0,
              },
              { label: "Post activity", value: gbpPubs },
            ],
          });
        }

        const reviewItems = Object.entries(data.reviews ?? {}).map(
          ([label, value]) => ({
            label: activityLabel("reviews", label),
            value,
          }),
        );
        if (reviewItems.length > 0)
          groups.push({ title: "Reviews", items: reviewItems });

        const leadItems = Object.entries(data.leads ?? {}).map(
          ([label, value]) => ({
            label: activityLabel("leads", label),
            value,
          }),
        );
        if (leadItems.length > 0)
          groups.push({ title: "Leads", items: leadItems });

        const contentItems = Object.entries(
          data.content_publications ?? {},
        ).map(([label, value]) => ({
          label: activityLabel("content", label),
          value,
        }));
        if (contentItems.length > 0)
          groups.push({ title: "Content", items: contentItems });

        const crawlItems = Object.entries(data.seo?.crawl_runs ?? {}).map(
          ([label, value]) => ({
            label: activityLabel("seo", label),
            value,
          }),
        );
        const oppItems = Object.entries(data.seo?.opportunities ?? {}).map(
          ([label, value]) => ({
            label: activityLabel("seo", label),
            value,
          }),
        );
        const seoItems = [...crawlItems, ...oppItems];
        if (seoItems.length > 0) groups.push({ title: "SEO", items: seoItems });

        if (groups.length === 0) {
          panel.append(
            overviewEmptyState(
              "No activity history yet",
              "Products have not recorded activity yet. Complete the next available product task to start the timeline.",
              "Open Business Profile",
              "/gbp",
            ),
          );
          return;
        }

        const grid = document.createElement("div");
        grid.className = "ui-product-activity";
        for (const group of groups) {
          const card = document.createElement("article");
          card.className = "ui-product-activity__row";
          const header = document.createElement("div");
          header.className = "ui-card__header";
          const title = document.createElement("h3");
          title.className = "ui-card__heading";
          title.textContent = group.title;
          header.append(title);
          card.append(header);
          const body = document.createElement("div");
          body.className = "ui-product-activity__facts";
          for (const item of group.items.slice(0, 2)) {
            const row = document.createElement("div");
            row.className = "ui-product-activity__fact";
            const label = document.createElement("span");
            label.className = "ui-text-secondary";
            label.textContent = item.label;
            const value = document.createElement("strong");
            value.textContent = String(item.value);
            row.append(label, value);
            body.append(row);
          }
          card.append(body);
          grid.append(card);
        }
        panel.append(grid);
      }

      function renderRecentResults(
        outcome: Awaited<ReturnType<typeof listWorkflowRuns>>,
      ): void {
        const section = document.getElementById("results-section")!;
        const panel = document.getElementById("results-panel")!;
        panel.replaceChildren();
        if (outcome.kind !== "ok") {
          section.hidden = true;
          return;
        }

        const seen = new Set<string>();
        const completed = outcome.data
          .filter((run) => run.status === "completed")
          .filter((run) => {
            const key = run.workflow_key ?? run.id;
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
          })
          .slice(0, 5);

        section.hidden = completed.length === 0;
        if (!completed.length) return;

        const list = document.createElement("ul");
        list.className = "ui-record-list";
        const labels: Record<string, string> = {
          "gbp.sync": "Business Profile checked",
          "gbp.generate_post": "Business Profile post proposal prepared",
          "reviews.ingest": "New reviews checked",
          "content.publish": "Content published",
          "seo.crawl_or_analysis": "Website crawl completed",
          "agent.gbp": "Business Profile recommendations prepared",
          "agent.seo": "SEO recommendations prepared",
          "agent.content": "Content ideas prepared",
          "agent.reviews": "Review recommendations prepared",
          "agent.insights": "Growth analysis completed",
          "agent.growth": "Growth analysis completed",
          "seo.analyze": "SEO opportunities analyzed",
          "content.draft_revision": "Content draft prepared",
          "reviews.publish_response": "Review response published",
          "gbp.publish_change": "Business Profile changes published",
          "gbp.publish_post": "Business Profile post published",
          "gbp.upload_media": "Business Profile media published",
        };
        for (const run of completed) {
          const item = document.createElement("li");
          const title = document.createElement("strong");
          const workflowKey = run.workflow_key ?? "";
          const productFallback = workflowKey.startsWith("gbp.")
            ? "Business Profile work completed"
            : workflowKey.startsWith("reviews.")
              ? "Review work completed"
              : workflowKey.startsWith("content.")
                ? "Content work completed"
                : workflowKey.startsWith("seo.")
                  ? "SEO work completed"
                  : "Automation completed";
          title.textContent = labels[workflowKey] ?? productFallback;
          const date = document.createElement("span");
          const completedAt = run.completed_at
            ? new Date(run.completed_at)
            : null;
          date.textContent =
            completedAt && !Number.isNaN(completedAt.getTime())
              ? completedAt.toLocaleDateString(undefined, {
                  month: "short",
                  day: "numeric",
                })
              : "";
          item.append(title, date);
          list.append(item);
        }
        panel.append(list);
      }

      function overviewEmptyState(
        heading: string,
        description: string,
        actionLabel?: string,
        actionHref?: string,
      ): HTMLDivElement {
        const state = emptyState(heading, description, actionLabel, actionHref);
        state.classList.add("ui-empty-state--compact");
        return state;
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Workspace");
        if (!applyBootResult(regions, result)) return;

        populateSwitcher(
          result.organizations,
          (org) => void loadOrganization(org),
        );
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
