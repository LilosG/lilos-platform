---
import AppShell from "../components/AppShell.astro";
import {
  Boxes,
  Building2,
  Globe,
  MapPin,
  ShieldCheck,
  Users,
} from "@lucide/astro";
import {
  Button,
  Card,
  CardGrid,
  EmptyState,
  Icon,
  PageHeader,
  PageShell,
  Region,
  Skeleton,
} from "../lib/ui/primitives";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs settings" />
    <title>Settings · LILOs</title>
  </head>
  <body>
    <AppShell>
      <PageShell id="boot-not-configured" width="narrow">
        <EmptyState
          heading="This deployment is not configured"
          description="Connect the platform runtime configuration to enable Settings."
        />
      </PageShell>

      <PageShell id="boot-loading" width="narrow" hidden>
        <Skeleton lines={4} label="Loading settings" />
      </PageShell>

      <Region
        id="boot-error"
        as="div"
        role="alert"
        label="Settings error"
        hidden
      />

      <PageShell id="workspace-empty" width="narrow" hidden>
        <EmptyState
          heading="No organization access yet"
          description="Your account is not a member of any organization. Ask an administrator to invite you."
        />
      </PageShell>

      <PageShell id="settings-content" hidden>
        <!-- Settings directory -->
        <Region
          id="settings-directory"
          as="section"
          labelledBy="settings-title"
        >
          <PageHeader
            eyebrow="Manage"
            title="Settings"
            titleId="settings-title"
            description="Configure this organization's business information, locations, website, users, and governance."
          />

          <CardGrid id="settings-cards">
            <Card
              as="button"
              interactive
              dataDomain="business"
              heading="Business Information"
              description="Brand name, description, approved claims, and default call to action."
              ><Icon icon={Building2} size="lg" /></Card
            >
            <Card
              as="button"
              interactive
              dataDomain="locations"
              heading="Locations"
              description="Manage business locations and their status."
              ><Icon icon={MapPin} size="lg" /></Card
            >
            <Card
              as="button"
              interactive
              dataDomain="website"
              heading="Website & Domain"
              description="Review domains associated with this organization."
              ><Icon icon={Globe} size="lg" /></Card
            >
            <Card
              as="button"
              interactive
              dataDomain="users"
              heading="Users & Access"
              description="Team members, invitations, and role assignments."
              ><Icon icon={Users} size="lg" /></Card
            >
            <Card
              as="button"
              interactive
              dataDomain="governance"
              heading="Governance & Approvals"
              description="Approval policies, verified business details, and notification rules."
              ><Icon icon={ShieldCheck} size="lg" /></Card
            >
            <Card
              as="button"
              interactive
              dataDomain="products"
              heading="Products"
              description="Open the organization's entitled product workspaces."
              ><Icon icon={Boxes} size="lg" /></Card
            >
          </CardGrid>
        </Region>

        <!-- Domain workspace (shown when a card is selected) -->
        <Region
          id="settings-domain"
          as="section"
          labelledBy="domain-title"
          hidden
        >
          <PageHeader
            eyebrow="Settings"
            title="—"
            titleId="domain-title"
            description="Loading setting details."
            descriptionId="domain-description"
          >
            <Button
              slot="actions"
              variant="secondary"
              size="sm"
              id="back-to-settings">Back to Settings</Button
            >
          </PageHeader>
          <Region
            id="domain-content"
            as="div"
            label="Settings details"
            class="ui-region--flow"
          />
        </Region>
      </PageShell>
    </AppShell>
    <script>
      import {
        fetchOrganizationProfile,
        replaceOrganizationProfile,
        fetchOrganizationDomains,
        type OrganizationProfile,
      } from "../lib/settings";
      import {
        fetchLocations,
        PRODUCT_KEYS,
        PRODUCT_LABELS,
      } from "../lib/workspace";
      import {
        fetchBusinessFactCandidates,
        fetchEffectiveBusinessFacts,
        decideBusinessFact,
        reconcileBusinessFacts,
        reconcileDefaultPolicy,
        fetchEffectivePolicies,
        fetchMemberships,
        fetchInvitations,
        businessFactLabel,
        factSourceLabel,
        formatBusinessFactValue,
      } from "../lib/administration";
      import { formatBusinessHoursRows } from "../lib/business-hours";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        emptyState,
        errorAlert,
        describeFailure,
        hasPlatformAdminGrant,
        meetsPlatformAdminRequiredAssurance,
        canUsePlatformAdministration,
        type BootRegions,
      } from "../lib/ui";
      import { statusLabel } from "../lib/status-language";

      let organizationId = "";
      let isAgencyWorkspace = false;
      let canOperateClientSettings = false;
      let _needsMfaForOperatorControls = false;

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("settings-content")!,
      };

      const directory = document.getElementById("settings-directory")!;
      const domainView = document.getElementById("settings-domain")!;
      const domainTitle = document.getElementById("domain-title")!;
      const domainDesc = document.getElementById("domain-description")!;
      const domainContent = document.getElementById("domain-content")!;

      function showDirectory(): void {
        directory.hidden = false;
        domainView.hidden = true;
      }

      function showDomain(title: string, description: string): void {
        directory.hidden = true;
        domainView.hidden = false;
        domainTitle.textContent = title;
        domainDesc.textContent = description;
        domainContent.replaceChildren();
        domainContent.append(createLoading());
      }

      function createLoading(): HTMLDivElement {
        const el = document.createElement("div");
        el.className = "ui-skeleton-group";
        el.textContent = "Loading…";
        return el;
      }

      document
        .getElementById("back-to-settings")!
        .addEventListener("click", showDirectory);

      // Wire settings cards
      document
        .querySelectorAll<HTMLElement>("[data-domain]")
        .forEach((card) => {
          card.addEventListener("click", () => {
            const domain = card.dataset.domain!;
            switch (domain) {
              case "business":
                void openBusiness();
                break;
              case "locations":
                void openLocations();
                break;
              case "website":
                void openWebsite();
                break;
              case "users":
                void openUsers();
                break;
              case "governance":
                void openGovernance();
                break;
              case "products":
                void openProducts();
                break;
            }
          });
        });

      // ---- Business Information ----
      async function openBusiness(): Promise<void> {
        showDomain(
          "Business Information",
          "Edit this client's brand details, description, and approved claims.",
        );
        const result = await fetchOrganizationProfile(organizationId);
        if (result.kind === "not-found") {
          domainContent.replaceChildren(
            emptyState(
              "No business profile yet",
              "Create a business profile to start confirming business facts.",
            ),
          );
          return;
        }
        if (result.kind !== "ok") {
          domainContent.replaceChildren(
            errorAlert(describeFailure(result, "Business profile")),
          );
          return;
        }
        domainContent.replaceChildren(renderBusinessForm(result.data));
      }

      function renderBusinessForm(
        profile: OrganizationProfile,
      ): HTMLFormElement {
        const form = document.createElement("form");
        form.id = "profile-form";
        const grid = document.createElement("div");
        grid.className = "ui-form-grid";

        function field(
          id: string,
          label: string,
          value: string | null,
          multiline = false,
        ): HTMLDivElement {
          const f = document.createElement("div");
          f.className = "ui-field";
          const lbl = document.createElement("label");
          lbl.className = "ui-field__label";
          lbl.htmlFor = id;
          lbl.textContent = label;
          f.append(lbl);
          const inp = multiline
            ? document.createElement("textarea")
            : document.createElement("input");
          inp.id = id;
          inp.className = multiline ? "ui-textarea" : "ui-input";
          (inp as HTMLInputElement).value = value ?? "";
          if (multiline) (inp as HTMLTextAreaElement).rows = 3;
          f.append(inp);
          return f;
        }

        grid.append(
          field(
            "profile-brand-name",
            "Business / brand name",
            profile.brand_name,
          ),
          field(
            "profile-call-to-action",
            "Default call to action",
            profile.default_call_to_action,
          ),
          field("profile-summary", "Brand summary", profile.brand_summary),
        );
        const desc = field(
          "profile-description",
          "Business description",
          profile.business_description,
          true,
        );
        desc.classList.add("ui-field--full");
        grid.append(desc);
        const claims = field(
          "profile-approved-claims",
          "Approved claims (comma-separated)",
          (profile.approved_claims ?? []).join(", "),
        );
        claims.classList.add("ui-field--full");
        grid.append(claims);
        form.append(grid);

        const actions = document.createElement("div");
        actions.className = "ui-inline ui-inline--center";
        const submit = document.createElement("button");
        submit.type = "submit";
        submit.className = "ui-button ui-button--primary ui-button--md";
        submit.textContent = "Save business profile";
        const status = document.createElement("p");
        status.id = "profile-save-status";
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        status.className = "ui-text-secondary";
        actions.append(submit, status);
        form.append(actions);

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const claimsValue = (
            document.getElementById(
              "profile-approved-claims",
            ) as HTMLInputElement
          ).value
            .split(",")
            .map((s) => s.trim())
            .filter(Boolean);
          status.textContent = "Saving…";
          const result = await replaceOrganizationProfile(organizationId, {
            brand_name:
              (
                document.getElementById(
                  "profile-brand-name",
                ) as HTMLInputElement
              ).value || null,
            brand_summary:
              (document.getElementById("profile-summary") as HTMLInputElement)
                .value || null,
            business_description:
              (
                document.getElementById(
                  "profile-description",
                ) as HTMLTextAreaElement
              ).value || null,
            value_proposition: profile.value_proposition,
            target_customer: profile.target_customer,
            primary_services: profile.primary_services,
            approved_claims: claimsValue.length ? claimsValue : null,
            prohibited_claims: profile.prohibited_claims,
            tone_guidelines: profile.tone_guidelines,
            legal_disclaimers: profile.legal_disclaimers,
            default_call_to_action:
              (
                document.getElementById(
                  "profile-call-to-action",
                ) as HTMLInputElement
              ).value || null,
            expected_version: profile.version,
          });
          if (result.kind === "ok") {
            profile.version = result.data.version;
            status.textContent =
              "Saved. Refresh business details in Governance to review the updated information.";
          } else {
            status.textContent = describeFailure(result, "Save");
          }
        });
        return form;
      }

      // ---- Locations ----
      async function openLocations(): Promise<void> {
        showDomain(
          "Locations",
          "Manage business locations for this organization.",
        );
        const result = await fetchLocations(organizationId);
        if (result.kind !== "ok") {
          domainContent.replaceChildren(
            errorAlert(describeFailure(result, "Locations")),
          );
          return;
        }
        if (result.data.length === 0) {
          domainContent.replaceChildren(
            emptyState(
              "No locations yet",
              isAgencyWorkspace
                ? "Add this client’s first location in guided onboarding."
                : "Your account team has not added a business location yet.",
              isAgencyWorkspace ? "Open guided onboarding" : undefined,
              isAgencyWorkspace ? "/onboarding" : undefined,
            ),
          );
          return;
        }
        const list = document.createElement("ul");
        list.className = "ui-record-list";
        for (const loc of result.data) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = loc.name;
          const detail = document.createElement("p");
          detail.textContent = loc.is_primary
            ? `${statusLabel(loc.status)} · Primary`
            : statusLabel(loc.status);
          info.append(name, detail);
          const badge = statusBadge(
            loc.is_primary ? "ready" : "neutral",
            statusLabel(loc.status),
          );
          item.append(info, badge);
          list.append(item);
        }
        domainContent.replaceChildren(list);
      }

      // ---- Website & Domain ----
      async function openWebsite(): Promise<void> {
        showDomain(
          "Website & Domain",
          "Domains associated with this organization.",
        );
        const result = await fetchOrganizationDomains(organizationId);
        if (result.kind !== "ok") {
          domainContent.replaceChildren(
            errorAlert(describeFailure(result, "Domains")),
          );
          return;
        }
        if (result.data.length === 0) {
          domainContent.replaceChildren(
            emptyState(
              "No domains yet",
              isAgencyWorkspace
                ? "Add the client’s website in guided onboarding."
                : "Your account team has not added a website yet.",
              isAgencyWorkspace ? "Open guided onboarding" : undefined,
              isAgencyWorkspace ? "/onboarding" : undefined,
            ),
          );
          return;
        }
        const list = document.createElement("ul");
        list.className = "ui-record-list";
        for (const dom of result.data) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = dom.domain;
          const detail = document.createElement("p");
          const labels: string[] = ["Configured"];
          if (dom.is_primary) labels.push("Primary");
          detail.textContent = labels.join(" · ");
          info.append(name, detail);
          const badge = statusBadge(
            dom.is_primary ? "ready" : "neutral",
            dom.is_primary ? "Primary" : "Configured",
          );
          item.append(info, badge);
          list.append(item);
        }
        domainContent.replaceChildren(list);
      }

      // ---- Users & Access ----
      async function openUsers(): Promise<void> {
        showDomain(
          "Users & Access",
          "Team members, invitations, and role assignments.",
        );
        const [membersResult, invitationsResult] = await Promise.all([
          fetchMemberships(organizationId),
          fetchInvitations(organizationId),
        ]);

        const sections: HTMLElement[] = [];

        if (membersResult.kind === "ok" && membersResult.data.length > 0) {
          const card = document.createElement("div");
          card.className = "ui-card";
          const header = document.createElement("div");
          header.className = "ui-card__header";
          header.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent: "Members",
            }),
          );
          card.append(header);
          const body = document.createElement("div");
          body.className = "ui-card__body";
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const member of membersResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = `${statusLabel(member.membership_type)} member`;
            const detail = document.createElement("p");
            detail.textContent =
              "Identity details are protected; access is managed by membership status.";
            info.append(name, detail);
            const badge = statusBadge(
              member.status === "active" ? "ready" : "blocked",
              member.status,
            );
            item.append(info, badge);
            list.append(item);
          }
          body.append(list);
          card.append(body);
          sections.push(card);
        }

        if (
          invitationsResult.kind === "ok" &&
          invitationsResult.data.length > 0
        ) {
          const card = document.createElement("div");
          card.className = "ui-card";
          const header = document.createElement("div");
          header.className = "ui-card__header";
          header.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent: "Pending Invitations",
            }),
          );
          card.append(header);
          const body = document.createElement("div");
          body.className = "ui-card__body";
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const inv of invitationsResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = inv.normalized_email;
            const detail = document.createElement("p");
            detail.textContent = `Expires ${new Date(inv.expires_at).toLocaleDateString()}`;
            info.append(name, detail);
            const badge = statusBadge(
              inv.status === "pending" ? "setup" : "neutral",
              inv.status,
            );
            item.append(info, badge);
            list.append(item);
          }
          body.append(list);
          card.append(body);
          sections.push(card);
        }

        if (sections.length === 0) {
          domainContent.replaceChildren(
            emptyState(
              "No team members yet",
              isAgencyWorkspace
                ? "Add or invite team members in guided onboarding."
                : "Ask your account team to add or invite users.",
              isAgencyWorkspace ? "Open guided onboarding" : undefined,
              isAgencyWorkspace ? "/onboarding" : undefined,
            ),
          );
          return;
        }
        domainContent.replaceChildren(...sections);
      }

      // ---- Governance & Approvals ----
      async function openGovernance(): Promise<void> {
        showDomain(
          "Governance & Approvals",
          "Approval policies, business facts, and notification rules.",
        );

        const [policyResult, effectiveResult, pendingResult, locationsResult] =
          await Promise.all([
            fetchEffectivePolicies(organizationId, "approval"),
            fetchEffectiveBusinessFacts(organizationId),
            fetchBusinessFactCandidates(organizationId),
            fetchLocations(organizationId),
          ]);

        const locationNames: Map<string, string> = new Map();
        if (locationsResult.kind === "ok") {
          for (const loc of locationsResult.data) {
            locationNames.set(loc.id, loc.name);
          }
        }

        const sections: HTMLElement[] = [];

        sections.push(_buildPolicySection(policyResult));
        sections.push(
          _buildEffectiveFactsSection(effectiveResult, locationNames),
        );
        sections.push(_buildPendingFactsSection(pendingResult, locationNames));

        domainContent.replaceChildren(...sections);
      }

      function _renderFactValue(
        container: HTMLElement,
        factKey: string,
        value: unknown,
      ): void {
        if (factKey === "business.hours") {
          const rows = formatBusinessHoursRows(value);
          if (rows && rows.length > 0) {
            for (const row of rows) {
              const rowEl = document.createElement("div");
              rowEl.className = "ui-fact-row";
              const daySpan = document.createElement("span");
              daySpan.textContent = row.dayLabel;
              const timeSpan = document.createElement("span");
              timeSpan.textContent = row.timeLabel;
              rowEl.append(daySpan, timeSpan);
              container.append(rowEl);
            }
            return;
          }
        }
        const p = document.createElement("p");
        p.textContent = formatBusinessFactValue(value);
        container.append(p);
      }

      function _buildPolicySection(
        policyResult:
          | import("../lib/administration").ApiOutcome<
              import("../lib/administration").PolicyRevision[]
            >
          | { kind: "not-found" },
      ): HTMLElement {
        const card = document.createElement("div");
        card.className = "ui-card";
        const header = document.createElement("div");
        header.className = "ui-card__header";
        const title = document.createElement("h3");
        title.className = "ui-card__heading";
        title.textContent = "Approval Policy";
        header.append(title);
        card.append(header);
        const body = document.createElement("div");
        body.className = "ui-card__body";

        if (policyResult.kind === "ok" && policyResult.data.length > 0) {
          body.append(statusBadge("ready", "Active"));
          const note = document.createElement("p");
          note.className = "ui-text-secondary";
          note.textContent = "An approval policy is in place.";
          body.append(note);
        } else if (
          policyResult.kind === "not-found" ||
          (policyResult.kind === "ok" && policyResult.data.length === 0)
        ) {
          body.append(statusBadge("blocked", "Missing"));
          const note = document.createElement("p");
          note.className = "ui-text-secondary";
          note.textContent = "No approval policy yet.";
          body.append(note);
          if (canOperateClientSettings) {
            const btn = _makeBtn("Provision default policy", "secondary", "sm");
            btn.addEventListener("click", async () => {
              btn.disabled = true;
              btn.textContent = "Provisioning\u2026";
              const result = await reconcileDefaultPolicy(organizationId);
              if (result.kind === "ok") {
                btn.textContent = "Provisioned";
                await openGovernance();
              } else {
                btn.disabled = false;
                btn.textContent = "Provision default policy";
                body.append(errorAlert(describeFailure(result, "Policy")));
              }
            });
            body.append(btn);
          } else if (_needsMfaForOperatorControls) {
            body.append(_buildMfaNudge());
          } else {
            const contact = document.createElement("p");
            contact.className = "ui-text-secondary";
            contact.textContent =
              "Ask your account team to configure the approval policy.";
            body.append(contact);
          }
        } else {
          body.append(errorAlert(describeFailure(policyResult, "Policy")));
        }
        card.append(body);
        return card;
      }

      const CORE_FACT_KEYS = [
        "business.name",
        "business.address",
        "business.website",
        "business.hours",
        "brand.approved_claims",
      ];

      function _buildEffectiveFactsSection(
        result: import("../lib/administration").ApiOutcome<
          import("../lib/administration").EffectiveFact[]
        >,
        locationNames: Map<string, string>,
      ): HTMLElement {
        const card = document.createElement("div");
        card.className = "ui-card";
        const header = document.createElement("div");
        header.className = "ui-card__header";
        const title = document.createElement("h3");
        title.className = "ui-card__heading";
        title.textContent = "Verified Business Details";
        header.append(title);
        card.append(header);
        const body = document.createElement("div");
        body.className = "ui-card__body";

        if (result.kind !== "ok") {
          body.append(errorAlert(describeFailure(result, "Business details")));
          card.append(body);
          return card;
        }

        const factsByKey = new Map<string, typeof result.data>();
        for (const f of result.data) {
          const bucket = factsByKey.get(f.fact_key) || [];
          bucket.push(f);
          factsByKey.set(f.fact_key, bucket);
        }

        const list = document.createElement("ul");
        list.className = "ui-record-list";

        for (const key of CORE_FACT_KEYS) {
          const entries = factsByKey.get(key) || [];

          if (key === "brand.approved_claims" && entries.length === 0) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const h3 = document.createElement("h3");
            h3.textContent = businessFactLabel(key);
            const detail = document.createElement("p");
            detail.textContent = "Not configured";
            const explain = document.createElement("span");
            explain.className = "ui-text-secondary";
            explain.textContent =
              "Approved claims control which claims are permitted in governed content.";
            detail.append(" ", explain);
            info.append(h3, detail);

            const gotoBtn = _makeBtn("Business Information", "secondary", "sm");
            gotoBtn.addEventListener("click", () => {
              const bizCard = document.querySelector<HTMLElement>(
                '[data-domain="business"]',
              );
              if (bizCard) bizCard.click();
            });
            item.append(info, gotoBtn);
            list.append(item);
            continue;
          }

          for (const fact of entries) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const hdr = document.createElement("div");
            hdr.className = "ui-inline ui-inline--center ui-inline--tight";

            const h3 = document.createElement("h3");
            h3.textContent = businessFactLabel(fact.fact_key);
            hdr.append(h3);

            if (fact.location_id) {
              const locBadge = document.createElement("span");
              locBadge.className = "ui-text-secondary";
              locBadge.textContent =
                locationNames.get(fact.location_id) || "Location";
              hdr.append(locBadge);
            }

            const detail = document.createElement("div");
            _renderFactValue(detail, fact.fact_key, fact.value);

            const scopeInfo = document.createElement("span");
            scopeInfo.className = "ui-text-secondary";
            scopeInfo.textContent = factSourceLabel(fact.source);
            detail.append(scopeInfo);

            info.append(hdr, detail);
            item.append(info, statusBadge("ready", "Verified"));
            list.append(item);
          }

          if (key !== "brand.approved_claims" && entries.length === 0) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const h3 = document.createElement("h3");
            h3.textContent = businessFactLabel(key);
            const detail = document.createElement("p");
            detail.className = "ui-text-secondary";
            detail.textContent = "Not configured";
            info.append(h3, detail);
            item.append(info, statusBadge("missing", "Missing"));
            list.append(item);
          }
        }

        body.append(list);
        card.append(body);
        return card;
      }

      function _buildPendingFactsSection(
        result: import("../lib/administration").ApiOutcome<
          import("../lib/administration").BusinessFactRevision[]
        >,
        locationNames: Map<string, string>,
      ): HTMLElement {
        const card = document.createElement("div");
        card.className = "ui-card";
        const header = document.createElement("div");
        header.className = "ui-card__header";
        const hdrRow = document.createElement("div");
        hdrRow.className = "ui-inline ui-inline--start ui-inline--spread";
        const title = document.createElement("h3");
        title.className = "ui-card__heading";
        title.textContent = "Pending Confirmations";
        hdrRow.append(title);
        if (canOperateClientSettings) {
          hdrRow.append(_buildReconcileButton(header));
        } else if (_needsMfaForOperatorControls) {
          hdrRow.append(_buildMfaNudge());
        }
        header.append(hdrRow);
        card.append(header);
        const body = document.createElement("div");
        body.className = "ui-card__body";

        if (result.kind !== "ok") {
          body.append(
            errorAlert(describeFailure(result, "Pending confirmations")),
          );
          card.append(body);
          return card;
        }

        const count = result.data.length;
        const summary = document.createElement("p");
        summary.className = "ui-text-secondary";
        summary.textContent =
          count === 0
            ? "No items requiring review."
            : `${count} item${count === 1 ? "" : "s"} requiring review`;
        body.append(summary);

        if (count === 0) {
          card.append(body);
          return card;
        }

        const list = document.createElement("ul");
        list.className = "ui-record-list";
        for (const candidate of result.data) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const hdr = document.createElement("div");
          hdr.className = "ui-inline ui-inline--center ui-inline--tight";
          const name = document.createElement("h3");
          name.textContent = businessFactLabel(candidate.fact_key);
          hdr.append(name);

          if (candidate.location_id) {
            const locBadge = document.createElement("span");
            locBadge.className = "ui-text-secondary";
            locBadge.textContent =
              locationNames.get(candidate.location_id) || "Location";
            hdr.append(locBadge);
          }

          const detail = document.createElement("div");
          _renderFactValue(detail, candidate.fact_key, candidate.value);
          info.append(hdr, detail);

          const meta = document.createElement("span");
          meta.className = "ui-text-secondary";
          const mp: string[] = [];
          if (candidate.authority === "system_derived") {
            mp.push("System-derived");
          }
          if (candidate.source) {
            mp.push(factSourceLabel(candidate.source));
          }
          meta.textContent = mp.join(" \u00b7 ");
          detail.append(" ", meta);

          const actions = document.createElement("div");
          actions.className = "ui-inline ui-inline--center ui-inline--tight";

          const confirmBtn = _makeBtn("Confirm", "primary", "sm");
          confirmBtn.addEventListener("click", async () => {
            confirmBtn.disabled = true;
            confirmBtn.textContent = "Confirming\u2026";
            const decision = await decideBusinessFact(
              organizationId,
              candidate.id,
              "approve",
            );
            if (decision.kind !== "ok") {
              confirmBtn.disabled = false;
              confirmBtn.textContent = "Confirm";
              info.append(errorAlert(describeFailure(decision, "Confirm")));
              return;
            }
            await openGovernance();
          });
          const rejectBtn = _makeBtn("Reject", "secondary", "sm");
          rejectBtn.addEventListener("click", async () => {
            rejectBtn.disabled = true;
            rejectBtn.textContent = "Rejecting\u2026";
            const decision = await decideBusinessFact(
              organizationId,
              candidate.id,
              "reject",
            );
            if (decision.kind !== "ok") {
              rejectBtn.disabled = false;
              rejectBtn.textContent = "Reject";
              info.append(errorAlert(describeFailure(decision, "Reject")));
              return;
            }
            await openGovernance();
          });

          actions.append(confirmBtn, rejectBtn);
          item.append(info, actions);
          list.append(item);
        }
        body.append(list);
        card.append(body);
        return card;
      }

      function _makeBtn(
        label: string,
        variant: "primary" | "secondary",
        size: "sm" | "md",
      ): HTMLButtonElement {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = `ui-button ui-button--${variant} ui-button--${size}`;
        btn.textContent = label;
        return btn;
      }

      function _buildReconcileButton(
        container: HTMLElement,
      ): HTMLButtonElement {
        const btn = _makeBtn("Reconcile business data", "secondary", "sm");
        btn.addEventListener("click", async () => {
          btn.disabled = true;
          btn.textContent = "Reconciling\u2026";
          const result = await reconcileBusinessFacts(organizationId);
          if (result.kind === "ok") {
            await openGovernance();
          } else {
            btn.disabled = false;
            btn.textContent = "Reconcile business data";
            container.append(errorAlert(describeFailure(result, "Facts")));
          }
        });
        return btn;
      }

      function _buildMfaNudge(): HTMLDivElement {
        const nudge = document.createElement("div");
        nudge.className = "ui-stack ui-stack--2 ui-text-secondary";
        const msg = document.createElement("p");
        msg.textContent =
          "Operator controls require MFA. Complete MFA to manage this workspace's governance.";
        const action = _makeBtn("Complete MFA", "secondary", "sm");
        action.addEventListener("click", () => {
          const next = encodeURIComponent(
            window.location.pathname + window.location.search,
          );
          window.location.assign(`/mfa?next=${next}`);
        });
        nudge.append(msg, action);
        return nudge;
      }
      // ---- Products ----
      async function openProducts(): Promise<void> {
        showDomain(
          "Products",
          "Open product workspaces. Provider health and connection setup are managed in Integrations.",
        );
        const dependency = document.createElement("div");
        dependency.className = "ui-notice ui-notice--info";
        const dependencyCopy = document.createElement("div");
        const dependencyTitle = document.createElement("strong");
        dependencyTitle.textContent = "Connections and provider health";
        const dependencyDetail = document.createElement("span");
        dependencyDetail.textContent =
          "Managed centrally for this organization.";
        dependencyCopy.append(dependencyTitle, dependencyDetail);
        const dependencyLink = document.createElement("a");
        dependencyLink.href = "/integrations";
        dependencyLink.textContent = "Manage integrations";
        dependency.append(dependencyCopy, dependencyLink);
        const list = document.createElement("ul");
        list.className = "ui-record-list";
        PRODUCT_KEYS.forEach((key) => {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = PRODUCT_LABELS[key];
          const detail = document.createElement("p");
          detail.textContent = "Operational workspace";
          info.append(name, detail);
          const actions = document.createElement("div");
          actions.className = "ui-inline ui-inline--end ui-inline--tight";
          const link = document.createElement("a");
          link.className = "ui-button ui-button--secondary ui-button--sm";
          link.href = `/${key}`;
          link.textContent = "Open";
          actions.append(link);
          item.append(info, actions);
          list.append(item);
        });
        domainContent.replaceChildren(dependency, list);
      }

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;
        isAgencyWorkspace = ["internal", "partner", "support"].includes(
          org.membership_type,
        );
        canOperateClientSettings = canUsePlatformAdministration();
        _needsMfaForOperatorControls =
          hasPlatformAdminGrant() && !meetsPlatformAdminRequiredAssurance();
        showDirectory();
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Settings");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
