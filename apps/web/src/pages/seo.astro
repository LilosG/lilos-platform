---
import AppShell from "../components/AppShell.astro";
import Button from "../lib/ui/Button.astro";
import CardGrid from "../lib/ui/CardGrid.astro";
import EmptyState from "../lib/ui/EmptyState.astro";
import Notice from "../lib/ui/Notice.astro";
import PageHeader from "../lib/ui/PageHeader.astro";
import PageSection from "../lib/ui/PageSection.astro";
import PageShell from "../lib/ui/PageShell.astro";
import Region from "../lib/ui/Region.astro";
import Skeleton from "../lib/ui/Skeleton.astro";
import Tabs from "../lib/ui/Tabs.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs SEO" />
    <title>SEO · LILOs</title>
  </head>
  <body>
    <AppShell>
      <PageShell id="boot-not-configured"
        ><EmptyState
          heading="This deployment is not configured"
          description="Connect the platform runtime configuration to enable SEO."
        /></PageShell
      >
      <PageShell id="boot-loading" hidden
        ><Skeleton lines={3} label="Loading SEO" /></PageShell
      >
      <PageShell id="boot-error" hidden><Region role="alert" /></PageShell>
      <PageShell id="workspace-empty" hidden
        ><EmptyState
          heading="No organization access yet"
          description="Ask an administrator to invite your account to an organization."
        /></PageShell
      >

      <PageShell id="seo-content" hidden>
        <PageHeader
          eyebrow="Operations"
          title="SEO"
          description="Inspect crawl health, prioritize governed opportunities, and track observed search performance."
        >
          <Button
            slot="actions"
            href="/integrations"
            variant="secondary"
            size="sm">Manage integrations</Button
          >
        </PageHeader>
        <Notice title="Search data"
          ><p>
            Search Console and Analytics connection health are managed
            centrally.
          </p><Button
            slot="action"
            href="/integrations"
            variant="secondary"
            size="sm">Manage integrations</Button
          ></Notice
        >
        <PageSection eyebrow="Performance" title="SEO outcomes"
          ><CardGrid id="seo-metrics" minimum="sm" /></PageSection
        >
        <Tabs
          id="seo-tabs"
          label="SEO workspace"
          items={[
            { id: "overview", label: "Overview" },
            { id: "crawl", label: "Crawl" },
            { id: "opportunities", label: "Opportunities" },
            { id: "search-console", label: "Search Console" },
          ]}
        >
          <Region id="tab-overview" tabPanel="overview" />
          <Region id="tab-crawl" tabPanel="crawl" hidden />
          <Region id="tab-opportunities" tabPanel="opportunities" hidden />
          <Region id="tab-search-console" tabPanel="search-console" hidden />
        </Tabs>
      </PageShell>
    </AppShell>
    <script>
      import {
        MAX_CRAWL_PAGES,
        fetchWebsites,
        fetchSEOSummary,
        fetchOpportunities,
        fetchSearchProperties,
        fetchRecommendations,
        createRecommendation,
        decideRecommendation,
        fetchImplementationTasks,
        runCrawl,
        normalizeCrawlPageLimit,
        describeCrawlResult,
        isSEOOpportunityActionable,
      } from "../lib/seo";
      import { fetchSearchConsolePerformance } from "../lib/search-console";
      import { startWorkflowRun } from "../lib/workflows";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        metricCard,
        emptyState,
        errorAlert,
        describeFailure,
        formatTimestamp,
        sectionCard,
        detailFact,
        liveStatus,
        formField,
        createSelectControl,
        buildDataTable,
        type BootRegions,
      } from "../lib/ui";
      import {
        reportingPeriodSelector,
        comparisonKPI,
        sourceFreshness,
        formatFreshness,
        formatDateRange,
        buildGscDataTable,
      } from "../lib/reporting";
      import { reportingTrendChart } from "../lib/reporting-chart";
      import { statusLabel, statusTone } from "../lib/status-language";

      let organizationId = "";

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("seo-content")!,
      };

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;

        const [summaryResult, websitesResult, oppsResult] = await Promise.all([
          fetchSEOSummary(organizationId),
          fetchWebsites(organizationId),
          fetchOpportunities(organizationId),
        ]);

        renderMetrics(summaryResult, websitesResult, oppsResult);
        renderOverview(websitesResult, oppsResult);
        renderCrawl(websitesResult);
        renderOpportunities(oppsResult);
        renderSearchConsole(websitesResult);
      }

      function renderMetrics(
        summary: Awaited<ReturnType<typeof fetchSEOSummary>>,
        websites: Awaited<ReturnType<typeof fetchWebsites>>,
        opps: Awaited<ReturnType<typeof fetchOpportunities>>,
      ): void {
        const grid = document.getElementById("seo-metrics")!;
        grid.replaceChildren();

        const websiteCount =
          websites.kind === "ok" ? String(websites.data.length) : "—";
        const oppCount = opps.kind === "ok" ? String(opps.data.length) : "—";
        const openOpps =
          opps.kind === "ok"
            ? opps.data.filter((o) => isSEOOpportunityActionable(o.status))
                .length
            : null;
        const highPriority =
          opps.kind === "ok"
            ? opps.data.filter(
                (o) =>
                  o.priority_score >= 70 &&
                  isSEOOpportunityActionable(o.status),
              ).length
            : null;

        grid.append(
          metricCard(
            "Websites",
            websiteCount,
            websites.kind === "ok" ? "Configured" : "Unable to load",
          ),
          metricCard(
            "Opportunities",
            oppCount,
            openOpps === null ? "Unable to load" : `${openOpps} open`,
          ),
          metricCard(
            "High priority",
            highPriority === null ? "—" : String(highPriority),
            highPriority === null ? "Unable to load" : "Priority score ≥ 70",
          ),
        );
        if (summary.kind === "ok") {
          grid.append(
            metricCard(
              "Crawl runs",
              String(summary.data.crawl_run_count),
              "Total",
            ),
          );
        }
      }

      function clientWebsiteStatus(status: string): {
        kind: string;
        label: string;
        note: string;
      } {
        if (status === "archived") {
          return { kind: "neutral", label: "Unavailable", note: "Archived" };
        }
        if (status === "paused") {
          return { kind: "setup", label: "Needs attention", note: "Paused" };
        }
        return {
          kind: statusTone(status),
          label: status === "active" ? "Ready" : statusLabel(status),
          note: "Website configured",
        };
      }

      function renderOverview(
        websites: Awaited<ReturnType<typeof fetchWebsites>>,
        opps: Awaited<ReturnType<typeof fetchOpportunities>>,
      ): void {
        const panel = document.getElementById("tab-overview")!;
        panel.replaceChildren();

        if (websites.kind !== "ok" || websites.data.length === 0) {
          const banner = document.createElement("div");
          banner.className = "ui-notice ui-notice--warning";
          const copy = document.createElement("div");
          copy.append(
            Object.assign(document.createElement("strong"), {
              textContent: "Website setup required",
            }),
            Object.assign(document.createElement("p"), {
              textContent:
                "Add the organization website before crawl and opportunity work can begin.",
            }),
          );
          const link = document.createElement("a");
          link.className = "ui-button ui-button--secondary ui-button--sm";
          link.href = "/settings";
          link.textContent = "Manage website";
          banner.append(copy, link);
          panel.append(banner);
          return;
        }

        // Website status cards using client terminology
        for (const website of websites.data) {
          const card = document.createElement("div");
          card.className = "ui-card";
          const header = document.createElement("div");
          header.className = "ui-card__header";
          header.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent: website.name,
            }),
          );
          header.append(
            Object.assign(document.createElement("p"), {
              className: "ui-card__description",
              textContent: website.canonical_origin,
            }),
          );
          card.append(header);
          const body = document.createElement("div");
          body.className = "ui-card__body";

          const websiteTerm = clientWebsiteStatus(website.status);
          body.append(statusBadge(websiteTerm.kind, websiteTerm.label));
          if (websiteTerm.note) {
            const detail = document.createElement("p");
            detail.className = "ui-text-secondary";
            detail.textContent = websiteTerm.note;
            body.append(detail);
          }
          if (website.verified_at) {
            const verified = document.createElement("p");
            verified.className = "ui-text-secondary";
            verified.textContent = `Verified ${formatTimestamp(website.verified_at)}`;
            body.append(verified);
          }
          card.append(body);
          panel.append(card);
        }

        // Recent opportunities
        if (opps.kind === "ok" && opps.data.length > 0) {
          const card = document.createElement("div");
          card.className = "ui-card";
          const header = document.createElement("div");
          header.className = "ui-card__header";
          header.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent: "Recent opportunities",
            }),
          );
          card.append(header);
          const body = document.createElement("div");
          body.className = "ui-card__body";
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const opp of opps.data.slice(0, 5)) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = statusLabel(opp.opportunity_type);
            const detail = document.createElement("p");
            detail.textContent = `Priority ${opp.priority_score} · ${statusLabel(opp.status)}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(statusTone(opp.status), statusLabel(opp.status)),
            );
            list.append(item);
          }
          body.append(list);
          card.append(body);
          panel.append(card);
        }
      }

      function renderCrawl(
        websites: Awaited<ReturnType<typeof fetchWebsites>>,
      ): void {
        const panel = document.getElementById("tab-crawl")!;
        panel.replaceChildren();

        if (websites.kind !== "ok" || websites.data.length === 0) {
          panel.append(
            emptyState(
              "No websites to crawl",
              "Add a website first to enable crawling.",
            ),
          );
          return;
        }

        for (const website of websites.data) {
          const card = document.createElement("div");
          card.className = "ui-card";
          const header = document.createElement("div");
          header.className = "ui-card__header";
          header.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent: `Crawl ${website.name}`,
            }),
          );
          card.append(header);
          const body = document.createElement("div");
          body.className = "ui-card__body";

          const maxPagesField = document.createElement("div");
          maxPagesField.className = "ui-field";
          maxPagesField.append(
            Object.assign(document.createElement("label"), {
              className: "ui-field__label",
              htmlFor: `crawl-max-pages-${website.id}`,
              textContent: "Max pages",
            }),
          );
          const maxPagesInput = document.createElement("input");
          maxPagesInput.className = "ui-input";
          maxPagesInput.id = `crawl-max-pages-${website.id}`;
          maxPagesInput.type = "number";
          maxPagesInput.min = "1";
          maxPagesInput.max = String(MAX_CRAWL_PAGES);
          maxPagesInput.value = String(MAX_CRAWL_PAGES);
          maxPagesField.append(maxPagesInput);
          body.append(maxPagesField);

          const crawlBtn = document.createElement("button");
          crawlBtn.type = "button";
          crawlBtn.className = "ui-button ui-button--primary ui-button--md";
          crawlBtn.textContent = "Run crawl";
          const status = document.createElement("p");
          status.className = "ui-text-secondary";
          status.setAttribute("role", "status");
          status.setAttribute("aria-live", "polite");
          crawlBtn.addEventListener("click", async () => {
            const crawlOrganizationId = organizationId;
            const requestTimestamp = Date.now();
            crawlBtn.disabled = true;
            crawlBtn.textContent = "Starting…";
            const workflowStart = await startWorkflowRun(
              crawlOrganizationId,
              "seo.crawl_or_analysis",
              {
                idempotencyKey: `web-crawl-${website.id}-${requestTimestamp}`,
              },
            );
            if (organizationId !== crawlOrganizationId) return;
            if (workflowStart.kind !== "ok") {
              status.textContent = describeFailure(workflowStart, "Crawl");
              crawlBtn.disabled = false;
              crawlBtn.textContent = "Run crawl";
              return;
            }
            const result = await runCrawl(crawlOrganizationId, website.id, {
              workflowRunId: workflowStart.data.workflow_run_id,
              seedPaths: ["/"],
              maxPages: normalizeCrawlPageLimit(Number(maxPagesInput.value)),
              idempotencyKey: `web-crawl-run-${website.id}-${requestTimestamp}`,
            });
            if (organizationId !== crawlOrganizationId) return;
            if (result.kind === "ok") {
              crawlBtn.disabled = false;
              crawlBtn.textContent = "Run again";
              status.textContent = describeCrawlResult(result.data);
              const [updatedSummary, updatedOpps] = await Promise.all([
                fetchSEOSummary(crawlOrganizationId),
                fetchOpportunities(crawlOrganizationId),
              ]);
              if (organizationId !== crawlOrganizationId) return;
              renderMetrics(updatedSummary, websites, updatedOpps);
              renderOverview(websites, updatedOpps);
              renderOpportunities(updatedOpps);
            } else {
              crawlBtn.disabled = false;
              crawlBtn.textContent = "Run crawl";
              status.textContent = describeFailure(result, "Crawl");
            }
          });
          const actions = document.createElement("div");
          actions.className = "ui-inline ui-inline--center";
          actions.append(crawlBtn, status);
          body.append(actions);
          card.append(body);
          panel.append(card);
        }
      }

      function renderOpportunities(
        opps: Awaited<ReturnType<typeof fetchOpportunities>>,
      ): void {
        const panel = document.getElementById("tab-opportunities")!;
        panel.replaceChildren();

        if (opps.kind !== "ok") {
          panel.append(errorAlert(describeFailure(opps, "Opportunities")));
          return;
        }
        if (opps.data.length === 0) {
          panel.append(
            emptyState(
              "No opportunities found",
              "Run a crawl to identify SEO improvement opportunities.",
            ),
          );
          return;
        }

        panel.append(
          buildDataTable(
            [
              {
                key: "type",
                header: "Type",
                render: (opportunity: (typeof opps.data)[number]) =>
                  statusLabel(opportunity.opportunity_type),
              },
              {
                key: "priority",
                header: "Priority",
                width: "content",
                format: { unit: "count" },
                render: (opportunity: (typeof opps.data)[number]) =>
                  statusBadge(
                    opportunity.priority_score >= 70
                      ? "blocked"
                      : opportunity.priority_score >= 40
                        ? "setup"
                        : "neutral",
                    String(opportunity.priority_score),
                  ),
              },
              {
                key: "status",
                header: "Status",
                render: (opportunity: (typeof opps.data)[number]) =>
                  statusBadge(
                    statusTone(opportunity.status),
                    statusLabel(opportunity.status),
                  ),
              },
              {
                key: "actions",
                header: "Actions",
                width: "content",
                render: (opportunity: (typeof opps.data)[number]) => {
                  const action = document.createElement("button");
                  action.type = "button";
                  action.className =
                    "ui-button ui-button--secondary ui-button--sm";
                  action.textContent = "Review";
                  action.addEventListener(
                    "click",
                    () => void renderOpportunityDetail(opportunity, opps),
                  );
                  return action;
                },
              },
            ],
            opps.data,
          ),
        );
      }

      async function renderOpportunityDetail(
        opportunity: import("../lib/seo").SEOOpportunity,
        opportunityList: Awaited<ReturnType<typeof fetchOpportunities>>,
      ): Promise<void> {
        const panel = document.getElementById("tab-opportunities")!;
        panel.replaceChildren(
          Object.assign(document.createElement("div"), {
            className: "ui-skeleton-group",
            textContent: "Loading recommendation workspace…",
          }),
        );
        const recommendations = await fetchRecommendations(
          organizationId,
          opportunity.id,
        );
        panel.replaceChildren();
        const back = document.createElement("button");
        back.type = "button";
        back.className = "ui-button ui-button--secondary ui-button--sm";
        back.textContent = "Back to opportunities";
        back.addEventListener("click", () =>
          renderOpportunities(opportunityList),
        );

        const heading = document.createElement("div");
        heading.className = "ui-page-header";
        const intro = document.createElement("div");
        intro.className = "ui-page-header__identity";
        const type = statusLabel(opportunity.opportunity_type);
        intro.append(
          Object.assign(document.createElement("p"), {
            className: "ui-overline",
            textContent: "SEO opportunity",
          }),
          Object.assign(document.createElement("h2"), { textContent: type }),
          Object.assign(document.createElement("p"), {
            textContent:
              "Review the supporting evidence, expected impact, and approval state before any implementation begins.",
          }),
        );
        heading.append(
          intro,
          statusBadge(
            opportunity.priority_score >= 70
              ? "blocked"
              : opportunity.priority_score >= 40
                ? "setup"
                : "neutral",
            `Priority ${opportunity.priority_score}`,
          ),
        );
        panel.append(back, heading);

        const grid = document.createElement("div");
        grid.className = "ui-card-grid ui-card-grid--lg";
        grid.append(
          renderEvidenceCard(opportunity),
          await renderRecommendationCard(opportunity, recommendations),
        );
        panel.append(grid);
      }

      function renderEvidenceCard(
        opportunity: import("../lib/seo").SEOOpportunity,
      ): HTMLElement {
        const card = sectionCard(
          "Why this matters",
          "Evidence and score factors recorded by the latest analysis.",
        );
        const body = card.querySelector<HTMLElement>(".ui-card__body")!;
        const factors = Object.entries(opportunity.score_explanation);
        if (factors.length > 0) {
          const list = document.createElement("dl");
          list.className = "ui-stack ui-stack--2";
          for (const [key, value] of factors) {
            const term = document.createElement("dt");
            term.textContent = statusLabel(key);
            const detail = document.createElement("dd");
            detail.textContent = String(value);
            list.append(term, detail);
          }
          body.append(list);
        }
        const evidence = readableEvidence(opportunity.evidence);
        if (evidence.length > 0) {
          const title = document.createElement("h4");
          title.textContent = "Supporting evidence";
          const list = document.createElement("ul");
          list.className = "ui-stack ui-stack--2";
          for (const line of evidence) {
            const item = document.createElement("li");
            item.textContent = line;
            list.append(item);
          }
          body.append(title, list);
        } else {
          body.append(
            emptyState(
              "No readable evidence attached",
              "The opportunity can be reviewed after a crawl records supporting observations.",
            ),
          );
        }
        return card;
      }

      async function renderRecommendationCard(
        opportunity: import("../lib/seo").SEOOpportunity,
        recommendations: Awaited<ReturnType<typeof fetchRecommendations>>,
      ): Promise<HTMLElement> {
        const card = sectionCard(
          "Recommended action",
          "Recommendations are governed revisions, separate from implementation.",
        );
        const body = card.querySelector<HTMLElement>(".ui-card__body")!;
        if (recommendations.kind !== "ok") {
          body.append(
            errorAlert(describeFailure(recommendations, "Recommendations")),
          );
          return card;
        }
        const latest = recommendations.data[0];
        if (latest) {
          body.append(
            detailFact("Action", latest.proposed_action),
            detailFact("Expected result", latest.expected_result_hypothesis),
            detailFact(
              "Effort and risk",
              `${statusLabel(latest.effort)} effort · ${statusLabel(latest.risk)} risk`,
            ),
            statusBadge(statusTone(latest.status), statusLabel(latest.status)),
          );
          if (latest.status === "awaiting_approval") {
            const approve = document.createElement("button");
            approve.type = "button";
            approve.className = "ui-button ui-button--primary ui-button--md";
            approve.textContent = "Approve recommendation";
            approve.addEventListener("click", async () => {
              approve.disabled = true;
              const result = await decideRecommendation(
                organizationId,
                latest.id,
                true,
              );
              if (result.kind === "ok") {
                const refreshed = await fetchOpportunities(organizationId);
                if (refreshed.kind === "ok")
                  await renderOpportunityDetail(opportunity, refreshed);
              } else {
                approve.disabled = false;
                body.append(errorAlert(describeFailure(result, "Approval")));
              }
            });
            body.append(approve);
          }
          const tasks = await fetchImplementationTasks(
            organizationId,
            latest.id,
          );
          if (tasks.kind === "ok" && tasks.data.length > 0) {
            const taskTitle = document.createElement("h4");
            taskTitle.textContent = "Implementation";
            body.append(taskTitle);
            for (const task of tasks.data) {
              body.append(
                detailFact(
                  statusLabel(task.target_type),
                  task.verified_at
                    ? `Verified ${formatTimestamp(task.verified_at)}`
                    : statusLabel(task.status),
                ),
              );
            }
          }
          return card;
        }

        const form = document.createElement("form");
        form.className = "ui-form-grid";
        const action = document.createElement("textarea");
        action.required = true;
        action.rows = 4;
        const outcome = document.createElement("textarea");
        outcome.required = true;
        outcome.rows = 3;
        const risk = optionSelect(
          ["low", "medium", "high"],
          `seo-risk-${opportunity.id}`,
          "Risk",
        );
        const effort = optionSelect(
          ["low", "medium", "high"],
          `seo-effort-${opportunity.id}`,
          "Effort",
        );
        form.append(
          formField("Proposed action", action, {
            full: true,
            id: `seo-action-${opportunity.id}`,
          }),
          formField("Expected result", outcome, {
            full: true,
            id: `seo-outcome-${opportunity.id}`,
          }),
          risk.root,
          effort.root,
        );
        const submit = document.createElement("button");
        submit.type = "submit";
        submit.className = "ui-button ui-button--primary ui-button--md";
        submit.textContent = "Create recommendation";
        const status = liveStatus();
        form.append(submit, status);
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          submit.disabled = true;
          status.textContent = "Creating recommendation…";
          const result = await createRecommendation(
            organizationId,
            opportunity.id,
            {
              proposedAction: action.value,
              expectedResultHypothesis: outcome.value,
              risk: risk.input.value as "low" | "medium" | "high",
              effort: effort.input.value as "low" | "medium" | "high",
            },
          );
          if (result.kind === "ok") {
            const refreshed = await fetchOpportunities(organizationId);
            if (refreshed.kind === "ok")
              await renderOpportunityDetail(opportunity, refreshed);
          } else {
            submit.disabled = false;
            status.textContent = describeFailure(result, "Recommendation");
          }
        });
        body.append(form);
        return card;
      }

      function readableEvidence(evidence: Record<string, unknown>): string[] {
        const lines: string[] = [];
        for (const [key, value] of Object.entries(evidence)) {
          const label = statusLabel(key);
          if (["string", "number", "boolean"].includes(typeof value)) {
            lines.push(`${label}: ${String(value)}`);
          } else if (
            Array.isArray(value) &&
            value.every((entry) => ["string", "number"].includes(typeof entry))
          ) {
            lines.push(`${label}: ${value.join(", ")}`);
          }
        }
        return lines;
      }

      function optionSelect(values: string[], id: string, label: string) {
        return createSelectControl(
          id,
          label,
          values.map((value) => ({
            value,
            label: statusLabel(value),
          })),
          values[0] ?? "",
        );
      }

      let searchConsolePeriodDays = 28;

      async function renderSearchConsole(
        websites: Awaited<ReturnType<typeof fetchWebsites>>,
      ): Promise<void> {
        const panel = document.getElementById("tab-search-console")!;
        panel.replaceChildren();

        if (websites.kind !== "ok" || websites.data.length === 0) {
          panel.append(
            emptyState(
              "No websites configured",
              "Add a website to enable Search Console integration.",
            ),
          );
          return;
        }

        for (const website of websites.data) {
          // Website header
          const websiteHeader = document.createElement("div");
          websiteHeader.className = "ui-card";
          const whBody = document.createElement("div");
          whBody.className = "ui-card__body";
          const whRow = document.createElement("div");
          whRow.className = "ui-inline ui-inline--center ui-inline--spread";
          const whInfo = document.createElement("div");
          const whTitle = document.createElement("h3");
          whTitle.textContent = website.name;
          const whDomain = document.createElement("p");
          whDomain.className = "ui-text-secondary";
          whDomain.textContent = website.canonical_origin;
          whInfo.append(whTitle, whDomain);
          whRow.append(whInfo);

          // Period selector
          const selector = reportingPeriodSelector(
            searchConsolePeriodDays,
            (days) => {
              searchConsolePeriodDays = days;
              void renderSearchConsole(websites);
            },
          );
          whRow.append(selector);
          whBody.append(whRow);
          websiteHeader.append(whBody);
          panel.append(websiteHeader);

          // Fetch performance data
          const propsResult = await fetchSearchProperties(
            organizationId,
            website.id,
          );
          if (propsResult.kind !== "ok" || propsResult.data.length === 0) {
            panel.append(
              emptyState(
                "No Search Console properties",
                "Map a Search Console property in Integrations to see performance data.",
                "Go to Integrations",
                "/integrations",
              ),
            );
            return;
          }

          const perfResult = await fetchSearchConsolePerformance(
            organizationId,
            website.id,
            searchConsolePeriodDays,
          );

          if (perfResult.kind !== "ok" || !perfResult.data.connected) {
            panel.append(
              emptyState(
                "No Search Console data available",
                "Sync Search Console to see performance data.",
              ),
            );
            return;
          }

          const data = perfResult.data;

          // Freshness
          if (data.freshness && data.range) {
            const freshnessRow = document.createElement("div");
            freshnessRow.className =
              "ui-inline ui-inline--center ui-inline--spread";
            const dateLabel = document.createElement("p");
            dateLabel.className = "ui-text-secondary";
            dateLabel.textContent = `${formatDateRange(data.range.start, data.range.end)} · vs ${formatDateRange(data.comparison_range?.start || "", data.comparison_range?.end || "")}`;
            freshnessRow.append(
              dateLabel,
              sourceFreshness(
                data.freshness.last_synced_at,
                data.freshness.status,
              ),
            );
            panel.append(freshnessRow);
          }

          // KPI cards
          const gscLabels: Record<string, string> = {
            clicks: "Clicks",
            impressions: "Impressions",
            ctr: "CTR",
            position: "Avg position",
          };
          const gscFormatters: Record<string, (v: number | null) => string> = {
            clicks: (v) => (v !== null ? v.toLocaleString() : "—"),
            impressions: (v) => (v !== null ? v.toLocaleString() : "—"),
            ctr: (v) => (v !== null ? `${(v * 100).toFixed(1)}%` : "—"),
            position: (v) => (v !== null ? v.toFixed(1) : "—"),
          };

          const gscGrid = document.createElement("div");
          gscGrid.className = "ui-card-grid ui-card-grid--sm";
          const searchContext = `Google Search Console · ${searchConsolePeriodDays} days · ${formatFreshness(data.freshness.last_synced_at, data.freshness.status)}`;
          for (const key of ["clicks", "impressions", "ctr", "position"]) {
            const metric = data.metrics[key];
            if (metric) {
              const card = comparisonKPI(
                gscLabels[key],
                metric.current as number | null,
                metric.previous as number | null,
                metric.delta as number | null,
                metric.percent_delta as number | null,
                searchContext,
                key,
                `${searchConsolePeriodDays} days`,
              );
              const valueEl = card.querySelector(".ui-metric-card__value");
              if (valueEl) {
                valueEl.textContent = gscFormatters[key](
                  metric.current as number | null,
                );
              }
              gscGrid.append(card);
            }
          }
          panel.append(gscGrid);

          // Daily chart
          if (data.series && data.series.length > 0) {
            const chartSection = document.createElement("div");
            chartSection.className =
              "ui-card ui-card--spaced ui-card--flush reporting-chart-card";
            const chartHeader = document.createElement("div");
            chartHeader.className = "ui-card__header";
            const chartTitle = document.createElement("h3");
            chartTitle.className = "ui-card__heading";
            chartTitle.textContent = "Organic search trend";
            chartHeader.append(chartTitle);
            chartSection.append(chartHeader);
            const chartBody = document.createElement("div");
            chartBody.className = "ui-card__body";
            chartBody.append(
              reportingTrendChart(
                [
                  {
                    key: "clicks",
                    label: "Clicks",
                    points: data.series.map((item) => ({
                      date: item.date,
                      value: item.clicks ?? null,
                    })),
                  },
                  {
                    key: "impressions",
                    label: "Impressions",
                    points: data.series.map((item) => ({
                      date: item.date,
                      value: item.impressions ?? null,
                    })),
                  },
                  {
                    key: "ctr",
                    label: "CTR",
                    points: data.series.map((item) => ({
                      date: item.date,
                      value: item.ctr ?? null,
                    })),
                    formatValue: (value) => `${(value * 100).toFixed(1)}%`,
                  },
                  {
                    key: "position",
                    label: "Avg position",
                    points: data.series.map((item) => ({
                      date: item.date,
                      value: item.position ?? null,
                    })),
                    formatValue: (value) => value.toFixed(1),
                  },
                ],
                "clicks",
              ),
            );
            chartSection.append(chartBody);
            panel.append(chartSection);
          }

          // Top queries
          if (data.top_queries && data.top_queries.length > 0) {
            const queriesSection = document.createElement("div");
            queriesSection.className = "ui-card ui-card--spaced ui-card--flush";
            const qHeader = document.createElement("div");
            qHeader.className = "ui-card__header";
            const qTitle = document.createElement("h3");
            qTitle.className = "ui-card__heading";
            qTitle.textContent = "Top search queries";
            qHeader.append(qTitle);
            queriesSection.append(qHeader);
            const qBody = document.createElement("div");
            qBody.className = "ui-card__body";
            const queryRows = data.top_queries.map((q) => ({
              primary: q.query,
              clicks: q.clicks,
              impressions: q.impressions,
              ctr: q.ctr !== null ? `${(q.ctr * 100).toFixed(1)}%` : "—",
              position: q.position !== null ? q.position.toFixed(1) : "—",
            }));
            const qTable = buildGscDataTable(
              ["Query", "Clicks", "Impressions", "CTR", "Position"],
              queryRows.slice(0, 5),
            );
            qBody.append(qTable);
            if (data.top_queries.length > 5) {
              const viewAll = document.createElement("button");
              viewAll.type = "button";
              viewAll.className =
                "ui-button ui-button--secondary ui-button--sm";
              viewAll.textContent = `View all ${data.top_queries.length} queries`;
              viewAll.addEventListener("click", () => {
                qBody.replaceChildren(
                  buildGscDataTable(
                    ["Query", "Clicks", "Impressions", "CTR", "Position"],
                    queryRows,
                  ),
                );
              });
              qBody.append(viewAll);
            }
            queriesSection.append(qBody);
            panel.append(queriesSection);
          }

          // Top pages
          if (data.top_pages && data.top_pages.length > 0) {
            const pagesSection = document.createElement("div");
            pagesSection.className = "ui-card ui-card--spaced ui-card--flush";
            const pHeader = document.createElement("div");
            pHeader.className = "ui-card__header";
            const pTitle = document.createElement("h3");
            pTitle.className = "ui-card__heading";
            pTitle.textContent = "Top landing pages";
            pHeader.append(pTitle);
            pagesSection.append(pHeader);
            const pBody = document.createElement("div");
            pBody.className = "ui-card__body";
            const pageRows = data.top_pages.map((page) => ({
              primary: page.page,
              clicks: page.clicks,
              impressions: page.impressions,
              ctr: page.ctr !== null ? `${(page.ctr * 100).toFixed(1)}%` : "—",
              position: page.position !== null ? page.position.toFixed(1) : "—",
            }));
            const pTable = buildGscDataTable(
              ["Page", "Clicks", "Impressions", "CTR", "Position"],
              pageRows.slice(0, 5),
            );
            pBody.append(pTable);
            if (data.top_pages.length > 5) {
              const viewAll = document.createElement("button");
              viewAll.type = "button";
              viewAll.className =
                "ui-button ui-button--secondary ui-button--sm";
              viewAll.textContent = `View all ${data.top_pages.length} pages`;
              viewAll.addEventListener("click", () => {
                pBody.replaceChildren(
                  buildGscDataTable(
                    ["Page", "Clicks", "Impressions", "CTR", "Position"],
                    pageRows,
                  ),
                );
              });
              pBody.append(viewAll);
            }
            pagesSection.append(pBody);
            panel.append(pagesSection);
          }

          // Property info (compact)
          const propSection = document.createElement("div");
          propSection.className = "ui-notice ui-notice--info";
          propSection.textContent =
            propsResult.data.length === 1
              ? `Property: ${propsResult.data[0].external_property_id}`
              : `${propsResult.data.length} properties connected`;
          panel.append(propSection);
        }
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("SEO");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
