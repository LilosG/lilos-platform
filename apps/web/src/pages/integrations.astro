---
import AppShell from "../components/AppShell.astro";
import {
  Button,
  CardGrid,
  EmptyState,
  PageHeader,
  PageShell,
  Region,
  Skeleton,
} from "../lib/ui/primitives";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs integrations" />
    <title>Integrations · LILOs</title>
  </head>
  <body>
    <AppShell>
      <PageShell id="boot-not-configured" width="narrow">
        <EmptyState
          heading="This deployment is not configured"
          description="Connect the platform runtime configuration to enable Integrations."
        />
      </PageShell>

      <PageShell id="boot-loading" width="narrow" hidden>
        <Skeleton lines={4} label="Loading integrations" />
      </PageShell>

      <Region
        id="boot-error"
        as="div"
        role="alert"
        label="Integrations error"
        hidden
      />

      <PageShell id="workspace-empty" width="narrow" hidden>
        <EmptyState
          heading="No organization access yet"
          description="Your account is not a member of any organization. Ask an administrator to invite you."
        />
      </PageShell>

      <PageShell id="integrations-content" hidden>
        <Region id="connections" as="section" labelledBy="integrations-title">
          <PageHeader
            eyebrow="Manage"
            title="Integrations"
            titleId="integrations-title"
            description="Connect supported external providers here. Product pages consume confirmed connections and mappings."
          />
          <CardGrid id="integration-cards" />
        </Region>

        <Region
          id="provider-workspace"
          as="section"
          labelledBy="provider-title"
          hidden
        >
          <PageHeader
            eyebrow="Integrations"
            eyebrowId="provider-eyebrow"
            title="—"
            titleId="provider-title"
            description="Loading provider details."
            descriptionId="provider-description"
          >
            <Button
              slot="actions"
              variant="secondary"
              size="sm"
              id="back-to-integrations">Back to Integrations</Button
            >
          </PageHeader>
          <Region
            id="provider-content"
            as="div"
            label="Provider details"
            class="ui-region--flow"
          />
        </Region>
      </PageShell>
    </AppShell>
    <script>
      import {
        beginConnection,
        connectGoogle,
        disconnectConnection,
        fetchConnectionStatus,
        describeGbpConnectFailure,
        googleAuthorizationAction,
      } from "../lib/gbp-connection";
      import {
        confirmGbpMappingAndReconcile,
        discoverGoogleResourcesAndReconcile,
        gbpWriteGovernanceFor,
        removeGbpMappingAndReconcile,
        REMOVE_GBP_MAPPING_CONFIRMATION,
      } from "../lib/google-workspace-governance";
      import { beginGitHubInstall, disconnectGitHub } from "../lib/github-app";
      import {
        fetchGoogleWorkspace,
        fetchUnmappedResources,
        fetchGitHubWorkspace,
        type GitHubWorkspace,
        type GoogleWorkspace,
      } from "../lib/integrations";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        emptyState,
        errorAlert,
        describeFailure,
        formatTimestamp,
        confirmInline,
        canUsePlatformAdministration,
        createSelectControl,
        type BootRegions,
      } from "../lib/ui";
      import { statusLabel } from "../lib/status-language";
      import { fetchLocations, type LocationSummary } from "../lib/workspace";
      import { reconcileBusinessFacts } from "../lib/administration";
      import {
        createPublishingTarget,
        type PublishingTarget,
      } from "../lib/content";
      import { fetchWebsites } from "../lib/seo";
      import {
        discoverSearchConsole,
        mapSearchConsole,
      } from "../lib/search-console";

      let organizationId = "";

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("integrations-content")!,
      };

      const directory = document.getElementById("connections")!;
      const providerView = document.getElementById("provider-workspace")!;
      const providerTitle = document.getElementById("provider-title")!;
      const providerDesc = document.getElementById("provider-description")!;
      const providerContent = document.getElementById("provider-content")!;

      const PROVIDER_DESCRIPTIONS: Record<string, string> = {
        google:
          "Manage Google Business Profile, Search Console, and Analytics.",
        github: "Manage GitHub repository connections for content publishing.",
      };

      function isGitHubConnected(
        workspace: GitHubWorkspace | null | undefined,
      ): boolean {
        return (
          workspace?.connection_status === "connected" ||
          workspace?.connection_status === "active"
        );
      }

      function showDirectory(): void {
        directory.hidden = false;
        providerView.hidden = true;
      }

      function showProvider(key: string, name: string): void {
        directory.hidden = true;
        providerView.hidden = false;
        providerTitle.textContent = name;
        providerDesc.textContent = PROVIDER_DESCRIPTIONS[key] || "";
        providerContent.replaceChildren();
        providerContent.append(createLoading());
      }

      function createLoading(): HTMLDivElement {
        const el = document.createElement("div");
        el.className = "ui-skeleton-group";
        el.textContent = "Loading…";
        return el;
      }

      document
        .getElementById("back-to-integrations")!
        .addEventListener("click", () => {
          showDirectory();
          void renderDirectory();
        });

      async function renderDirectory(): Promise<void> {
        const cards = document.getElementById("integration-cards")!;
        cards.replaceChildren(createLoading());

        const [googleResult, githubResult] = await Promise.all([
          fetchConnectionStatus(organizationId),
          fetchGitHubWorkspace(organizationId),
        ]);

        cards.replaceChildren();

        cards.append(
          makeDirectoryCard(
            "google",
            "Google",
            "Business Profile, Search Console, and Analytics",
            googleResult.kind === "ok" &&
              googleResult.data?.status === "connected"
              ? "connected"
              : googleResult.kind === "ok" &&
                  googleResult.data?.status === "reconnect_required"
                ? "degraded"
                : googleResult.kind === "error" &&
                    googleResult.code === "INTEGRATION_NOT_CONFIGURED"
                  ? "not_configured"
                  : "not_connected",
            () => void openGoogle(),
          ),
        );

        const ghStatus: "connected" | "not_connected" =
          githubResult.kind === "ok" && isGitHubConnected(githubResult.data)
            ? "connected"
            : "not_connected";
        cards.append(
          makeDirectoryCard(
            "github",
            "GitHub",
            "Content publishing via GitHub repositories",
            ghStatus,
            () => void openGitHub(githubResult),
          ),
        );
      }

      function makeDirectoryCard(
        key: string,
        name: string,
        description: string,
        status: string,
        onClick: () => void,
      ): HTMLButtonElement {
        const card = document.createElement("button");
        card.className = "ui-card ui-card--interactive";
        card.type = "button";
        card.dataset.provider = key;
        card.addEventListener("click", onClick);

        const header = document.createElement("header");
        header.className = "ui-card__header";
        const title = document.createElement("h3");
        title.className = "ui-card__heading";
        title.textContent = name;
        header.append(title);

        const desc = document.createElement("p");
        desc.className = "ui-card__description";
        desc.textContent = description;

        const footer = document.createElement("footer");
        footer.className = "ui-card__footer";
        const badgeKind =
          status === "connected"
            ? "ready"
            : status === "degraded"
              ? "blocked"
              : status === "not_configured"
                ? "missing"
                : "setup";
        const label =
          status === "connected"
            ? "Connected"
            : status === "degraded"
              ? "Needs attention"
              : status === "not_configured"
                ? "Not configured"
                : "Not connected";
        footer.append(statusBadge(badgeKind, label));

        const body = document.createElement("div");
        body.className = "ui-card__body";
        body.append(desc);
        card.append(header, body, footer);
        return card;
      }

      async function openGoogle(): Promise<void> {
        showProvider("google", "Google");
        await loadGoogleWorkspace();
      }

      async function reloadGoogleWorkspace(): Promise<void> {
        await loadGoogleWorkspace();
      }

      async function reconcileGoogleSourceData(): Promise<void> {
        await reconcileBusinessFacts(organizationId);
        await reloadGoogleWorkspace();
      }

      async function loadGoogleWorkspace(): Promise<void> {
        const content = providerContent;
        content.replaceChildren(createLoading());

        const [currentConnectionResult, wsResult, locationsResult] =
          await Promise.all([
            fetchConnectionStatus(organizationId),
            fetchGoogleWorkspace(organizationId),
            fetchLocations(organizationId),
          ]);

        content.replaceChildren();

        const connCard = makeCard("Connection");
        content.append(connCard);
        const connBody = connCard.querySelector(
          ".ui-card__body",
        ) as HTMLElement;
        renderGoogleConnection(connBody, currentConnectionResult);

        if (wsResult.kind !== "ok") {
          content.append(
            errorAlert(describeFailure(wsResult, "Google workspace")),
          );
          return;
        }

        const ws = wsResult.data;
        const platformLocations =
          locationsResult.kind === "ok" ? locationsResult.data : [];
        const capsCard = makeCard("Authorized Google services");
        content.append(capsCard);
        const capsBody = capsCard.querySelector(
          ".ui-card__body",
        ) as HTMLElement;
        renderCapabilities(capsBody, ws);

        if (ws.mapped_resources.length > 0) {
          const mappedCard = makeCard("Business Profile mappings");
          content.append(mappedCard);
          renderMappedResources(
            mappedCard.querySelector(".ui-card__body") as HTMLElement,
            ws,
            platformLocations,
          );
        }

        if (canUsePlatformAdministration()) {
          await renderUnmappedQueue(content, wsResult);
          if (
            ws.capabilities.some(
              (cap) => cap.key === "search_console" && cap.enabled,
            )
          ) {
            await renderSearchConsoleSetup(content);
          }
        }
      }

      async function renderSearchConsoleSetup(
        parent: HTMLElement,
      ): Promise<void> {
        const card = makeCard("Search Console property");
        const body = card.querySelector(".ui-card__body") as HTMLElement;
        parent.append(card);

        const websitesResult = await fetchWebsites(organizationId);
        if (websitesResult.kind !== "ok") {
          body.append(
            errorAlert(describeFailure(websitesResult, "SEO websites")),
          );
          return;
        }
        if (websitesResult.data.length === 0) {
          body.append(
            emptyState(
              "Add a website first",
              "Save the client's domain in onboarding, then return here to map its Search Console property.",
            ),
          );
          return;
        }

        const websiteSelect = createSelectControl(
          "search-console-website",
          "Website",
          websitesResult.data.map((website) => ({
            value: website.id,
            label: `${website.name} · ${website.canonical_origin}`,
          })),
          websitesResult.data.length === 1 ? websitesResult.data[0].id : "",
          "Select website…",
        );
        const discoverButton = document.createElement("button");
        discoverButton.type = "button";
        discoverButton.className = "ui-button ui-button--primary ui-button--md";
        discoverButton.textContent = "Discover Search Console properties";
        const results = document.createElement("div");
        results.className = "ui-stack ui-stack--3";
        body.append(websiteSelect.root, discoverButton, results);

        discoverButton.addEventListener("click", async () => {
          const websiteId = websiteSelect.input.value;
          if (!websiteId) {
            results.replaceChildren(errorAlert("Select a website first."));
            return;
          }
          discoverButton.disabled = true;
          discoverButton.textContent = "Discovering…";
          results.replaceChildren(createLoading());
          const discovery = await discoverSearchConsole(
            organizationId,
            websiteId,
          );
          discoverButton.disabled = false;
          discoverButton.textContent = "Discover Search Console properties";
          if (discovery.kind !== "ok") {
            results.replaceChildren(
              errorAlert(
                describeFailure(discovery, "Search Console discovery"),
              ),
            );
            return;
          }
          if (discovery.data.properties.length === 0) {
            results.replaceChildren(
              emptyState(
                "No accessible properties found",
                "Confirm this Google account can access the client's Search Console property.",
              ),
            );
            return;
          }

          const propertySelect = createSelectControl(
            "search-console-property",
            "Search Console property",
            discovery.data.properties.map((property) => ({
              value: `${property.property_type}\t${property.external_property_id}`,
              label: `${property.external_property_id} · ${property.permission_level}`,
            })),
            discovery.data.recommended
              ? `${discovery.data.recommended.property_type}\t${discovery.data.recommended.external_property_id}`
              : "",
            "Select property…",
          );
          const mapButton = document.createElement("button");
          mapButton.type = "button";
          mapButton.className = "ui-button ui-button--primary ui-button--md";
          mapButton.textContent = "Map selected property";
          mapButton.addEventListener("click", async () => {
            const [propertyType, externalPropertyId] =
              propertySelect.input.value.split("\t", 2);
            if (
              !externalPropertyId ||
              (propertyType !== "domain" && propertyType !== "url_prefix")
            ) {
              results.append(
                errorAlert("Select a Search Console property first."),
              );
              return;
            }
            mapButton.disabled = true;
            mapButton.textContent = "Mapping…";
            const mapped = await mapSearchConsole(organizationId, websiteId, {
              external_property_id: externalPropertyId,
              property_type: propertyType,
            });
            if (mapped.kind === "ok") {
              results.replaceChildren(
                statusBadge("ready", "Search Console property mapped"),
              );
            } else {
              mapButton.disabled = false;
              mapButton.textContent = "Map selected property";
              results.append(
                errorAlert(describeFailure(mapped, "Search Console mapping")),
              );
            }
          });
          results.replaceChildren(propertySelect.root, mapButton);
        });
      }

      function renderGoogleConnection(
        panel: HTMLElement,
        outcome: Awaited<ReturnType<typeof fetchConnectionStatus>>,
      ): void {
        panel.replaceChildren();

        if (
          outcome.kind === "error" &&
          outcome.code === "INTEGRATION_NOT_CONFIGURED"
        ) {
          panel.append(
            emptyState(
              "Google connection is not configured",
              "This deployment has not been configured with Google OAuth credentials yet.",
            ),
          );
          return;
        }
        if (outcome.kind !== "ok") {
          panel.append(
            errorAlert(describeFailure(outcome, "Google connection")),
          );
          return;
        }

        const state = outcome.data;
        if (state === null || state.status === "disconnected") {
          const connectBtn = document.createElement("button");
          connectBtn.type = "button";
          connectBtn.className = "ui-button ui-button--primary ui-button--md";
          connectBtn.textContent = "Connect Google";
          connectBtn.addEventListener("click", async () => {
            connectBtn.disabled = true;
            connectBtn.textContent = "Connecting…";
            const result = await connectGoogle(organizationId, [
              "gbp",
              "search_console",
              "analytics",
            ]);
            if (result.kind === "ok") {
              window.location.assign(result.data.authorization_url);
            } else {
              connectBtn.disabled = false;
              connectBtn.textContent = "Connect Google";
              const desc = describeGbpConnectFailure(result, organizationId);
              panel.append(errorAlert(desc.message));
            }
          });
          panel.append(connectBtn);
          panel.append(
            Object.assign(document.createElement("p"), {
              className: "ui-text-secondary",
              textContent:
                "Connect your Google account to enable Business Profile, Search Console, and Analytics.",
            }),
          );
          return;
        }

        const badgeKind =
          state.status === "connected"
            ? "ready"
            : state.status === "reconnect_required"
              ? "blocked"
              : "setup";
        panel.append(
          statusBadge(
            badgeKind,
            state.status === "reconnect_required"
              ? "Reconnect required"
              : statusLabel(state.status),
          ),
        );

        if (state.last_verified_at) {
          const verified = document.createElement("p");
          verified.className = "ui-text-secondary";
          verified.textContent = `Last verified ${formatTimestamp(state.last_verified_at)}`;
          panel.append(verified);
        }
        if (state.token_expires_at) {
          const expires = document.createElement("p");
          expires.className = "ui-text-secondary";
          expires.textContent = `Token expires ${formatTimestamp(state.token_expires_at)}`;
          panel.append(expires);
        }

        const actions = document.createElement("div");
        actions.className = "ui-inline ui-inline--center";

        const authorizationAction = googleAuthorizationAction(state);
        if (authorizationAction.kind === "reconnect") {
          const reconnectBtn = document.createElement("button");
          reconnectBtn.type = "button";
          reconnectBtn.className = "ui-button ui-button--primary ui-button--md";
          reconnectBtn.textContent = "Reconnect Google";
          reconnectBtn.addEventListener("click", async () => {
            const result = await beginConnection(organizationId);
            if (result.kind === "ok") {
              window.location.assign(result.data.authorization_url);
            } else {
              panel.append(errorAlert(describeFailure(result, "Reconnect")));
            }
          });
          actions.append(reconnectBtn);
        }

        if (authorizationAction.kind === "authorize_missing") {
          const authorizeBtn = document.createElement("button");
          authorizeBtn.type = "button";
          authorizeBtn.className = "ui-button ui-button--primary ui-button--md";
          authorizeBtn.textContent = "Authorize missing Google services";
          authorizeBtn.addEventListener("click", async () => {
            authorizeBtn.disabled = true;
            authorizeBtn.textContent = "Redirecting…";
            const result = await connectGoogle(
              organizationId,
              authorizationAction.products,
            );
            if (result.kind === "ok") {
              window.location.assign(result.data.authorization_url);
            } else {
              authorizeBtn.disabled = false;
              authorizeBtn.textContent = "Authorize missing Google services";
              panel.append(
                errorAlert(describeFailure(result, "Google authorization")),
              );
            }
          });
          actions.append(authorizeBtn);
          panel.append(
            Object.assign(document.createElement("p"), {
              className: "ui-text-secondary",
              textContent:
                "Authorize the remaining read-only Google services to enable Analytics and Search Console discovery.",
            }),
          );
        }

        if (
          (state.status === "connected" || state.status === "degraded") &&
          canUsePlatformAdministration()
        ) {
          const discoverBtn = document.createElement("button");
          discoverBtn.type = "button";
          discoverBtn.className = "ui-button ui-button--primary ui-button--md";
          discoverBtn.textContent = "Discover accounts and locations";
          discoverBtn.addEventListener("click", async () => {
            discoverBtn.disabled = true;
            discoverBtn.textContent = "Discovering…";
            const result = await discoverGoogleResourcesAndReconcile(
              organizationId,
              reconcileGoogleSourceData,
            );
            if (result.kind !== "ok") {
              discoverBtn.textContent = "Discover accounts and locations";
              discoverBtn.disabled = false;
              panel.append(errorAlert(describeFailure(result, "Discovery")));
            }
          });
          actions.append(discoverBtn);
        }

        if (state.status === "connected" || state.status === "degraded") {
          const disconnectBtn = document.createElement("button");
          disconnectBtn.type = "button";
          disconnectBtn.className =
            "ui-button ui-button--secondary ui-button--md";
          disconnectBtn.textContent = "Disconnect";
          disconnectBtn.addEventListener("click", () => {
            disconnectBtn.disabled = true;
            actions.append(
              confirmInline(
                "Disconnect Google? New syncs and provider actions will stop.",
                () => void performGoogleDisconnect(),
                () => {
                  disconnectBtn.disabled = false;
                },
                "Disconnect Google",
              ),
            );
          });
          actions.append(disconnectBtn);
        }

        panel.append(actions);
      }

      async function performGoogleDisconnect(): Promise<void> {
        const result = await disconnectConnection(organizationId);
        if (result.kind === "ok") {
          await reloadGoogleWorkspace();
        } else {
          providerContent.append(
            errorAlert(describeFailure(result, "Disconnect")),
          );
        }
      }

      function renderCapabilities(
        panel: HTMLElement,
        ws: GoogleWorkspace,
      ): void {
        const explanation = document.createElement("p");
        explanation.className = "ui-text-secondary";
        explanation.textContent =
          "Authorization means the connected Google account granted LILOs access. It does not mean a Business Profile or Search Console property is mapped or that data has synced.";
        panel.append(explanation);

        const list = document.createElement("ul");
        list.className = "ui-record-list";
        for (const cap of ws.capabilities) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = cap.label;
          info.append(name);
          item.append(
            info,
            statusBadge(
              cap.enabled ? "ready" : "setup",
              cap.enabled ? "Authorized" : "Not authorized",
            ),
          );
          list.append(item);
        }
        panel.append(list);
      }

      function renderMappedResources(
        panel: HTMLElement,
        ws: GoogleWorkspace,
        platformLocations: LocationSummary[],
      ): void {
        const locationNames = new Map(
          platformLocations.map((location) => [location.id, location.name]),
        );
        const mappedCounts = new Map<string, number>();
        for (const resource of ws.mapped_resources) {
          if (!resource.platform_resource_id) continue;
          mappedCounts.set(
            resource.platform_resource_id,
            (mappedCounts.get(resource.platform_resource_id) ?? 0) + 1,
          );
        }
        const duplicateLocationIds = new Set(
          [...mappedCounts.entries()]
            .filter(([, count]) => count > 1)
            .map(([locationId]) => locationId),
        );

        if (duplicateLocationIds.size > 0) {
          const duplicateNames = [...duplicateLocationIds].map(
            (locationId) => locationNames.get(locationId) ?? "a LILOs location",
          );
          const duplicateResourceCount = ws.mapped_resources.filter(
            (resource) =>
              resource.platform_resource_id &&
              duplicateLocationIds.has(resource.platform_resource_id),
          ).length;
          const duplicateLabel =
            duplicateLocationIds.size === 1 ? "location" : "locations";
          panel.append(
            errorAlert(
              `${duplicateResourceCount} Business Profile resources are mapped across ${duplicateLocationIds.size} duplicate ${duplicateLabel}: ${duplicateNames.join(", ")}. Keep the correct Business Profile and remove the incorrect mapping below.`,
            ),
          );
        }

        const explanation = document.createElement("p");
        explanation.className = "ui-text-secondary";
        explanation.textContent =
          "These are Google Business Profile resources attached to LILOs locations. Removing a mapping only detaches it from this workspace; it does not delete or change the Google profile.";
        panel.append(explanation);

        const list = document.createElement("ul");
        list.className = "ui-record-list";
        for (const res of ws.mapped_resources) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = res.display_name || res.external_resource_id;
          const detail = document.createElement("p");
          const syncLabel =
            res.sync_freshness === "fresh"
              ? "Synced"
              : res.sync_freshness === "stale"
                ? "Stale"
                : "Never synced";
          const mappedTo = res.platform_resource_id
            ? (locationNames.get(res.platform_resource_id) ??
              "Unknown LILOs location")
            : "No LILOs location";
          detail.textContent = `Mapped to ${mappedTo} · ${syncLabel}`;
          if (res.last_synced_at) {
            detail.textContent += ` · ${formatTimestamp(res.last_synced_at)}`;
          }
          const feedback = document.createElement("div");
          feedback.className = "ui-stack ui-stack--2";
          info.append(name, detail, feedback);

          const states = document.createElement("div");
          states.className = "ui-inline ui-inline--center ui-inline--tight";
          states.append(
            statusBadge(
              res.sync_freshness === "fresh"
                ? "ready"
                : res.sync_freshness === "stale"
                  ? "blocked"
                  : "setup",
              res.sync_freshness === "fresh"
                ? "Fresh"
                : res.sync_freshness === "stale"
                  ? "Stale"
                  : "Pending",
            ),
          );

          const governance = gbpWriteGovernanceFor(
            res,
            canUsePlatformAdministration(),
          );
          if (governance !== null) {
            states.append(
              statusBadge(governance.stateKind, governance.stateLabel),
            );
            const actionLabel = governance.actionLabel;
            const confirmationMessage = governance.confirmationMessage;
            const desiredWriteEnabled = governance.desiredWriteEnabled;
            const platformLocationId = res.platform_resource_id;
            const gbpLocationId = res.gbp_location_id;
            if (
              actionLabel !== null &&
              confirmationMessage !== null &&
              desiredWriteEnabled !== null &&
              platformLocationId !== null &&
              gbpLocationId !== null
            ) {
              const action = document.createElement("button");
              action.type = "button";
              action.className =
                "ui-button ui-button--secondary ui-button--sm";
              action.textContent = actionLabel;
              action.addEventListener("click", () => {
                action.disabled = true;
                feedback.replaceChildren(
                  confirmInline(
                    confirmationMessage,
                    () => {
                      void (async () => {
                        const result = await confirmGbpMappingAndReconcile(
                          organizationId,
                          platformLocationId,
                          gbpLocationId,
                          desiredWriteEnabled,
                          reconcileGoogleSourceData,
                        );
                        if (result.kind !== "ok") {
                          action.disabled = false;
                          feedback.replaceChildren(
                            errorAlert(
                              describeFailure(result, "provider-write access"),
                            ),
                          );
                        }
                      })();
                    },
                    () => {
                      action.disabled = false;
                    },
                    actionLabel,
                  ),
                );
              });
              states.append(action);
            }
          }

          if (
            canUsePlatformAdministration() &&
            res.platform_resource_id !== null &&
            res.gbp_location_id !== null
          ) {
            const removeAction = document.createElement("button");
            removeAction.type = "button";
            removeAction.className =
              "ui-button ui-button--secondary ui-button--sm";
            removeAction.textContent = "Remove mapping";
            removeAction.addEventListener("click", () => {
              removeAction.disabled = true;
              feedback.replaceChildren(
                confirmInline(
                  REMOVE_GBP_MAPPING_CONFIRMATION,
                  () => {
                    void (async () => {
                      const result = await removeGbpMappingAndReconcile(
                        organizationId,
                        res.platform_resource_id!,
                        res.gbp_location_id!,
                        reconcileGoogleSourceData,
                      );
                      if (result.kind !== "ok") {
                        removeAction.disabled = false;
                        feedback.replaceChildren(
                          errorAlert(
                            describeFailure(result, "remove mapping"),
                          ),
                        );
                      }
                    })();
                  },
                  () => {
                    removeAction.disabled = false;
                  },
                  "Remove mapping",
                ),
              );
            });
            states.append(removeAction);
          }

          item.append(info, states);
          list.append(item);
        }
        panel.append(list);
      }

      async function renderUnmappedQueue(
        parent: HTMLElement,
        wsResult: Awaited<ReturnType<typeof fetchGoogleWorkspace>>,
      ): Promise<void> {
        if (wsResult.kind !== "ok" || wsResult.data.unmapped_count === 0) {
          return;
        }

        const disclosure = document.createElement("details");
        disclosure.className = "ui-card";
        disclosure.open = true;
        const summary = document.createElement("summary");
        summary.className = "ui-card__header";
        summary.textContent = `Unmapped Business Profiles (${wsResult.data.unmapped_count})`;
        const body = document.createElement("div");
        body.className = "ui-card__body";
        disclosure.append(summary, body);
        parent.append(disclosure);

        const searchRow = document.createElement("div");
        searchRow.className = "ui-control--compact";
        const searchInput = document.createElement("input");
        searchInput.type = "search";
        searchInput.placeholder = "Search unmapped Business Profiles…";
        searchInput.className = "ui-input";
        searchRow.append(searchInput);
        body.append(searchRow);

        const locationsResult = await fetchLocations(organizationId);
        const availableLocations: LocationSummary[] =
          locationsResult.kind === "ok" ? locationsResult.data : [];

        const listContainer = document.createElement("div");
        body.append(listContainer);

        async function loadUnmapped(search?: string): Promise<void> {
          listContainer.replaceChildren(createLoading());
          const result = await fetchUnmappedResources(organizationId, search);
          if (result.kind !== "ok") {
            listContainer.replaceChildren(
              errorAlert(describeFailure(result, "unmapped resources")),
            );
            return;
          }
          if (result.data.length === 0) {
            listContainer.replaceChildren(
              emptyState(
                "No unmapped Business Profiles",
                "All discovered Business Profile resources have been mapped.",
              ),
            );
            return;
          }
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const resource of result.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = resource.display_name;
            const detail = document.createElement("p");
            detail.textContent = resource.primary_category || "";
            info.append(name, detail);

            const rowActions = document.createElement("div");
            rowActions.className =
              "ui-inline ui-inline--center ui-inline--tight";

            const locationSelect = createSelectControl(
              `mapping-location-${resource.id}`,
              "LILOs location",
              availableLocations.map((location) => ({
                value: location.id,
                label: location.name,
              })),
              availableLocations.length === 1 ? availableLocations[0].id : "",
              "Select location…",
            );
            locationSelect.root.classList.add("ui-control--compact");

            const mapBtn = document.createElement("button");
            mapBtn.type = "button";
            mapBtn.className = "ui-button ui-button--primary ui-button--sm";
            mapBtn.textContent = "Map";
            mapBtn.addEventListener("click", async () => {
              const selectedLocationId = locationSelect.input.value;
              if (!selectedLocationId) {
                const errorEl = document.createElement("p");
                errorEl.className = "ui-text-danger";
                errorEl.textContent = "Select a location first.";
                item.append(errorEl);
                return;
              }
              mapBtn.disabled = true;
              mapBtn.textContent = "Mapping…";
              const mapResult = await confirmGbpMappingAndReconcile(
                organizationId,
                selectedLocationId,
                resource.id,
                false,
                reconcileGoogleSourceData,
              );
              if (mapResult.kind !== "ok") {
                mapBtn.textContent = "Map";
                mapBtn.disabled = false;
                item.append(
                  errorAlert(describeFailure(mapResult, "confirm mapping")),
                );
              }
            });

            rowActions.append(locationSelect.root, mapBtn);
            info.append(rowActions);

            item.append(info);
            list.append(item);
          }
          listContainer.replaceChildren(list);
        }

        await loadUnmapped();
        let debounceTimer: ReturnType<typeof setTimeout>;
        searchInput.addEventListener("input", () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            const q = searchInput.value.trim();
            void loadUnmapped(q || undefined);
          }, 300);
        });
      }

      async function openGitHub(
        wsResult: Awaited<ReturnType<typeof fetchGitHubWorkspace>>,
      ): Promise<void> {
        showProvider("github", "GitHub");
        const content = providerContent;
        content.replaceChildren();

        const connCard = makeCard("Connection");
        content.append(connCard);
        const connBody = connCard.querySelector(
          ".ui-card__body",
        ) as HTMLElement;

        if (wsResult.kind !== "ok") {
          connBody.append(
            errorAlert(describeFailure(wsResult, "GitHub connection")),
          );
          return;
        }

        const ws = wsResult.data;

        if (!isGitHubConnected(ws)) {
          const installBtn = document.createElement("button");
          installBtn.type = "button";
          installBtn.className = "ui-button ui-button--primary ui-button--md";
          installBtn.textContent = "Install GitHub App";
          installBtn.addEventListener("click", async () => {
            installBtn.disabled = true;
            installBtn.textContent = "Redirecting…";
            const result = await beginGitHubInstall(organizationId);
            if (result.kind === "ok") {
              window.location.assign(result.data.authorization_url);
            } else {
              installBtn.disabled = false;
              installBtn.textContent = "Install GitHub App";
              connBody.append(errorAlert(describeFailure(result, "GitHub")));
            }
          });

          connBody.append(installBtn);
          connBody.append(
            Object.assign(document.createElement("p"), {
              className: "ui-text-secondary",
              textContent:
                "Install the LILOs GitHub App to enable repository-backed publishing and implementation workflows.",
            }),
          );
          return;
        }

        connBody.append(statusBadge("ready", "Connected"));

        const repositoryCount = ws.repositories.length;
        connBody.append(
          Object.assign(document.createElement("p"), {
            className: "ui-text-secondary",
            textContent:
              repositoryCount > 0
                ? `LILOs GitHub App connected · ${repositoryCount} accessible ${
                    repositoryCount === 1 ? "repository" : "repositories"
                  }`
                : "LILOs GitHub App installed and connected.",
          }),
        );

        const disconnectBtn = document.createElement("button");
        disconnectBtn.type = "button";
        disconnectBtn.className =
          "ui-button ui-button--secondary ui-button--md";
        disconnectBtn.textContent = "Disconnect GitHub App";
        disconnectBtn.addEventListener("click", () => {
          disconnectBtn.disabled = true;
          connBody.append(
            confirmInline(
              "Disconnect GitHub? New publishing and implementation work will stop.",
              () => void performGitHubDisconnect(),
              () => {
                disconnectBtn.disabled = false;
              },
              "Disconnect GitHub",
            ),
          );
        });
        connBody.append(disconnectBtn);

        if (ws.repositories.length > 0) {
          const reposCard = makeCard("Accessible Repositories");
          content.append(reposCard);
          const reposBody = reposCard.querySelector(
            ".ui-card__body",
          ) as HTMLElement;

          const list = document.createElement("ul");
          list.className = "ui-record-list";

          for (const repo of ws.repositories) {
            const item = document.createElement("li");
            const info = document.createElement("div");

            const name = document.createElement("h3");
            name.textContent = repo.name;

            const detail = document.createElement("p");
            detail.textContent = `Default branch: ${repo.default_branch}`;

            info.append(name, detail);
            item.append(
              info,
              statusBadge(
                repo.private ? "neutral" : "ready",
                repo.private ? "Private" : "Public",
              ),
            );
            list.append(item);
          }

          reposBody.append(list);
        }

        renderGitHubPublishingTargets(content, ws);
      }

      function renderGitHubPublishingTargets(
        parent: HTMLElement,
        ws: GitHubWorkspace,
      ): void {
        const card = makeCard("Publishing target");
        const body = card.querySelector(".ui-card__body") as HTMLElement;
        parent.append(card);

        if (ws.publishing_targets.length > 0) {
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const target of ws.publishing_targets) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = target.key;
            const detail = document.createElement("p");
            detail.textContent = `${target.repository_id} · ${target.base_branch} · ${target.allowed_path_prefix}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(
                target.status === "active" ? "ready" : "setup",
                statusLabel(target.status),
              ),
            );
            list.append(item);
          }
          body.append(list);
          return;
        }

        if (!canUsePlatformAdministration() || !ws.connection_id) {
          body.append(
            emptyState(
              "No publishing target configured",
              "An administrator with elevated access can select the client's publishing repository.",
            ),
          );
          return;
        }
        if (ws.repositories.length === 0) {
          body.append(
            emptyState(
              "No accessible repositories",
              "Grant the LILOs GitHub App access to the client's website repository.",
            ),
          );
          return;
        }

        const repositorySelect = createSelectControl(
          "github-publishing-repository",
          "Publishing repository",
          ws.repositories.map((repository) => ({
            value: repository.repository_id,
            label: repository.name,
          })),
          ws.repositories.length === 1 ? ws.repositories[0].repository_id : "",
          "Select repository…",
        );
        const pathControl = document.createElement("label");
        pathControl.className = "ui-control";
        const pathLabel = document.createElement("span");
        pathLabel.className = "ui-control__label";
        pathLabel.textContent = "Allowed content path";
        const pathInput = document.createElement("input");
        pathInput.className = "ui-input";
        pathInput.value = "src/content/blog";
        pathInput.required = true;
        pathControl.append(pathLabel, pathInput);
        const feedback = document.createElement("div");
        const saveButton = document.createElement("button");
        saveButton.type = "button";
        saveButton.className = "ui-button ui-button--primary ui-button--md";
        saveButton.textContent = "Use repository for publishing";
        body.append(repositorySelect.root, pathControl, saveButton, feedback);

        saveButton.addEventListener("click", async () => {
          const repository = ws.repositories.find(
            (item) => item.repository_id === repositorySelect.input.value,
          );
          if (!repository || !pathInput.value.trim()) {
            feedback.replaceChildren(
              errorAlert(
                "Select a repository and enter an allowed content path.",
              ),
            );
            return;
          }
          saveButton.disabled = true;
          saveButton.textContent = "Saving…";
          const result = await createPublishingTarget(organizationId, {
            key: "primary-site",
            connectionId: ws.connection_id!,
            repositoryId: repository.repository_id,
            baseBranch: repository.default_branch || "main",
            allowedPathPrefix: pathInput.value.trim(),
          });
          if (result.kind === "ok") {
            const target: PublishingTarget = result.data;
            feedback.replaceChildren(
              statusBadge(
                "ready",
                `${target.key} publishing target configured`,
              ),
            );
            repositorySelect.input.disabled = true;
            pathInput.disabled = true;
            saveButton.remove();
          } else {
            saveButton.disabled = false;
            saveButton.textContent = "Use repository for publishing";
            feedback.replaceChildren(
              errorAlert(describeFailure(result, "publishing target")),
            );
          }
        });
      }

      async function performGitHubDisconnect(): Promise<void> {
        const result = await disconnectGitHub(organizationId);
        if (result.kind === "ok") {
          await openGitHub(await fetchGitHubWorkspace(organizationId));
        } else {
          providerContent.append(
            errorAlert(describeFailure(result, "GitHub disconnect")),
          );
        }
      }

      function makeCard(title: string): HTMLDivElement {
        const card = document.createElement("div");
        card.className = "ui-card";
        const header = document.createElement("div");
        header.className = "ui-card__header";
        const titleEl = document.createElement("h3");
        titleEl.className = "ui-card__heading";
        titleEl.textContent = title;
        header.append(titleEl);
        card.append(header);
        const body = document.createElement("div");
        body.className = "ui-card__body";
        card.append(body);
        return card;
      }

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;
        showDirectory();
        await renderDirectory();
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Integrations");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
        if (
          new URLSearchParams(window.location.search).get("connected") === "1"
        ) {
          await openGoogle();
        }
      }

      void boot();
    </script>
  </body>
</html>
