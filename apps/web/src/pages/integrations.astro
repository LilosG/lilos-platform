---
import AppShell from "../components/AppShell.astro";
import {
  Button,
  CardGrid,
  EmptyState,
  PageHeader,
  PageShell,
  Region,
  Skeleton,
} from "../lib/ui/primitives";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs integrations" />
    <title>Integrations · LILOs</title>
  </head>
  <body>
    <AppShell>
      <PageShell id="boot-not-configured" width="narrow">
        <EmptyState
          heading="This deployment is not configured"
          description="Connect the platform runtime configuration to enable Integrations."
        />
      </PageShell>
      <PageShell id="boot-loading" width="narrow" hidden>
        <Skeleton lines={4} label="Loading integrations" />
      </PageShell>
      <Region
        id="boot-error"
        as="div"
        role="alert"
        label="Integrations error"
        hidden
      />
      <PageShell id="workspace-empty" width="narrow" hidden>
        <EmptyState
          heading="No organization access yet"
          description="Your account is not a member of any organization. Ask an administrator to invite you."
        />
      </PageShell>

      <PageShell id="integrations-content" hidden>
        <Region id="connections" as="section" labelledBy="integrations-title">
          <PageHeader
            eyebrow="Manage"
            title="Integrations"
            titleId="integrations-title"
            description="Authorize provider accounts, map the correct client resources, and verify that source data is actually syncing."
          />
          <CardGrid id="integration-cards" />
        </Region>

        <Region
          id="provider-workspace"
          as="section"
          labelledBy="provider-title"
          hidden
        >
          <PageHeader
            eyebrow="Integrations"
            title="—"
            titleId="provider-title"
            description="Loading provider details."
            descriptionId="provider-description"
          >
            <Button
              slot="actions"
              variant="secondary"
              size="sm"
              id="back-to-integrations">Back to Integrations</Button
            >
          </PageHeader>
          <Region
            id="provider-content"
            as="div"
            label="Provider details"
            class="ui-region--flow"
          />
        </Region>
      </PageShell>
    </AppShell>

    <script>
      import {
        beginConnection,
        connectGoogle,
        disconnectConnection,
        fetchConnectionStatus,
        describeGbpConnectFailure,
        googleAuthorizationAction,
      } from "../lib/gbp-connection";
      import {
        confirmGbpMappingAndReconcile,
        discoverGoogleResourcesAndReconcile,
        gbpWriteGovernanceFor,
        removeGbpMappingAndReconcile,
        REMOVE_GBP_MAPPING_CONFIRMATION,
      } from "../lib/google-workspace-governance";
      import { beginGitHubInstall, disconnectGitHub } from "../lib/github-app";
      import {
        fetchGoogleWorkspace,
        fetchUnmappedResources,
        fetchGitHubWorkspace,
        type GitHubWorkspace,
        type GoogleWorkspace,
      } from "../lib/integrations";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        emptyState,
        errorAlert,
        describeFailure,
        formatTimestamp,
        confirmInline,
        canUsePlatformAdministration,
        createSelectControl,
        type BootRegions,
      } from "../lib/ui";
      import { statusLabel } from "../lib/status-language";
      import { fetchLocations, type LocationSummary } from "../lib/workspace";
      import { reconcileBusinessFacts } from "../lib/administration";
      import {
        createPublishingTarget,
        type PublishingTarget,
      } from "../lib/content";
      import {
        fetchWebsites,
        fetchSearchProperties,
        type SEOWebsite,
      } from "../lib/seo";
      import {
        discoverSearchConsole,
        fetchSearchConsolePerformance,
        mapSearchConsole,
        searchConsoleReportHasData,
        syncSearchConsole,
      } from "../lib/search-console";
      import {
        analyticsReportHasData,
        discoverAnalytics,
        fetchAnalyticsPerformance,
        mapAnalytics,
        syncAnalytics,
      } from "../lib/analytics";

      let organizationId = "";

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("integrations-content")!,
      };
      const directory = document.getElementById("connections")!;
      const providerView = document.getElementById("provider-workspace")!;
      const providerTitle = document.getElementById("provider-title")!;
      const providerDesc = document.getElementById("provider-description")!;
      const providerContent = document.getElementById("provider-content")!;

      const PROVIDER_DESCRIPTIONS: Record<string, string> = {
        google:
          "Google account authorization, Business Profile mappings, Search Console, and Analytics source status.",
        github: "GitHub repository connections for content publishing.",
      };

      function isGitHubConnected(
        workspace: GitHubWorkspace | null | undefined,
      ): boolean {
        return (
          workspace?.connection_status === "connected" ||
          workspace?.connection_status === "active"
        );
      }

      function createLoading(): HTMLDivElement {
        const element = document.createElement("div");
        element.className = "ui-skeleton-group";
        element.textContent = "Loading…";
        return element;
      }

      function makeCard(title: string): HTMLDivElement {
        const card = document.createElement("div");
        card.className = "ui-card";
        const header = document.createElement("div");
        header.className = "ui-card__header";
        const heading = document.createElement("h3");
        heading.className = "ui-card__heading";
        heading.textContent = title;
        header.append(heading);
        const body = document.createElement("div");
        body.className = "ui-card__body";
        card.append(header, body);
        return card;
      }

      function appendSourceFact(
        parent: HTMLElement,
        label: string,
        value: string,
        state?: "ready" | "setup" | "blocked" | "neutral",
      ): void {
        const row = document.createElement("div");
        row.className = "ui-inline ui-inline--center";
        const copy = document.createElement("div");
        const heading = document.createElement("strong");
        heading.textContent = label;
        const detail = document.createElement("p");
        detail.className = "ui-text-secondary";
        detail.textContent = value;
        copy.append(heading, detail);
        row.append(copy);
        if (state) row.append(statusBadge(state, value));
        parent.append(row);
      }

      function freshnessTone(
        freshness: string,
      ): "ready" | "setup" | "blocked" | "neutral" {
        if (freshness === "fresh") return "ready";
        if (freshness === "stale" || freshness === "error") return "blocked";
        if (freshness === "never_synced") return "setup";
        return "neutral";
      }

      function showDirectory(): void {
        directory.hidden = false;
        providerView.hidden = true;
      }

      function showProvider(key: string, name: string): void {
        directory.hidden = true;
        providerView.hidden = false;
        providerTitle.textContent = name;
        providerDesc.textContent = PROVIDER_DESCRIPTIONS[key] || "";
        providerContent.replaceChildren(createLoading());
      }

      document
        .getElementById("back-to-integrations")!
        .addEventListener("click", () => {
          showDirectory();
          void renderDirectory();
        });

      async function renderDirectory(): Promise<void> {
        const cards = document.getElementById("integration-cards")!;
        cards.replaceChildren(createLoading());
        const [googleResult, githubResult] = await Promise.all([
          fetchConnectionStatus(organizationId),
          fetchGitHubWorkspace(organizationId),
        ]);
        cards.replaceChildren();
        cards.append(
          makeDirectoryCard(
            "google",
            "Google",
            "Business Profile, Search Console, and Analytics",
            googleResult.kind === "ok" &&
              googleResult.data?.status === "connected"
              ? "connected"
              : googleResult.kind === "ok" &&
                  googleResult.data?.status === "reconnect_required"
                ? "degraded"
                : googleResult.kind === "error" &&
                    googleResult.code === "INTEGRATION_NOT_CONFIGURED"
                  ? "not_configured"
                  : "not_connected",
            () => void openGoogle(),
          ),
        );
        const githubStatus =
          githubResult.kind === "ok" && isGitHubConnected(githubResult.data)
            ? "connected"
            : "not_connected";
        cards.append(
          makeDirectoryCard(
            "github",
            "GitHub",
            "Content publishing via GitHub repositories",
            githubStatus,
            () => void openGitHub(githubResult),
          ),
        );
      }

      function makeDirectoryCard(
        key: string,
        name: string,
        description: string,
        status: string,
        onClick: () => void,
      ): HTMLButtonElement {
        const card = document.createElement("button");
        card.className = "ui-card ui-card--interactive";
        card.type = "button";
        card.dataset.provider = key;
        card.addEventListener("click", onClick);
        const header = document.createElement("header");
        header.className = "ui-card__header";
        const title = document.createElement("h3");
        title.className = "ui-card__heading";
        title.textContent = name;
        header.append(title);
        const body = document.createElement("div");
        body.className = "ui-card__body";
        const descriptionNode = document.createElement("p");
        descriptionNode.className = "ui-card__description";
        descriptionNode.textContent = description;
        body.append(descriptionNode);
        const footer = document.createElement("footer");
        footer.className = "ui-card__footer";
        const badgeKind =
          status === "connected"
            ? "ready"
            : status === "degraded"
              ? "blocked"
              : status === "not_configured"
                ? "missing"
                : "setup";
        const label =
          status === "connected"
            ? "Authorized"
            : status === "degraded"
              ? "Needs attention"
              : status === "not_configured"
                ? "Not configured"
                : "Not authorized";
        footer.append(statusBadge(badgeKind, label));
        card.append(header, body, footer);
        return card;
      }

      async function openGoogle(): Promise<void> {
        showProvider("google", "Google");
        await loadGoogleWorkspace();
      }

      async function reloadGoogleWorkspace(): Promise<void> {
        await loadGoogleWorkspace();
      }

      async function reconcileGoogleSourceData(): Promise<void> {
        await reconcileBusinessFacts(organizationId);
        await reloadGoogleWorkspace();
      }

      async function loadGoogleWorkspace(): Promise<void> {
        providerContent.replaceChildren(createLoading());
        const [connectionResult, workspaceResult, locationsResult] =
          await Promise.all([
            fetchConnectionStatus(organizationId),
            fetchGoogleWorkspace(organizationId),
            fetchLocations(organizationId),
          ]);
        providerContent.replaceChildren();

        const connectionCard = makeCard("Google account authorization");
        providerContent.append(connectionCard);
        renderGoogleConnection(
          connectionCard.querySelector(".ui-card__body") as HTMLElement,
          connectionResult,
        );

        if (workspaceResult.kind !== "ok") {
          providerContent.append(
            errorAlert(describeFailure(workspaceResult, "Google workspace")),
          );
          return;
        }

        const workspace = workspaceResult.data;
        const platformLocations =
          locationsResult.kind === "ok" ? locationsResult.data : [];
        const capabilitiesCard = makeCard("Authorized Google services");
        providerContent.append(capabilitiesCard);
        renderCapabilities(
          capabilitiesCard.querySelector(".ui-card__body") as HTMLElement,
          workspace,
        );

        if (workspace.mapped_resources.length > 0) {
          const mappedCard = makeCard("Business Profile mappings");
          providerContent.append(mappedCard);
          renderMappedResources(
            mappedCard.querySelector(".ui-card__body") as HTMLElement,
            workspace,
            platformLocations,
          );
        }

        if (canUsePlatformAdministration()) {
          await renderUnmappedQueue(providerContent, workspaceResult);
        }

        if (
          workspace.capabilities.some(
            (capability) =>
              capability.key === "search_console" && capability.enabled,
          )
        ) {
          await renderSearchConsoleSource(providerContent);
        }

        if (
          workspace.capabilities.some(
            (capability) =>
              capability.key === "analytics" && capability.enabled,
          )
        ) {
          await renderAnalyticsSource(providerContent);
        }
      }

      function renderGoogleConnection(
        panel: HTMLElement,
        outcome: Awaited<ReturnType<typeof fetchConnectionStatus>>,
      ): void {
        panel.replaceChildren();
        if (
          outcome.kind === "error" &&
          outcome.code === "INTEGRATION_NOT_CONFIGURED"
        ) {
          panel.append(
            emptyState(
              "Google authorization is not configured",
              "This deployment has not been configured with Google OAuth credentials yet.",
            ),
          );
          return;
        }
        if (outcome.kind !== "ok") {
          panel.append(
            errorAlert(describeFailure(outcome, "Google authorization")),
          );
          return;
        }
        const state = outcome.data;
        if (state === null || state.status === "disconnected") {
          const connectButton = document.createElement("button");
          connectButton.type = "button";
          connectButton.className =
            "ui-button ui-button--primary ui-button--md";
          connectButton.textContent = "Authorize Google";
          connectButton.addEventListener("click", async () => {
            connectButton.disabled = true;
            connectButton.textContent = "Redirecting…";
            const result = await connectGoogle(organizationId, [
              "gbp",
              "search_console",
              "analytics",
            ]);
            if (result.kind === "ok") {
              window.location.assign(result.data.authorization_url);
            } else {
              connectButton.disabled = false;
              connectButton.textContent = "Authorize Google";
              panel.append(
                errorAlert(
                  describeGbpConnectFailure(result, organizationId).message,
                ),
              );
            }
          });
          panel.append(
            connectButton,
            Object.assign(document.createElement("p"), {
              className: "ui-text-secondary",
              textContent:
                "Authorization grants LILOs access to the selected Google services. Mapping and data sync happen separately below.",
            }),
          );
          return;
        }

        const badgeKind =
          state.status === "connected"
            ? "ready"
            : state.status === "reconnect_required"
              ? "blocked"
              : "setup";
        panel.append(
          statusBadge(
            badgeKind,
            state.status === "reconnect_required"
              ? "Reconnect required"
              : "Authorized",
          ),
        );
        if (state.last_verified_at) {
          panel.append(
            Object.assign(document.createElement("p"), {
              className: "ui-text-secondary",
              textContent: `Last verified ${formatTimestamp(state.last_verified_at)}`,
            }),
          );
        }

        const actions = document.createElement("div");
        actions.className = "ui-inline ui-inline--center";
        const authorizationAction = googleAuthorizationAction(state);
        if (authorizationAction.kind === "reconnect") {
          const reconnectButton = document.createElement("button");
          reconnectButton.type = "button";
          reconnectButton.className =
            "ui-button ui-button--primary ui-button--md";
          reconnectButton.textContent = "Reconnect Google";
          reconnectButton.addEventListener("click", async () => {
            const result = await beginConnection(organizationId);
            if (result.kind === "ok") {
              window.location.assign(result.data.authorization_url);
            } else {
              panel.append(errorAlert(describeFailure(result, "Reconnect")));
            }
          });
          actions.append(reconnectButton);
        }
        if (authorizationAction.kind === "authorize_missing") {
          const authorizeButton = document.createElement("button");
          authorizeButton.type = "button";
          authorizeButton.className =
            "ui-button ui-button--primary ui-button--md";
          authorizeButton.textContent = "Authorize missing services";
          authorizeButton.addEventListener("click", async () => {
            authorizeButton.disabled = true;
            const result = await connectGoogle(
              organizationId,
              authorizationAction.products,
            );
            if (result.kind === "ok") {
              window.location.assign(result.data.authorization_url);
            } else {
              authorizeButton.disabled = false;
              panel.append(
                errorAlert(describeFailure(result, "Google authorization")),
              );
            }
          });
          actions.append(authorizeButton);
        }
        if (
          (state.status === "connected" || state.status === "degraded") &&
          canUsePlatformAdministration()
        ) {
          const discoverButton = document.createElement("button");
          discoverButton.type = "button";
          discoverButton.className =
            "ui-button ui-button--primary ui-button--md";
          discoverButton.textContent = "Discover Business Profiles";
          discoverButton.addEventListener("click", async () => {
            discoverButton.disabled = true;
            discoverButton.textContent = "Discovering…";
            const result = await discoverGoogleResourcesAndReconcile(
              organizationId,
              reconcileGoogleSourceData,
            );
            if (result.kind !== "ok") {
              discoverButton.disabled = false;
              discoverButton.textContent = "Discover Business Profiles";
              panel.append(errorAlert(describeFailure(result, "Discovery")));
            }
          });
          actions.append(discoverButton);
        }
        if (state.status === "connected" || state.status === "degraded") {
          const disconnectButton = document.createElement("button");
          disconnectButton.type = "button";
          disconnectButton.className =
            "ui-button ui-button--secondary ui-button--md";
          disconnectButton.textContent = "Disconnect";
          disconnectButton.addEventListener("click", () => {
            disconnectButton.disabled = true;
            actions.append(
              confirmInline(
                "Disconnect Google? New syncs and provider actions will stop.",
                () => void performGoogleDisconnect(),
                () => {
                  disconnectButton.disabled = false;
                },
                "Disconnect Google",
              ),
            );
          });
          actions.append(disconnectButton);
        }
        panel.append(actions);
      }

      async function performGoogleDisconnect(): Promise<void> {
        const result = await disconnectConnection(organizationId);
        if (result.kind === "ok") await reloadGoogleWorkspace();
        else {
          providerContent.append(
            errorAlert(describeFailure(result, "Disconnect")),
          );
        }
      }

      function renderCapabilities(
        panel: HTMLElement,
        workspace: GoogleWorkspace,
      ): void {
        const explanation = document.createElement("p");
        explanation.className = "ui-text-secondary";
        explanation.textContent =
          "Authorized means the Google account granted LILOs access. It does not mean the client resource is mapped or that data has synced.";
        panel.append(explanation);
        const list = document.createElement("ul");
        list.className = "ui-record-list";
        for (const capability of workspace.capabilities) {
          const item = document.createElement("li");
          const name = document.createElement("h3");
          name.textContent = capability.label;
          item.append(
            name,
            statusBadge(
              capability.enabled ? "ready" : "setup",
              capability.enabled ? "Authorized" : "Not authorized",
            ),
          );
          list.append(item);
        }
        panel.append(list);
      }

      function renderMappedResources(
        panel: HTMLElement,
        workspace: GoogleWorkspace,
        platformLocations: LocationSummary[],
      ): void {
        const locationNames = new Map(
          platformLocations.map((location) => [location.id, location.name]),
        );
        const mappedCounts = new Map<string, number>();
        for (const resource of workspace.mapped_resources) {
          if (!resource.platform_resource_id) continue;
          mappedCounts.set(
            resource.platform_resource_id,
            (mappedCounts.get(resource.platform_resource_id) ?? 0) + 1,
          );
        }
        const duplicateLocationIds = new Set(
          [...mappedCounts.entries()]
            .filter(([, count]) => count > 1)
            .map(([locationId]) => locationId),
        );
        if (duplicateLocationIds.size > 0) {
          panel.append(
            errorAlert(
              "More than one Business Profile is mapped to the same LILOs location. Keep the correct profile and remove the incorrect mapping below.",
            ),
          );
        }
        const explanation = document.createElement("p");
        explanation.className = "ui-text-secondary";
        explanation.textContent =
          "A Business Profile is a Google provider resource mapped to a LILOs location. It is not an additional LILOs location.";
        panel.append(explanation);

        const list = document.createElement("ul");
        list.className = "ui-record-list";
        for (const resource of workspace.mapped_resources) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent =
            resource.display_name || resource.external_resource_id;
          const detail = document.createElement("p");
          const mappedTo = resource.platform_resource_id
            ? (locationNames.get(resource.platform_resource_id) ??
              "Unknown LILOs location")
            : "No LILOs location";
          detail.textContent = `Mapped to LILOs location: ${mappedTo}`;
          if (resource.last_synced_at) {
            detail.textContent += ` · Last sync ${formatTimestamp(resource.last_synced_at)}`;
          }
          const feedback = document.createElement("div");
          feedback.className = "ui-stack ui-stack--2";
          info.append(name, detail, feedback);

          const actions = document.createElement("div");
          actions.className = "ui-inline ui-inline--center ui-inline--tight";
          actions.append(
            statusBadge(
              freshnessTone(resource.sync_freshness),
              resource.sync_freshness === "fresh"
                ? "Synced"
                : resource.sync_freshness === "stale"
                  ? "Stale"
                  : "Sync pending",
            ),
          );
          const governance = gbpWriteGovernanceFor(
            resource,
            canUsePlatformAdministration(),
          );
          if (governance !== null) {
            actions.append(
              statusBadge(governance.stateKind, governance.stateLabel),
            );
            if (
              governance.actionLabel !== null &&
              governance.confirmationMessage !== null &&
              governance.desiredWriteEnabled !== null &&
              resource.platform_resource_id !== null &&
              resource.gbp_location_id !== null
            ) {
              const action = document.createElement("button");
              action.type = "button";
              action.className = "ui-button ui-button--secondary ui-button--sm";
              action.textContent = governance.actionLabel;
              action.addEventListener("click", () => {
                action.disabled = true;
                feedback.replaceChildren(
                  confirmInline(
                    governance.confirmationMessage!,
                    () => {
                      void (async () => {
                        const result = await confirmGbpMappingAndReconcile(
                          organizationId,
                          resource.platform_resource_id!,
                          resource.gbp_location_id!,
                          governance.desiredWriteEnabled!,
                          reconcileGoogleSourceData,
                        );
                        if (result.kind !== "ok") {
                          action.disabled = false;
                          feedback.replaceChildren(
                            errorAlert(
                              describeFailure(result, "provider-write access"),
                            ),
                          );
                        }
                      })();
                    },
                    () => {
                      action.disabled = false;
                    },
                    governance.actionLabel!,
                  ),
                );
              });
              actions.append(action);
            }
          }
          if (
            canUsePlatformAdministration() &&
            resource.platform_resource_id !== null &&
            resource.gbp_location_id !== null
          ) {
            const removeButton = document.createElement("button");
            removeButton.type = "button";
            removeButton.className =
              "ui-button ui-button--secondary ui-button--sm";
            removeButton.textContent = "Remove mapping";
            removeButton.addEventListener("click", () => {
              removeButton.disabled = true;
              feedback.replaceChildren(
                confirmInline(
                  REMOVE_GBP_MAPPING_CONFIRMATION,
                  () => {
                    void (async () => {
                      const result = await removeGbpMappingAndReconcile(
                        organizationId,
                        resource.platform_resource_id!,
                        resource.gbp_location_id!,
                        reconcileGoogleSourceData,
                      );
                      if (result.kind !== "ok") {
                        removeButton.disabled = false;
                        feedback.replaceChildren(
                          errorAlert(describeFailure(result, "remove mapping")),
                        );
                      }
                    })();
                  },
                  () => {
                    removeButton.disabled = false;
                  },
                  "Remove mapping",
                ),
              );
            });
            actions.append(removeButton);
          }
          item.append(info, actions);
          list.append(item);
        }
        panel.append(list);
      }

      async function renderUnmappedQueue(
        parent: HTMLElement,
        workspaceResult: Awaited<ReturnType<typeof fetchGoogleWorkspace>>,
      ): Promise<void> {
        if (
          workspaceResult.kind !== "ok" ||
          workspaceResult.data.unmapped_count === 0
        ) {
          return;
        }
        const disclosure = document.createElement("details");
        disclosure.className = "ui-card";
        const summary = document.createElement("summary");
        summary.className = "ui-card__header";
        summary.textContent = "Find another Business Profile";
        const body = document.createElement("div");
        body.className = "ui-card__body";
        const guidance = document.createElement("p");
        guidance.className = "ui-text-secondary";
        guidance.textContent =
          "Search the connected Google account only when you need to replace or add a Business Profile. Other clients are not shown by default.";
        const searchInput = document.createElement("input");
        searchInput.type = "search";
        searchInput.placeholder = "Search Business Profiles by business name…";
        searchInput.className = "ui-input";
        const resultContainer = document.createElement("div");
        resultContainer.append(
          emptyState(
            "Search to find a Business Profile",
            "Enter at least 3 characters.",
          ),
        );
        body.append(guidance, searchInput, resultContainer);
        disclosure.append(summary, body);
        parent.append(disclosure);

        const locationsResult = await fetchLocations(organizationId);
        const availableLocations =
          locationsResult.kind === "ok" ? locationsResult.data : [];
        let debounceTimer: ReturnType<typeof setTimeout>;
        searchInput.addEventListener("input", () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            const query = searchInput.value.trim();
            if (query.length < 3) {
              resultContainer.replaceChildren(
                emptyState(
                  "Search to find a Business Profile",
                  "Enter at least 3 characters.",
                ),
              );
              return;
            }
            void loadUnmappedProfiles(
              query,
              availableLocations,
              resultContainer,
            );
          }, 300);
        });
      }

      async function loadUnmappedProfiles(
        query: string,
        availableLocations: LocationSummary[],
        container: HTMLElement,
      ): Promise<void> {
        container.replaceChildren(createLoading());
        const result = await fetchUnmappedResources(organizationId, query);
        if (result.kind !== "ok") {
          container.replaceChildren(
            errorAlert(describeFailure(result, "Business Profile search")),
          );
          return;
        }
        if (!result.data.length) {
          container.replaceChildren(
            emptyState(
              "No matching Business Profiles",
              "Try a more specific business name.",
            ),
          );
          return;
        }
        const list = document.createElement("ul");
        list.className = "ui-record-list";
        for (const resource of result.data) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = resource.display_name;
          const detail = document.createElement("p");
          detail.textContent = resource.primary_category || "";
          const locationSelect = createSelectControl(
            `mapping-location-${resource.id}`,
            "LILOs location",
            availableLocations.map((location) => ({
              value: location.id,
              label: location.name,
            })),
            availableLocations.length === 1 ? availableLocations[0].id : "",
            "Select location…",
          );
          const mapButton = document.createElement("button");
          mapButton.type = "button";
          mapButton.className = "ui-button ui-button--primary ui-button--sm";
          mapButton.textContent = "Map";
          mapButton.addEventListener("click", async () => {
            const locationId = locationSelect.input.value;
            if (!locationId) {
              item.append(errorAlert("Select a LILOs location first."));
              return;
            }
            mapButton.disabled = true;
            mapButton.textContent = "Mapping…";
            const mapResult = await confirmGbpMappingAndReconcile(
              organizationId,
              locationId,
              resource.id,
              false,
              reconcileGoogleSourceData,
            );
            if (mapResult.kind !== "ok") {
              mapButton.disabled = false;
              mapButton.textContent = "Map";
              item.append(errorAlert(describeFailure(mapResult, "mapping")));
            }
          });
          info.append(name, detail, locationSelect.root, mapButton);
          item.append(info);
          list.append(item);
        }
        container.replaceChildren(list);
      }

      async function renderSearchConsoleSource(
        parent: HTMLElement,
      ): Promise<void> {
        const card = makeCard("Search Console");
        const body = card.querySelector(".ui-card__body") as HTMLElement;
        parent.append(card);
        const websitesResult = await fetchWebsites(organizationId);
        if (websitesResult.kind !== "ok") {
          body.append(
            errorAlert(describeFailure(websitesResult, "SEO websites")),
          );
          return;
        }
        if (!websitesResult.data.length) {
          body.append(
            emptyState(
              "No website configured",
              "Add the client's domain in onboarding before mapping Search Console.",
            ),
          );
          return;
        }

        const websiteSelect = createSelectControl(
          "search-console-website",
          "Website",
          websitesResult.data.map((website) => ({
            value: website.id,
            label: `${website.name} · ${website.canonical_origin}`,
          })),
          websitesResult.data.length === 1 ? websitesResult.data[0].id : "",
          "Select website…",
        );
        const statusRegion = document.createElement("div");
        statusRegion.className = "ui-stack ui-stack--3";
        body.append(websiteSelect.root, statusRegion);
        const refresh = (): void => {
          const website = websitesResult.data.find(
            (item) => item.id === websiteSelect.input.value,
          );
          if (!website) {
            statusRegion.replaceChildren(
              emptyState(
                "Select a website",
                "Choose the website whose Search Console data should be used.",
              ),
            );
            return;
          }
          void renderSearchConsoleWebsiteStatus(website, statusRegion);
        };
        websiteSelect.input.addEventListener("change", refresh);
        refresh();
      }

      async function renderSearchConsoleWebsiteStatus(
        website: SEOWebsite,
        region: HTMLElement,
      ): Promise<void> {
        region.replaceChildren(createLoading());
        const [propertiesResult, performanceResult] = await Promise.all([
          fetchSearchProperties(organizationId, website.id),
          fetchSearchConsolePerformance(organizationId, website.id),
        ]);
        region.replaceChildren();
        if (propertiesResult.kind !== "ok") {
          region.append(
            errorAlert(
              describeFailure(propertiesResult, "Search Console mapping"),
            ),
          );
          return;
        }
        const mapped = propertiesResult.data.find(
          (property) =>
            property.provider === "google_search_console" &&
            property.mapping_status === "mapped",
        );
        if (!mapped) {
          appendSourceFact(region, "Mapping", "Not mapped", "setup");
          appendSourceFact(region, "Data", "No Search Console data", "setup");
        } else {
          appendSourceFact(region, "Mapping", "Mapped", "ready");
          appendSourceFact(region, "Property", mapped.external_property_id);
          appendSourceFact(
            region,
            "Sync",
            mapped.last_synced_at
              ? `Last successful sync ${formatTimestamp(mapped.last_synced_at)}`
              : "Never synced",
            freshnessTone(mapped.freshness_status),
          );
          const dataReady =
            performanceResult.kind === "ok" &&
            searchConsoleReportHasData(performanceResult.data);
          appendSourceFact(
            region,
            "Data",
            dataReady
              ? "Available in SEO and Insights"
              : "No synced report data",
            dataReady ? "ready" : "setup",
          );
        }

        if (!canUsePlatformAdministration()) return;
        const feedback = document.createElement("div");
        feedback.className = "ui-stack ui-stack--2";
        const actions = document.createElement("div");
        actions.className = "ui-inline ui-inline--center";
        if (mapped) {
          const syncButton = document.createElement("button");
          syncButton.type = "button";
          syncButton.className = "ui-button ui-button--primary ui-button--sm";
          syncButton.textContent = "Sync now";
          syncButton.addEventListener("click", async () => {
            syncButton.disabled = true;
            syncButton.textContent = "Syncing…";
            const result = await syncSearchConsole(
              organizationId,
              website.id,
              mapped.id,
            );
            if (result.kind === "ok") {
              await renderSearchConsoleWebsiteStatus(website, region);
            } else {
              syncButton.disabled = false;
              syncButton.textContent = "Sync now";
              feedback.replaceChildren(
                errorAlert(describeFailure(result, "Search Console sync")),
              );
            }
          });
          actions.append(syncButton);
        }
        const discoverButton = document.createElement("button");
        discoverButton.type = "button";
        discoverButton.className =
          "ui-button ui-button--secondary ui-button--sm";
        discoverButton.textContent = mapped
          ? "Change property"
          : "Find property";
        discoverButton.addEventListener("click", async () => {
          await renderSearchConsoleDiscovery(website, feedback);
        });
        actions.append(discoverButton);
        region.append(actions, feedback);
      }

      async function renderSearchConsoleDiscovery(
        website: SEOWebsite,
        region: HTMLElement,
      ): Promise<void> {
        region.replaceChildren(createLoading());
        const discovery = await discoverSearchConsole(
          organizationId,
          website.id,
        );
        if (discovery.kind !== "ok") {
          region.replaceChildren(
            errorAlert(describeFailure(discovery, "Search Console discovery")),
          );
          return;
        }
        if (!discovery.data.properties.length) {
          region.replaceChildren(
            emptyState(
              "No accessible Search Console properties",
              "Confirm this Google account can access the client's property.",
            ),
          );
          return;
        }
        const propertySelect = createSelectControl(
          "search-console-property",
          "Search Console property",
          discovery.data.properties.map((property) => ({
            value: `${property.property_type}\t${property.external_property_id}`,
            label: `${property.external_property_id} · ${property.permission_level}`,
          })),
          discovery.data.recommended
            ? `${discovery.data.recommended.property_type}\t${discovery.data.recommended.external_property_id}`
            : "",
          "Select property…",
        );
        const mapButton = document.createElement("button");
        mapButton.type = "button";
        mapButton.className = "ui-button ui-button--primary ui-button--sm";
        mapButton.textContent = "Map and sync";
        mapButton.addEventListener("click", async () => {
          const [propertyType, externalPropertyId] =
            propertySelect.input.value.split("\t", 2);
          if (
            !externalPropertyId ||
            (propertyType !== "domain" && propertyType !== "url_prefix")
          ) {
            region.append(
              errorAlert("Select a Search Console property first."),
            );
            return;
          }
          mapButton.disabled = true;
          mapButton.textContent = "Mapping…";
          const mapped = await mapSearchConsole(organizationId, website.id, {
            external_property_id: externalPropertyId,
            property_type: propertyType,
          });
          if (mapped.kind !== "ok") {
            mapButton.disabled = false;
            mapButton.textContent = "Map and sync";
            region.append(
              errorAlert(describeFailure(mapped, "Search Console mapping")),
            );
            return;
          }
          const properties = await fetchSearchProperties(
            organizationId,
            website.id,
          );
          const mappedProperty =
            properties.kind === "ok"
              ? properties.data.find(
                  (property) =>
                    property.mapping_status === "mapped" &&
                    property.external_property_id === externalPropertyId,
                )
              : undefined;
          if (!mappedProperty) {
            region.replaceChildren(
              errorAlert(
                "Search Console property was mapped, but LILOs could not resolve the new mapping for its first sync. Reload and use Sync now.",
              ),
            );
            return;
          }
          mapButton.textContent = "Syncing…";
          const synced = await syncSearchConsole(
            organizationId,
            website.id,
            mappedProperty.id,
          );
          if (synced.kind === "ok") {
            await reloadGoogleWorkspace();
          } else {
            region.replaceChildren(
              errorAlert(
                `Property mapped, but the first sync failed. ${describeFailure(synced, "Search Console sync")}`,
              ),
            );
          }
        });
        region.replaceChildren(propertySelect.root, mapButton);
      }

      async function renderAnalyticsSource(parent: HTMLElement): Promise<void> {
        const card = makeCard("Google Analytics 4");
        const body = card.querySelector(".ui-card__body") as HTMLElement;
        parent.append(card);
        const performance = await fetchAnalyticsPerformance(organizationId);
        if (performance.kind !== "ok") {
          body.append(
            errorAlert(describeFailure(performance, "Google Analytics")),
          );
          return;
        }
        const mappedProperties = performance.data.properties;
        if (!mappedProperties.length) {
          appendSourceFact(body, "Mapping", "Not mapped", "setup");
          appendSourceFact(body, "Data", "No Analytics data", "setup");
        } else {
          appendSourceFact(body, "Mapping", "Mapped", "ready");
          for (const property of mappedProperties) {
            const propertyBlock = document.createElement("div");
            propertyBlock.className = "ui-stack ui-stack--2";
            appendSourceFact(
              propertyBlock,
              property.display_name,
              property.external_property_id,
            );
            appendSourceFact(
              propertyBlock,
              "Sync",
              property.last_synced_at
                ? `Last successful sync ${formatTimestamp(property.last_synced_at)}`
                : "Never synced",
              freshnessTone(property.freshness_status),
            );
            if (canUsePlatformAdministration()) {
              const syncButton = document.createElement("button");
              syncButton.type = "button";
              syncButton.className =
                "ui-button ui-button--secondary ui-button--sm";
              syncButton.textContent = "Sync now";
              const feedback = document.createElement("div");
              syncButton.addEventListener("click", async () => {
                syncButton.disabled = true;
                syncButton.textContent = "Syncing…";
                const result = await syncAnalytics(organizationId, property.id);
                if (result.kind === "ok") await reloadGoogleWorkspace();
                else {
                  syncButton.disabled = false;
                  syncButton.textContent = "Sync now";
                  feedback.replaceChildren(
                    errorAlert(describeFailure(result, "Analytics sync")),
                  );
                }
              });
              propertyBlock.append(syncButton, feedback);
            }
            body.append(propertyBlock);
          }
          const dataReady = analyticsReportHasData(performance.data);
          appendSourceFact(
            body,
            "Data",
            dataReady ? "Available in Insights" : "No synced report data",
            dataReady ? "ready" : "setup",
          );
        }
        if (!canUsePlatformAdministration()) return;
        const discoveryRegion = document.createElement("div");
        discoveryRegion.className = "ui-stack ui-stack--3";
        const discoverButton = document.createElement("button");
        discoverButton.type = "button";
        discoverButton.className =
          "ui-button ui-button--secondary ui-button--sm";
        discoverButton.textContent = mappedProperties.length
          ? "Find another Analytics property"
          : "Find Analytics property";
        discoverButton.addEventListener("click", async () => {
          discoverButton.disabled = true;
          discoverButton.textContent = "Discovering…";
          const websites = await fetchWebsites(organizationId);
          const websiteId =
            websites.kind === "ok" && websites.data.length === 1
              ? websites.data[0].id
              : undefined;
          const discovery = await discoverAnalytics(organizationId, websiteId);
          discoverButton.disabled = false;
          discoverButton.textContent = mappedProperties.length
            ? "Find another Analytics property"
            : "Find Analytics property";
          if (discovery.kind !== "ok") {
            discoveryRegion.replaceChildren(
              errorAlert(describeFailure(discovery, "Analytics discovery")),
            );
            return;
          }
          if (!discovery.data.properties.length) {
            discoveryRegion.replaceChildren(
              emptyState(
                "No accessible Analytics properties",
                "Confirm this Google account can access the client's GA4 property.",
              ),
            );
            return;
          }
          const select = createSelectControl(
            "analytics-property",
            "Analytics property",
            discovery.data.properties.map((property) => ({
              value: property.external_property_id,
              label: `${property.display_name} · ${property.account_display_name}`,
            })),
            discovery.data.recommended?.external_property_id ?? "",
            "Select property…",
          );
          const mapButton = document.createElement("button");
          mapButton.type = "button";
          mapButton.className = "ui-button ui-button--primary ui-button--sm";
          mapButton.textContent = "Map and sync";
          mapButton.addEventListener("click", async () => {
            const selected = discovery.data.properties.find(
              (property) =>
                property.external_property_id === select.input.value,
            );
            if (!selected) {
              discoveryRegion.append(
                errorAlert("Select an Analytics property first."),
              );
              return;
            }
            mapButton.disabled = true;
            mapButton.textContent = "Mapping…";
            const mapped = await mapAnalytics(organizationId, {
              external_property_id: selected.external_property_id,
              property_number: selected.property_number,
              display_name: selected.display_name,
            });
            if (mapped.kind !== "ok") {
              mapButton.disabled = false;
              mapButton.textContent = "Map and sync";
              discoveryRegion.append(
                errorAlert(describeFailure(mapped, "Analytics mapping")),
              );
              return;
            }
            const refreshed = await fetchAnalyticsPerformance(organizationId);
            const mappedProperty =
              refreshed.kind === "ok"
                ? refreshed.data.properties.find(
                    (property) =>
                      property.external_property_id ===
                      selected.external_property_id,
                  )
                : undefined;
            if (!mappedProperty) {
              discoveryRegion.replaceChildren(
                errorAlert(
                  "Analytics property was mapped, but LILOs could not resolve the new mapping for its first sync. Reload and use Sync now.",
                ),
              );
              return;
            }
            mapButton.textContent = "Syncing…";
            const synced = await syncAnalytics(
              organizationId,
              mappedProperty.id,
            );
            if (synced.kind === "ok") await reloadGoogleWorkspace();
            else {
              discoveryRegion.replaceChildren(
                errorAlert(
                  `Property mapped, but the first sync failed. ${describeFailure(synced, "Analytics sync")}`,
                ),
              );
            }
          });
          discoveryRegion.replaceChildren(select.root, mapButton);
        });
        body.append(discoverButton, discoveryRegion);
      }

      async function openGitHub(
        workspaceResult: Awaited<ReturnType<typeof fetchGitHubWorkspace>>,
      ): Promise<void> {
        showProvider("github", "GitHub");
        providerContent.replaceChildren();
        const connectionCard = makeCard("Connection");
        providerContent.append(connectionCard);
        const connectionBody = connectionCard.querySelector(
          ".ui-card__body",
        ) as HTMLElement;
        if (workspaceResult.kind !== "ok") {
          connectionBody.append(
            errorAlert(describeFailure(workspaceResult, "GitHub connection")),
          );
          return;
        }
        const workspace = workspaceResult.data;
        if (!isGitHubConnected(workspace)) {
          const installButton = document.createElement("button");
          installButton.type = "button";
          installButton.className =
            "ui-button ui-button--primary ui-button--md";
          installButton.textContent = "Install GitHub App";
          installButton.addEventListener("click", async () => {
            installButton.disabled = true;
            const result = await beginGitHubInstall(organizationId);
            if (result.kind === "ok") {
              window.location.assign(result.data.authorization_url);
            } else {
              installButton.disabled = false;
              connectionBody.append(
                errorAlert(describeFailure(result, "GitHub")),
              );
            }
          });
          connectionBody.append(installButton);
          return;
        }
        connectionBody.append(statusBadge("ready", "Connected"));
        connectionBody.append(
          Object.assign(document.createElement("p"), {
            className: "ui-text-secondary",
            textContent: `${workspace.repositories.length} accessible ${workspace.repositories.length === 1 ? "repository" : "repositories"}`,
          }),
        );
        const disconnectButton = document.createElement("button");
        disconnectButton.type = "button";
        disconnectButton.className =
          "ui-button ui-button--secondary ui-button--md";
        disconnectButton.textContent = "Disconnect GitHub App";
        disconnectButton.addEventListener("click", () => {
          disconnectButton.disabled = true;
          connectionBody.append(
            confirmInline(
              "Disconnect GitHub? New publishing and implementation work will stop.",
              () => void performGitHubDisconnect(),
              () => {
                disconnectButton.disabled = false;
              },
              "Disconnect GitHub",
            ),
          );
        });
        connectionBody.append(disconnectButton);

        if (workspace.repositories.length > 0) {
          const repositoriesCard = makeCard("Accessible repositories");
          providerContent.append(repositoriesCard);
          const repositoriesBody = repositoriesCard.querySelector(
            ".ui-card__body",
          ) as HTMLElement;
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const repository of workspace.repositories) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = repository.name;
            const detail = document.createElement("p");
            detail.textContent = `Default branch: ${repository.default_branch}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(
                repository.private ? "neutral" : "ready",
                repository.private ? "Private" : "Public",
              ),
            );
            list.append(item);
          }
          repositoriesBody.append(list);
        }
        renderGitHubPublishingTargets(providerContent, workspace);
      }

      function renderGitHubPublishingTargets(
        parent: HTMLElement,
        workspace: GitHubWorkspace,
      ): void {
        const card = makeCard("Publishing target");
        const body = card.querySelector(".ui-card__body") as HTMLElement;
        parent.append(card);
        if (workspace.publishing_targets.length > 0) {
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const target of workspace.publishing_targets) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = target.key;
            const detail = document.createElement("p");
            detail.textContent = `${target.repository_id} · ${target.base_branch} · ${target.allowed_path_prefix}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(
                target.status === "active" ? "ready" : "setup",
                statusLabel(target.status),
              ),
            );
            list.append(item);
          }
          body.append(list);
          return;
        }
        if (!canUsePlatformAdministration() || !workspace.connection_id) {
          body.append(
            emptyState(
              "No publishing target configured",
              "An administrator with elevated access can select the client's publishing repository.",
            ),
          );
          return;
        }
        if (!workspace.repositories.length) {
          body.append(
            emptyState(
              "No accessible repositories",
              "Grant the LILOs GitHub App access to the client's website repository.",
            ),
          );
          return;
        }
        const repositorySelect = createSelectControl(
          "github-publishing-repository",
          "Publishing repository",
          workspace.repositories.map((repository) => ({
            value: repository.repository_id,
            label: repository.name,
          })),
          workspace.repositories.length === 1
            ? workspace.repositories[0].repository_id
            : "",
          "Select repository…",
        );
        const pathControl = document.createElement("label");
        pathControl.className = "ui-control";
        const pathLabel = document.createElement("span");
        pathLabel.className = "ui-control__label";
        pathLabel.textContent = "Allowed content path";
        const pathInput = document.createElement("input");
        pathInput.className = "ui-input";
        pathInput.value = "src/content/blog";
        pathControl.append(pathLabel, pathInput);
        const feedback = document.createElement("div");
        const saveButton = document.createElement("button");
        saveButton.type = "button";
        saveButton.className = "ui-button ui-button--primary ui-button--md";
        saveButton.textContent = "Use repository for publishing";
        saveButton.addEventListener("click", async () => {
          const repository = workspace.repositories.find(
            (item) => item.repository_id === repositorySelect.input.value,
          );
          if (!repository || !pathInput.value.trim()) {
            feedback.replaceChildren(
              errorAlert(
                "Select a repository and enter an allowed content path.",
              ),
            );
            return;
          }
          saveButton.disabled = true;
          const result = await createPublishingTarget(organizationId, {
            key: "primary-site",
            connectionId: workspace.connection_id!,
            repositoryId: repository.repository_id,
            baseBranch: repository.default_branch || "main",
            allowedPathPrefix: pathInput.value.trim(),
          });
          if (result.kind === "ok") {
            const target: PublishingTarget = result.data;
            feedback.replaceChildren(
              statusBadge(
                "ready",
                `${target.key} publishing target configured`,
              ),
            );
            repositorySelect.input.disabled = true;
            pathInput.disabled = true;
            saveButton.remove();
          } else {
            saveButton.disabled = false;
            feedback.replaceChildren(
              errorAlert(describeFailure(result, "publishing target")),
            );
          }
        });
        body.append(repositorySelect.root, pathControl, saveButton, feedback);
      }

      async function performGitHubDisconnect(): Promise<void> {
        const result = await disconnectGitHub(organizationId);
        if (result.kind === "ok") {
          await openGitHub(await fetchGitHubWorkspace(organizationId));
        } else {
          providerContent.append(
            errorAlert(describeFailure(result, "GitHub disconnect")),
          );
        }
      }

      async function loadOrganization(
        organization: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(organization);
        organizationId = organization.organization_id;
        showDirectory();
        await renderDirectory();
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Integrations");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(
          result.organizations,
          (organization) => void loadOrganization(organization),
        );
        const organization =
          result.organizations.find(
            (item) => item.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(organization);
        if (
          new URLSearchParams(window.location.search).get("connected") === "1"
        ) {
          await openGoogle();
        }
      }

      void boot();
    </script>
  </body>
</html>
