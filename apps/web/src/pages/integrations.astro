---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs integrations" />
    <title>Integrations · LILOs</title>
  </head>
  <body>
    <AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1>
        <p>No Supabase or API connection is configured for this build.</p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p class="loading-state">Loading integrations…</p>
      </div>

      <div id="boot-error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <div class="empty-state">
          <span class="empty-state__icon" aria-hidden="true">○</span>
          <h3>No organization access yet</h3>
          <p>
            Your account is not a member of any organization. Ask an
            administrator to invite you.
          </p>
        </div>
      </div>

      <div id="integrations-content" hidden>
        <!-- Integrations directory -->
        <div id="integrations-directory">
          <div class="page-head">
            <div class="page-head__intro">
              <p class="eyebrow">Manage</p>
              <h1>Integrations</h1>
              <p>
                Connect external providers. Daily product pages consume these
                connections automatically.
              </p>
            </div>
          </div>

          <div class="directory-grid" id="integration-cards"></div>
        </div>

        <!-- Provider workspace (shown when a provider card is selected) -->
        <div id="provider-workspace" hidden>
          <div class="page-head">
            <div class="page-head__intro">
              <p class="eyebrow" id="provider-eyebrow">Integrations</p>
              <h1 id="provider-title">—</h1>
              <p id="provider-description"></p>
            </div>
            <div class="page-head__meta">
              <div class="page-head__actions">
                <button
                  type="button"
                  class="button button--secondary button--sm"
                  id="back-to-integrations">← Back to Integrations</button
                >
              </div>
            </div>
          </div>
          <div id="provider-content"></div>
        </div>
      </div>
    </AppShell>
    <script>
      import {
        beginConnection,
        disconnectConnection,
        fetchConnectionStatus,
        discoverResources,
        describeGbpConnectFailure,
      } from "../lib/gbp-connection";
      import {
        beginGitHubInstall,
        fetchGitHubRepositories,
      } from "../lib/github-app";
      import { fetchGitHubConnections } from "../lib/content";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        emptyState,
        errorAlert,
        describeFailure,
        formatTimestamp,
        type BootRegions,
      } from "../lib/ui";

      let organizationId = "";

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("integrations-content")!,
      };

      const directory = document.getElementById("integrations-directory")!;
      const providerView = document.getElementById("provider-workspace")!;
      const providerTitle = document.getElementById("provider-title")!;
      const providerDesc = document.getElementById("provider-description")!;
      const providerContent = document.getElementById("provider-content")!;

      function showDirectory(): void {
        directory.hidden = false;
        providerView.hidden = true;
      }

      function showProvider(title: string, description: string): void {
        directory.hidden = true;
        providerView.hidden = false;
        providerTitle.textContent = title;
        providerDesc.textContent = description;
        providerContent.replaceChildren();
        providerContent.append(createLoading());
      }

      function createLoading(): HTMLDivElement {
        const el = document.createElement("div");
        el.className = "loading-state";
        el.textContent = "Loading…";
        return el;
      }

      document
        .getElementById("back-to-integrations")!
        .addEventListener("click", showDirectory);

      async function renderDirectory(): Promise<void> {
        const cards = document.getElementById("integration-cards")!;
        cards.replaceChildren();

        const [googleResult, githubResult] = await Promise.all([
          fetchConnectionStatus(organizationId),
          fetchGitHubConnections(organizationId),
        ]);

        // Google card
        const googleCard = document.createElement("button");
        googleCard.className = "integration-card";
        googleCard.type = "button";
        googleCard.dataset.provider = "google";

        const googleHeader = document.createElement("div");
        googleHeader.className = "integration-card__header";
        const googleIcon = document.createElement("span");
        googleIcon.className = "integration-card__icon";
        googleIcon.textContent = "G";
        const googleTitle = document.createElement("div");
        googleTitle.className = "integration-card__title";
        googleTitle.textContent = "Google";
        googleHeader.append(googleIcon, googleTitle);

        const googleDesc = document.createElement("p");
        googleDesc.className = "integration-card__desc";
        googleDesc.textContent =
          "Business Profile, Search Console, and Analytics";

        const googleFooter = document.createElement("div");
        googleFooter.className = "integration-card__footer";

        if (
          googleResult.kind === "ok" &&
          googleResult.data &&
          googleResult.data.status === "connected"
        ) {
          googleFooter.append(statusBadge("ready", "Connected"));
        } else if (
          googleResult.kind === "ok" &&
          googleResult.data &&
          googleResult.data.status === "reconnect_required"
        ) {
          googleFooter.append(statusBadge("blocked", "Needs attention"));
        } else if (
          googleResult.kind === "error" &&
          googleResult.code === "INTEGRATION_NOT_CONFIGURED"
        ) {
          googleFooter.append(statusBadge("missing", "Not configured"));
        } else {
          googleFooter.append(statusBadge("setup", "Not connected"));
        }

        googleCard.append(googleHeader, googleDesc, googleFooter);
        googleCard.addEventListener(
          "click",
          () => void openGoogle(googleResult),
        );
        cards.append(googleCard);

        // GitHub card
        const githubCard = document.createElement("button");
        githubCard.className = "integration-card";
        githubCard.type = "button";
        githubCard.dataset.provider = "github";

        const ghHeader = document.createElement("div");
        ghHeader.className = "integration-card__header";
        const ghIcon = document.createElement("span");
        ghIcon.className = "integration-card__icon";
        ghIcon.textContent = "⌥";
        const ghTitle = document.createElement("div");
        ghTitle.className = "integration-card__title";
        ghTitle.textContent = "GitHub";
        ghHeader.append(ghIcon, ghTitle);

        const ghDesc = document.createElement("p");
        ghDesc.className = "integration-card__desc";
        ghDesc.textContent = "Content publishing via GitHub repositories";

        const ghFooter = document.createElement("div");
        ghFooter.className = "integration-card__footer";

        if (githubResult.kind === "ok" && githubResult.data.length > 0) {
          ghFooter.append(statusBadge("ready", "Connected"));
        } else {
          ghFooter.append(statusBadge("setup", "Not connected"));
        }

        githubCard.append(ghHeader, ghDesc, ghFooter);
        githubCard.addEventListener(
          "click",
          () => void openGitHub(githubResult),
        );
        cards.append(githubCard);
      }

      // ---- Google provider workspace ----
      async function openGoogle(
        connectionResult: Awaited<ReturnType<typeof fetchConnectionStatus>>,
      ): Promise<void> {
        showProvider(
          "Google",
          "Manage the Google connection for Business Profile, Search Console, and Analytics.",
        );
        const content = providerContent;
        content.replaceChildren();

        // Connection panel
        const connCard = document.createElement("div");
        connCard.className = "card";
        const connHeader = document.createElement("div");
        connHeader.className = "card__header";
        const connTitle = document.createElement("h3");
        connTitle.className = "card__title";
        connTitle.textContent = "Connection";
        connHeader.append(connTitle);
        connCard.append(connHeader);
        const connBody = document.createElement("div");
        connBody.className = "card__body";
        connCard.append(connBody);
        content.append(connCard);

        renderGoogleConnection(connBody, connectionResult);

        // Services panel
        const servicesCard = document.createElement("div");
        servicesCard.className = "card";
        const servicesHeader = document.createElement("div");
        servicesHeader.className = "card__header";
        const servicesTitle = document.createElement("h3");
        servicesTitle.className = "card__title";
        servicesTitle.textContent = "Connected Services";
        servicesHeader.append(servicesTitle);
        servicesCard.append(servicesHeader);
        const servicesBody = document.createElement("div");
        servicesBody.className = "card__body";
        servicesCard.append(servicesBody);
        content.append(servicesCard);

        if (
          connectionResult.kind === "ok" &&
          connectionResult.data &&
          connectionResult.data.services
        ) {
          const services = connectionResult.data.services;
          const list = document.createElement("ul");
          list.className = "product-list";
          for (const [name, enabled] of Object.entries(services)) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const sName = document.createElement("h3");
            sName.textContent =
              name === "gbp"
                ? "Business Profile"
                : name === "search_console"
                  ? "Search Console"
                  : name === "analytics"
                    ? "Analytics"
                    : name;
            info.append(sName);
            const badge = statusBadge(
              enabled ? "ready" : "setup",
              enabled ? "Enabled" : "Not enabled",
            );
            item.append(info, badge);
            list.append(item);
          }
          servicesBody.append(list);
        } else {
          servicesBody.append(
            emptyState(
              "No services connected",
              "Connect Google to discover and enable individual services.",
            ),
          );
        }
      }

      function renderGoogleConnection(
        panel: HTMLElement,
        outcome: Awaited<ReturnType<typeof fetchConnectionStatus>>,
      ): void {
        panel.replaceChildren();

        if (
          outcome.kind === "error" &&
          outcome.code === "INTEGRATION_NOT_CONFIGURED"
        ) {
          panel.append(
            emptyState(
              "Google connection is not configured",
              "This deployment has not been configured with Google OAuth credentials yet.",
            ),
          );
          return;
        }
        if (outcome.kind !== "ok") {
          panel.append(
            errorAlert(describeFailure(outcome, "Google connection")),
          );
          return;
        }

        const state = outcome.data;
        if (state === null || state.status === "disconnected") {
          const connectBtn = document.createElement("button");
          connectBtn.type = "button";
          connectBtn.className = "button";
          connectBtn.textContent = "Connect Google";
          connectBtn.addEventListener("click", async () => {
            connectBtn.disabled = true;
            connectBtn.textContent = "Connecting…";
            const result = await beginConnection(organizationId);
            if (result.kind === "ok") {
              window.location.assign(result.data.authorization_url);
            } else {
              connectBtn.disabled = false;
              connectBtn.textContent = "Connect Google";
              const desc = describeGbpConnectFailure(result, organizationId);
              panel.append(errorAlert(desc.message));
            }
          });
          panel.append(connectBtn);
          panel.append(
            Object.assign(document.createElement("p"), {
              className: "text-sm muted",
              textContent:
                "Connect your Google account to enable Business Profile, Search Console, and Analytics.",
            }),
          );
          return;
        }

        const badgeKind =
          state.status === "connected"
            ? "ready"
            : state.status === "reconnect_required"
              ? "blocked"
              : "setup";
        panel.append(statusBadge(badgeKind, state.status));

        if (state.last_verified_at) {
          const verified = document.createElement("p");
          verified.className = "text-sm muted";
          verified.textContent = `Last verified ${formatTimestamp(state.last_verified_at)}`;
          panel.append(verified);
        }

        const actions = document.createElement("div");
        actions.className = "form-actions";
        actions.style.borderTop = "none";
        actions.style.paddingTop = "0";
        actions.style.marginTop = "0.5rem";

        if (state.status === "reconnect_required") {
          const reconnectBtn = document.createElement("button");
          reconnectBtn.type = "button";
          reconnectBtn.className = "button";
          reconnectBtn.textContent = "Reconnect Google";
          reconnectBtn.addEventListener("click", async () => {
            const result = await beginConnection(organizationId);
            if (result.kind === "ok")
              window.location.assign(result.data.authorization_url);
            else panel.append(errorAlert(describeFailure(result, "Reconnect")));
          });
          actions.append(reconnectBtn);
        }

        if (state.status === "connected" || state.status === "degraded") {
          const discoverBtn = document.createElement("button");
          discoverBtn.type = "button";
          discoverBtn.className = "button";
          discoverBtn.textContent = "Discover accounts and locations";
          discoverBtn.addEventListener("click", async () => {
            discoverBtn.disabled = true;
            discoverBtn.textContent = "Discovering…";
            const result = await discoverResources(organizationId);
            if (result.kind === "ok") {
              discoverBtn.textContent = `Discovered ${result.data.accounts_discovered} account(s), ${result.data.locations_discovered} location(s)`;
            } else {
              discoverBtn.textContent = "Discover accounts and locations";
              discoverBtn.disabled = false;
              panel.append(errorAlert(describeFailure(result, "Discovery")));
            }
          });
          actions.append(discoverBtn);

          const disconnectBtn = document.createElement("button");
          disconnectBtn.type = "button";
          disconnectBtn.className = "button button--secondary";
          disconnectBtn.textContent = "Disconnect";
          disconnectBtn.addEventListener("click", async () => {
            const result = await disconnectConnection(organizationId);
            if (result.kind === "ok") {
              const refreshed = await fetchConnectionStatus(organizationId);
              renderGoogleConnection(panel, refreshed);
            } else {
              panel.append(errorAlert(describeFailure(result, "Disconnect")));
            }
          });
          actions.append(disconnectBtn);
        }

        panel.append(actions);
      }

      // ---- GitHub provider workspace ----
      async function openGitHub(
        connectionsResult: Awaited<ReturnType<typeof fetchGitHubConnections>>,
      ): Promise<void> {
        showProvider(
          "GitHub",
          "Connect GitHub for content publishing to repositories.",
        );
        const content = providerContent;
        content.replaceChildren();

        const connCard = document.createElement("div");
        connCard.className = "card";
        const connHeader = document.createElement("div");
        connHeader.className = "card__header";
        const connTitle = document.createElement("h3");
        connTitle.className = "card__title";
        connTitle.textContent = "Connection";
        connHeader.append(connTitle);
        connCard.append(connHeader);
        const connBody = document.createElement("div");
        connBody.className = "card__body";
        connCard.append(connBody);
        content.append(connCard);

        if (
          connectionsResult.kind !== "ok" ||
          connectionsResult.data.length === 0
        ) {
          const installBtn = document.createElement("button");
          installBtn.type = "button";
          installBtn.className = "button";
          installBtn.textContent = "Install GitHub App";
          installBtn.addEventListener("click", async () => {
            installBtn.disabled = true;
            installBtn.textContent = "Redirecting…";
            const result = await beginGitHubInstall(organizationId);
            if (result.kind === "ok") {
              window.location.assign(result.data.authorization_url);
            } else {
              installBtn.disabled = false;
              installBtn.textContent = "Install GitHub App";
              connBody.append(errorAlert(describeFailure(result, "GitHub")));
            }
          });
          connBody.append(installBtn);
          connBody.append(
            Object.assign(document.createElement("p"), {
              className: "text-sm muted",
              textContent:
                "Install the GitHub App to enable content publishing to your repositories.",
            }),
          );
          return;
        }

        const conn = connectionsResult.data[0];
        connBody.append(
          statusBadge(
            conn.status === "active" ? "ready" : "setup",
            conn.status,
          ),
        );
        if (conn.external_account_reference) {
          const ref = document.createElement("p");
          ref.className = "text-sm muted";
          ref.textContent = `Connected as ${conn.external_account_reference}`;
          connBody.append(ref);
        }

        // Repositories
        const reposResult = await fetchGitHubRepositories(organizationId);
        if (reposResult.kind === "ok" && reposResult.data.length > 0) {
          const reposCard = document.createElement("div");
          reposCard.className = "card";
          const reposHeader = document.createElement("div");
          reposHeader.className = "card__header";
          const reposTitle = document.createElement("h3");
          reposTitle.className = "card__title";
          reposTitle.textContent = "Accessible Repositories";
          reposHeader.append(reposTitle);
          reposCard.append(reposHeader);
          const reposBody = document.createElement("div");
          reposBody.className = "card__body";
          reposCard.append(reposBody);
          const list = document.createElement("ul");
          list.className = "product-list";
          for (const repo of reposResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = repo.name;
            const detail = document.createElement("p");
            detail.textContent = `Default branch: ${repo.default_branch}`;
            info.append(name, detail);
            const badge = statusBadge(
              repo.private ? "neutral" : "ready",
              repo.private ? "Private" : "Public",
            );
            item.append(info, badge);
            list.append(item);
          }
          reposBody.append(list);
          content.append(reposCard);
        }
      }

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;
        showDirectory();
        await renderDirectory();
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Integrations");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
