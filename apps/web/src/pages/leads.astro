---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content="LILOs Leads workspace" /><title>
      Leads · LILOs
    </title></head
  >
  <body
    ><AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1><p>
          No Supabase or API connection is configured for this build.
        </p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p>Loading Leads…</p>
      </div>

      <div id="boot-error" class="alert alert--error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <h1>No organization access yet</h1><p>
          Your account is not a member of any organization. Ask an administrator
          to invite you.
        </p>
      </div>

      <div id="leads-content" hidden>
        <div class="page-head">
          <div class="page-head__intro">
            <p class="eyebrow">Operations</p>
            <h1>Leads</h1>
            <p>
              Manage incoming leads, track lifecycle, and assign follow-up work.
            </p>
          </div>
        </div>

        <div class="metric-grid" id="summary-panel"></div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Inbox</p>
            <h2>Leads</h2>
          </div>
          <form
            id="filter-form"
            style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center"
          >
            <label class="sr-only" for="status-filter">Status</label>
            <select
              id="status-filter"
              class="button button--secondary button--sm"
              aria-label="Filter leads by status"
            >
              <option value="">All statuses</option>
              <option value="new">New</option>
              <option value="validating">Validating</option>
              <option value="unassigned">Unassigned</option>
              <option value="assigned">Assigned</option>
              <option value="acknowledged">Acknowledged</option>
              <option value="contact_attempted">Contact attempted</option>
              <option value="contacted">Contacted</option>
              <option value="qualifying">Qualifying</option>
              <option value="qualified">Qualified</option>
              <option value="appointment_requested"
                >Appointment requested</option
              >
              <option value="appointment_scheduled"
                >Appointment scheduled</option
              >
              <option value="converted">Converted</option>
              <option value="nurture">Nurture</option>
              <option value="unresponsive">Unresponsive</option>
              <option value="disqualified">Disqualified</option>
              <option value="lost">Lost</option>
              <option value="spam">Spam</option>
              <option value="duplicate">Duplicate</option>
              <option value="cancelled">Cancelled</option>
              <option value="archived">Archived</option>
            </select>
            <label class="sr-only" for="urgency-filter">Urgency</label>
            <select
              id="urgency-filter"
              class="button button--secondary button--sm"
              aria-label="Filter leads by urgency"
            >
              <option value="">All urgency</option>
              <option value="routine">Routine</option>
              <option value="same_day">Same day</option>
              <option value="urgent">Urgent</option>
              <option value="emergency">Emergency</option>
              <option value="unknown">Unknown</option>
            </select>
            <label class="sr-only" for="search-input">Search</label>
            <input
              id="search-input"
              type="search"
              placeholder="Search…"
              class="button button--secondary button--sm"
              style="flex:1;min-width:12rem"
            />
            <button type="submit" class="button button--secondary button--sm"
              >Apply</button
            >
          </form>
        </div>
        <div id="leads-list-panel">
          <ul class="product-list" id="leads-list"></ul>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Sources</p>
            <h2>Source performance</h2>
          </div>
        </div>
        <ul class="product-list" id="sources-list"></ul>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Account health</p>
            <h2>Leads readiness</h2>
          </div>
        </div>
        <div class="attention-card" id="readiness-panel">
          <p>Checking readiness…</p>
        </div>

        <section id="detail-section" aria-labelledby="detail-title" hidden>
          <div class="section-heading">
            <div>
              <p class="eyebrow">Lead detail</p><h2 id="detail-title">
                Selected lead
              </h2>
            </div><button
              type="button"
              class="button button--secondary button--sm"
              id="close-lead-detail">← Back to queue</button
            >
          </div><div class="split">
            <article>
              <p class="eyebrow">Contact</p><div id="detail-body"></div><h3>
                Lifecycle
              </h3><div id="lifecycle-facts" class="lifecycle-facts"></div><div
                class="hero__actions"
              >
                <label class="sr-only" for="status-select">Status</label><select
                  id="status-select"
                >
                  <option value="new">New</option><option value="validating"
                    >Validating</option
                  ><option value="unassigned">Unassigned</option><option
                    value="assigned">Assigned</option
                  ><option value="acknowledged">Acknowledged</option><option
                    value="contact_attempted">Contact attempted</option
                  ><option value="contacted">Contacted</option><option
                    value="qualifying">Qualifying</option
                  ><option value="qualified">Qualified</option><option
                    value="appointment_requested">Appointment requested</option
                  ><option value="appointment_scheduled"
                    >Appointment scheduled</option
                  ><option value="nurture">Nurture</option><option
                    value="unresponsive">Unresponsive</option
                  ><option value="archived">Archived</option>
                </select><button
                  type="button"
                  class="button button--secondary"
                  id="status-button">Change status</button
                >
              </div><div class="field">
                <label for="assignee-select">Assign to teammate</label><select
                  id="assignee-select"
                  aria-label="Assign to teammate"
                  disabled
                >
                  <option value="">Unassigned</option>
                </select><p
                  class="field-hint"
                  id="assignee-status"
                  role="status"
                  aria-live="polite"
                >
                  Loading teammates…
                </p><button
                  type="button"
                  class="button"
                  id="assign-button"
                  disabled>Assign</button
                >
              </div><div class="hero__actions">
                <label class="sr-only" for="conversion-value"
                  >Conversion value</label
                ><input
                  id="conversion-value"
                  type="number"
                  min="0"
                  step="0.01"
                  placeholder="Conversion value (optional)"
                /><button
                  type="button"
                  class="button button--secondary"
                  id="convert-button">Mark converted</button
                >
              </div>
              <div class="hero__actions">
                <label class="sr-only" for="loss-reason">Loss reason</label
                ><input
                  id="loss-reason"
                  type="text"
                  placeholder="Loss reason"
                /><button
                  type="button"
                  class="button button--secondary"
                  id="loss-button">Mark lost</button
                >
              </div><p
                id="terminal-note"
                class="alert alert--info"
                role="status"
                hidden
              >
              </p><p id="action-status" role="status" aria-live="polite"></p><h3
              >
                Add note
              </h3><label class="sr-only" for="note-text">Note</label><textarea
                id="note-text"
                rows="3"
                maxlength="5000"></textarea><button
                type="button"
                class="button"
                id="note-button">Save note</button
              ><h3>Follow-up task</h3><label class="sr-only" for="task-title"
                >Task title</label
              ><input id="task-title" type="text" placeholder="Task title" />
              <button type="button" class="button" id="task-button"
                >Create task</button
              >
            </article><article id="activity">
              <p class="eyebrow">Notes</p><ol class="timeline" id="notes-list">
              </ol><p class="eyebrow">Follow-up tasks</p><ol
                class="timeline"
                id="tasks-list"
              >
              </ol><p class="eyebrow">Communications</p><p class="source-note">
                Delivery is shown only when a provider event has been recorded.
                This workspace does not imply that outbound email or SMS is
                available.
              </p><ol class="timeline" id="communications-list"></ol><p
                class="eyebrow"
              >
                Audit history
              </p><ol class="timeline" id="audit-history"></ol>
            </article>
          </div>
        </section>
      </div>
    </AppShell>
    <script>
      import {
        fetchProductReadiness,
        type MyOrganization,
      } from "../lib/workspace";
      import {
        addLeadNote,
        assignLead,
        completeLeadTask,
        convertLead,
        createLeadTask,
        fetchLead,
        fetchLeadAssignees,
        fetchLeadAudit,
        fetchLeadCommunications,
        fetchLeadNotes,
        fetchLeadSummary,
        fetchLeadTasks,
        fetchLeads,
        fetchSourcePerformance,
        formatSpeedToLead,
        isTerminalLeadStatus,
        LEAD_TRANSITION_TARGET_STATUSES,
        recordLeadLoss,
        transitionLeadStatus,
        type AssigneeCandidate,
        type LeadDetail,
        type LeadSummary,
        type LeadTask,
      } from "../lib/leads";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        emptyState,
        errorAlert,
        describeFailure,
        metricCard,
        type BootRegions,
      } from "../lib/ui";

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("leads-content")!,
      };

      let organizationId = "";
      let selectedLeadId: string | null = null;
      // Assignable teammates for the currently selected organization only.
      // Reset to an empty list on every organization switch so stale members
      // from a previous organization can never remain selectable, and only
      // ever populated from the authoritative `leads/assignees` endpoint.
      let assignees: AssigneeCandidate[] = [];

      document
        .getElementById("close-lead-detail")!
        .addEventListener("click", () => {
          document.getElementById("detail-section")!.hidden = true;
          document.getElementById("leads-list-panel")!.scrollIntoView({
            block: "start",
          });
        });

      function statusBadgeKind(status: string): string {
        if (status === "converted") return "ready";
        if (["lost", "disqualified", "spam", "cancelled"].includes(status))
          return "blocked";
        if (status === "new" || status === "unassigned") return "missing";
        return "setup";
      }

      async function renderReadiness(): Promise<void> {
        const panel = document.getElementById("readiness-panel")!;
        panel.replaceChildren();
        const outcome = await fetchProductReadiness(organizationId, "leads");
        if (outcome.kind !== "ok") {
          panel.append(errorAlert(describeFailure(outcome)));
          return;
        }
        const state = outcome.data.readiness_state;
        const label = state === "not_entitled" ? "setup" : state;
        panel.append(
          statusBadge(
            label,
            state === "ready" ? "Operational" : humanize(state),
          ),
        );
        for (const finding of outcome.data.blocking_requirements) {
          const reason = document.createElement("p");
          reason.textContent = finding.remediation;
          panel.append(reason);
        }
        if (
          outcome.data.blocking_requirements.length === 0 &&
          state === "ready"
        ) {
          const ready = document.createElement("p");
          ready.textContent = "Leads is ready to use.";
          panel.append(ready);
        }
      }

      async function renderSummary(): Promise<void> {
        const panel = document.getElementById("summary-panel")!;
        panel.replaceChildren();
        const outcome = await fetchLeadSummary(organizationId);
        if (outcome.kind !== "ok") {
          panel.append(errorAlert(describeFailure(outcome)));
          return;
        }
        const closedStatuses = new Set([
          "converted",
          "lost",
          "disqualified",
          "spam",
          "duplicate",
          "cancelled",
          "archived",
        ]);
        const openCount = Object.entries(outcome.data.by_status).reduce(
          (sum, [status, count]) =>
            sum + (closedStatuses.has(status) ? 0 : count),
          0,
        );
        const unassigned =
          (outcome.data.by_status.new ?? 0) +
          (outcome.data.by_status.unassigned ?? 0);
        const metrics: Array<[string, string, string]> = [
          [
            "Average speed to lead",
            formatSpeedToLead(outcome.data.average_speed_to_lead_seconds),
            "First human response",
          ],
          ["Open leads", String(openCount), "Active queue"],
          ["Needs assignment", String(unassigned), "New or unassigned"],
          [
            "Urgent",
            String(outcome.data.open_urgent_count),
            "Open urgent leads",
          ],
          [
            "Converted",
            String(outcome.data.by_status.converted ?? 0),
            "Recorded outcomes",
          ],
        ];
        for (const [label, value, meta] of metrics) {
          panel.append(metricCard(label, value, meta));
        }
      }

      async function renderSources(): Promise<void> {
        const list = document.getElementById("sources-list")!;
        list.replaceChildren();
        const outcome = await fetchSourcePerformance(organizationId);
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No lead sources configured yet.";
          list.append(item);
          return;
        }
        for (const source of outcome.data) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = source.name;
          const meta = document.createElement("p");
          meta.textContent = `${source.lead_count} leads · ${source.converted_count} converted`;
          info.append(name, meta);
          item.append(info);
          list.append(item);
        }
      }

      async function renderLeadsList(): Promise<void> {
        const list = document.getElementById("leads-list")!;
        list.replaceChildren();
        const statusFilter = (
          document.getElementById("status-filter") as HTMLSelectElement
        ).value;
        const urgencyFilter = (
          document.getElementById("urgency-filter") as HTMLSelectElement
        ).value;
        const search = (
          document.getElementById("search-input") as HTMLInputElement
        ).value.trim();
        const outcome = await fetchLeads(organizationId, {
          statusFilter: statusFilter || undefined,
          urgencyFilter: urgencyFilter || undefined,
          search: search || undefined,
        });
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.append(errorAlert(describeFailure(outcome)));
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.append(
            emptyState(
              "No leads yet",
              "This organization has no leads on record yet. New leads will appear here once they come in from connected sources.",
            ),
          );
          list.append(item);
          return;
        }
        for (const lead of outcome.data) {
          list.append(leadRow(lead));
        }
      }

      function leadRow(lead: LeadSummary): HTMLLIElement {
        const item = document.createElement("li");
        const info = document.createElement("div");
        const title = document.createElement("h3");
        title.textContent = `${lead.urgency === "unknown" ? "New" : humanize(lead.urgency)} lead`;
        const meta = document.createElement("p");
        const responseState = lead.first_human_contact_at
          ? `Contacted ${new Date(lead.first_human_contact_at).toLocaleString()}`
          : lead.acknowledged_at
            ? "Acknowledged · awaiting contact"
            : "Awaiting acknowledgement";
        meta.textContent = `${ageSince(lead.received_at)} · ${lead.assigned_to_user_id ? "Assigned" : "Unassigned"} · ${responseState}`;
        info.append(title, meta);
        const actions = document.createElement("div");
        actions.append(
          statusBadge(statusBadgeKind(lead.status), humanize(lead.status)),
        );
        const openButton = document.createElement("button");
        openButton.type = "button";
        openButton.className = "button button--secondary";
        openButton.textContent = "Open";
        openButton.addEventListener("click", () => void openLead(lead.id));
        actions.append(openButton);
        item.append(info, actions);
        return item;
      }

      async function openLead(leadId: string): Promise<void> {
        selectedLeadId = leadId;
        const detailSection = document.getElementById("detail-section")!;
        detailSection.hidden = false;
        detailSection.scrollIntoView({ block: "start" });
        const bodyPanel = document.getElementById("detail-body")!;
        bodyPanel.replaceChildren(document.createTextNode("Loading…"));

        const detail = await fetchLead(organizationId, leadId);
        if (detail.kind !== "ok") {
          bodyPanel.replaceChildren(
            document.createTextNode(describeFailure(detail)),
          );
          return;
        }
        renderDetailBody(detail.data);
        await Promise.all([
          renderNotes(leadId),
          renderTasks(leadId),
          renderCommunications(leadId),
          renderAuditHistory(leadId),
        ]);
      }

      function when(value: string | null): string {
        return value ? new Date(value).toLocaleString() : "Not yet";
      }

      function ageSince(value: string): string {
        const elapsedMinutes = Math.max(
          0,
          Math.floor((Date.now() - new Date(value).getTime()) / 60_000),
        );
        if (elapsedMinutes < 60)
          return `Received ${elapsedMinutes} minute${elapsedMinutes === 1 ? "" : "s"} ago`;
        const hours = Math.floor(elapsedMinutes / 60);
        if (hours < 48)
          return `Received ${hours} hour${hours === 1 ? "" : "s"} ago`;
        const days = Math.floor(hours / 24);
        return `Received ${days} day${days === 1 ? "" : "s"} ago`;
      }

      function fact(label: string, value: string): HTMLParagraphElement {
        const p = document.createElement("p");
        const strong = document.createElement("strong");
        strong.textContent = `${label}: `;
        p.append(strong, document.createTextNode(value));
        return p;
      }

      /**
       * Reflects the lead's current status into the transition select
       * truthfully. For a status that is not a valid transition target (any
       * terminal state other than `archived`), injects a single selected
       * placeholder option showing that status instead of leaving the select
       * displaying an unrelated state such as "new". The select itself is
       * disabled separately for terminal leads, so the placeholder only ever
       * displays the real state and can never be submitted.
       */
      function setLeadStatusSelect(status: string): void {
        const select = document.getElementById(
          "status-select",
        ) as HTMLSelectElement;
        select.querySelector("option[data-terminal-placeholder]")?.remove();
        if (
          (LEAD_TRANSITION_TARGET_STATUSES as readonly string[]).includes(
            status,
          )
        ) {
          select.value = status;
          return;
        }
        const option = document.createElement("option");
        option.value = status;
        option.textContent = status;
        option.setAttribute("data-terminal-placeholder", "");
        option.selected = true;
        select.prepend(option);
      }

      function assigneeLabel(candidate: AssigneeCandidate): string {
        const name = candidate.display_name?.trim();
        if (name) return name;
        return `Unnamed ${humanize(candidate.membership_type)} teammate`;
      }

      function humanize(value: string): string {
        return value
          .replace(/_/g, " ")
          .replace(/\b\w/g, (character) => character.toUpperCase());
      }

      function currentAssigneeLabel(assigneeId: string | null): string {
        if (!assigneeId) return "Unassigned";
        const candidate = assignees.find(
          (item) => item.user_profile_id === assigneeId,
        );
        return candidate
          ? assigneeLabel(candidate)
          : "Assigned teammate is no longer available";
      }

      function setAssigneeSelect(currentAssigneeId: string | null): void {
        const select = document.getElementById(
          "assignee-select",
        ) as HTMLSelectElement;
        select
          .querySelectorAll("option[data-candidate]")
          .forEach((option) => option.remove());
        for (const candidate of assignees) {
          const option = document.createElement("option");
          option.value = candidate.user_profile_id;
          option.textContent = assigneeLabel(candidate);
          option.setAttribute("data-candidate", "");
          select.append(option);
        }
        const selectable =
          currentAssigneeId !== null &&
          assignees.some(
            (candidate) => candidate.user_profile_id === currentAssigneeId,
          );
        select.value = selectable ? currentAssigneeId! : "";
      }

      async function renderAssignees(): Promise<void> {
        const select = document.getElementById(
          "assignee-select",
        ) as HTMLSelectElement;
        const status = document.getElementById("assignee-status")!;
        const assignButton = document.getElementById(
          "assign-button",
        ) as HTMLButtonElement;
        select.disabled = true;
        assignButton.disabled = true;
        status.textContent = "Loading teammates…";
        // Drop any previous organization's members immediately so a stale
        // teammate can never be selected while the new list loads.
        assignees = [];
        select
          .querySelectorAll("option[data-candidate]")
          .forEach((option) => option.remove());

        const outcome = await fetchLeadAssignees(organizationId);
        if (outcome.kind === "forbidden") {
          status.textContent = "You do not have permission to assign leads.";
          return;
        }
        if (outcome.kind === "unauthenticated") {
          status.textContent = "Your session has expired. Sign in again.";
          return;
        }
        if (outcome.kind === "disconnected") {
          status.textContent = "Could not reach the platform API.";
          return;
        }
        if (outcome.kind !== "ok") {
          status.textContent = describeFailure(outcome);
          return;
        }
        assignees = outcome.data;
        if (assignees.length === 0) {
          status.textContent =
            "No assignable teammates in this organization yet.";
          // The select stays usable for displaying the unassigned state but
          // assignment is not possible without teammates.
          select.disabled = false;
          return;
        }
        status.textContent = "";
        select.disabled = false;
        assignButton.disabled = false;
      }

      function renderDetailBody(lead: LeadDetail): void {
        const bodyPanel = document.getElementById("detail-body")!;
        bodyPanel.replaceChildren();
        const name = document.createElement("p");
        const fullName = [lead.first_name, lead.last_name]
          .filter(Boolean)
          .join(" ");
        name.textContent = fullName || "No name provided";
        document.getElementById("detail-title")!.textContent =
          fullName || `${humanize(lead.urgency)} lead`;
        const contact = document.createElement("p");
        contact.textContent =
          [lead.normalized_email, lead.normalized_phone]
            .filter(Boolean)
            .join(" · ") || "No contact info provided";
        const message = document.createElement("p");
        message.textContent = lead.message ?? "No message provided.";
        const status = document.createElement("p");
        status.append(
          statusBadge(statusBadgeKind(lead.status), humanize(lead.status)),
        );
        bodyPanel.append(name, contact, message, status);

        // Lifecycle facts come from real backend timestamps only — no value
        // is ever invented. `acknowledged_at` and `first_human_contact_at`
        // are the lead's own speed-to-lead state; showing them truthfully
        // (including a clear "Not yet") is the only way the operator can see
        // whether human contact has actually happened.
        const facts = document.getElementById("lifecycle-facts")!;
        facts.replaceChildren();
        facts.append(
          fact("Urgency", lead.urgency),
          fact("Received", when(lead.received_at)),
          fact("Acknowledged", when(lead.acknowledged_at)),
          fact("First human contact", when(lead.first_human_contact_at)),
          fact("Assigned to", currentAssigneeLabel(lead.assigned_to_user_id)),
        );
        if (lead.converted_at !== null) {
          facts.append(
            fact("Converted at", when(lead.converted_at)),
            fact(
              "Converted value",
              lead.converted_value_cents !== null
                ? (lead.converted_value_cents / 100).toLocaleString(undefined, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2,
                  })
                : "Not specified",
            ),
          );
        }
        if (lead.loss_reason !== null) {
          facts.append(fact("Loss reason", lead.loss_reason));
        }

        // Reflect the current assignee into the picker truthfully. If the
        // assignee is an active teammate in this organization, the picker
        // selects their option so the operator sees their name. If the lead
        // is unassigned, or the assignee is no longer selectable (revoked,
        // suspended, deactivated, or from a different organization), the
        // picker falls back to "Unassigned" — it never fabricates a name for
        // an unresolved id and never leaves a stale id selectable. Internal
        // identifiers remain available to the request layer but are not
        // presented as teammate names.
        setAssigneeSelect(lead.assigned_to_user_id);

        setLeadStatusSelect(lead.status);

        // A terminal lead cannot be transitioned, converted, or lost further
        // (the backend rejects every such attempt with InvalidLeadTransition),
        // so those controls are disabled rather than left as controls that
        // can only ever produce an error. Assignment remains enabled because
        // the API permits reassigning a closed lead for record-keeping.
        const terminal = isTerminalLeadStatus(lead.status);
        (
          document.getElementById("status-select") as HTMLSelectElement
        ).disabled = terminal;
        (
          document.getElementById("status-button") as HTMLButtonElement
        ).disabled = terminal;
        (
          document.getElementById("convert-button") as HTMLButtonElement
        ).disabled = terminal;
        (document.getElementById("loss-button") as HTMLButtonElement).disabled =
          terminal;
        const terminalNote = document.getElementById("terminal-note")!;
        terminalNote.hidden = !terminal;
        if (terminal) {
          terminalNote.textContent = `This lead is in a terminal state (${lead.status}). No further status transition, conversion, or loss is available.`;
        }
      }

      async function renderNotes(leadId: string): Promise<void> {
        const list = document.getElementById("notes-list")!;
        list.replaceChildren();
        const outcome = await fetchLeadNotes(organizationId, leadId);
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No notes yet.";
          list.append(item);
          return;
        }
        for (const note of outcome.data) {
          const item = document.createElement("li");
          const strong = document.createElement("strong");
          strong.textContent = new Date(note.created_at).toLocaleString();
          const span = document.createElement("span");
          span.textContent = note.body;
          item.append(strong, span);
          list.append(item);
        }
      }

      async function renderTasks(leadId: string): Promise<void> {
        const list = document.getElementById("tasks-list")!;
        list.replaceChildren();
        const outcome = await fetchLeadTasks(organizationId, leadId);
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No follow-up tasks yet.";
          list.append(item);
          return;
        }
        for (const task of outcome.data) {
          list.append(taskRow(leadId, task));
        }
      }

      function taskRow(leadId: string, task: LeadTask): HTMLLIElement {
        const item = document.createElement("li");
        const strong = document.createElement("strong");
        strong.textContent = `${task.title} (${task.status})`;
        const span = document.createElement("span");
        span.textContent = task.due_at
          ? `Due ${new Date(task.due_at).toLocaleString()}`
          : "";
        item.append(strong, span);
        if (task.status === "open") {
          const completeButton = document.createElement("button");
          completeButton.type = "button";
          completeButton.textContent = "Complete";
          completeButton.addEventListener("click", async () => {
            const result = await completeLeadTask(
              organizationId,
              leadId,
              task.id,
            );
            setActionStatus(
              result.kind === "ok"
                ? "Task completed."
                : describeFailure(result),
            );
            await renderTasks(leadId);
          });
          item.append(completeButton);
        }
        return item;
      }

      async function renderCommunications(leadId: string): Promise<void> {
        const list = document.getElementById("communications-list")!;
        list.replaceChildren();
        const outcome = await fetchLeadCommunications(organizationId, leadId);
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No communications yet.";
          list.append(item);
          return;
        }
        for (const comm of outcome.data) {
          const item = document.createElement("li");
          const strong = document.createElement("strong");
          // The status is the backend's real delivery state — never a
          // fabricated "sent"/"delivered" — so it is shown verbatim.
          strong.textContent = `${comm.channel} · ${comm.direction} · ${comm.status}`;
          const delivery = document.createElement("span");
          const parts: string[] = [];
          if (comm.sent_at)
            parts.push(`Sent ${new Date(comm.sent_at).toLocaleString()}`);
          if (comm.delivered_at)
            parts.push(
              `Delivered ${new Date(comm.delivered_at).toLocaleString()}`,
            );
          if (comm.failed_at)
            parts.push(`Failed ${new Date(comm.failed_at).toLocaleString()}`);
          // A communication with no delivery events yet has simply not been
          // sent/delivered — that is shown plainly, never as a success.
          delivery.textContent =
            parts.length > 0
              ? parts.join(" · ")
              : "No delivery events recorded yet.";
          item.append(strong, delivery);
          list.append(item);
        }
      }

      async function renderAuditHistory(leadId: string): Promise<void> {
        const list = document.getElementById("audit-history")!;
        list.replaceChildren();
        const outcome = await fetchLeadAudit(organizationId, leadId);
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No audit history yet.";
          list.append(item);
          return;
        }
        for (const event of outcome.data) {
          const item = document.createElement("li");
          const strong = document.createElement("strong");
          strong.textContent = event.summary;
          const span = document.createElement("span");
          span.textContent = new Date(event.occurred_at).toLocaleString();
          item.append(strong, span);
          list.append(item);
        }
      }

      function setActionStatus(message: string): void {
        document.getElementById("action-status")!.textContent = message;
      }

      function wireDetailActions(): void {
        document
          .getElementById("assign-button")
          ?.addEventListener("click", async () => {
            if (!selectedLeadId) return;
            const select = document.getElementById(
              "assignee-select",
            ) as HTMLSelectElement;
            const assignee = select.value;
            if (!assignee) {
              setActionStatus("Select a teammate to assign first.");
              return;
            }
            if (
              !assignees.some(
                (candidate) => candidate.user_profile_id === assignee,
              )
            ) {
              setActionStatus("Select a valid teammate from the list.");
              return;
            }
            const result = await assignLead(
              organizationId,
              selectedLeadId,
              assignee,
            );
            setActionStatus(
              result.kind === "ok" ? "Lead assigned." : describeFailure(result),
            );
            if (result.kind === "ok") {
              renderDetailBody(result.data);
              await renderAuditHistory(selectedLeadId);
            }
          });

        document
          .getElementById("status-button")
          ?.addEventListener("click", async () => {
            if (!selectedLeadId) return;
            const toStatus = (
              document.getElementById("status-select") as HTMLSelectElement
            ).value;
            const result = await transitionLeadStatus(
              organizationId,
              selectedLeadId,
              toStatus,
            );
            setActionStatus(
              result.kind === "ok"
                ? "Status updated."
                : describeFailure(result),
            );
            if (result.kind === "ok") {
              renderDetailBody(result.data);
              await renderAuditHistory(selectedLeadId);
            }
          });

        document
          .getElementById("convert-button")
          ?.addEventListener("click", async () => {
            if (!selectedLeadId) return;
            const raw = (
              document.getElementById("conversion-value") as HTMLInputElement
            ).value;
            const value = raw ? Math.round(Number.parseFloat(raw) * 100) : null;
            const result = await convertLead(
              organizationId,
              selectedLeadId,
              value,
            );
            setActionStatus(
              result.kind === "ok"
                ? "Lead marked converted."
                : describeFailure(result),
            );
            if (result.kind === "ok") {
              renderDetailBody(result.data);
              await Promise.all([
                renderAuditHistory(selectedLeadId),
                renderSummary(),
              ]);
            }
          });

        document
          .getElementById("loss-button")
          ?.addEventListener("click", async () => {
            if (!selectedLeadId) return;
            const reason = (
              document.getElementById("loss-reason") as HTMLInputElement
            ).value.trim();
            if (!reason) {
              setActionStatus("Enter a loss reason first.");
              return;
            }
            const result = await recordLeadLoss(
              organizationId,
              selectedLeadId,
              "lost",
              reason,
            );
            setActionStatus(
              result.kind === "ok"
                ? "Lead marked lost."
                : describeFailure(result),
            );
            if (result.kind === "ok") {
              renderDetailBody(result.data);
              await renderAuditHistory(selectedLeadId);
            }
          });

        document
          .getElementById("note-button")
          ?.addEventListener("click", async () => {
            if (!selectedLeadId) return;
            const text = (
              document.getElementById("note-text") as HTMLTextAreaElement
            ).value.trim();
            if (!text) {
              setActionStatus("Enter a note first.");
              return;
            }
            const result = await addLeadNote(
              organizationId,
              selectedLeadId,
              text,
            );
            setActionStatus(
              result.kind === "ok" ? "Note saved." : describeFailure(result),
            );
            if (result.kind === "ok") {
              (
                document.getElementById("note-text") as HTMLTextAreaElement
              ).value = "";
              await Promise.all([
                renderNotes(selectedLeadId),
                renderAuditHistory(selectedLeadId),
              ]);
            }
          });

        document
          .getElementById("task-button")
          ?.addEventListener("click", async () => {
            if (!selectedLeadId) return;
            const title = (
              document.getElementById("task-title") as HTMLInputElement
            ).value.trim();
            if (!title) {
              setActionStatus("Enter a task title first.");
              return;
            }
            const result = await createLeadTask(
              organizationId,
              selectedLeadId,
              { title },
            );
            setActionStatus(
              result.kind === "ok" ? "Task created." : describeFailure(result),
            );
            if (result.kind === "ok") {
              (
                document.getElementById("task-title") as HTMLInputElement
              ).value = "";
              await Promise.all([
                renderTasks(selectedLeadId),
                renderAuditHistory(selectedLeadId),
              ]);
            }
          });
      }

      function wireFilters(): void {
        document
          .getElementById("filter-form")
          ?.addEventListener("submit", (event) => {
            event.preventDefault();
            void renderLeadsList();
          });
      }

      async function loadOrganization(
        organization: MyOrganization,
      ): Promise<void> {
        setActiveOrganization(organization);
        organizationId = organization.organization_id;

        // The previously selected lead belongs to the previous organization.
        // Close its detail panel and clear the action status so no stale
        // lifecycle state ever leaks across organizations.
        selectedLeadId = null;
        document.getElementById("detail-section")!.hidden = true;
        document.getElementById("terminal-note")!.hidden = true;
        setActionStatus("");

        await renderReadiness();
        await Promise.all([
          renderSummary(),
          renderSources(),
          renderLeadsList(),
          renderAssignees(),
        ]);
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Leads");
        if (!applyBootResult(regions, result)) return;
        wireDetailActions();
        wireFilters();
        populateSwitcher(
          result.organizations,
          (organization) => void loadOrganization(organization),
        );
        const organization =
          result.organizations.find(
            (item) => item.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(organization);
      }

      void boot();
    </script>
  </body>
</html>
