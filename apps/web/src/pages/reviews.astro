---
import AppShell from "../components/AppShell.astro";
import Button from "../lib/ui/Button.astro";
import Card from "../lib/ui/Card.astro";
import CardGrid from "../lib/ui/CardGrid.astro";
import EmptyState from "../lib/ui/EmptyState.astro";
import Inline from "../lib/ui/Inline.astro";
import Input from "../lib/ui/Input.astro";
import Notice from "../lib/ui/Notice.astro";
import PageHeader from "../lib/ui/PageHeader.astro";
import PageSection from "../lib/ui/PageSection.astro";
import PageShell from "../lib/ui/PageShell.astro";
import Region from "../lib/ui/Region.astro";
import Select from "../lib/ui/Select.astro";
import Skeleton from "../lib/ui/Skeleton.astro";
import StageStrip from "../lib/ui/StageStrip.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs reviews" />
    <title>Reviews · LILOs</title>
  </head>
  <body>
    <AppShell>
      <PageShell id="boot-not-configured"
        ><EmptyState
          heading="This deployment is not configured"
          description="Connect the platform runtime configuration to enable Reviews."
        /></PageShell
      >
      <PageShell id="boot-loading" hidden
        ><Skeleton lines={3} label="Loading reviews" /></PageShell
      >
      <PageShell id="boot-error" hidden><Region role="alert" /></PageShell>
      <PageShell id="workspace-empty" hidden
        ><EmptyState
          heading="No organization access yet"
          description="Ask an administrator to invite your account to an organization."
        /></PageShell
      >

      <PageShell id="reviews-content" hidden>
        <PageHeader
          eyebrow="Operations"
          title="Reviews"
          description="Triage customer reviews, prepare governed responses, and verify publication outcomes."
        >
          <Button
            slot="actions"
            href="/automations?agent=agent.reviews"
            variant="secondary"
            size="sm">Run Reviews agent</Button
          >
          <Select
            slot="actions"
            id="location-select"
            label="Select location"
            options={[]}
          />
          <Button
            slot="actions"
            id="ingest-reviews-button"
            variant="secondary"
            size="sm">Sync from Google</Button
          >
        </PageHeader>

        <Notice title="Google reviews"
          ><p>
            Connection health and location mapping are managed centrally.
          </p><Button
            slot="action"
            href="/integrations"
            variant="secondary"
            size="sm">Manage integrations</Button
          ></Notice
        >
        <Region id="no-locations" hidden
          ><Notice tone="warning" title="Location setup required"
            ><p>
              Add a location before reviews can be synced and answered.
            </p><Button
              slot="action"
              href="/settings"
              variant="secondary"
              size="sm">Manage locations</Button
            ></Notice
          ></Region
        >

        <Region id="reviews-workspace" hidden>
          <PageSection eyebrow="Performance" title="Review outcomes"
            ><CardGrid id="reviews-metrics" minimum="sm" /></PageSection
          >
          <PageSection
            eyebrow="Workflow"
            title="Response stages"
            description="Counts reflect all synced reviews. Select a stage to filter the loaded inbox."
          >
            <StageStrip
              id="review-stages"
              label="Review response stages"
              items={[
                { id: "all", label: "All" },
                { id: "inbox", label: "Inbox" },
                { id: "draft", label: "Draft" },
                { id: "approval", label: "Approval" },
                { id: "publish", label: "Publishing" },
                { id: "responded", label: "Responded" },
              ]}
            />
          </PageSection>
          <PageSection eyebrow="Inbox" title="Reviews">
            <Card>
              <Inline>
                <Select
                  id="status-filter"
                  label="Status"
                  options={[
                    { value: "", label: "All statuses" },
                    { value: "new", label: "New" },
                    { value: "classified", label: "Classified" },
                    { value: "escalated", label: "Escalated" },
                    { value: "publishing", label: "Pending Google moderation" },
                    { value: "publication_failed", label: "Response failed" },
                    { value: "responded", label: "Responded" },
                    { value: "restricted", label: "Restricted" },
                  ]}
                />
                <Input
                  id="search-input"
                  type="search"
                  label="Search reviews"
                  placeholder="Search review text"
                />
                <Button id="apply-filters" variant="secondary" size="sm"
                  >Apply filters</Button
                >
              </Inline>
            </Card>
            <Region id="reviews-list-panel" />
          </PageSection>

          <PageSection
            id="review-detail"
            eyebrow="Review detail"
            title="Selected review"
            titleId="review-detail-title"
            hidden
          >
            <Button
              slot="actions"
              id="close-detail"
              variant="secondary"
              size="sm">Back to list</Button
            >
            <Region id="review-detail-content" />
          </PageSection>
        </Region>
      </PageShell>
    </AppShell>
    <script>
      import {
        fetchReviews,
        fetchReviewSummary,
        fetchReviewDetail,
        fetchReviewResponses,
        draftResponse,
        generateAIDraft,
        approveResponse,
        publishResponse,
        ingestReviews,
        canDraftReviewResponse,
        reviewResponseSourceLabel,
        summarizeReviewStatuses,
        type ReviewSummary,
      } from "../lib/reviews";
      import { resolveBusinessFact } from "../lib/administration";
      import { fetchLocations } from "../lib/workspace";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        buildDataTable,
        statusBadge,
        metricCard,
        emptyState,
        errorAlert,
        describeFailure,
        formatTimestamp,
        selectValue,
        setSelectOptions,
        type BootRegions,
      } from "../lib/ui";
      import {
        sentimentLabel,
        statusLabel,
        statusTone,
      } from "../lib/status-language";

      let organizationId = "";
      let selectedLocationId = "";
      let activeReviewStage = "all";
      let latestReviews: ReviewSummary[] = [];

      const REVIEW_STAGE_STATUSES: Record<string, string[]> = {
        inbox: [
          "new",
          "classified",
          "triaged",
          "escalated",
          "disputed",
          "restricted",
        ],
        draft: ["drafting"],
        approval: ["awaiting_approval", "approved"],
        publish: ["publishing", "publication_failed"],
        responded: ["responded"],
      };

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("reviews-content")!,
      };

      document.getElementById("close-detail")!.addEventListener("click", () => {
        document.getElementById("review-detail")!.hidden = true;
      });

      document
        .querySelectorAll<HTMLButtonElement>("#review-stages [data-stage]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            activeReviewStage = button.dataset.stage ?? "all";
            document
              .querySelectorAll<HTMLButtonElement>(
                "#review-stages [data-stage]",
              )
              .forEach((candidate) => {
                candidate.setAttribute(
                  "aria-pressed",
                  String(candidate === button),
                );
              });
            renderReviewRows(latestReviews);
          });
        });

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;

        const locationsResult = await fetchLocations(organizationId);
        if (
          locationsResult.kind !== "ok" ||
          locationsResult.data.length === 0
        ) {
          document.getElementById("no-locations")!.hidden = false;
          document.getElementById("reviews-workspace")!.hidden = true;
          return;
        }

        populateLocationSelect(locationsResult.data);
        selectedLocationId = locationsResult.data[0].id;
        await loadReviews();
      }

      function populateLocationSelect(
        locations: import("../lib/workspace").LocationSummary[],
      ): void {
        const select = document.getElementById("location-select")!;
        setSelectOptions(
          "location-select",
          locations.map((location) => ({
            value: location.id,
            label: location.name,
          })),
          locations[0]?.id,
        );
        select.addEventListener("change", async () => {
          selectedLocationId = selectValue("location-select");
          await loadReviews();
        });
      }

      async function loadReviews(): Promise<void> {
        document.getElementById("no-locations")!.hidden = true;
        document.getElementById("reviews-workspace")!.hidden = false;
        document.getElementById("review-detail")!.hidden = true;

        const [summaryResult, reviewsResult] = await Promise.all([
          fetchReviewSummary(organizationId, selectedLocationId),
          fetchReviews(organizationId, selectedLocationId, getFilters()),
        ]);

        renderMetrics(summaryResult);
        if (summaryResult.kind === "ok") renderReviewStages(summaryResult.data);
        renderList(reviewsResult);
      }

      function getFilters(): { statusFilter?: string; search?: string } {
        const status = selectValue("status-filter");
        const search = (
          document.getElementById("search-input") as HTMLInputElement
        ).value;
        return {
          statusFilter: status || undefined,
          search: search || undefined,
        };
      }

      function renderMetrics(
        summary: Awaited<ReturnType<typeof fetchReviewSummary>>,
      ): void {
        const grid = document.getElementById("reviews-metrics")!;
        grid.replaceChildren();
        if (summary.kind !== "ok") {
          grid.append(errorAlert(describeFailure(summary, "Summary")));
          return;
        }
        const stats = summary.data;
        const counts = summarizeReviewStatuses(stats);
        const hasObservations = counts.total > 0;
        const noDataMeta = "No reviews synced yet";
        grid.append(
          metricCard(
            "Average rating",
            stats.average_rating !== null
              ? stats.average_rating.toFixed(1)
              : "No data",
            hasObservations ? "Out of 5" : noDataMeta,
          ),
          metricCard(
            "Total reviews",
            hasObservations ? String(counts.total) : "No data",
            hasObservations ? "All synced reviews" : noDataMeta,
          ),
          metricCard(
            "Responded",
            hasObservations ? String(counts.responded) : "No data",
            hasObservations ? "Observed on Google" : noDataMeta,
          ),
          metricCard(
            "New",
            hasObservations ? String(counts.newCount) : "No data",
            hasObservations ? "Awaiting review" : noDataMeta,
          ),
          metricCard(
            "Needs response",
            hasObservations ? String(counts.needsResponse) : "No data",
            hasObservations ? "Action required" : noDataMeta,
          ),
        );
      }

      function renderReviewStages(
        stats: import("../lib/reviews").ReviewSummaryStats,
      ): void {
        const byStatus = stats.by_status ?? {};
        const total = Object.values(byStatus).reduce(
          (sum, count) => sum + count,
          0,
        );
        const counts: Record<string, number> = { all: total };
        for (const [stage, statuses] of Object.entries(REVIEW_STAGE_STATUSES)) {
          counts[stage] = statuses.reduce(
            (sum, status) => sum + (byStatus[status] ?? 0),
            0,
          );
        }
        for (const [stage, count] of Object.entries(counts)) {
          const target = document.getElementById(
            `review-stages-${stage}-count`,
          );
          if (target) target.textContent = String(count);
        }
      }

      function renderList(
        reviews: Awaited<ReturnType<typeof fetchReviews>>,
      ): void {
        const panel = document.getElementById("reviews-list-panel")!;
        panel.replaceChildren();
        if (reviews.kind !== "ok") {
          panel.append(errorAlert(describeFailure(reviews, "Reviews")));
          return;
        }
        latestReviews = reviews.data;
        renderReviewRows(reviews.data);
      }

      function renderReviewRows(reviews: ReviewSummary[]): void {
        const panel = document.getElementById("reviews-list-panel")!;
        panel.replaceChildren();
        const stageStatuses = REVIEW_STAGE_STATUSES[activeReviewStage];
        const visibleReviews = stageStatuses
          ? reviews.filter((review) => stageStatuses.includes(review.status))
          : reviews;
        if (visibleReviews.length === 0) {
          panel.append(
            emptyState(
              activeReviewStage === "all"
                ? "No reviews yet"
                : "No reviews in this stage",
              activeReviewStage === "all"
                ? "Sync from Google to import reviews into this workspace."
                : "Choose another stage or sync again when new provider activity is available.",
            ),
          );
          return;
        }
        const latestSync = reviews
          .map((review) => review.last_synced_at)
          .filter(Boolean)
          .sort()
          .at(-1);
        const freshness = document.createElement("div");
        freshness.className = "ui-notice ui-notice--info";
        freshness.setAttribute("role", "status");
        freshness.textContent = latestSync
          ? `Google review data last synced ${formatTimestamp(latestSync)}`
          : "Review freshness is not yet available.";
        panel.append(freshness);
        const table = buildDataTable(
          [
            {
              key: "rating",
              header: "Rating",
              format: { unit: "decimal", precision: 1 },
              render: (review: ReviewSummary) => review.rating,
            },
            {
              key: "status",
              header: "Status",
              render: (review: ReviewSummary) =>
                statusBadge(
                  review.status === "new"
                    ? "setup"
                    : review.status === "responded"
                      ? "ready"
                      : "neutral",
                  statusLabel(review.status),
                ),
            },
            {
              key: "sentiment",
              header: "Sentiment",
              render: (review: ReviewSummary) =>
                sentimentLabel(review.sentiment),
            },
            {
              key: "risk",
              header: "Risk",
              render: (review: ReviewSummary) =>
                statusBadge(
                  review.risk_level === "high" ||
                    review.risk_level === "critical"
                    ? "blocked"
                    : review.risk_level === "medium"
                      ? "setup"
                      : "neutral",
                  statusLabel(review.risk_level),
                ),
            },
            {
              key: "date",
              header: "Review date",
              width: "content",
              render: (review: ReviewSummary) =>
                formatTimestamp(review.review_created_at),
            },
            {
              key: "actions",
              header: "Actions",
              width: "content",
              render: (review: ReviewSummary) => {
                const action = document.createElement("span");
                action.className = "ui-inline ui-inline--center";
                const openButton = document.createElement("button");
                openButton.type = "button";
                openButton.className =
                  "ui-button ui-button--secondary ui-button--sm";
                openButton.textContent = "Review";
                openButton.addEventListener(
                  "click",
                  () => void openReview(review),
                );
                action.append(openButton);
                return action;
              },
            },
          ],
          visibleReviews,
          {
            disclosure: { initialRows: 10, noun: "reviews" },
          },
        );
        panel.append(table);
      }

      async function openReview(review: ReviewSummary): Promise<void> {
        document.getElementById("review-detail")!.hidden = false;
        document.getElementById("review-detail-title")!.textContent =
          `Review ${review.rating ? `${review.rating}★` : "—"}`;

        const content = document.getElementById("review-detail-content")!;
        content.replaceChildren();
        content.append(createLoading());

        const [detailResult, responsesResult] = await Promise.all([
          fetchReviewDetail(organizationId, selectedLocationId, review.id),
          fetchReviewResponses(organizationId, selectedLocationId, review.id),
        ]);

        content.replaceChildren();

        if (detailResult.kind !== "ok") {
          content.append(
            errorAlert(describeFailure(detailResult, "Review detail")),
          );
          return;
        }

        // Review content
        const reviewCard = document.createElement("div");
        reviewCard.className = "ui-card";
        const reviewHeader = document.createElement("div");
        reviewHeader.className = "ui-card__header";
        reviewHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "ui-card__heading",
            textContent: "Review content",
          }),
        );
        reviewCard.append(reviewHeader);
        const reviewBody = document.createElement("div");
        reviewBody.className = "ui-card__body";
        const latestRevision = detailResult.data.revisions[0];
        if (latestRevision) {
          if (latestRevision.title) {
            const title = document.createElement("h3");
            title.textContent = latestRevision.title;
            reviewBody.append(title);
          }
          if (latestRevision.body) {
            const body = document.createElement("p");
            body.className = "ui-text-secondary";
            body.textContent = latestRevision.body;
            reviewBody.append(body);
          }
        }
        reviewBody.append(
          Object.assign(document.createElement("p"), {
            className: "ui-text-secondary",
            textContent: `Provider: ${review.provider} · ${formatTimestamp(review.review_created_at)} · Last synced ${formatTimestamp(detailResult.data.last_synced_at)}`,
          }),
        );
        reviewCard.append(reviewBody);
        content.append(reviewCard);

        // Compose response
        const composeCard = document.createElement("div");
        composeCard.className = "ui-card";
        const composeHeader = document.createElement("div");
        composeHeader.className = "ui-card__header";
        composeHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "ui-card__heading",
            textContent: "Compose response",
          }),
        );
        composeCard.append(composeHeader);
        const composeBody = document.createElement("div");
        composeBody.className = "ui-card__body";
        const textarea = document.createElement("textarea");
        textarea.className = "ui-textarea";
        textarea.id = "review-response-draft";
        textarea.rows = 4;
        textarea.placeholder = "Write a response…";
        const textareaLabel = document.createElement("label");
        textareaLabel.htmlFor = textarea.id;
        textareaLabel.className = "ui-field__label";
        textareaLabel.textContent = "Response draft";
        composeBody.append(textareaLabel, textarea);
        const btnRow = document.createElement("div");
        btnRow.className = "ui-inline ui-inline--center ui-inline--tight";
        const saveBtn = document.createElement("button");
        saveBtn.type = "button";
        saveBtn.className = "ui-button ui-button--secondary ui-button--sm";
        saveBtn.textContent = "Save draft";
        const aiBtn = document.createElement("button");
        aiBtn.type = "button";
        aiBtn.className = "ui-button ui-button--primary ui-button--sm";
        aiBtn.textContent = "Generate AI draft";
        const status = document.createElement("p");
        status.className = "ui-text-secondary";
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");

        async function approvedFactRevisionIds(): Promise<string[]> {
          const factKeys = [
            "business.name",
            "business.address",
            "brand.approved_claims",
          ];
          const results = await Promise.all(
            factKeys.map((factKey) =>
              resolveBusinessFact(organizationId, factKey, selectedLocationId),
            ),
          );
          return results.flatMap((result) =>
            result.kind === "ok" && result.data.selected_revision_id
              ? [result.data.selected_revision_id]
              : [],
          );
        }

        saveBtn.addEventListener("click", async () => {
          if (!textarea.value.trim()) {
            status.textContent = "Enter a response first.";
            return;
          }
          const latestRev = detailResult.data.revisions[0];
          if (!latestRev) {
            status.textContent = "No revision to respond to.";
            return;
          }
          const approvedFactIds = await approvedFactRevisionIds();
          if (approvedFactIds.length === 0) {
            status.textContent =
              "Approve at least one business fact before drafting a response.";
            return;
          }
          const result = await draftResponse(
            organizationId,
            selectedLocationId,
            review.id,
            {
              review_revision_id: latestRev.id,
              response_text: textarea.value,
              generated_by_type: "user",
              approved_fact_revision_ids: approvedFactIds,
            },
          );
          status.textContent =
            result.kind === "ok"
              ? "Draft saved."
              : describeFailure(result, "Save");
          if (result.kind === "ok") await openReview(review);
        });
        aiBtn.addEventListener("click", async () => {
          aiBtn.disabled = true;
          aiBtn.textContent = "Generating…";
          const latestRev = detailResult.data.revisions[0];
          if (!latestRev) {
            status.textContent = "No revision to respond to.";
            return;
          }
          const approvedFactIds = await approvedFactRevisionIds();
          if (approvedFactIds.length === 0) {
            status.textContent =
              "Approve at least one business fact before generating a draft.";
            aiBtn.disabled = false;
            aiBtn.textContent = "Generate AI draft";
            return;
          }
          const result = await generateAIDraft(
            organizationId,
            selectedLocationId,
            review.id,
            {
              review_revision_id: latestRev.id,
              approved_fact_revision_ids: approvedFactIds,
              idempotency_key: `web-ai-${review.id}-${Date.now()}`,
            },
          );
          if (result.kind === "ok") {
            textarea.value = result.data.response_text;
            status.textContent =
              "AI draft generated. Review it carefully before approving.";
          } else {
            status.textContent = describeFailure(result, "AI draft");
          }
          aiBtn.disabled = false;
          aiBtn.textContent = "Generate AI draft";
        });
        btnRow.append(saveBtn, aiBtn, status);
        composeBody.append(btnRow);
        composeCard.append(composeBody);
        if (canDraftReviewResponse(review.status)) {
          content.append(composeCard);
        }

        // Response history
        if (responsesResult.kind === "ok" && responsesResult.data.length > 0) {
          const historyCard = document.createElement("div");
          historyCard.className = "ui-card";
          const historyHeader = document.createElement("div");
          historyHeader.className = "ui-card__header";
          historyHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent: "Response history",
            }),
          );
          historyCard.append(historyHeader);
          const historyBody = document.createElement("div");
          historyBody.className = "ui-card__body";
          if (
            review.status === "responded" ||
            responsesResult.data.some(
              (response) => response.generated_by_type === "imported",
            )
          ) {
            const providerNotice = document.createElement("div");
            providerNotice.className = "ui-notice ui-notice--success";
            providerNotice.append(
              statusBadge("ready", "Observed on Google"),
              Object.assign(document.createElement("p"), {
                className: "ui-text-secondary",
                textContent:
                  "Google reports a public response for this review. LILOs will not invite a duplicate reply.",
              }),
            );
            historyBody.append(providerNotice);
          }
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const resp of responsesResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = `${reviewResponseSourceLabel(resp.generated_by_type)} · ${statusLabel(resp.status)}`;
            const detail = document.createElement("p");
            detail.textContent =
              resp.response_text.length > 100
                ? resp.response_text.slice(0, 100) + "…"
                : resp.response_text;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(statusTone(resp.status), statusLabel(resp.status)),
            );
            if (resp.status === "awaiting_approval") {
              const approveBtn = document.createElement("button");
              approveBtn.type = "button";
              approveBtn.className =
                "ui-button ui-button--primary ui-button--sm";
              approveBtn.textContent = "Approve";
              approveBtn.addEventListener("click", async () => {
                approveBtn.disabled = true;
                const result = await approveResponse(
                  organizationId,
                  selectedLocationId,
                  review.id,
                  resp.id,
                );
                if (result.kind === "ok") await openReview(review);
                else {
                  approveBtn.disabled = false;
                  info.append(errorAlert(describeFailure(result, "Approval")));
                }
              });
              item.append(approveBtn);
            }
            if (resp.status === "approved") {
              const publishBtn = document.createElement("button");
              publishBtn.type = "button";
              publishBtn.className =
                "ui-button ui-button--primary ui-button--sm";
              publishBtn.textContent = "Publish";
              publishBtn.addEventListener("click", async () => {
                publishBtn.disabled = true;
                publishBtn.textContent = "Publishing…";
                const result = await publishResponse(
                  organizationId,
                  selectedLocationId,
                  review.id,
                  resp.id,
                  `web-publish-${resp.id}-${Date.now()}`,
                );
                if (result.kind === "ok") await openReview(review);
                else {
                  publishBtn.disabled = false;
                  publishBtn.textContent = "Publish";
                  info.append(
                    errorAlert(describeFailure(result, "Publish response")),
                  );
                }
              });
              item.append(publishBtn);
            }
            list.append(item);
          }
          historyBody.append(list);
          historyCard.append(historyBody);
          content.append(historyCard);
        }
      }

      function createLoading(): HTMLDivElement {
        const el = document.createElement("div");
        el.className = "ui-skeleton-group";
        el.textContent = "Loading…";
        return el;
      }

      // Wire filter apply
      document
        .getElementById("apply-filters")!
        .addEventListener("click", () => void loadReviews());

      // Wire ingest
      document
        .getElementById("ingest-reviews-button")!
        .addEventListener("click", async () => {
          const btn = document.getElementById(
            "ingest-reviews-button",
          ) as HTMLButtonElement;
          btn.disabled = true;
          btn.textContent = "Syncing…";
          const result = await ingestReviews(
            organizationId,
            selectedLocationId,
          );
          btn.disabled = false;
          btn.textContent = "Sync from Google";
          if (result.kind === "ok") {
            await loadReviews();
          } else {
            const panel = document.getElementById("reviews-list-panel")!;
            panel.prepend(errorAlert(describeFailure(result, "Sync")));
          }
        });

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Reviews");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
