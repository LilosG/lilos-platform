---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs reviews" />
    <title>Reviews · LILOs</title>
  </head>
  <body>
    <AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1>
        <p>No Supabase or API connection is configured for this build.</p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p class="loading-state">Loading reviews…</p>
      </div>

      <div id="boot-error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <div class="empty-state">
          <span class="empty-state__icon" aria-hidden="true">○</span>
          <h3>No organization access yet</h3>
          <p>
            Your account is not a member of any organization. Ask an
            administrator to invite you.
          </p>
        </div>
      </div>

      <div id="reviews-content" hidden>
        <div class="page-head">
          <div class="page-head__intro">
            <p class="eyebrow">Operations</p>
            <h1>Reviews</h1>
            <p>
              Manage customer reviews, draft responses, and publish replies.
            </p>
          </div>
          <div class="page-head__meta">
            <div class="page-head__actions">
              <select
                id="location-select"
                class="button button--secondary button--sm"
                aria-label="Select location"></select>
              <button
                type="button"
                class="button button--secondary button--sm"
                id="ingest-reviews-button">Sync from Google</button
              >
            </div>
          </div>
        </div>

        <div id="no-locations" hidden>
          <div class="empty-state">
            <span class="empty-state__icon" aria-hidden="true">○</span>
            <h3>No locations available</h3>
            <p>Add locations to this organization to start managing reviews.</p>
          </div>
        </div>

        <div id="reviews-workspace" hidden>
          <div class="metric-grid" id="reviews-metrics"></div>

          <div class="section-heading">
            <div>
              <p class="eyebrow">Inbox</p>
              <h2>Reviews</h2>
            </div>
          </div>

          <div class="card" style="margin-bottom: 1rem">
            <div
              class="card__body"
              style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center"
            >
              <label class="sr-only" for="status-filter"
                >Filter reviews by status</label
              >
              <select
                id="status-filter"
                class="button button--secondary button--sm"
                aria-label="Filter reviews by status"
              >
                <option value="">All statuses</option>
                <option value="new">New</option>
                <option value="classified">Classified</option>
                <option value="escalated">Escalated</option>
                <option value="responded">Responded</option>
                <option value="restricted">Restricted</option>
              </select>
              <label class="sr-only" for="search-input">Search reviews</label>
              <input
                id="search-input"
                type="search"
                placeholder="Search reviews…"
                aria-label="Search reviews"
                class="button button--secondary button--sm"
                style="flex: 1; min-width: 12rem"
              />
              <button
                type="button"
                class="button button--secondary button--sm"
                id="apply-filters">Apply</button
              >
            </div>
          </div>

          <div id="reviews-list-panel"></div>

          <div id="review-detail" hidden>
            <div class="section-heading">
              <div>
                <p class="eyebrow">Review detail</p>
                <h2 id="review-detail-title">—</h2>
              </div>
              <button
                type="button"
                class="button button--secondary button--sm"
                id="close-detail">← Back to list</button
              >
            </div>
            <div id="review-detail-content"></div>
          </div>
        </div>
      </div>
    </AppShell>
    <script>
      import {
        fetchReviews,
        fetchReviewSummary,
        fetchReviewDetail,
        fetchReviewResponses,
        draftResponse,
        generateAIDraft,
        approveResponse,
        publishResponse,
        ingestReviews,
        type ReviewSummary,
      } from "../lib/reviews";
      import { resolveBusinessFact } from "../lib/administration";
      import { fetchLocations } from "../lib/workspace";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        metricCard,
        emptyState,
        errorAlert,
        describeFailure,
        formatTimestamp,
        type BootRegions,
      } from "../lib/ui";

      let organizationId = "";
      let selectedLocationId = "";

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("reviews-content")!,
      };

      document.getElementById("close-detail")!.addEventListener("click", () => {
        document.getElementById("review-detail")!.hidden = true;
      });

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;

        const locationsResult = await fetchLocations(organizationId);
        if (
          locationsResult.kind !== "ok" ||
          locationsResult.data.length === 0
        ) {
          document.getElementById("no-locations")!.hidden = false;
          document.getElementById("reviews-workspace")!.hidden = true;
          return;
        }

        populateLocationSelect(locationsResult.data);
        selectedLocationId = locationsResult.data[0].id;
        await loadReviews();
      }

      function populateLocationSelect(
        locations: import("../lib/workspace").LocationSummary[],
      ): void {
        const select = document.getElementById(
          "location-select",
        ) as HTMLSelectElement;
        select.replaceChildren();
        for (const loc of locations) {
          const opt = document.createElement("option");
          opt.value = loc.id;
          opt.textContent = loc.name;
          select.append(opt);
        }
        select.addEventListener("change", async () => {
          selectedLocationId = select.value;
          await loadReviews();
        });
      }

      async function loadReviews(): Promise<void> {
        document.getElementById("no-locations")!.hidden = true;
        document.getElementById("reviews-workspace")!.hidden = false;
        document.getElementById("review-detail")!.hidden = true;

        const [summaryResult, reviewsResult] = await Promise.all([
          fetchReviewSummary(organizationId, selectedLocationId),
          fetchReviews(organizationId, selectedLocationId, getFilters()),
        ]);

        renderMetrics(summaryResult);
        renderList(reviewsResult);
      }

      function getFilters(): { statusFilter?: string; search?: string } {
        const status = (
          document.getElementById("status-filter") as HTMLSelectElement
        ).value;
        const search = (
          document.getElementById("search-input") as HTMLInputElement
        ).value;
        return {
          statusFilter: status || undefined,
          search: search || undefined,
        };
      }

      function renderMetrics(
        summary: Awaited<ReturnType<typeof fetchReviewSummary>>,
      ): void {
        const grid = document.getElementById("reviews-metrics")!;
        grid.replaceChildren();
        if (summary.kind !== "ok") {
          grid.append(errorAlert(describeFailure(summary, "Summary")));
          return;
        }
        const stats = summary.data;
        const total = Object.values(stats.by_status ?? {}).reduce(
          (a, b) => a + b,
          0,
        );
        const newCount = stats.by_status?.["new"] ?? 0;
        const needsResponse =
          (stats.by_status?.["new"] ?? 0) +
          (stats.by_status?.["classified"] ?? 0);
        grid.append(
          metricCard(
            "Average rating",
            stats.average_rating ? stats.average_rating.toFixed(1) : "—",
            "Out of 5",
          ),
          metricCard("Total reviews", String(total), "All time"),
          metricCard("New", String(newCount), "Awaiting review"),
          metricCard(
            "Needs response",
            String(needsResponse),
            "Action required",
          ),
        );
      }

      function renderList(
        reviews: Awaited<ReturnType<typeof fetchReviews>>,
      ): void {
        const panel = document.getElementById("reviews-list-panel")!;
        panel.replaceChildren();
        if (reviews.kind !== "ok") {
          panel.append(errorAlert(describeFailure(reviews, "Reviews")));
          return;
        }
        if (reviews.data.length === 0) {
          panel.append(
            emptyState(
              "No reviews yet",
              "Reviews will appear here once they are synced from Google. Click \u201cSync from Google\u201d to import.",
            ),
          );
          return;
        }
        const table = document.createElement("div");
        table.className = "data-table";
        const t = document.createElement("table");
        const thead = document.createElement("thead");
        thead.innerHTML =
          "<tr><th>Rating</th><th>Status</th><th>Provider</th><th>Date</th><th></th></tr>";
        t.append(thead);
        const tbody = document.createElement("tbody");
        for (const review of reviews.data) {
          const tr = document.createElement("tr");
          tr.classList.add("data-table__row--clickable");
          tr.addEventListener("click", () => void openReview(review));

          const ratingTd = document.createElement("td");
          ratingTd.textContent = review.rating ? `${review.rating}★` : "—";

          const statusTd = document.createElement("td");
          statusTd.append(
            statusBadge(
              review.status === "new"
                ? "setup"
                : review.status === "responded"
                  ? "ready"
                  : "neutral",
              review.status,
            ),
          );

          const providerTd = document.createElement("td");
          providerTd.textContent = review.provider;

          const dateTd = document.createElement("td");
          dateTd.textContent = formatTimestamp(review.review_created_at);

          tr.append(ratingTd, statusTd, providerTd, dateTd);
          tbody.append(tr);
        }
        t.append(tbody);
        table.append(t);
        panel.append(table);
      }

      async function openReview(review: ReviewSummary): Promise<void> {
        document.getElementById("review-detail")!.hidden = false;
        document.getElementById("review-detail-title")!.textContent =
          `Review ${review.rating ? `${review.rating}★` : "—"}`;

        const content = document.getElementById("review-detail-content")!;
        content.replaceChildren();
        content.append(createLoading());

        const [detailResult, responsesResult] = await Promise.all([
          fetchReviewDetail(organizationId, selectedLocationId, review.id),
          fetchReviewResponses(organizationId, selectedLocationId, review.id),
        ]);

        content.replaceChildren();

        if (detailResult.kind !== "ok") {
          content.append(
            errorAlert(describeFailure(detailResult, "Review detail")),
          );
          return;
        }

        // Review content
        const reviewCard = document.createElement("div");
        reviewCard.className = "card";
        const reviewHeader = document.createElement("div");
        reviewHeader.className = "card__header";
        reviewHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "card__title",
            textContent: "Review content",
          }),
        );
        reviewCard.append(reviewHeader);
        const reviewBody = document.createElement("div");
        reviewBody.className = "card__body";
        const latestRevision =
          detailResult.data.revisions[detailResult.data.revisions.length - 1];
        if (latestRevision) {
          if (latestRevision.title) {
            const title = document.createElement("h3");
            title.textContent = latestRevision.title;
            reviewBody.append(title);
          }
          if (latestRevision.body) {
            const body = document.createElement("p");
            body.className = "text-sm";
            body.textContent = latestRevision.body;
            reviewBody.append(body);
          }
        }
        reviewBody.append(
          Object.assign(document.createElement("p"), {
            className: "text-xs muted",
            textContent: `Provider: ${review.provider} · ${formatTimestamp(review.review_created_at)}`,
          }),
        );
        reviewCard.append(reviewBody);
        content.append(reviewCard);

        // Compose response
        const composeCard = document.createElement("div");
        composeCard.className = "card";
        const composeHeader = document.createElement("div");
        composeHeader.className = "card__header";
        composeHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "card__title",
            textContent: "Compose response",
          }),
        );
        composeCard.append(composeHeader);
        const composeBody = document.createElement("div");
        composeBody.className = "card__body";
        const textarea = document.createElement("textarea");
        textarea.rows = 4;
        textarea.placeholder = "Write a response…";
        composeBody.append(textarea);
        const btnRow = document.createElement("div");
        btnRow.className = "flex-row gap-2";
        btnRow.style.marginTop = "0.5rem";
        const saveBtn = document.createElement("button");
        saveBtn.type = "button";
        saveBtn.className = "button button--secondary button--sm";
        saveBtn.textContent = "Save draft";
        const aiBtn = document.createElement("button");
        aiBtn.type = "button";
        aiBtn.className = "button button--sm";
        aiBtn.textContent = "Generate AI draft";
        const status = document.createElement("p");
        status.className = "text-sm muted";
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");

        async function approvedFactRevisionIds(): Promise<string[]> {
          const factKeys = [
            "business.name",
            "business.address",
            "brand.approved_claims",
          ];
          const results = await Promise.all(
            factKeys.map((factKey) =>
              resolveBusinessFact(organizationId, factKey, selectedLocationId),
            ),
          );
          return results.flatMap((result) =>
            result.kind === "ok" && result.data.selected_revision_id
              ? [result.data.selected_revision_id]
              : [],
          );
        }

        saveBtn.addEventListener("click", async () => {
          if (!textarea.value.trim()) {
            status.textContent = "Enter a response first.";
            return;
          }
          const latestRev =
            detailResult.data.revisions[detailResult.data.revisions.length - 1];
          if (!latestRev) {
            status.textContent = "No revision to respond to.";
            return;
          }
          const approvedFactIds = await approvedFactRevisionIds();
          if (approvedFactIds.length === 0) {
            status.textContent =
              "Approve at least one business fact before drafting a response.";
            return;
          }
          const result = await draftResponse(
            organizationId,
            selectedLocationId,
            review.id,
            {
              review_revision_id: latestRev.id,
              response_text: textarea.value,
              generated_by_type: "user",
              approved_fact_revision_ids: approvedFactIds,
            },
          );
          status.textContent =
            result.kind === "ok"
              ? "Draft saved."
              : describeFailure(result, "Save");
          if (result.kind === "ok") await openReview(review);
        });
        aiBtn.addEventListener("click", async () => {
          aiBtn.disabled = true;
          aiBtn.textContent = "Generating…";
          const latestRev =
            detailResult.data.revisions[detailResult.data.revisions.length - 1];
          if (!latestRev) {
            status.textContent = "No revision to respond to.";
            return;
          }
          const approvedFactIds = await approvedFactRevisionIds();
          if (approvedFactIds.length === 0) {
            status.textContent =
              "Approve at least one business fact before generating a draft.";
            aiBtn.disabled = false;
            aiBtn.textContent = "Generate AI draft";
            return;
          }
          const result = await generateAIDraft(
            organizationId,
            selectedLocationId,
            review.id,
            {
              review_revision_id: latestRev.id,
              approved_fact_revision_ids: approvedFactIds,
              idempotency_key: `web-ai-${review.id}-${Date.now()}`,
            },
          );
          if (result.kind === "ok") {
            textarea.value = result.data.response_text;
            status.textContent =
              "AI draft generated. Review it carefully before approving.";
          } else {
            status.textContent = describeFailure(result, "AI draft");
          }
          aiBtn.disabled = false;
          aiBtn.textContent = "Generate AI draft";
        });
        btnRow.append(saveBtn, aiBtn, status);
        composeBody.append(btnRow);
        composeCard.append(composeBody);
        content.append(composeCard);

        // Response history
        if (responsesResult.kind === "ok" && responsesResult.data.length > 0) {
          const historyCard = document.createElement("div");
          historyCard.className = "card";
          const historyHeader = document.createElement("div");
          historyHeader.className = "card__header";
          historyHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "card__title",
              textContent: "Response history",
            }),
          );
          historyCard.append(historyHeader);
          const historyBody = document.createElement("div");
          historyBody.className = "card__body";
          const list = document.createElement("ul");
          list.className = "product-list";
          for (const resp of responsesResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = `${resp.generated_by_type} · ${resp.status}`;
            const detail = document.createElement("p");
            detail.textContent =
              resp.response_text.length > 100
                ? resp.response_text.slice(0, 100) + "…"
                : resp.response_text;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(
                resp.status === "published"
                  ? "ready"
                  : resp.status === "approved"
                    ? "ready"
                    : "setup",
                resp.status,
              ),
            );
            if (resp.status === "awaiting_approval") {
              const approveBtn = document.createElement("button");
              approveBtn.type = "button";
              approveBtn.className = "button button--sm";
              approveBtn.textContent = "Approve";
              approveBtn.addEventListener("click", async () => {
                await approveResponse(
                  organizationId,
                  selectedLocationId,
                  review.id,
                  resp.id,
                );
                await openReview(review);
              });
              item.append(approveBtn);
            }
            if (resp.status === "approved") {
              const publishBtn = document.createElement("button");
              publishBtn.type = "button";
              publishBtn.className = "button button--sm";
              publishBtn.textContent = "Publish";
              publishBtn.addEventListener("click", async () => {
                await publishResponse(
                  organizationId,
                  selectedLocationId,
                  review.id,
                  resp.id,
                  `web-publish-${resp.id}-${Date.now()}`,
                );
                await openReview(review);
              });
              item.append(publishBtn);
            }
            list.append(item);
          }
          historyBody.append(list);
          historyCard.append(historyBody);
          content.append(historyCard);
        }
      }

      function createLoading(): HTMLDivElement {
        const el = document.createElement("div");
        el.className = "loading-state";
        el.textContent = "Loading…";
        return el;
      }

      // Wire filter apply
      document
        .getElementById("apply-filters")!
        .addEventListener("click", () => void loadReviews());

      // Wire ingest
      document
        .getElementById("ingest-reviews-button")!
        .addEventListener("click", async () => {
          const btn = document.getElementById(
            "ingest-reviews-button",
          ) as HTMLButtonElement;
          btn.disabled = true;
          btn.textContent = "Syncing…";
          const result = await ingestReviews(
            organizationId,
            selectedLocationId,
          );
          btn.disabled = false;
          btn.textContent = "Sync from Google";
          if (result.kind === "ok") {
            await loadReviews();
          } else {
            const panel = document.getElementById("reviews-list-panel")!;
            panel.prepend(errorAlert(describeFailure(result, "Sync")));
          }
        });

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Reviews");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
