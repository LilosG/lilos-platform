---
import AppShell from "../components/AppShell.astro";
import Button from "../lib/ui/Button.astro";
import CardGrid from "../lib/ui/CardGrid.astro";
import EmptyState from "../lib/ui/EmptyState.astro";
import Notice from "../lib/ui/Notice.astro";
import PageHeader from "../lib/ui/PageHeader.astro";
import PageSection from "../lib/ui/PageSection.astro";
import PageShell from "../lib/ui/PageShell.astro";
import Region from "../lib/ui/Region.astro";
import Skeleton from "../lib/ui/Skeleton.astro";
import StageStrip from "../lib/ui/StageStrip.astro";
import Tabs from "../lib/ui/Tabs.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs content" />
    <title>Content · LILOs</title>
  </head>
  <body>
    <AppShell>
      <PageShell id="boot-not-configured"
        ><EmptyState
          heading="This deployment is not configured"
          description="Connect the platform runtime configuration to enable Content."
        /></PageShell
      >
      <PageShell id="boot-loading" hidden
        ><Skeleton lines={3} label="Loading content" /></PageShell
      >
      <PageShell id="boot-error" hidden><Region role="alert" /></PageShell>
      <PageShell id="workspace-empty" hidden
        ><EmptyState
          heading="No organization access yet"
          description="Ask an administrator to invite your account to an organization."
        /></PageShell
      >

      <PageShell id="content-workspace" hidden>
        <PageHeader
          eyebrow="Operations"
          title="Content"
          description="Turn governed opportunities into reviewed, approved, and verified publications."
        >
          <Button
            slot="actions"
            id="new-content-item-button"
            variant="primary"
            size="sm">New content item</Button
          >
          <Button
            slot="actions"
            href="/integrations"
            variant="secondary"
            size="sm">Manage publishing</Button
          >
        </PageHeader>
        <Notice title="Publishing destination"
          ><p>
            GitHub connection and repository access are managed centrally.
          </p><Button
            slot="action"
            href="/integrations"
            variant="secondary"
            size="sm">Manage integrations</Button
          ></Notice
        >

        <PageSection eyebrow="Performance" title="Content scope"
          ><CardGrid id="content-metrics" minimum="sm" /></PageSection
        >
        <Tabs
          id="content-tabs"
          label="Content workspace"
          items={[
            { id: "pipeline", label: "Pipeline" },
            { id: "opportunities", label: "Opportunities" },
            { id: "publishing", label: "Publishing" },
          ]}
        >
          <Region id="tab-pipeline" tabPanel="pipeline">
            <PageSection
              eyebrow="Pipeline filter"
              title="Publishing stages"
              description="Counts are all-time summary totals. Select a stage to filter the currently loaded pipeline."
              density="compact"
            >
              <StageStrip
                id="content-stages"
                label="Pipeline stage filter"
                items={[
                  { id: "all", label: "Loaded items" },
                  { id: "draft", label: "Draft" },
                  { id: "approval", label: "Approval" },
                  { id: "published", label: "Published · all time" },
                ]}
              />
            </PageSection>
            <Region id="pipeline-list" />
          </Region>
          <Region id="tab-opportunities" tabPanel="opportunities" hidden />
          <Region id="tab-publishing" tabPanel="publishing" hidden />
        </Tabs>

        <PageSection
          id="content-detail"
          eyebrow="Content item"
          title="Content workflow"
          hidden
        >
          <Button
            slot="actions"
            id="back-to-content-pipeline"
            variant="secondary"
            size="sm">Back to pipeline</Button
          >
          <Region id="content-detail-body" live="polite" />
        </PageSection>
      </PageShell>
    </AppShell>
    <dialog
      id="new-content-item-modal"
      class="ui-modal ui-modal--md"
      aria-labelledby="new-content-modal-title"
    >
      <div class="ui-modal__surface">
        <header class="ui-modal__header">
          <div>
            <h2 id="new-content-modal-title">New content item</h2>
            <p>
              Create a standalone content item to begin the governed pipeline.
            </p>
          </div>
          <button
            type="button"
            class="ui-button ui-button--ghost"
            aria-label="Close dialog"
            id="new-content-modal-close">✕</button
          >
        </header>
        <div class="ui-modal__body">
          <form id="new-content-form" class="ui-form-grid">
            <div class="ui-field">
              <label class="ui-field__label" for="new-content-type"
                >Content type</label
              >
              <p class="ui-field__description">
                The kind of content you are creating
              </p>
              <select id="new-content-type" class="ui-input" required>
                <option value="">Select a type</option>
                <option value="blog">Blog post</option>
                <option value="page">Page</option>
                <option value="article">Article</option>
                <option value="guide">Guide</option>
                <option value="landing">Landing page</option>
              </select>
            </div>
            <div class="ui-field ui-field--full">
              <label class="ui-field__label" for="new-content-title"
                >Title</label
              >
              <p class="ui-field__description">
                A clear, descriptive title for this content item
              </p>
              <input
                id="new-content-title"
                class="ui-input"
                type="text"
                required
                maxlength="300"
              />
            </div>
            <div class="ui-field ui-field--full">
              <label class="ui-field__label" for="new-content-slug">Slug</label>
              <p class="ui-field__description">
                URL-friendly identifier — derived from your title
              </p>
              <input
                id="new-content-slug"
                class="ui-input"
                type="text"
                required
                maxlength="200"
                pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$"
              />
            </div>
            <div class="ui-field" id="new-content-location-field">
              <label class="ui-field__label" for="new-content-location"
                >Location (optional)</label
              >
              <p class="ui-field__description">
                Link this item to a specific business location
              </p>
              <select id="new-content-location" class="ui-input">
                <option value="">No location</option>
              </select>
            </div>
          </form>
          <div
            id="new-content-form-status"
            class="ui-text-secondary"
            role="status"
            aria-live="polite"
            hidden
          >
          </div>
        </div>
        <footer class="ui-modal__footer">
          <button
            type="button"
            class="ui-button ui-button--secondary ui-button--md"
            id="new-content-cancel">Cancel</button
          >
          <button
            type="submit"
            form="new-content-form"
            class="ui-button ui-button--primary ui-button--md"
            id="new-content-submit">Create item</button
          >
        </footer>
      </div>
    </dialog>
    <script>
      import {
        fetchContentSummary,
        fetchContentItems,
        fetchOpportunities,
        decideOpportunity,
        fetchPublishingTargets,
        fetchContentItem,
        fetchBriefs,
        fetchRevisions,
        fetchPublications,
        fetchItemAudit,
        createBrief,
        createRevision,
        generateAIDraft,
        decideRevision,
        createContentItem,
        isContentOpportunityActionable,
        CONTENT_REQUIRED_FACT_KEYS,
        deriveSlug,
        renderDocumentBody,
        CONTENT_GOAL_MAXLENGTH,
        AUDIENCE_MAXLENGTH,
        formatCharacterCount,
        describeContentFailure,
        storeInFlightAIDraft,
        recoverInFlightAIDraft,
        clearInFlightAIDraft,
        pollAIDraftRun,
        describeAIDraftStatus,
        isAIDraftTerminal,
        type ContentItem,
        type DurableAIDraftStart,
        type InFlightAIDraft,
      } from "../lib/content";
      import { fetchGitHubRepositories } from "../lib/github-app";
      import { fetchLocations } from "../lib/workspace";
      import {
        businessFactLabel,
        resolveBusinessFact,
      } from "../lib/administration";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        buildDataTable,
        statusBadge,
        metricCard,
        emptyState,
        errorAlert,
        describeFailure,
        formatTimestamp,
        sectionCard,
        detailFact,
        liveStatus,
        formField,
        type BootRegions,
      } from "../lib/ui";
      import { statusLabel, statusTone } from "../lib/status-language";

      let organizationId = "";
      let activeContentStage = "all";
      let loadedContentItems: ContentItem[] = [];

      const CONTENT_STAGE_STATUSES: Record<string, string[]> = {
        draft: ["briefing", "drafting", "draft"],
        approval: ["awaiting_approval", "approved", "approved_for_publish"],
        published: ["publishing", "published"],
      };

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("content-workspace")!,
      };

      document
        .getElementById("back-to-content-pipeline")!
        .addEventListener("click", showContentPipeline);

      document
        .querySelectorAll<HTMLButtonElement>("#content-stages [data-stage]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const stage = button.dataset.stage ?? "all";
            document
              .querySelectorAll<HTMLButtonElement>(
                "#content-stages [data-stage]",
              )
              .forEach((candidate) => {
                candidate.setAttribute(
                  "aria-pressed",
                  String(candidate === button),
                );
              });
            activeContentStage = stage;
            renderContentRows(loadedContentItems);
          });
        });

      function setupNewContentItemModal(): void {
        const modal = document.getElementById(
          "new-content-item-modal",
        ) as HTMLDialogElement | null;
        const openButton = document.getElementById("new-content-item-button");
        const closeButton = document.getElementById("new-content-modal-close");
        const cancelButton = document.getElementById("new-content-cancel");
        const titleInput = document.getElementById(
          "new-content-title",
        ) as HTMLInputElement | null;
        const slugInput = document.getElementById(
          "new-content-slug",
        ) as HTMLInputElement | null;
        const form = document.getElementById(
          "new-content-form",
        ) as HTMLFormElement | null;
        const submitButton = document.getElementById(
          "new-content-submit",
        ) as HTMLButtonElement | null;
        const statusEl = document.getElementById("new-content-form-status");

        if (
          !modal ||
          !openButton ||
          !closeButton ||
          !cancelButton ||
          !titleInput ||
          !slugInput ||
          !form ||
          !submitButton ||
          !statusEl
        )
          return;

        function openModal(): void {
          form!.reset();
          slugInput!.value = "";
          statusEl!.hidden = true;
          statusEl!.textContent = "";
          submitButton!.disabled = false;
          modal!.showModal();
        }

        function closeModal(): void {
          modal!.close();
        }

        openButton.addEventListener("click", openModal);
        closeButton.addEventListener("click", closeModal);
        cancelButton.addEventListener("click", closeModal);
        modal.addEventListener("click", (event) => {
          if (event.target === modal) closeModal();
        });

        titleInput.addEventListener("input", () => {
          if (document.activeElement !== slugInput) {
            slugInput!.value = deriveSlug(titleInput!.value);
          }
        });

        slugInput.addEventListener("input", () => {
          slugInput.value = slugInput.value
            .toLowerCase()
            .replace(/[^a-z0-9-]/g, "")
            .replace(/-+/g, "-")
            .replace(/^-+|-+$/g, "")
            .slice(0, 200);
        });

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!organizationId) return;
          submitButton!.disabled = true;
          statusEl!.hidden = false;
          statusEl!.textContent = "Creating content item…";

          const contentType = (
            document.getElementById("new-content-type") as HTMLSelectElement
          ).value;
          const title = titleInput!.value.trim();
          const slug = slugInput!.value.trim();
          const locationSelect = document.getElementById(
            "new-content-location",
          ) as HTMLSelectElement | null;
          const locationId = locationSelect?.value || null;

          const result = await createContentItem(organizationId, {
            contentType,
            title,
            slug,
            locationId: locationId ?? undefined,
          });

          if (result.kind === "ok") {
            closeModal();
            const [s, i, o, t] = await Promise.all([
              fetchContentSummary(organizationId),
              fetchContentItems(organizationId),
              fetchOpportunities(organizationId),
              fetchPublishingTargets(organizationId),
            ]);
            renderMetrics(s, i, o, t);
            renderContentStages(s, i, o);
            renderPipeline(i);
            renderOpportunities(o);
            void renderPublishing(t);
            await openContentItem(result.data);
          } else {
            submitButton!.disabled = false;
            statusEl!.textContent = describeFailure(result, "Content item");
          }
        });
      }

      async function populateLocationSelector(): Promise<void> {
        const select = document.getElementById(
          "new-content-location",
        ) as HTMLSelectElement | null;
        if (!select) return;
        const result = await fetchLocations(organizationId);
        if (result.kind === "ok") {
          for (const loc of result.data) {
            const option = document.createElement("option");
            option.value = loc.id;
            option.textContent = loc.name;
            select.append(option);
          }
        }
      }

      setupNewContentItemModal();

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;
        showContentPipeline();
        void populateLocationSelector();

        const [summaryResult, itemsResult, oppsResult, targetsResult] =
          await Promise.all([
            fetchContentSummary(organizationId),
            fetchContentItems(organizationId),
            fetchOpportunities(organizationId),
            fetchPublishingTargets(organizationId),
          ]);

        renderMetrics(summaryResult, itemsResult, oppsResult, targetsResult);
        renderContentStages(summaryResult, itemsResult, oppsResult);
        renderPipeline(itemsResult);
        renderOpportunities(oppsResult);
        void renderPublishing(targetsResult);
      }

      function renderMetrics(
        summary: Awaited<ReturnType<typeof fetchContentSummary>>,
        items: Awaited<ReturnType<typeof fetchContentItems>>,
        opps: Awaited<ReturnType<typeof fetchOpportunities>>,
        targets: Awaited<ReturnType<typeof fetchPublishingTargets>>,
      ): void {
        const grid = document.getElementById("content-metrics")!;
        grid.replaceChildren();

        const itemCount =
          items.kind === "ok" && items.data.length > 0
            ? String(items.data.length)
            : "No data";
        const oppCount =
          opps.kind === "ok" && opps.data.length > 0
            ? String(opps.data.length)
            : "No data";
        const openOpps =
          opps.kind === "ok"
            ? opps.data.filter((o) => isContentOpportunityActionable(o.status))
                .length
            : null;
        const targetCount =
          targets.kind === "ok" && targets.data.length > 0
            ? String(targets.data.length)
            : "No data";

        grid.append(
          metricCard("Items loaded", itemCount, "Current pipeline response"),
          metricCard(
            "Opportunities",
            oppCount,
            openOpps === null ? "Unable to load" : `${openOpps} open`,
          ),
          metricCard(
            "Publishing targets",
            targetCount,
            targets.kind !== "ok"
              ? "Unable to load"
              : targets.data.length > 0
                ? "Configured"
                : "Not configured",
          ),
        );
        if (summary.kind === "ok") {
          const published = summary.data.by_status?.["published"] ?? 0;
          grid.append(
            metricCard(
              "Published",
              published > 0 ? String(published) : "No data",
              published > 0
                ? "All-time summary · separate from loaded rows"
                : "No verified publications yet",
            ),
          );
        }
      }

      function renderContentStages(
        summary: Awaited<ReturnType<typeof fetchContentSummary>>,
        items: Awaited<ReturnType<typeof fetchContentItems>>,
        opportunities: Awaited<ReturnType<typeof fetchOpportunities>>,
      ): void {
        const byStatus = summary.kind === "ok" ? summary.data.by_status : {};
        const counts: Record<string, number> = {
          all: items.kind === "ok" ? items.data.length : 0,
          opportunities:
            summary.kind === "ok"
              ? summary.data.open_opportunities
              : opportunities.kind === "ok"
                ? opportunities.data.filter((item) =>
                    isContentOpportunityActionable(item.status),
                  ).length
                : 0,
          draft:
            (byStatus.drafting ?? 0) +
            (byStatus.draft ?? 0) +
            (byStatus.briefing ?? 0),
          approval:
            (byStatus.awaiting_approval ?? 0) +
            (byStatus.approved ?? 0) +
            (byStatus.approved_for_publish ?? 0),
          published: (byStatus.publishing ?? 0) + (byStatus.published ?? 0),
        };
        for (const [stage, count] of Object.entries(counts)) {
          const target = document.getElementById(
            `content-stages-${stage}-count`,
          );
          if (target) target.textContent = String(count);
        }
      }

      function renderPipeline(
        items: Awaited<ReturnType<typeof fetchContentItems>>,
      ): void {
        const panel = document.getElementById("pipeline-list")!;
        panel.replaceChildren();

        if (items.kind !== "ok") {
          panel.append(errorAlert(describeFailure(items, "Content items")));
          return;
        }
        loadedContentItems = items.data;
        renderContentRows(items.data);
      }

      function renderContentRows(items: ContentItem[]): void {
        const panel = document.getElementById("pipeline-list")!;
        panel.replaceChildren();
        const statuses = CONTENT_STAGE_STATUSES[activeContentStage];
        const visibleItems = statuses
          ? items.filter((item) => statuses.includes(item.status))
          : items;
        if (visibleItems.length === 0) {
          panel.append(
            emptyState(
              activeContentStage === "all"
                ? "No content items yet"
                : "No loaded items in this stage",
              activeContentStage === "all"
                ? "Create a new content item or accept a content opportunity to begin."
                : "Choose another stage or load the next pipeline page.",
            ),
          );
          return;
        }
        panel.append(
          buildDataTable(
            [
              {
                key: "title",
                header: "Title",
                render: (item: ContentItem) => item.title,
              },
              {
                key: "status",
                header: "Stage",
                render: (item: ContentItem) =>
                  statusBadge(
                    statusTone(item.status),
                    statusLabel(item.status),
                  ),
              },
              {
                key: "published",
                header: "Published",
                width: "content",
                render: (item: ContentItem) =>
                  item.published_at ? formatTimestamp(item.published_at) : "—",
              },
              {
                key: "actions",
                header: "Actions",
                width: "content",
                render: (item: ContentItem) => {
                  const openButton = document.createElement("button");
                  openButton.type = "button";
                  openButton.className =
                    "ui-button ui-button--secondary ui-button--sm";
                  openButton.textContent = "Open";
                  openButton.addEventListener(
                    "click",
                    () => void openContentItem(item),
                  );
                  return openButton;
                },
              },
            ],
            visibleItems,
          ),
        );
      }

      function renderOpportunities(
        opps: Awaited<ReturnType<typeof fetchOpportunities>>,
      ): void {
        const panel = document.getElementById("tab-opportunities")!;
        panel.replaceChildren();

        if (opps.kind !== "ok") {
          panel.append(errorAlert(describeFailure(opps, "Opportunities")));
          return;
        }
        if (opps.data.length === 0) {
          panel.append(
            emptyState(
              "No opportunities yet",
              "Opportunities will appear here when SEO and content analysis identify them.",
            ),
          );
          return;
        }

        const list = document.createElement("ul");
        list.className = "ui-record-list";
        for (const opp of opps.data) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = statusLabel(opp.opportunity_type);
          const detail = document.createElement("p");
          detail.textContent = `Priority ${opp.priority_score} · ${statusLabel(opp.status)}`;
          info.append(name, detail);
          item.append(
            info,
            statusBadge(statusTone(opp.status), statusLabel(opp.status)),
          );
          if (isContentOpportunityActionable(opp.status)) {
            const acceptBtn = document.createElement("button");
            acceptBtn.type = "button";
            acceptBtn.className = "ui-button ui-button--primary ui-button--sm";
            acceptBtn.textContent = "Accept";
            acceptBtn.addEventListener("click", async () => {
              const result = await decideOpportunity(
                organizationId,
                opp.id,
                true,
              );
              if (result.kind === "ok") {
                const [s, i, o, t] = await Promise.all([
                  fetchContentSummary(organizationId),
                  fetchContentItems(organizationId),
                  fetchOpportunities(organizationId),
                  fetchPublishingTargets(organizationId),
                ]);
                renderMetrics(s, i, o, t);
                renderContentStages(s, i, o);
                renderPipeline(i);
                renderOpportunities(o);
                void renderPublishing(t);
              }
            });
            item.append(acceptBtn);
          }
          list.append(item);
        }
        panel.append(list);
      }

      async function renderPublishing(
        targets: Awaited<ReturnType<typeof fetchPublishingTargets>>,
      ): Promise<void> {
        const panel = document.getElementById("tab-publishing")!;
        panel.replaceChildren();

        if (targets.kind !== "ok") {
          panel.append(
            errorAlert(describeFailure(targets, "Publishing targets")),
          );
          return;
        }

        const repositories = await fetchGitHubRepositories(organizationId);
        const repositoryNames = new Map(
          repositories.kind === "ok"
            ? repositories.data.map((repository) => [
                repository.repository_id,
                repository.name,
              ])
            : [],
        );

        if (targets.data.length === 0) {
          const banner = document.createElement("div");
          banner.className = "ui-notice ui-notice--warning";
          const copy = document.createElement("div");
          copy.append(
            Object.assign(document.createElement("strong"), {
              textContent: "Publishing setup required",
            }),
            Object.assign(document.createElement("p"), {
              textContent:
                "Map an authorized GitHub repository before content can be published.",
            }),
          );
          const link = document.createElement("a");
          link.className = "ui-button ui-button--secondary ui-button--sm";
          link.href = "/integrations";
          link.textContent = "Manage GitHub";
          banner.append(copy, link);
          panel.append(banner);
          return;
        }

        for (const target of targets.data) {
          const card = document.createElement("div");
          card.className = "ui-card";
          const header = document.createElement("div");
          header.className = "ui-card__header";
          header.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent:
                repositoryNames.get(target.repository_id) ??
                "Configured repository",
            }),
          );
          header.append(
            Object.assign(document.createElement("p"), {
              className: "ui-card__description",
              textContent: `${target.base_branch} · ${target.allowed_path_prefix}`,
            }),
          );
          card.append(header);
          const body = document.createElement("div");
          body.className = "ui-card__body";
          body.append(
            statusBadge(statusTone(target.status), statusLabel(target.status)),
          );
          card.append(body);
          panel.append(card);
        }
      }

      function selectContentTab(name: string): void {
        document
          .querySelector<HTMLButtonElement>(
            `#content-tabs [data-tab="${name}"]`,
          )
          ?.click();
      }

      function showContentPipeline(): void {
        document.getElementById("content-detail")!.hidden = true;
        document.getElementById("content-metrics")!.hidden = false;
        document.getElementById("content-tabs")!.hidden = false;
        selectContentTab("pipeline");
      }

      // Track an in-flight AI draft generation via sessionStorage so a
      // browser refresh can recover the operation truthfully.  The
      // idempotency key is reused across retries until the operation is
      // definitively completed, failed, or the user navigates away.
      function getActiveAiDraftState(
        itemId: string,
        briefId: string,
      ): InFlightAIDraft | null {
        return recoverInFlightAIDraft(organizationId, itemId, briefId);
      }

      function setActiveAiDraftState(state: InFlightAIDraft): void {
        storeInFlightAIDraft(organizationId, state);
      }

      function clearAiDraftState(itemId: string, briefId: string): void {
        clearInFlightAIDraft(organizationId, itemId, briefId);
      }

      /**
       * Resume polling a previously-started durable AI draft operation.
       *
       * Called on page load when sessionStorage contains an in-flight
       * operation, and also after a successful start.  Polls every 3
       * seconds until the run reaches a terminal state, then refreshes
       * the workspace or shows the failure.
       */
      async function resumeAIDraftPolling(
        item: ContentItem,
        brief: { id: string },
        state: InFlightAIDraft,
        documentArea: HTMLElement,
      ): Promise<void> {
        const POLL_INTERVAL_MS = 3_000;
        const MAX_POLL_ATTEMPTS = 200; // ~10 minutes at 3s intervals

        for (let attempt = 0; attempt < MAX_POLL_ATTEMPTS; attempt++) {
          const pollResult = await pollAIDraftRun(organizationId, state.runId);

          if (!pollResult) {
            // Run not found — may have been cleaned up.  Refresh to
            // check whether a revision was created.
            clearAiDraftState(item.id, brief.id);
            await openContentItem(item);
            return;
          }

          const { status } = pollResult;

          // Update the UI status text if the button/status elements are
          // still in the DOM.
          const aiStatus = documentArea.querySelector<HTMLElement>(
            "[data-ai-draft-status]",
          );
          if (aiStatus) {
            aiStatus.textContent = describeAIDraftStatus(status);
          }

          if (isAIDraftTerminal(status)) {
            clearAiDraftState(item.id, brief.id);
            if (status === "completed") {
              await openContentItem(item);
            }
            // For failed/cancelled, the status text already shows the
            // message; the button is re-enabled by the caller.
            return;
          }

          // Wait before polling again.
          await new Promise((resolve) => setTimeout(resolve, POLL_INTERVAL_MS));
        }

        // Exceeded max attempts — treat as failed.
        clearAiDraftState(item.id, brief.id);
        const aiStatus = documentArea.querySelector<HTMLElement>(
          "[data-ai-draft-status]",
        );
        if (aiStatus) {
          aiStatus.textContent =
            "Draft generation is taking longer than expected.  The platform is still working — refresh the page to check for updates.";
        }
      }

      async function openContentItem(item: ContentItem): Promise<void> {
        document.getElementById("content-metrics")!.hidden = true;
        document.getElementById("content-tabs")!.hidden = true;
        document
          .querySelectorAll<HTMLElement>("#content-workspace > .tab-panel")
          .forEach((panel) => (panel.hidden = true));
        const detail = document.getElementById("content-detail")!;
        const body = document.getElementById("content-detail-body")!;
        detail.hidden = false;
        body.replaceChildren(
          Object.assign(document.createElement("div"), {
            className: "ui-skeleton-group",
            textContent: "Loading content workspace…",
          }),
        );

        const [
          itemResult,
          briefs,
          revisions,
          publications,
          audit,
          factResolutions,
        ] = await Promise.all([
          fetchContentItem(organizationId, item.id),
          fetchBriefs(organizationId, item.id),
          fetchRevisions(organizationId, item.id),
          fetchPublications(organizationId, item.id),
          fetchItemAudit(organizationId, item.id),
          Promise.all(
            CONTENT_REQUIRED_FACT_KEYS.map((key) =>
              resolveBusinessFact(organizationId, key),
            ),
          ),
        ]);
        if (itemResult.kind !== "ok") {
          body.replaceChildren(
            errorAlert(describeFailure(itemResult, "Content item")),
          );
          return;
        }

        const current = itemResult.data;
        body.replaceChildren();

        // ---- Item header ----
        const header = document.createElement("div");
        header.className = "ui-page-header";
        const intro = document.createElement("div");
        intro.className = "ui-page-header__identity";
        intro.append(
          Object.assign(document.createElement("p"), {
            className: "ui-overline",
            textContent: statusLabel(current.content_type),
          }),
          Object.assign(document.createElement("h2"), {
            textContent: current.title,
          }),
          Object.assign(document.createElement("p"), {
            textContent:
              "Build the brief, review revisions, approve the final copy, and follow provider-observed publication state.",
          }),
        );
        header.append(
          intro,
          statusBadge(statusTone(current.status), statusLabel(current.status)),
        );
        body.append(header);

        // ---- Editorial workspace (two-column on desktop) ----
        const workspace = document.createElement("div");
        workspace.className = "content-editorial-workspace";

        const contextRail = document.createElement("aside");
        contextRail.className = "content-editorial__context";

        const documentArea = document.createElement("div");
        documentArea.className = "content-editorial__document";

        workspace.append(contextRail, documentArea);
        body.append(workspace);

        renderContextRail(
          contextRail,
          current,
          briefs,
          factResolutions,
          revisions,
        );
        renderRevisionWorkspace(documentArea, current, briefs, revisions);

        // ---- Secondary area: publication + activity ----
        const secondary = document.createElement("div");
        secondary.className = "content-editorial__secondary";

        // Publication is visible as a secondary card once the item is
        // past early-stage editorial phases.  It must not dominate the
        // primary editing viewport while the user is still drafting.
        const pubVisibilityStages = [
          "approved",
          "approved_for_publish",
          "publishing",
          "published",
        ];
        const showPublication = pubVisibilityStages.includes(current.status);
        if (showPublication) {
          secondary.append(renderPublicationWorkspace(publications));
        }
        secondary.append(renderContentActivity(audit));
        body.append(secondary);

        // ---- Recover in-flight AI draft operation ----
        const latestBrief = briefs.kind === "ok" ? briefs.data[0] : undefined;
        if (latestBrief) {
          const inFlight = getActiveAiDraftState(item.id, latestBrief.id);
          if (inFlight) {
            void resumeAIDraftPolling(
              item,
              latestBrief,
              inFlight,
              documentArea,
            );
          }
        }
      }

      /* ----------------------------------------------------------------
         CONTEXT RAIL (~30 % of the editorial workspace on desktop)
         ---------------------------------------------------------------- */
      function renderContextRail(
        container: HTMLElement,
        item: ContentItem,
        briefs: Awaited<ReturnType<typeof fetchBriefs>>,
        factResolutions: Awaited<ReturnType<typeof resolveBusinessFact>>[],
        revisions: Awaited<ReturnType<typeof fetchRevisions>>,
      ): void {
        const card = sectionCard(
          "Context",
          "Audience, intent, approved business details, and source information.",
        );
        const body = card.querySelector<HTMLElement>(".ui-card__body")!;
        container.append(card);

        if (briefs.kind !== "ok") {
          body.append(errorAlert(describeFailure(briefs, "Briefs")));
          return;
        }

        const latestBrief = briefs.data[0];
        const latestRevision =
          revisions.kind === "ok" ? revisions.data[0] : undefined;

        if (latestBrief) {
          body.append(
            detailFact("Audience", latestBrief.audience),
            detailFact("Intent", latestBrief.intent),
            detailFact(
              "Business details",
              `${latestBrief.approved_fact_revision_ids.length} governed revision${latestBrief.approved_fact_revision_ids.length === 1 ? "" : "s"}`,
            ),
          );
          if (latestRevision) {
            body.append(
              detailFact(
                "Current revision",
                `Revision ${latestRevision.revision_number} · ${statusLabel(latestRevision.status)}`,
              ),
            );
          }
          body.append(
            statusBadge(
              statusTone(latestBrief.status),
              statusLabel(latestBrief.status),
            ),
          );
          // Also show the existing brief form for creating a new brief
          // when the operator wants to change direction.  We reuse the
          // brief-creation form but present it collapsed behind a
          // `<details>` element so it does not dominate the context rail.
          renderBriefCreationForm(body, item, factResolutions);
          return;
        }

        // ---- No brief yet: show fact readiness and the creation form ----
        const facts = CONTENT_REQUIRED_FACT_KEYS.map((key, index) => ({
          key,
          outcome: factResolutions[index],
        }));
        const approvedFactRevisionIds = facts.flatMap(({ outcome }) =>
          outcome.kind === "ok" &&
          outcome.data.state === "resolved" &&
          outcome.data.selected_revision_id
            ? [outcome.data.selected_revision_id]
            : [],
        );

        const factList = document.createElement("div");
        factList.className = "ui-stack ui-stack--2";
        for (const { key, outcome } of facts) {
          const resolved =
            outcome.kind === "ok" &&
            outcome.data.state === "resolved" &&
            Boolean(outcome.data.selected_revision_id);
          factList.append(
            detailFact(
              businessFactLabel(key),
              resolved
                ? "Approved"
                : outcome.kind === "ok"
                  ? outcome.data.state === "ambiguous"
                    ? "Needs review"
                    : "Missing"
                  : "Unavailable",
            ),
          );
        }
        body.append(factList);

        if (
          approvedFactRevisionIds.length !== CONTENT_REQUIRED_FACT_KEYS.length
        ) {
          body.append(
            emptyState(
              "Approved business details required",
              "Confirm the business name and approved claims in Governance before creating a grounded content brief.",
              "Review business details",
              "/settings",
            ),
          );
          return;
        }

        renderBriefCreationForm(
          body,
          item,
          factResolutions,
          approvedFactRevisionIds,
        );
      }

      /** Append the brief creation form.  When `approvedFactRevisionIds` is
       *  omitted the form is placed behind a `<details>` element because a
       *  brief already exists. */
      function renderBriefCreationForm(
        container: HTMLElement,
        item: ContentItem,
        factResolutions: Awaited<ReturnType<typeof resolveBusinessFact>>[],
        precomputedFactRevisionIds?: string[],
      ): void {
        const facts = CONTENT_REQUIRED_FACT_KEYS.map((key, index) => ({
          key,
          outcome: factResolutions[index],
        }));
        const approvedFactRevisionIds =
          precomputedFactRevisionIds ??
          facts.flatMap(({ outcome }) =>
            outcome.kind === "ok" &&
            outcome.data.state === "resolved" &&
            outcome.data.selected_revision_id
              ? [outcome.data.selected_revision_id]
              : [],
          );

        if (
          approvedFactRevisionIds.length !== CONTENT_REQUIRED_FACT_KEYS.length
        ) {
          return;
        }

        const form = document.createElement("form");
        form.className = "ui-form-grid";

        const audienceInput = document.createElement("input");
        audienceInput.type = "text";
        audienceInput.required = true;
        audienceInput.maxLength = AUDIENCE_MAXLENGTH;

        const intentInput = document.createElement("textarea");
        intentInput.required = true;
        intentInput.rows = 3;
        intentInput.maxLength = CONTENT_GOAL_MAXLENGTH;

        form.append(
          formField("Audience", audienceInput, {
            hint: `Who this content should help · ${formatCharacterCount(0, AUDIENCE_MAXLENGTH)} maximum`,
            id: `content-audience-${item.id}`,
            characterLimit: AUDIENCE_MAXLENGTH,
          }),
          formField("Content goal", intentInput, {
            hint: `The question or outcome this content should address · ${formatCharacterCount(0, CONTENT_GOAL_MAXLENGTH)} maximum`,
            full: true,
            id: `content-intent-${item.id}`,
            characterLimit: CONTENT_GOAL_MAXLENGTH,
          }),
        );

        const submit = document.createElement("button");
        submit.className = "ui-button ui-button--primary ui-button--md";
        submit.type = "submit";
        submit.textContent = "Create brief";
        const status = liveStatus();
        form.append(submit, status);

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          // Client-side guard mirroring the backend contract.
          if (intentInput.value.length > CONTENT_GOAL_MAXLENGTH) {
            status.textContent = `Content goal must be ${CONTENT_GOAL_MAXLENGTH} characters or fewer.`;
            return;
          }
          if (audienceInput.value.length > AUDIENCE_MAXLENGTH) {
            status.textContent = `Audience must be ${AUDIENCE_MAXLENGTH} characters or fewer.`;
            return;
          }
          submit.disabled = true;
          status.textContent = "Creating brief…";
          const result = await createBrief(organizationId, item.id, {
            audience: audienceInput.value.trim(),
            intent: intentInput.value.trim(),
            targetReference: item.slug,
            approvedFactRevisionIds,
          });
          if (result.kind === "ok") await openContentItem(item);
          else {
            submit.disabled = false;
            status.textContent = describeContentFailure(result, "Brief");
          }
        });

        const wrapper = document.createElement("div");
        wrapper.className = "stack-top-4";
        // When a brief already exists, use <details> to collapse the
        // creation form so the operator can still create a fresh brief
        // without it dominating the context rail.
        if (precomputedFactRevisionIds === undefined) {
          wrapper.append(form);
        } else {
          const details = document.createElement("details");
          const summary = document.createElement("summary");
          summary.textContent = "Create a new brief";
          details.append(summary, form);
          wrapper.append(details);
        }
        container.append(wrapper);
      }

      /* ----------------------------------------------------------------
         REVISION / DOCUMENT WORKSPACE
         ---------------------------------------------------------------- */
      function renderRevisionWorkspace(
        container: HTMLElement,
        item: ContentItem,
        briefs: Awaited<ReturnType<typeof fetchBriefs>>,
        revisions: Awaited<ReturnType<typeof fetchRevisions>>,
      ): void {
        if (revisions.kind !== "ok") {
          container.append(sectionCard("Revision", undefined));
          const card = container.lastElementChild!;
          const body = card.querySelector<HTMLElement>(".ui-card__body")!;
          body.append(errorAlert(describeFailure(revisions, "Revisions")));
          return;
        }

        const latestBrief = briefs.kind === "ok" ? briefs.data[0] : undefined;
        const latest = revisions.data[0];

        if (latest) {
          // ---- Render the revision with safe structured document output ----
          const section = sectionCard(
            `Revision ${latest.revision_number}`,
            undefined,
          );
          const body = section.querySelector<HTMLElement>(".ui-card__body")!;

          // Status bar
          const statusBar = document.createElement("div");
          statusBar.className =
            "ui-inline ui-inline--center ui-inline--spread stack-bottom-4";
          statusBar.append(
            statusBadge(statusTone(latest.status), statusLabel(latest.status)),
          );
          if (latest.approved_at) {
            const approvedInfo = document.createElement("span");
            approvedInfo.className = "ui-text-secondary";
            approvedInfo.textContent = `Approved ${formatTimestamp(latest.approved_at)}`;
            statusBar.append(approvedInfo);
          }
          body.append(statusBar);

          // Grounding provenance — show actual persisted grounding references
          if (latest.created_by_type === "ai" && latest.provenance) {
            const prov = latest.provenance;
            const parts: string[] = [];
            if (prov.fact_count > 0) {
              parts.push(
                `${prov.fact_count} approved fact${prov.fact_count === 1 ? "" : "s"}`,
              );
            }
            const sourceEntries = Object.entries(prov.source_counts);
            for (const [label, count] of sourceEntries) {
              parts.push(`${count} ${label} source${count === 1 ? "" : "s"}`);
            }

            const provenance = document.createElement("div");
            provenance.className = "stack-bottom-4";

            const summary = document.createElement("p");
            summary.className = "ui-text-secondary";
            summary.textContent =
              parts.length > 0
                ? `Grounded with ${parts.join(" · ")}`
                : "AI-assisted draft requires human review.";
            provenance.append(summary);

            // Expandable source detail
            if (prov.source_labels.length > 0) {
              const details = document.createElement("details");
              details.className = "ui-text-secondary";
              const dtSummary = document.createElement("summary");
              dtSummary.textContent = "Source references";
              dtSummary.style.cursor = "pointer";
              details.append(dtSummary);

              const list = document.createElement("ul");
              list.className = "ui-stack ui-stack--1";
              list.style.marginTop = "0.5rem";
              for (const src of prov.source_labels) {
                const li = document.createElement("li");
                if (src.url) {
                  const link = document.createElement("a");
                  link.href = src.url;
                  link.target = "_blank";
                  link.rel = "noreferrer";
                  link.textContent = src.title || src.url;
                  link.className = "ui-text-secondary";
                  li.append(`${src.label}: `, link);
                } else {
                  li.textContent = `${src.label}: ${src.title || "—"}`;
                }
                list.append(li);
              }
              details.append(list);
              provenance.append(details);
            }

            body.append(provenance);
          }

          // Rendered document body (safe DOM rendering, no innerHTML)
          const docContainer = renderDocumentBody(latest.body);

          // Validation state
          if (!latest.validation_document.valid) {
            const validationNote = document.createElement("div");
            validationNote.className =
              "ui-notice ui-notice--warning stack-top-4";
            const vText = document.createElement("p");
            vText.textContent =
              latest.validation_document.errors.join(" · ") ||
              "This revision did not pass validation.";
            validationNote.append(vText);
            body.append(validationNote);
          }

          body.append(docContainer);

          // Approval actions tied to the current revision stage
          const actions = document.createElement("div");
          actions.className =
            "ui-inline ui-inline--center ui-inline--tight stack-top-4";
          if (latest.status === "awaiting_editorial") {
            actions.append(
              revisionDecisionButton(
                item,
                latest.id,
                "editorial",
                "Approve editorial review",
              ),
            );
          } else if (latest.status === "awaiting_client") {
            actions.append(
              revisionDecisionButton(
                item,
                latest.id,
                "client",
                "Approve for publishing",
              ),
            );
          }
          body.append(actions);
          container.append(section);
        } else {
          const section = sectionCard(
            "Document",
            "No draft yet.  Create a brief, then generate or write the first revision.",
          );
          const body = section.querySelector<HTMLElement>(".ui-card__body")!;
          body.append(
            emptyState(
              "No draft yet",
              latestBrief
                ? "Generate a draft or write the first revision below."
                : "Create a brief before starting a draft.",
            ),
          );
          container.append(section);
        }

        // ---- Generation / manual-entry actions (always shown when a
        //      brief exists regardless of revision state) ----
        if (latestBrief) {
          const actionSection = sectionCard(
            "Actions",
            "Generate an AI-assisted draft or write a revision manually.",
          );
          const actionsBody =
            actionSection.querySelector<HTMLElement>(".ui-card__body")!;

          // AI Draft generation
          const genRow = document.createElement("div");
          genRow.className = "ui-inline ui-inline--center ui-inline--spread";
          const genInfo = document.createElement("div");
          const genTitle = document.createElement("h4");
          genTitle.textContent = "Assisted draft";
          const genHint = document.createElement("p");
          genHint.className = "ui-text-secondary";
          genHint.textContent =
            "AI generation runs in the background.  The page will update automatically when complete.";
          genInfo.append(genTitle, genHint);

          const aiButton = document.createElement("button");
          aiButton.type = "button";
          aiButton.className = "ui-button ui-button--secondary ui-button--md";
          aiButton.textContent = "Generate assisted draft";
          const aiStatus = liveStatus();
          aiStatus.setAttribute("data-ai-draft-status", "");
          const genActions = document.createElement("div");
          genActions.className = "ui-inline ui-inline--center ui-inline--tight";
          genActions.append(aiButton, aiStatus);
          genRow.append(genInfo, genActions);

          // If an in-flight operation exists for this item+brief, resume
          // polling and disable the button immediately.
          const existingState = getActiveAiDraftState(item.id, latestBrief.id);
          if (existingState) {
            aiButton.disabled = true;
            aiStatus.textContent = describeAIDraftStatus("queued");
            void resumeAIDraftPolling(
              item,
              latestBrief,
              existingState,
              container,
            ).then(() => {
              // Re-enable the button on terminal failure.
              const currentState = getActiveAiDraftState(
                item.id,
                latestBrief.id,
              );
              if (!currentState) {
                aiButton.disabled = false;
              }
            });
          }

          aiButton.addEventListener("click", async () => {
            aiButton.disabled = true;
            aiStatus.textContent = "Starting generation…";

            // Reuse the existing idempotency key if this is a retry of
            // the same brief within the same item view.  A new UUID is
            // only minted the first time or after a clear.
            let state = getActiveAiDraftState(item.id, latestBrief.id);
            if (!state) {
              state = {
                itemId: item.id,
                briefId: latestBrief.id,
                idempotencyKey: crypto.randomUUID(),
                runId: "", // filled after start response
              };
            }

            const result = await generateAIDraft(
              organizationId,
              item.id,
              latestBrief.id,
              state.idempotencyKey,
            );

            if (result.kind === "ok") {
              const startData: DurableAIDraftStart = result.data;
              state.runId = startData.workflow_run_id;
              setActiveAiDraftState(state);
              aiStatus.textContent = describeAIDraftStatus("queued");
              void resumeAIDraftPolling(
                item,
                latestBrief,
                state,
                container,
              ).then(() => {
                const currentState = getActiveAiDraftState(
                  item.id,
                  latestBrief.id,
                );
                if (!currentState) {
                  aiButton.disabled = false;
                }
              });
            } else {
              aiButton.disabled = false;
              aiStatus.textContent = describeContentFailure(
                result,
                "Draft generation",
              );
              // Do NOT clear the idempotency key on failure so a retry
              // uses the same identity.  The backend is expected to
              // handle the duplicate idempotency key safely.
            }
          });

          actionsBody.append(genRow);

          // Manual revision entry
          const divider = document.createElement("hr");
          divider.className = "ui-divider";
          actionsBody.append(divider);

          const form = document.createElement("form");
          form.className = "ui-form-grid";
          const copy = document.createElement("textarea");
          copy.required = true;
          copy.rows = 10;
          form.append(
            formField("Write a revision", copy, {
              hint: "Use approved business facts and review before publishing",
              full: true,
              id: `content-revision-${item.id}`,
            }),
          );
          const submit = document.createElement("button");
          submit.type = "submit";
          submit.className = "ui-button ui-button--primary ui-button--md";
          submit.textContent = "Save revision";
          const status = liveStatus();
          form.append(submit, status);
          form.addEventListener("submit", async (event) => {
            event.preventDefault();
            submit.disabled = true;
            status.textContent = "Saving revision…";
            const result = await createRevision(organizationId, item.id, {
              body: copy.value,
              frontmatter: { title: item.title, slug: item.slug },
              approvedFactRevisionIds: latestBrief.approved_fact_revision_ids,
            });
            if (result.kind === "ok") await openContentItem(item);
            else {
              submit.disabled = false;
              status.textContent = describeContentFailure(result, "Revision");
            }
          });
          actionsBody.append(form);
          container.append(actionSection);
        }

        // ---- Revision history ----
        if (revisions.data.length > 1) {
          const historySection = sectionCard(
            "Revision history",
            "Previous revisions remain reviewable.",
          );
          const historyBody =
            historySection.querySelector<HTMLElement>(".ui-card__body")!;
          for (const rev of revisions.data.slice(1, 6)) {
            const row = document.createElement("div");
            row.className = "ui-inline ui-inline--center ui-inline--spread";
            const info = document.createElement("div");
            const revNum = document.createElement("strong");
            revNum.textContent = `Revision ${rev.revision_number}`;
            const meta = document.createElement("span");
            meta.className = "ui-text-secondary";
            meta.textContent = ` · ${statusLabel(rev.status)}`;
            info.append(revNum, meta);
            row.append(
              info,
              statusBadge(statusTone(rev.status), statusLabel(rev.status)),
            );
            historyBody.append(row);
          }
          container.append(historySection);
        }
      }

      function revisionDecisionButton(
        item: ContentItem,
        revisionId: string,
        stage: "editorial" | "client",
        label: string,
      ): HTMLButtonElement {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "ui-button ui-button--primary ui-button--md";
        button.textContent = label;
        button.addEventListener("click", async () => {
          button.disabled = true;
          const result = await decideRevision(
            organizationId,
            item.id,
            revisionId,
            stage,
            true,
          );
          if (result.kind === "ok") await openContentItem(item);
          else {
            button.disabled = false;
            button.insertAdjacentElement(
              "afterend",
              errorAlert(describeContentFailure(result, "Approval")),
            );
          }
        });
        return button;
      }

      function renderPublicationWorkspace(
        publications: Awaited<ReturnType<typeof fetchPublications>>,
      ): HTMLElement {
        const card = sectionCard(
          "Publication",
          "Provider-observed publishing and deployment state.",
        );
        const body = card.querySelector<HTMLElement>(".ui-card__body")!;
        if (publications.kind !== "ok") {
          body.append(
            errorAlert(describeContentFailure(publications, "Publications")),
          );
        } else if (publications.data.length === 0) {
          body.append(
            emptyState(
              "Not submitted for publishing",
              "After final approval, publishing requires a configured target and an accepted publishing connector.",
              "Review publishing setup",
              "/integrations",
            ),
          );
        } else {
          for (const publication of publications.data) {
            const row = document.createElement("div");
            row.className = "ui-inline ui-inline--center ui-inline--spread";
            const info = document.createElement("div");
            const title = document.createElement("h4");
            title.textContent = publication.target_path || "Publication";
            const detail = document.createElement("p");
            detail.textContent = publication.verified_at
              ? `Verified ${formatTimestamp(publication.verified_at)}`
              : "Awaiting provider verification";
            info.append(title, detail);
            row.append(
              info,
              statusBadge(
                statusTone(publication.status),
                statusLabel(publication.status),
              ),
            );
            if (publication.published_url) {
              const link = document.createElement("a");
              link.href = publication.published_url;
              link.target = "_blank";
              link.rel = "noreferrer";
              link.textContent = "View published page";
              row.append(link);
            }
            body.append(row);
          }
        }
        return card;
      }

      function renderContentActivity(
        audit: Awaited<ReturnType<typeof fetchItemAudit>>,
      ): HTMLElement {
        const card = sectionCard(
          "Recent activity",
          "A concise history of work on this item.",
        );
        const body = card.querySelector<HTMLElement>(".ui-card__body")!;
        if (audit.kind !== "ok") {
          body.append(errorAlert(describeContentFailure(audit, "Activity")));
        } else if (audit.data.length === 0) {
          body.append(
            emptyState(
              "No recorded changes",
              "Content activity will appear here.",
            ),
          );
        } else {
          for (const entry of audit.data.slice(0, 8)) {
            body.append(
              detailFact(entry.summary, formatTimestamp(entry.occurred_at)),
            );
          }
        }
        return card;
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Content");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
