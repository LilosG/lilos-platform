---
import AppShell from "../components/AppShell.astro";
import Button from "../lib/ui/Button.astro";
import EmptyState from "../lib/ui/EmptyState.astro";
import PageHeader from "../lib/ui/PageHeader.astro";
import PageShell from "../lib/ui/PageShell.astro";
import Region from "../lib/ui/Region.astro";
import Skeleton from "../lib/ui/Skeleton.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="LILOs Content workflow" />
    <title>Content · LILOs</title>
  </head>
  <body>
    <AppShell>
      <PageShell id="boot-not-configured">
        <EmptyState
          heading="This deployment is not configured"
          description="Connect the platform runtime configuration to enable Content."
        />
      </PageShell>
      <PageShell id="boot-loading" hidden>
        <Skeleton lines={4} label="Loading Content" />
      </PageShell>
      <PageShell id="boot-error" hidden><Region role="alert" /></PageShell>
      <PageShell id="workspace-empty" hidden>
        <EmptyState
          heading="No organization access yet"
          description="Ask an administrator to invite your account to an organization."
        />
      </PageShell>

      <PageShell id="content-workspace" hidden>
        <PageHeader
          eyebrow="Operations"
          title="Content"
          description="Move each idea through one clear path: brief, draft, review, approval, publishing, verification."
        >
          <Button
            slot="actions"
            href="/automations?agent=agent.content"
            variant="secondary"
            size="sm">Run Content agent</Button
          >
          <Button slot="actions" id="new-item" variant="primary" size="sm">
            New content item
          </Button>
        </PageHeader>

        <div id="content-list-view">
          <section class="content-summary" aria-label="Content summary">
            <div class="content-summary__card">
              <span>Needs action</span><strong id="metric-action">0</strong>
            </div>
            <div class="content-summary__card">
              <span>Ready to publish</span><strong id="metric-ready">0</strong>
            </div>
            <div class="content-summary__card">
              <span>Publishing</span><strong id="metric-publishing">0</strong>
            </div>
            <div class="content-summary__card">
              <span>Published</span><strong id="metric-published">0</strong>
            </div>
          </section>

          <section class="content-panel">
            <div class="content-panel__header">
              <div>
                <p class="content-eyebrow">Pipeline</p>
                <h2>What needs to happen next</h2>
                <p>Each item shows one current stage and one next action.</p>
              </div>
              <div
                class="content-filters"
                role="group"
                aria-label="Filter content"
              >
                <button type="button" data-filter="active" aria-pressed="true"
                  >Active</button
                >
                <button
                  type="button"
                  data-filter="publishing"
                  aria-pressed="false">Publishing</button
                >
                <button
                  type="button"
                  data-filter="published"
                  aria-pressed="false">Published</button
                >
                <button type="button" data-filter="all" aria-pressed="false"
                  >All</button
                >
              </div>
            </div>
            <Region id="content-list" live="polite" />
          </section>

          <section class="content-panel">
            <details>
              <summary>Content opportunities</summary>
              <p class="content-secondary">
                Evidence-backed opportunities stay separate from the working
                pipeline until you accept them.
              </p>
              <Region id="opportunity-list" live="polite" />
            </details>
          </section>
        </div>

        <div id="content-detail-view" hidden>
          <div class="content-back-row">
            <button
              type="button"
              class="ui-button ui-button--secondary ui-button--sm"
              id="back-to-list"
            >
              ← Back to content
            </button>
          </div>
          <Region id="content-detail" live="polite" />
        </div>
      </PageShell>
    </AppShell>

    <dialog
      id="new-item-modal"
      class="ui-modal ui-modal--md"
      aria-labelledby="new-item-title"
    >
      <div class="ui-modal__surface">
        <header class="ui-modal__header">
          <div>
            <h2 id="new-item-title">New content item</h2>
            <p>
              Start with the page you want to create. LILOs will guide the
              remaining steps.
            </p>
          </div>
          <button
            type="button"
            class="ui-button ui-button--ghost"
            id="close-new-item"
            aria-label="Close">✕</button
          >
        </header>
        <form id="new-item-form" class="ui-modal__body ui-form-grid">
          <div class="ui-field">
            <label class="ui-field__label" for="content-type"
              >Content type</label
            >
            <select id="content-type" class="ui-input" required>
              <option value="blog">Blog post</option>
              <option value="page">Page</option>
              <option value="guide">Guide</option>
              <option value="landing">Landing page</option>
            </select>
          </div>
          <div class="ui-field">
            <label class="ui-field__label" for="content-location"
              >Location</label
            >
            <select id="content-location" class="ui-input">
              <option value="">Organization-wide</option>
            </select>
          </div>
          <div class="ui-field ui-field--full">
            <label class="ui-field__label" for="content-title">Title</label>
            <input
              id="content-title"
              class="ui-input"
              maxlength="300"
              required
            />
          </div>
          <div class="ui-field ui-field--full">
            <label class="ui-field__label" for="content-slug">URL slug</label>
            <input
              id="content-slug"
              class="ui-input"
              maxlength="200"
              required
            />
          </div>
          <p id="new-item-status" class="ui-text-secondary" role="status"></p>
        </form>
        <footer class="ui-modal__footer">
          <button
            type="button"
            class="ui-button ui-button--secondary ui-button--md"
            id="cancel-new-item">Cancel</button
          >
          <button
            type="submit"
            form="new-item-form"
            class="ui-button ui-button--primary ui-button--md"
            id="create-new-item">Create item</button
          >
        </footer>
      </div>
    </dialog>

    <script>
      import {
        CONTENT_REQUIRED_FACT_KEYS,
        createBrief,
        createContentItem,
        createRevision,
        decideOpportunity,
        deriveSlug,
        describeAIDraftStatus,
        describeContentFailure,
        fetchOpportunities,
        generateAIDraft,
        isAIDraftTerminal,
        pollAIDraftRun,
        renderDocumentBody,
        type ContentOpportunity,
      } from "../lib/content";
      import {
        contentStageLabel,
        contentStageTone,
        decideContentOperationRevision,
        fetchContentOperation,
        fetchContentOperations,
        fetchContentPublishingAssets,
        publishContentOperation,
        type ContentImageAsset,
        type ContentOperatorDetail,
        type ContentOperatorSummary,
      } from "../lib/content-operations";
      import {
        businessFactLabel,
        resolveBusinessFact,
      } from "../lib/administration";
      import { fetchLocations } from "../lib/workspace";
      import {
        applyBootResult,
        bootWorkspace,
        describeFailure,
        emptyState,
        errorAlert,
        formatTimestamp,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        type BootRegions,
      } from "../lib/ui";

      let organizationId = "";
      let items: ContentOperatorSummary[] = [];
      let activeFilter = "active";
      let activeItemId: string | null = null;
      let pollTimer: number | null = null;

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("content-workspace")!,
      };

      function stageRank(stage: ContentOperatorSummary["stage"]): number {
        const order = [
          "brief_needed",
          "draft_needed",
          "drafting",
          "editorial_review",
          "client_review",
          "revision_needed",
          "ready_to_publish",
          "publishing",
          "published",
        ];
        return Math.max(order.indexOf(stage), 0);
      }

      function stageMatches(item: ContentOperatorSummary): boolean {
        if (activeFilter === "all") return true;
        if (activeFilter === "published") return item.stage === "published";
        if (activeFilter === "publishing") return item.stage === "publishing";
        return !["published", "publishing"].includes(item.stage);
      }

      function renderMetrics(): void {
        const action = items.filter(
          (item) =>
            !["published", "publishing", "ready_to_publish"].includes(
              item.stage,
            ),
        ).length;
        const ready = items.filter(
          (item) => item.stage === "ready_to_publish",
        ).length;
        const publishing = items.filter(
          (item) => item.stage === "publishing",
        ).length;
        const published = items.filter(
          (item) => item.stage === "published",
        ).length;
        document.getElementById("metric-action")!.textContent = String(action);
        document.getElementById("metric-ready")!.textContent = String(ready);
        document.getElementById("metric-publishing")!.textContent =
          String(publishing);
        document.getElementById("metric-published")!.textContent =
          String(published);
      }

      function renderList(): void {
        const region = document.getElementById("content-list")!;
        region.replaceChildren();
        const visible = items
          .filter(stageMatches)
          .sort((a, b) => stageRank(b.stage) - stageRank(a.stage));
        if (!visible.length) {
          region.append(
            emptyState(
              "Nothing in this view",
              "Choose another filter or create a content item.",
            ),
          );
          return;
        }
        const table = document.createElement("div");
        table.className = "content-list";
        for (const item of visible) {
          const row = document.createElement("button");
          row.type = "button";
          row.className = "content-row";
          row.addEventListener("click", () => void openItem(item.id));
          const main = document.createElement("div");
          main.className = "content-row__main";
          const title = document.createElement("strong");
          title.textContent = item.title;
          const meta = document.createElement("span");
          meta.textContent = item.published_at
            ? `Published ${formatTimestamp(item.published_at)}`
            : item.content_type.replace(/_/g, " ");
          main.append(title, meta);
          const stage = document.createElement("div");
          stage.className = "content-row__stage";
          stage.append(
            statusBadge(
              contentStageTone(item.stage),
              contentStageLabel(item.stage),
            ),
          );
          const next = document.createElement("div");
          next.className = "content-row__next";
          const nextLabel = document.createElement("span");
          nextLabel.textContent = "Next";
          const nextValue = document.createElement("strong");
          nextValue.textContent = item.next_action.label;
          next.append(nextLabel, nextValue);
          row.append(main, stage, next);
          table.append(row);
        }
        region.append(table);
      }

      async function refreshList(): Promise<void> {
        const result = await fetchContentOperations(organizationId);
        if (result.kind !== "ok") {
          document
            .getElementById("content-list")!
            .replaceChildren(errorAlert(describeFailure(result, "Content")));
          return;
        }
        items = result.data;
        renderMetrics();
        renderList();
      }

      function progress(detail: ContentOperatorDetail): HTMLElement {
        const labels = [
          "Brief",
          "Draft",
          "Review",
          "Approve",
          "Publish",
          "Verify",
        ];
        const map: Record<ContentOperatorDetail["stage"], number> = {
          brief_needed: 0,
          draft_needed: 1,
          drafting: 1,
          editorial_review: 2,
          client_review: 3,
          revision_needed: 2,
          ready_to_publish: 4,
          publishing: 4,
          published: 6,
          needs_attention: 4,
        };
        const current = map[detail.stage];
        const strip = document.createElement("ol");
        strip.className = "content-progress";
        labels.forEach((label, index) => {
          const step = document.createElement("li");
          if (index < current) step.dataset.state = "done";
          else if (index === current) step.dataset.state = "current";
          else step.dataset.state = "upcoming";
          const marker = document.createElement("span");
          marker.textContent = index < current ? "✓" : String(index + 1);
          const text = document.createElement("span");
          text.textContent = label;
          step.append(marker, text);
          strip.append(step);
        });
        return strip;
      }

      function actionCard(detail: ContentOperatorDetail): HTMLElement {
        const card = document.createElement("section");
        card.className = "content-action-card";
        const top = document.createElement("div");
        top.className = "content-action-card__top";
        const text = document.createElement("div");
        const eyebrow = document.createElement("p");
        eyebrow.className = "content-eyebrow";
        eyebrow.textContent = "Current stage";
        const heading = document.createElement("h2");
        heading.textContent = contentStageLabel(detail.stage);
        const message = document.createElement("p");
        message.textContent = stageDescription(detail);
        text.append(eyebrow, heading, message);
        top.append(
          text,
          statusBadge(
            contentStageTone(detail.stage),
            contentStageLabel(detail.stage),
          ),
        );
        card.append(top, progress(detail));
        const action = document.createElement("div");
        action.className = "content-primary-action";
        renderPrimaryAction(action, detail);
        card.append(action);
        return card;
      }

      function stageDescription(detail: ContentOperatorDetail): string {
        switch (detail.stage) {
          case "brief_needed":
            return "Define who this page is for and what it needs to accomplish.";
          case "draft_needed":
            return "The brief is ready. Generate a grounded draft or write one manually.";
          case "drafting":
            return "A draft exists and is ready to move into review.";
          case "editorial_review":
            return "Review the current revision for accuracy, quality, and approved business facts.";
          case "client_review":
            return "Editorial review is complete. Final approval is required before publishing.";
          case "revision_needed":
            return "The current revision needs changes before it can continue.";
          case "ready_to_publish":
            return "The latest revision is fully approved. Complete any required publishing details, then publish.";
          case "publishing":
            return "LILOs is creating the repository change, validating checks, merging, and verifying deployment.";
          case "published":
            return "The approved content has been deployed and verified.";
          case "needs_attention":
            return "Publishing needs attention before the item can continue.";
        }
      }

      function renderPrimaryAction(
        container: HTMLElement,
        detail: ContentOperatorDetail,
      ): void {
        const latestRevision = detail.revisions[0];
        const latestBrief = detail.briefs[0];
        if (detail.stage === "brief_needed") {
          void renderBriefAction(container, detail);
          return;
        }
        if (
          detail.stage === "draft_needed" ||
          detail.stage === "revision_needed"
        ) {
          if (!latestBrief) return;
          renderDraftAction(container, detail, latestBrief.id);
          return;
        }
        if (detail.stage === "editorial_review" && latestRevision) {
          container.append(
            decisionButton(
              detail,
              latestRevision.id,
              "editorial",
              "Approve editorial review",
            ),
          );
          return;
        }
        if (detail.stage === "client_review" && latestRevision) {
          container.append(
            decisionButton(
              detail,
              latestRevision.id,
              "client",
              "Approve for publishing",
            ),
          );
          return;
        }
        if (detail.stage === "ready_to_publish") {
          void renderPublishAction(container, detail);
          return;
        }
        if (detail.stage === "publishing") {
          const status = document.createElement("p");
          const publication = detail.publications[0];
          status.textContent = publication
            ? `Publishing status: ${publication.status.replace(/_/g, " ")}. This page refreshes automatically.`
            : "Publishing is in progress. This page refreshes automatically.";
          container.append(status);
          return;
        }
        if (detail.stage === "published") {
          const publication = detail.publications[0];
          if (publication?.published_url) {
            const link = document.createElement("a");
            link.className = "ui-button ui-button--primary ui-button--md";
            link.href = publication.published_url;
            link.target = "_blank";
            link.rel = "noreferrer";
            link.textContent = "View published page";
            container.append(link);
          }
          return;
        }
        if (detail.stage === "needs_attention") {
          const publication = detail.publications[0];
          container.append(
            errorAlert(
              publication?.safe_error_code
                ? `Publishing stopped: ${publication.safe_error_code.replace(/_/g, " ").toLowerCase()}.`
                : "Publishing stopped and needs review.",
            ),
          );
        }
      }

      async function renderBriefAction(
        container: HTMLElement,
        detail: ContentOperatorDetail,
      ): Promise<void> {
        const facts = await Promise.all(
          CONTENT_REQUIRED_FACT_KEYS.map((key) =>
            resolveBusinessFact(
              organizationId,
              key,
              detail.location_id ?? undefined,
            ),
          ),
        );
        const approvedIds = facts.flatMap((result) =>
          result.kind === "ok" &&
          result.data.state === "resolved" &&
          result.data.selected_revision_id
            ? [result.data.selected_revision_id]
            : [],
        );
        if (approvedIds.length !== CONTENT_REQUIRED_FACT_KEYS.length) {
          const missing = CONTENT_REQUIRED_FACT_KEYS.filter(
            (_, index) =>
              !(
                facts[index].kind === "ok" &&
                facts[index].data.state === "resolved" &&
                facts[index].data.selected_revision_id
              ),
          );
          container.append(
            emptyState(
              "Business details need approval",
              `Approve ${missing.map(businessFactLabel).join(", ")} before creating the brief.`,
              "Review business details",
              "/settings",
            ),
          );
          return;
        }
        const form = document.createElement("form");
        form.className = "content-action-form";
        const audience = document.createElement("input");
        audience.className = "ui-input";
        audience.placeholder = "Who should this page help?";
        audience.required = true;
        const goal = document.createElement("textarea");
        goal.className = "ui-input";
        goal.placeholder = "What should this page help them understand or do?";
        goal.rows = 3;
        goal.required = true;
        const submit = document.createElement("button");
        submit.type = "submit";
        submit.className = "ui-button ui-button--primary ui-button--md";
        submit.textContent = "Create brief";
        const status = document.createElement("p");
        status.className = "ui-text-secondary";
        form.append(audience, goal, submit, status);
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          submit.disabled = true;
          status.textContent = "Creating brief…";
          const result = await createBrief(organizationId, detail.id, {
            audience: audience.value.trim(),
            intent: goal.value.trim(),
            targetReference: detail.slug,
            approvedFactRevisionIds: approvedIds,
          });
          if (result.kind === "ok") await openItem(detail.id);
          else {
            submit.disabled = false;
            status.textContent = describeContentFailure(result, "Brief");
          }
        });
        container.append(form);
      }

      function renderDraftAction(
        container: HTMLElement,
        detail: ContentOperatorDetail,
        briefId: string,
      ): void {
        const row = document.createElement("div");
        row.className = "content-action-buttons";
        const generate = document.createElement("button");
        generate.type = "button";
        generate.className = "ui-button ui-button--primary ui-button--md";
        generate.textContent =
          detail.stage === "revision_needed"
            ? "Generate revised draft"
            : "Generate assisted draft";
        const status = document.createElement("p");
        status.className = "ui-text-secondary";
        generate.addEventListener("click", async () => {
          generate.disabled = true;
          status.textContent = "Starting draft…";
          const result = await generateAIDraft(
            organizationId,
            detail.id,
            briefId,
            crypto.randomUUID(),
          );
          if (result.kind !== "ok") {
            generate.disabled = false;
            status.textContent = describeContentFailure(
              result,
              "Draft generation",
            );
            return;
          }
          status.textContent = describeAIDraftStatus("queued");
          while (true) {
            await new Promise((resolve) => window.setTimeout(resolve, 2000));
            const poll = await pollAIDraftRun(
              organizationId,
              result.data.workflow_run_id,
            );
            if (!poll) {
              status.textContent =
                "Draft status could not be refreshed. Reload to check progress.";
              break;
            }
            status.textContent = describeAIDraftStatus(poll.status);
            if (isAIDraftTerminal(poll.status)) {
              if (poll.status === "completed") await openItem(detail.id);
              else generate.disabled = false;
              break;
            }
          }
        });
        row.append(generate);
        container.append(row, status);
      }

      function decisionButton(
        detail: ContentOperatorDetail,
        revisionId: string,
        stage: "editorial" | "client",
        label: string,
      ): HTMLButtonElement {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "ui-button ui-button--primary ui-button--md";
        button.textContent = label;
        button.addEventListener("click", async () => {
          button.disabled = true;
          const result = await decideContentOperationRevision(
            organizationId,
            detail.id,
            revisionId,
            stage,
            true,
          );
          if (result.kind === "ok") await openItem(detail.id);
          else {
            button.disabled = false;
            button.insertAdjacentElement(
              "afterend",
              errorAlert(describeFailure(result, "Approval")),
            );
          }
        });
        return button;
      }

      async function renderPublishAction(
        container: HTMLElement,
        detail: ContentOperatorDetail,
      ): Promise<void> {
        if (!detail.publishing_targets.length) {
          container.append(
            emptyState(
              "Publishing destination required",
              "Connect the site repository once, then return here to publish.",
              "Configure publishing",
              "/integrations",
            ),
          );
          return;
        }
        const form = document.createElement("form");
        form.className = "content-publish-form";
        const target = document.createElement("select");
        target.className = "ui-input";
        for (const option of detail.publishing_targets) {
          const element = document.createElement("option");
          element.value = option.id;
          element.textContent = option.repository_id;
          target.append(element);
        }
        const selectedTarget = detail.publishing_requirements.target_id;
        if (selectedTarget) target.value = selectedTarget;

        const imageWrap = document.createElement("div");
        imageWrap.className = "content-publish-fields";
        const imageSelect = document.createElement("select");
        imageSelect.className = "ui-input";
        const placeholder = document.createElement("option");
        placeholder.value = "";
        placeholder.textContent = "Select website image";
        imageSelect.append(placeholder);
        const alt = document.createElement("input");
        alt.className = "ui-input";
        alt.placeholder = "Describe the image for accessibility";
        const helper = document.createElement("p");
        helper.className = "ui-text-secondary";
        helper.textContent =
          "The site schema requires an approved image before this page can publish.";
        imageWrap.append(imageSelect, alt, helper);

        const loadAssets = async (): Promise<void> => {
          imageSelect.disabled = true;
          while (imageSelect.options.length > 1) imageSelect.remove(1);
          const result = await fetchContentPublishingAssets(
            organizationId,
            detail.id,
            target.value,
          );
          if (result.kind === "ok") {
            for (const asset of result.data) appendAsset(imageSelect, asset);
          }
          imageSelect.disabled = false;
        };
        target.addEventListener("change", () => void loadAssets());

        const requirements = detail.publishing_requirements;
        if (requirements.requires_image || requirements.requires_image_alt) {
          void loadAssets();
        } else {
          imageWrap.hidden = true;
        }

        const submit = document.createElement("button");
        submit.type = "submit";
        submit.className = "ui-button ui-button--primary ui-button--md";
        submit.textContent = "Publish to website";
        const status = document.createElement("p");
        status.className = "ui-text-secondary";
        form.append(target, imageWrap, submit, status);
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (requirements.requires_image && !imageSelect.value) {
            status.textContent = "Select an image before publishing.";
            return;
          }
          if (requirements.requires_image_alt && !alt.value.trim()) {
            status.textContent = "Add image alt text before publishing.";
            return;
          }
          submit.disabled = true;
          status.textContent = "Starting governed publication…";
          const result = await publishContentOperation(
            organizationId,
            detail.id,
            {
              idempotencyKey: crypto.randomUUID(),
              publishingTargetId: target.value,
              image: imageSelect.value || undefined,
              imageAlt: alt.value.trim() || undefined,
            },
          );
          if (result.kind === "ok") await openItem(detail.id);
          else {
            submit.disabled = false;
            status.textContent = describeFailure(result, "Publishing");
          }
        });
        container.append(form);
      }

      function appendAsset(
        select: HTMLSelectElement,
        asset: ContentImageAsset,
      ): void {
        const option = document.createElement("option");
        option.value = asset.path;
        option.textContent = asset.path;
        select.append(option);
      }

      function renderDetail(detail: ContentOperatorDetail): void {
        const region = document.getElementById("content-detail")!;
        region.replaceChildren();
        const header = document.createElement("header");
        header.className = "content-detail-header";
        const title = document.createElement("h1");
        title.textContent = detail.title;
        const meta = document.createElement("p");
        meta.textContent = `/${detail.slug}`;
        header.append(title, meta);
        region.append(header, actionCard(detail));

        const latest = detail.revisions[0];
        if (latest) {
          const documentCard = document.createElement("section");
          documentCard.className = "content-panel";
          const heading = document.createElement("div");
          heading.className = "content-panel__header";
          const label = document.createElement("div");
          const eyebrow = document.createElement("p");
          eyebrow.className = "content-eyebrow";
          eyebrow.textContent = `Revision ${latest.revision_number}`;
          const h2 = document.createElement("h2");
          h2.textContent = "Current content";
          label.append(eyebrow, h2);
          heading.append(
            label,
            statusBadge(
              latest.status === "approved" ? "ready" : "setup",
              latest.status.replace(/_/g, " "),
            ),
          );
          documentCard.append(heading, renderDocumentBody(latest.body));
          region.append(documentCard);
        }

        if (detail.briefs[0]) {
          const context = document.createElement("section");
          context.className = "content-panel";
          const brief = detail.briefs[0];
          context.innerHTML = `<p class="content-eyebrow">Brief</p><h2>Content direction</h2>`;
          const facts = document.createElement("dl");
          facts.className = "content-detail-facts";
          facts.append(
            fact("Audience", brief.audience),
            fact("Goal", brief.intent),
          );
          context.append(facts);
          region.append(context);
        }

        if (detail.briefs[0]) {
          const revise = document.createElement("details");
          revise.className = "content-panel";
          const summary = document.createElement("summary");
          summary.textContent = "Revise this content";
          const explanation = document.createElement("p");
          explanation.className = "content-secondary";
          explanation.textContent =
            "Creating a new revision intentionally sends the item back through review.";
          const form = document.createElement("form");
          form.className = "content-action-form";
          const copy = document.createElement("textarea");
          copy.className = "ui-input";
          copy.rows = 12;
          copy.value = latest?.body ?? "";
          const submit = document.createElement("button");
          submit.type = "submit";
          submit.className = "ui-button ui-button--secondary ui-button--md";
          submit.textContent = "Save new revision";
          const status = document.createElement("p");
          form.append(copy, submit, status);
          form.addEventListener("submit", async (event) => {
            event.preventDefault();
            submit.disabled = true;
            const result = await createRevision(organizationId, detail.id, {
              body: copy.value,
              frontmatter: latest?.frontmatter ?? { title: detail.title },
              approvedFactRevisionIds:
                detail.briefs[0].approved_fact_revision_ids,
            });
            if (result.kind === "ok") await openItem(detail.id);
            else {
              submit.disabled = false;
              status.textContent = describeContentFailure(result, "Revision");
            }
          });
          revise.append(summary, explanation, form);
          region.append(revise);
        }

        if (detail.revisions.length > 1 || detail.publications.length) {
          const history = document.createElement("details");
          history.className = "content-panel";
          const summary = document.createElement("summary");
          summary.textContent = "History and publishing details";
          const list = document.createElement("div");
          list.className = "content-history";
          for (const revision of detail.revisions.slice(1, 8)) {
            const row = document.createElement("p");
            row.textContent = `Revision ${revision.revision_number} · ${revision.status.replace(/_/g, " ")}`;
            list.append(row);
          }
          for (const publication of detail.publications.slice(0, 5)) {
            const row = document.createElement("p");
            row.textContent = `Publication · ${publication.status.replace(/_/g, " ")} · ${publication.target_path}`;
            list.append(row);
          }
          history.append(summary, list);
          region.append(history);
        }
      }

      function fact(label: string, value: string): HTMLElement {
        const wrapper = document.createElement("div");
        const dt = document.createElement("dt");
        dt.textContent = label;
        const dd = document.createElement("dd");
        dd.textContent = value;
        wrapper.append(dt, dd);
        return wrapper;
      }

      async function openItem(itemId: string): Promise<void> {
        activeItemId = itemId;
        if (pollTimer !== null) window.clearTimeout(pollTimer);
        document.getElementById("content-list-view")!.hidden = true;
        document.getElementById("content-detail-view")!.hidden = false;
        const region = document.getElementById("content-detail")!;
        region.replaceChildren();
        region.append(
          emptyState(
            "Loading content…",
            "Refreshing the latest workflow state.",
          ),
        );
        const result = await fetchContentOperation(organizationId, itemId);
        if (result.kind !== "ok") {
          region.replaceChildren(
            errorAlert(describeFailure(result, "Content item")),
          );
          return;
        }
        renderDetail(result.data);
        if (result.data.stage === "publishing") {
          pollTimer = window.setTimeout(() => {
            if (activeItemId === itemId) void openItem(itemId);
          }, 5000);
        }
      }

      function showList(): void {
        activeItemId = null;
        if (pollTimer !== null) window.clearTimeout(pollTimer);
        document.getElementById("content-detail-view")!.hidden = true;
        document.getElementById("content-list-view")!.hidden = false;
        void refreshList();
      }

      async function renderOpportunities(): Promise<void> {
        const region = document.getElementById("opportunity-list")!;
        const result = await fetchOpportunities(organizationId);
        region.replaceChildren();
        if (result.kind !== "ok") {
          region.append(
            errorAlert(describeFailure(result, "Content opportunities")),
          );
          return;
        }
        const open = result.data.filter((item) =>
          ["identified", "validated"].includes(item.status),
        );
        if (!open.length) {
          region.append(
            emptyState(
              "No open opportunities",
              "New evidence-backed opportunities will appear here.",
            ),
          );
          return;
        }
        for (const opportunity of open)
          region.append(opportunityRow(opportunity));
      }

      function opportunityRow(opportunity: ContentOpportunity): HTMLElement {
        const row = document.createElement("div");
        row.className = "content-opportunity";
        const text = document.createElement("div");
        const title = document.createElement("strong");
        title.textContent = opportunity.target_reference;
        const meta = document.createElement("span");
        meta.textContent = `${opportunity.opportunity_type.replace(/_/g, " ")} · priority ${opportunity.priority_score}`;
        text.append(title, meta);
        const accept = document.createElement("button");
        accept.type = "button";
        accept.className = "ui-button ui-button--secondary ui-button--sm";
        accept.textContent = "Accept opportunity";
        accept.addEventListener("click", async () => {
          accept.disabled = true;
          const result = await decideOpportunity(
            organizationId,
            opportunity.id,
            true,
          );
          if (result.kind === "ok") await renderOpportunities();
          else accept.disabled = false;
        });
        row.append(text, accept);
        return row;
      }

      function setupModal(): void {
        const modal = document.getElementById(
          "new-item-modal",
        ) as HTMLDialogElement;
        const form = document.getElementById(
          "new-item-form",
        ) as HTMLFormElement;
        const title = document.getElementById(
          "content-title",
        ) as HTMLInputElement;
        const slug = document.getElementById(
          "content-slug",
        ) as HTMLInputElement;
        const submit = document.getElementById(
          "create-new-item",
        ) as HTMLButtonElement;
        const status = document.getElementById("new-item-status")!;
        const close = (): void => modal.close();
        document.getElementById("new-item")!.addEventListener("click", () => {
          form.reset();
          modal.showModal();
        });
        document
          .getElementById("close-new-item")!
          .addEventListener("click", close);
        document
          .getElementById("cancel-new-item")!
          .addEventListener("click", close);
        title.addEventListener("input", () => {
          slug.value = deriveSlug(title.value);
        });
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          submit.disabled = true;
          status.textContent = "Creating item…";
          const location = document.getElementById(
            "content-location",
          ) as HTMLSelectElement;
          const type = document.getElementById(
            "content-type",
          ) as HTMLSelectElement;
          const result = await createContentItem(organizationId, {
            contentType: type.value,
            title: title.value.trim(),
            slug: slug.value.trim(),
            locationId: location.value || undefined,
          });
          if (result.kind === "ok") {
            close();
            await refreshList();
            await openItem(result.data.id);
          } else {
            submit.disabled = false;
            status.textContent = describeFailure(result, "Content item");
          }
        });
      }

      async function loadLocations(): Promise<void> {
        const select = document.getElementById(
          "content-location",
        ) as HTMLSelectElement;
        const result = await fetchLocations(organizationId);
        if (result.kind !== "ok") return;
        for (const location of result.data) {
          const option = document.createElement("option");
          option.value = location.id;
          option.textContent = location.name;
          select.append(option);
        }
      }

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;
        await Promise.all([
          refreshList(),
          renderOpportunities(),
          loadLocations(),
        ]);
      }

      document
        .getElementById("back-to-list")!
        .addEventListener("click", showList);
      document
        .querySelectorAll<HTMLButtonElement>("[data-filter]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            activeFilter = button.dataset.filter ?? "active";
            document
              .querySelectorAll<HTMLButtonElement>("[data-filter]")
              .forEach((candidate) => {
                candidate.setAttribute(
                  "aria-pressed",
                  String(candidate === button),
                );
              });
            renderList();
          });
        });
      setupModal();

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Content");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(
          result.organizations,
          (org) => void loadOrganization(org),
        );
        const org =
          result.organizations.find(
            (candidate) =>
              candidate.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>

