---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs content" />
    <title>Content · LILOs</title>
  </head>
  <body>
    <AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1>
        <p>No Supabase or API connection is configured for this build.</p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p class="loading-state">Loading content…</p>
      </div>

      <div id="boot-error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <div class="empty-state">
          <span class="empty-state__icon" aria-hidden="true">○</span>
          <h3>No organization access yet</h3>
          <p>
            Your account is not a member of any organization. Ask an
            administrator to invite you.
          </p>
        </div>
      </div>

      <div id="content-workspace" hidden>
        <div class="page-head">
          <div class="page-head__intro">
            <p class="eyebrow">Operations</p>
            <h1>Content</h1>
            <p>
              Manage content opportunities, drafts, approvals, and publishing
              pipeline.
            </p>
          </div>
          <div class="page-head__meta">
            <div class="page-head__actions">
              <a
                class="button button--secondary button--sm"
                href="/integrations">Manage publishing</a
              >
            </div>
          </div>
        </div>

        <div class="metric-grid" id="content-metrics"></div>

        <div class="tabs" role="tablist" id="content-tabs">
          <button
            class="tabs__tab"
            role="tab"
            aria-selected="true"
            data-tab="pipeline">Pipeline</button
          >
          <button
            class="tabs__tab"
            role="tab"
            aria-selected="false"
            data-tab="opportunities">Opportunities</button
          >
          <button
            class="tabs__tab"
            role="tab"
            aria-selected="false"
            data-tab="publishing">Publishing</button
          >
        </div>

        <div id="tab-pipeline" class="tab-panel"></div>
        <div id="tab-opportunities" class="tab-panel" hidden></div>
        <div id="tab-publishing" class="tab-panel" hidden>
          <div class="sr-only" aria-hidden="true">
            <button type="button" id="create-target-button" hidden
              >Create target</button
            >
          </div>
        </div>

        <section id="content-detail" class="detail-workspace" hidden>
          <button
            type="button"
            class="button button--secondary button--sm"
            id="back-to-content-pipeline">← Back to pipeline</button
          >
          <div id="content-detail-body" aria-live="polite"></div>
        </section>
      </div>
    </AppShell>
    <script>
      import {
        fetchContentSummary,
        fetchContentItems,
        fetchOpportunities,
        decideOpportunity,
        fetchPublishingTargets,
        fetchGitHubConnections,
        isGitHubAppConnection,
        createPublishingTarget,
        fetchContentItem,
        fetchBriefs,
        fetchRevisions,
        fetchPublications,
        fetchItemAudit,
        createBrief,
        createRevision,
        generateAIDraft,
        decideRevision,
        isContentOpportunityActionable,
        CONTENT_REQUIRED_FACT_KEYS,
        type ContentItem,
      } from "../lib/content";
      import { fetchGitHubRepositories } from "../lib/github-app";
      import {
        businessFactLabel,
        resolveBusinessFact,
      } from "../lib/administration";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        metricCard,
        emptyState,
        errorAlert,
        describeFailure,
        formatTimestamp,
        setupTabs,
        sectionCard,
        detailFact,
        liveStatus,
        formField,
        type BootRegions,
      } from "../lib/ui";

      let organizationId = "";

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("content-workspace")!,
      };

      setupTabs(document.getElementById("content-tabs")!);

      document
        .getElementById("back-to-content-pipeline")!
        .addEventListener("click", showContentPipeline);

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;
        showContentPipeline();

        const [summaryResult, itemsResult, oppsResult, targetsResult] =
          await Promise.all([
            fetchContentSummary(organizationId),
            fetchContentItems(organizationId),
            fetchOpportunities(organizationId),
            fetchPublishingTargets(organizationId),
          ]);

        renderMetrics(summaryResult, itemsResult, oppsResult, targetsResult);
        renderPipeline(itemsResult);
        renderOpportunities(oppsResult);
        void renderPublishing(targetsResult);
      }

      function renderMetrics(
        summary: Awaited<ReturnType<typeof fetchContentSummary>>,
        items: Awaited<ReturnType<typeof fetchContentItems>>,
        opps: Awaited<ReturnType<typeof fetchOpportunities>>,
        targets: Awaited<ReturnType<typeof fetchPublishingTargets>>,
      ): void {
        const grid = document.getElementById("content-metrics")!;
        grid.replaceChildren();

        const itemCount = items.kind === "ok" ? String(items.data.length) : "—";
        const oppCount = opps.kind === "ok" ? String(opps.data.length) : "—";
        const openOpps =
          opps.kind === "ok"
            ? opps.data.filter((o) => isContentOpportunityActionable(o.status))
                .length
            : null;
        const targetCount =
          targets.kind === "ok" ? String(targets.data.length) : "—";

        grid.append(
          metricCard("Content items", itemCount, "In pipeline"),
          metricCard(
            "Opportunities",
            oppCount,
            openOpps === null ? "Unable to load" : `${openOpps} open`,
          ),
          metricCard(
            "Publishing targets",
            targetCount,
            targets.kind !== "ok"
              ? "Unable to load"
              : targets.data.length > 0
                ? "Configured"
                : "Not configured",
          ),
        );
        if (summary.kind === "ok") {
          const published = summary.data.by_status?.["published"] ?? 0;
          grid.append(metricCard("Published", String(published), "All time"));
        }
      }

      function renderPipeline(
        items: Awaited<ReturnType<typeof fetchContentItems>>,
      ): void {
        const panel = document.getElementById("tab-pipeline")!;
        panel.replaceChildren();

        if (items.kind !== "ok") {
          panel.append(errorAlert(describeFailure(items, "Content items")));
          return;
        }
        if (items.data.length === 0) {
          panel.append(
            emptyState(
              "No content items yet",
              "Accept content opportunities to start building your pipeline.",
            ),
          );
          const button = document.createElement("button");
          button.type = "button";
          button.className = "button button--secondary empty-state-action";
          button.textContent = "View opportunities";
          button.addEventListener("click", () =>
            selectContentTab("opportunities"),
          );
          panel.querySelector(".empty-state")?.append(button);
          return;
        }

        const table = document.createElement("div");
        table.className = "data-table";
        const t = document.createElement("table");
        const thead = document.createElement("thead");
        thead.innerHTML =
          "<tr><th>Title</th><th>Status</th><th>Published</th><th><span class='sr-only'>Actions</span></th></tr>";
        t.append(thead);
        const tbody = document.createElement("tbody");
        for (const item of items.data) {
          const tr = document.createElement("tr");
          const titleTd = document.createElement("td");
          titleTd.textContent = item.title;
          const statusTd = document.createElement("td");
          statusTd.append(
            statusBadge(
              item.status === "published"
                ? "ready"
                : item.status === "approved"
                  ? "ready"
                  : "setup",
              item.status,
            ),
          );
          const pubTd = document.createElement("td");
          pubTd.textContent = item.published_at
            ? formatTimestamp(item.published_at)
            : "—";
          const actionTd = document.createElement("td");
          const openButton = document.createElement("button");
          openButton.type = "button";
          openButton.className = "button button--secondary button--sm";
          openButton.textContent = "Open";
          openButton.addEventListener(
            "click",
            () => void openContentItem(item),
          );
          actionTd.append(openButton);
          tr.append(titleTd, statusTd, pubTd, actionTd);
          tbody.append(tr);
        }
        t.append(tbody);
        table.append(t);
        panel.append(table);
      }

      function renderOpportunities(
        opps: Awaited<ReturnType<typeof fetchOpportunities>>,
      ): void {
        const panel = document.getElementById("tab-opportunities")!;
        panel.replaceChildren();

        if (opps.kind !== "ok") {
          panel.append(errorAlert(describeFailure(opps, "Opportunities")));
          return;
        }
        if (opps.data.length === 0) {
          panel.append(
            emptyState(
              "No opportunities yet",
              "Opportunities will appear here when SEO and content analysis identify them.",
            ),
          );
          return;
        }

        const list = document.createElement("ul");
        list.className = "product-list";
        for (const opp of opps.data) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = opp.opportunity_type
            .replace(/_/g, " ")
            .replace(/\b\w/g, (c) => c.toUpperCase());
          const detail = document.createElement("p");
          detail.textContent = `Priority ${opp.priority_score} · ${opp.status}`;
          info.append(name, detail);
          item.append(
            info,
            statusBadge(opp.status, opp.status.replace(/_/g, " ")),
          );
          if (isContentOpportunityActionable(opp.status)) {
            const acceptBtn = document.createElement("button");
            acceptBtn.type = "button";
            acceptBtn.className = "button button--sm";
            acceptBtn.textContent = "Accept";
            acceptBtn.addEventListener("click", async () => {
              const result = await decideOpportunity(
                organizationId,
                opp.id,
                true,
              );
              if (result.kind === "ok") {
                const [s, i, o, t] = await Promise.all([
                  fetchContentSummary(organizationId),
                  fetchContentItems(organizationId),
                  fetchOpportunities(organizationId),
                  fetchPublishingTargets(organizationId),
                ]);
                renderMetrics(s, i, o, t);
                renderPipeline(i);
                renderOpportunities(o);
                void renderPublishing(t);
              }
            });
            item.append(acceptBtn);
          }
          list.append(item);
        }
        panel.append(list);
      }

      async function renderPublishing(
        targets: Awaited<ReturnType<typeof fetchPublishingTargets>>,
      ): Promise<void> {
        const panel = document.getElementById("tab-publishing")!;
        panel.replaceChildren();

        if (targets.kind !== "ok") {
          panel.append(
            errorAlert(describeFailure(targets, "Publishing targets")),
          );
          return;
        }

        const repositories = await fetchGitHubRepositories(organizationId);
        const repositoryNames = new Map(
          repositories.kind === "ok"
            ? repositories.data.map((repository) => [
                repository.repository_id,
                repository.name,
              ])
            : [],
        );

        if (targets.data.length === 0) {
          panel.append(
            emptyState(
              "No publishing targets configured",
              "Connect a GitHub repository in Integrations to enable content publishing.",
              "Go to Integrations",
              "/integrations",
            ),
          );

          // The production publishing path is the GitHub App installation.
          // The API retains a separate advanced PAT fallback for controlled
          // migrations, but the normal product UI must not invite PAT use.
          const setupCard = document.createElement("div");
          setupCard.className = "card";
          setupCard.style.marginTop = "1rem";
          const setupHeader = document.createElement("div");
          setupHeader.className = "card__header";
          setupHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "card__title",
              textContent: "Publishing setup",
            }),
          );
          setupCard.append(setupHeader);
          const setupBody = document.createElement("div");
          setupBody.className = "card__body";

          const status = document.createElement("p");
          status.className = "text-sm muted";
          status.setAttribute("role", "status");
          status.setAttribute("aria-live", "polite");
          status.textContent =
            "Choose an authorized repository. This records the target; publishing remains subject to the verified connector and approval workflow.";
          setupBody.append(status);

          if (repositories.kind !== "ok" || repositories.data.length === 0) {
            const installLink = document.createElement("a");
            installLink.className = "button";
            installLink.href = "/integrations";
            installLink.textContent = "Connect GitHub";
            setupBody.append(installLink);
            if (repositories.kind !== "ok") {
              setupBody.append(
                errorAlert(describeFailure(repositories, "Repositories")),
              );
            }
            setupCard.append(setupBody);
            panel.append(setupCard);
            return;
          }

          // Target creation form
          const targetField = document.createElement("div");
          targetField.className = "field";
          targetField.style.marginTop = "1rem";
          targetField.append(
            Object.assign(document.createElement("label"), {
              htmlFor: "target-repo-id",
              textContent: "Repository",
            }),
          );
          const repoSelect = document.createElement("select");
          repoSelect.id = "target-repo-id";
          for (const repository of repositories.data) {
            const option = document.createElement("option");
            option.value = repository.repository_id;
            option.textContent = `${repository.name} · ${repository.default_branch}`;
            repoSelect.append(option);
          }
          targetField.append(repoSelect);
          setupBody.append(targetField);

          const createBtn = document.createElement("button");
          createBtn.type = "button";
          createBtn.className = "button button--secondary";
          createBtn.textContent = "Create target";
          createBtn.id = "create-target-button";
          createBtn.addEventListener("click", async () => {
            status.textContent = "Creating…";
            const connResult = await fetchGitHubConnections(organizationId);
            const appConnections =
              connResult.kind === "ok"
                ? connResult.data.filter(isGitHubAppConnection)
                : [];
            if (connResult.kind !== "ok" || appConnections.length === 0) {
              status.textContent = "Install the GitHub App first.";
              return;
            }
            const result = await createPublishingTarget(organizationId, {
              key: "default",
              connectionId: appConnections[0].id,
              repositoryId: repoSelect.value,
              baseBranch:
                repositories.data.find(
                  (repository) => repository.repository_id === repoSelect.value,
                )?.default_branch ?? "main",
              allowedPathPrefix: "content/",
            });
            status.textContent =
              result.kind === "ok"
                ? "Target created."
                : describeFailure(result, "Create target");
            if (result.kind === "ok") {
              const refreshed = await fetchPublishingTargets(organizationId);
              await renderPublishing(refreshed);
            }
          });
          setupBody.append(createBtn);
          setupCard.append(setupBody);
          panel.append(setupCard);
          return;
        }

        for (const target of targets.data) {
          const card = document.createElement("div");
          card.className = "card";
          const header = document.createElement("div");
          header.className = "card__header";
          header.append(
            Object.assign(document.createElement("h3"), {
              className: "card__title",
              textContent:
                repositoryNames.get(target.repository_id) ??
                "Configured repository",
            }),
          );
          header.append(
            Object.assign(document.createElement("p"), {
              className: "card__description",
              textContent: `${target.base_branch} · ${target.allowed_path_prefix}`,
            }),
          );
          card.append(header);
          const body = document.createElement("div");
          body.className = "card__body";
          body.append(
            statusBadge(
              target.status === "active" ? "ready" : "setup",
              target.status,
            ),
          );
          card.append(body);
          panel.append(card);
        }
      }

      function selectContentTab(name: string): void {
        document
          .querySelector<HTMLButtonElement>(
            `#content-tabs [data-tab="${name}"]`,
          )
          ?.click();
      }

      function showContentPipeline(): void {
        document.getElementById("content-detail")!.hidden = true;
        document.getElementById("content-metrics")!.hidden = false;
        document.getElementById("content-tabs")!.hidden = false;
        selectContentTab("pipeline");
      }

      async function openContentItem(item: ContentItem): Promise<void> {
        document.getElementById("content-metrics")!.hidden = true;
        document.getElementById("content-tabs")!.hidden = true;
        document
          .querySelectorAll<HTMLElement>("#content-workspace > .tab-panel")
          .forEach((panel) => (panel.hidden = true));
        const detail = document.getElementById("content-detail")!;
        const body = document.getElementById("content-detail-body")!;
        detail.hidden = false;
        body.replaceChildren(
          Object.assign(document.createElement("div"), {
            className: "loading-state",
            textContent: "Loading content workspace…",
          }),
        );

        const [
          itemResult,
          briefs,
          revisions,
          publications,
          audit,
          factResolutions,
        ] = await Promise.all([
          fetchContentItem(organizationId, item.id),
          fetchBriefs(organizationId, item.id),
          fetchRevisions(organizationId, item.id),
          fetchPublications(organizationId, item.id),
          fetchItemAudit(organizationId, item.id),
          Promise.all(
            CONTENT_REQUIRED_FACT_KEYS.map((key) =>
              resolveBusinessFact(organizationId, key),
            ),
          ),
        ]);
        if (itemResult.kind !== "ok") {
          body.replaceChildren(
            errorAlert(describeFailure(itemResult, "Content item")),
          );
          return;
        }

        const current = itemResult.data;
        body.replaceChildren();
        const header = document.createElement("div");
        header.className = "page-head page-head--detail";
        const intro = document.createElement("div");
        intro.className = "page-head__intro";
        intro.append(
          Object.assign(document.createElement("p"), {
            className: "eyebrow",
            textContent: current.content_type.replace(/_/g, " "),
          }),
          Object.assign(document.createElement("h2"), {
            textContent: current.title,
          }),
          Object.assign(document.createElement("p"), {
            textContent:
              "Build the brief, review revisions, approve the final copy, and follow provider-observed publication state.",
          }),
        );
        header.append(
          intro,
          statusBadge(current.status, current.status.replace(/_/g, " ")),
        );
        body.append(header);

        const grid = document.createElement("div");
        grid.className = "detail-grid";
        grid.append(
          renderBriefWorkspace(current, briefs, factResolutions),
          renderRevisionWorkspace(current, briefs, revisions),
          renderPublicationWorkspace(publications),
          renderContentActivity(audit),
        );
        body.append(grid);
      }

      function renderBriefWorkspace(
        item: ContentItem,
        briefs: Awaited<ReturnType<typeof fetchBriefs>>,
        factResolutions: Awaited<ReturnType<typeof resolveBusinessFact>>[],
      ): HTMLElement {
        const card = sectionCard(
          "Brief",
          "Audience, intent, and approved business context.",
        );
        const body = card.querySelector<HTMLElement>(".card__body")!;
        if (briefs.kind !== "ok") {
          body.append(errorAlert(describeFailure(briefs, "Briefs")));
          return card;
        }
        const latest = briefs.data[0];
        if (latest) {
          body.append(
            detailFact("Audience", latest.audience),
            detailFact("Intent", latest.intent),
            detailFact(
              "Approved business details",
              `${latest.approved_fact_revision_ids.length} governed revision${latest.approved_fact_revision_ids.length === 1 ? "" : "s"}`,
            ),
            statusBadge(latest.status, latest.status.replace(/_/g, " ")),
          );
          return card;
        }

        const facts = CONTENT_REQUIRED_FACT_KEYS.map((key, index) => ({
          key,
          outcome: factResolutions[index],
        }));
        const approvedFactRevisionIds = facts.flatMap(({ outcome }) =>
          outcome.kind === "ok" &&
          outcome.data.state === "resolved" &&
          outcome.data.selected_revision_id
            ? [outcome.data.selected_revision_id]
            : [],
        );
        const factList = document.createElement("div");
        factList.className = "fact-readiness";
        for (const { key, outcome } of facts) {
          const resolved =
            outcome.kind === "ok" &&
            outcome.data.state === "resolved" &&
            Boolean(outcome.data.selected_revision_id);
          factList.append(
            detailFact(
              businessFactLabel(key),
              resolved
                ? "Approved"
                : outcome.kind === "ok"
                  ? outcome.data.state === "ambiguous"
                    ? "Needs review"
                    : "Missing"
                  : "Unavailable",
            ),
          );
        }
        body.append(factList);

        if (
          approvedFactRevisionIds.length !== CONTENT_REQUIRED_FACT_KEYS.length
        ) {
          body.append(
            emptyState(
              "Approved business details required",
              "Confirm the business name and approved claims in Governance before creating a grounded content brief.",
              "Review business details",
              "/settings",
            ),
          );
          return card;
        }

        const form = document.createElement("form");
        form.className = "form-grid";
        const audience = document.createElement("input");
        audience.required = true;
        const intent = document.createElement("textarea");
        intent.required = true;
        intent.rows = 4;
        form.append(
          formField("Audience", audience, {
            hint: "Who this content should help",
            id: `content-audience-${item.id}`,
          }),
          formField("Content goal", intent, {
            hint: "The question or outcome this content should address",
            full: true,
            id: `content-intent-${item.id}`,
          }),
        );
        const submit = document.createElement("button");
        submit.className = "button";
        submit.type = "submit";
        submit.textContent = "Create brief";
        const status = liveStatus();
        form.append(submit, status);
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          submit.disabled = true;
          status.textContent = "Creating brief…";
          const result = await createBrief(organizationId, item.id, {
            audience: audience.value,
            intent: intent.value,
            targetReference: item.slug,
            approvedFactRevisionIds,
          });
          if (result.kind === "ok") await openContentItem(item);
          else {
            submit.disabled = false;
            status.textContent = describeFailure(result, "Brief");
          }
        });
        body.append(form);
        return card;
      }

      function renderRevisionWorkspace(
        item: ContentItem,
        briefs: Awaited<ReturnType<typeof fetchBriefs>>,
        revisions: Awaited<ReturnType<typeof fetchRevisions>>,
      ): HTMLElement {
        const card = sectionCard(
          "Draft and review",
          "Every revision remains reviewable and requires explicit approval.",
        );
        const body = card.querySelector<HTMLElement>(".card__body")!;
        if (revisions.kind !== "ok") {
          body.append(errorAlert(describeFailure(revisions, "Revisions")));
          return card;
        }
        const latestBrief = briefs.kind === "ok" ? briefs.data[0] : undefined;
        const latest = revisions.data[0];
        if (latest) {
          const article = document.createElement("article");
          article.className = "content-preview";
          const title = document.createElement("h4");
          title.textContent = `Revision ${latest.revision_number}`;
          const copy = document.createElement("p");
          copy.className = "content-preview__body";
          copy.textContent = latest.body;
          article.append(
            title,
            statusBadge(latest.status, latest.status.replace(/_/g, " ")),
            copy,
          );
          if (!latest.validation_document.valid) {
            const warning = errorAlert(
              latest.validation_document.errors.join(" · ") ||
                "This revision did not pass validation.",
            );
            article.append(warning);
          }
          const actions = document.createElement("div");
          actions.className = "form-actions form-actions--compact";
          if (latest.status === "awaiting_editorial") {
            actions.append(
              revisionDecisionButton(
                item,
                latest.id,
                "editorial",
                "Approve editorial review",
              ),
            );
          } else if (latest.status === "awaiting_client") {
            actions.append(
              revisionDecisionButton(
                item,
                latest.id,
                "client",
                "Approve for publishing",
              ),
            );
          }
          article.append(actions);
          body.append(article);
        } else {
          body.append(
            emptyState(
              "No draft yet",
              latestBrief
                ? "Generate a draft or write the first revision below."
                : "Create a brief before starting a draft.",
            ),
          );
        }

        if (latestBrief) {
          const actions = document.createElement("div");
          actions.className = "form-actions form-actions--compact";
          const aiButton = document.createElement("button");
          aiButton.type = "button";
          aiButton.className = "button button--secondary";
          aiButton.textContent = "Generate assisted draft";
          const aiStatus = liveStatus();
          aiButton.addEventListener("click", async () => {
            aiButton.disabled = true;
            aiStatus.textContent = "Generating draft…";
            const result = await generateAIDraft(
              organizationId,
              item.id,
              latestBrief.id,
              crypto.randomUUID(),
            );
            if (result.kind === "ok") await openContentItem(item);
            else {
              aiButton.disabled = false;
              aiStatus.textContent = describeFailure(
                result,
                "Draft generation",
              );
            }
          });
          actions.append(aiButton, aiStatus);
          body.append(actions);

          const form = document.createElement("form");
          form.className = "form-grid form-grid--compact";
          const copy = document.createElement("textarea");
          copy.required = true;
          copy.rows = 8;
          form.append(
            formField("Write a revision", copy, {
              hint: "Use approved business facts and review before publishing",
              full: true,
              id: `content-revision-${item.id}`,
            }),
          );
          const submit = document.createElement("button");
          submit.type = "submit";
          submit.className = "button";
          submit.textContent = "Save revision";
          const status = liveStatus();
          form.append(submit, status);
          form.addEventListener("submit", async (event) => {
            event.preventDefault();
            submit.disabled = true;
            status.textContent = "Saving revision…";
            const result = await createRevision(organizationId, item.id, {
              body: copy.value,
              frontmatter: { title: item.title, slug: item.slug },
              approvedFactRevisionIds: latestBrief.approved_fact_revision_ids,
            });
            if (result.kind === "ok") await openContentItem(item);
            else {
              submit.disabled = false;
              status.textContent = describeFailure(result, "Revision");
            }
          });
          body.append(form);
        }
        return card;
      }

      function revisionDecisionButton(
        item: ContentItem,
        revisionId: string,
        stage: "editorial" | "client",
        label: string,
      ): HTMLButtonElement {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "button";
        button.textContent = label;
        button.addEventListener("click", async () => {
          button.disabled = true;
          const result = await decideRevision(
            organizationId,
            item.id,
            revisionId,
            stage,
            true,
          );
          if (result.kind === "ok") await openContentItem(item);
          else {
            button.disabled = false;
            button.insertAdjacentElement(
              "afterend",
              errorAlert(describeFailure(result, "Approval")),
            );
          }
        });
        return button;
      }

      function renderPublicationWorkspace(
        publications: Awaited<ReturnType<typeof fetchPublications>>,
      ): HTMLElement {
        const card = sectionCard(
          "Publication",
          "Provider-observed publishing and deployment state.",
        );
        const body = card.querySelector<HTMLElement>(".card__body")!;
        if (publications.kind !== "ok") {
          body.append(
            errorAlert(describeFailure(publications, "Publications")),
          );
        } else if (publications.data.length === 0) {
          body.append(
            emptyState(
              "Not submitted for publishing",
              "After final approval, publishing requires a configured target and an accepted publishing connector. LILOs does not report success until provider state confirms it.",
              "Review publishing setup",
              "/integrations",
            ),
          );
        } else {
          for (const publication of publications.data) {
            const row = document.createElement("div");
            row.className = "activity-row";
            const info = document.createElement("div");
            const title = document.createElement("h4");
            title.textContent = publication.target_path || "Publication";
            const detail = document.createElement("p");
            detail.textContent = publication.verified_at
              ? `Verified ${formatTimestamp(publication.verified_at)}`
              : "Awaiting provider verification";
            info.append(title, detail);
            row.append(
              info,
              statusBadge(
                publication.status,
                publication.status.replace(/_/g, " "),
              ),
            );
            if (publication.published_url) {
              const link = document.createElement("a");
              link.href = publication.published_url;
              link.target = "_blank";
              link.rel = "noreferrer";
              link.textContent = "View published page";
              row.append(link);
            }
            body.append(row);
          }
        }
        return card;
      }

      function renderContentActivity(
        audit: Awaited<ReturnType<typeof fetchItemAudit>>,
      ): HTMLElement {
        const card = sectionCard(
          "Recent activity",
          "A concise history of work on this item.",
        );
        const body = card.querySelector<HTMLElement>(".card__body")!;
        if (audit.kind !== "ok") {
          body.append(errorAlert(describeFailure(audit, "Activity")));
        } else if (audit.data.length === 0) {
          body.append(
            emptyState(
              "No recorded changes",
              "Content activity will appear here.",
            ),
          );
        } else {
          for (const entry of audit.data.slice(0, 8)) {
            body.append(
              detailFact(entry.summary, formatTimestamp(entry.occurred_at)),
            );
          }
        }
        return card;
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Content");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
