---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs insights" />
    <title>Insights · LILOs</title>
  </head>
  <body>
    <AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1>
        <p>No Supabase or API connection is configured for this build.</p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p class="loading-state">Loading insights…</p>
      </div>

      <div id="boot-error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <div class="empty-state">
          <span class="empty-state__icon" aria-hidden="true">○</span>
          <h3>No organization access yet</h3>
          <p>
            Your account is not a member of any organization. Ask an
            administrator to invite you.
          </p>
        </div>
      </div>

      <div id="insights-content" hidden>
        <div class="page-head">
          <div class="page-head__intro">
            <p class="eyebrow">Operations</p>
            <h1>Insights</h1>
            <p>
              Cross-product reporting from real operational data — no simulated
              or fabricated metrics.
            </p>
          </div>
          <div class="page-head__meta">
            <div class="page-head__actions">
              <a
                class="button button--secondary button--sm"
                href="/integrations">Manage data sources</a
              >
            </div>
          </div>
        </div>

        <div id="insights-readiness-panel"></div>

        <div class="section-heading section-heading--first">
          <div>
            <p class="eyebrow">Website performance</p>
            <h2>Latest Analytics results</h2>
          </div>
        </div>
        <div id="performance-panel">
          <div class="loading-state">Loading performance…</div>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Data sources</p>
            <h2>Connected sources</h2>
          </div>
        </div>
        <div id="sources-panel">
          <div class="loading-state">Loading data sources…</div>
        </div>

        <div class="section-heading">
          <div>
            <p class="eyebrow">Activity</p>
            <h2>Cross-product metrics</h2>
          </div>
        </div>
        <div id="activity-panel">
          <div class="loading-state">Loading activity…</div>
        </div>
      </div>
    </AppShell>
    <script>
      import {
        fetchProductReadiness,
        fetchInsightsSummary,
        PRODUCT_LABELS,
      } from "../lib/workspace";
      import { summarizeReadiness } from "../lib/dashboard-logic";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        emptyState,
        errorAlert,
        describeFailure,
        metricCard,
        formatTimestamp,
        type BootRegions,
      } from "../lib/ui";

      let organizationId = "";

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("insights-content")!,
      };

      const SOURCE_PRODUCTS = [
        "gbp",
        "reviews",
        "leads",
        "content",
        "seo",
      ] as const;

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;

        const [readinessResult, summaryResult, sourceReadiness] =
          await Promise.all([
            fetchProductReadiness(organizationId, "insights"),
            fetchInsightsSummary(organizationId),
            Promise.all(
              SOURCE_PRODUCTS.map((key) =>
                fetchProductReadiness(organizationId, key),
              ),
            ),
          ]);

        renderReadiness(readinessResult);
        renderPerformance(summaryResult);
        renderSources(sourceReadiness, summaryResult);
        renderActivity(summaryResult);
      }

      function renderReadiness(
        outcome: Awaited<ReturnType<typeof fetchProductReadiness>>,
      ): void {
        const panel = document.getElementById("insights-readiness-panel")!;
        panel.replaceChildren();

        if (outcome.kind !== "ok") {
          panel.append(errorAlert(describeFailure(outcome, "Insights")));
          return;
        }

        const summary = summarizeReadiness(outcome);
        if (summary.status === "ready") {
          const alert = document.createElement("div");
          alert.className = "alert alert--success";
          alert.style.marginBottom = "0";
          alert.append(statusBadge("ready", "Ready"));
          const text = document.createElement("p");
          text.className = "text-sm";
          text.textContent =
            "Insights reporting is available. SEO recommendations are on the SEO page.";
          alert.append(text);
          panel.append(alert);
        } else if (summary.status === "setup" || summary.status === "blocked") {
          const alert = document.createElement("div");
          alert.className = "alert alert--warning";
          alert.style.marginBottom = "0";
          alert.append(
            statusBadge(
              summary.status,
              summary.status === "setup" ? "Setup required" : "Blocked",
            ),
          );
          const text = document.createElement("p");
          text.className = "text-sm";
          text.textContent = summary.detail;
          alert.append(text);
          const link = document.createElement("a");
          link.className = "button button--secondary button--sm";
          link.href = "/settings";
          link.textContent =
            summary.status === "setup" ? "Complete setup" : "Review blockers";
          alert.append(link);
          panel.append(alert);
        }
      }

      function renderSources(
        readinessResults: Awaited<ReturnType<typeof fetchProductReadiness>>[],
        summaryResult: Awaited<ReturnType<typeof fetchInsightsSummary>>,
      ): void {
        const panel = document.getElementById("sources-panel")!;
        panel.replaceChildren();

        const grid = document.createElement("div");
        grid.className = "directory-grid";

        if (summaryResult.kind === "ok" && summaryResult.data.ga4?.connected) {
          const analytics = summaryResult.data.ga4;
          const card = document.createElement("div");
          card.className = "integration-card";
          const latestSync = analytics.properties
            .map((property) => property.last_synced_at)
            .filter((value): value is string => Boolean(value))
            .sort()
            .at(-1);
          card.innerHTML =
            '<div class="integration-card__header"><span class="integration-card__icon">A</span><div class="integration-card__title">Google Analytics</div></div>';
          const description = document.createElement("p");
          description.className = "integration-card__desc";
          description.textContent = latestSync
            ? `${analytics.properties.length} mapped propert${analytics.properties.length === 1 ? "y" : "ies"} · Synced ${formatTimestamp(latestSync)}`
            : `${analytics.properties.length} mapped propert${analytics.properties.length === 1 ? "y" : "ies"} · Awaiting first sync`;
          const footer = document.createElement("div");
          footer.className = "integration-card__footer";
          footer.append(statusBadge("ready", "Connected"));
          card.append(description, footer);
          grid.append(card);
        }

        for (let i = 0; i < SOURCE_PRODUCTS.length; i++) {
          const key = SOURCE_PRODUCTS[i];
          const summary = summarizeReadiness(readinessResults[i]);
          const card = document.createElement("div");
          card.className = "integration-card";

          const header = document.createElement("div");
          header.className = "integration-card__header";
          const icon = document.createElement("span");
          icon.className = "integration-card__icon";
          icon.textContent = PRODUCT_LABELS[key][0];
          const title = document.createElement("div");
          title.className = "integration-card__title";
          title.textContent = PRODUCT_LABELS[key];
          header.append(icon, title);

          const desc = document.createElement("p");
          desc.className = "integration-card__desc";
          desc.textContent = summary.detail;

          const footer = document.createElement("div");
          footer.className = "integration-card__footer";
          footer.append(
            statusBadge(
              summary.status,
              summary.status === "ready"
                ? "Operational"
                : summary.status === "missing"
                  ? "Unavailable"
                  : summary.status.replace(/_/g, " "),
            ),
          );
          const link = document.createElement("a");
          link.className = "button button--secondary button--sm";
          link.href = `/${key}`;
          link.textContent = "Open →";
          footer.append(link);

          card.append(header, desc, footer);
          grid.append(card);
        }

        panel.append(grid);
      }

      function renderPerformance(
        summaryResult: Awaited<ReturnType<typeof fetchInsightsSummary>>,
      ): void {
        const panel = document.getElementById("performance-panel")!;
        panel.replaceChildren();
        if (summaryResult.kind !== "ok") {
          panel.append(
            errorAlert(describeFailure(summaryResult, "Performance")),
          );
          return;
        }
        const ga4 = summaryResult.data.ga4;
        if (!ga4?.connected || Object.keys(ga4.metrics).length === 0) {
          panel.append(
            emptyState(
              "No Analytics observations yet",
              "Connect and sync Google Analytics to report real website activity. LILOs will not invent values or trends while a source is unavailable.",
              "Manage data sources",
              "/integrations",
            ),
          );
          return;
        }
        const labels: Record<string, string> = {
          "ga4.sessions": "Sessions",
          "ga4.totalUsers": "Users",
          "ga4.screenPageViews": "Page views",
          "ga4.conversions": "Conversions",
        };
        const latestSync = ga4.properties
          .map((property) => property.last_synced_at)
          .filter((value): value is string => Boolean(value))
          .sort()
          .at(-1);
        const grid = document.createElement("div");
        grid.className = "metric-grid";
        for (const [key, value] of Object.entries(ga4.metrics)) {
          grid.append(
            metricCard(
              labels[key] ?? key.replace(/^ga4\./, "").replace(/_/g, " "),
              String(value),
              latestSync
                ? `Synced ${formatTimestamp(latestSync)}`
                : "Latest observation",
            ),
          );
        }
        panel.append(grid);
        const notice = document.createElement("p");
        notice.className = "source-note";
        notice.textContent =
          "Current totals are shown without a period comparison because the reporting API does not yet return an observation window or comparable prior period.";
        panel.append(notice);
      }

      function renderActivity(
        summaryResult: Awaited<ReturnType<typeof fetchInsightsSummary>>,
      ): void {
        const panel = document.getElementById("activity-panel")!;
        panel.replaceChildren();

        if (summaryResult.kind !== "ok") {
          panel.append(
            emptyState(
              "Activity unavailable",
              "Connect the insights product to see cross-product activity.",
              "Set up Insights",
              "/settings",
            ),
          );
          return;
        }

        const data = summaryResult.data;
        const groups: {
          title: string;
          metrics: { label: string; value: number }[];
        }[] = [];

        // GBP
        const gbpMetrics = [
          { label: "Locations", value: data.gbp?.locations ?? 0 },
          {
            label: "Profile snapshots",
            value: data.gbp?.profile_snapshots ?? 0,
          },
          {
            label: "Publications",
            value: Object.values(data.gbp?.publications ?? {}).reduce(
              (a, b) => a + b,
              0,
            ),
          },
        ];
        groups.push({ title: "Business Profile", metrics: gbpMetrics });

        // Reviews
        const reviewMetrics = Object.entries(data.reviews ?? {}).map(
          ([k, v]) => ({ label: k.replace(/_/g, " "), value: v }),
        );
        if (reviewMetrics.length > 0)
          groups.push({ title: "Reviews", metrics: reviewMetrics });

        // Leads
        const leadMetrics = Object.entries(data.leads ?? {}).map(([k, v]) => ({
          label: k.replace(/_/g, " "),
          value: v,
        }));
        if (leadMetrics.length > 0)
          groups.push({ title: "Leads", metrics: leadMetrics });

        // Content
        const contentMetrics = Object.entries(
          data.content_publications ?? {},
        ).map(([k, v]) => ({ label: k.replace(/_/g, " "), value: v }));
        if (contentMetrics.length > 0)
          groups.push({ title: "Content", metrics: contentMetrics });

        // SEO
        const seoMetrics = [
          ...Object.entries(data.seo?.crawl_runs ?? {}).map(([k, v]) => ({
            label: `Crawl: ${k}`,
            value: v,
          })),
          ...Object.entries(data.seo?.opportunities ?? {}).map(([k, v]) => ({
            label: `Opportunities: ${k}`,
            value: v,
          })),
        ];
        if (seoMetrics.length > 0)
          groups.push({ title: "SEO", metrics: seoMetrics });

        if (
          groups.length === 0 ||
          groups.every((g) => g.metrics.every((m) => m.value === 0))
        ) {
          panel.append(
            emptyState(
              "No activity recorded yet",
              "Once operations start running, activity from all products will appear here.",
            ),
          );
          return;
        }

        const grid = document.createElement("div");
        grid.className = "split";
        for (const group of groups) {
          const card = document.createElement("article");
          card.className = "card";
          const header = document.createElement("div");
          header.className = "card__header";
          header.append(
            Object.assign(document.createElement("h3"), {
              className: "card__title",
              textContent: group.title,
            }),
          );
          card.append(header);
          const body = document.createElement("div");
          body.className = "card__body";
          for (const m of group.metrics) {
            const row = document.createElement("div");
            row.className = "flex-row";
            row.style.justifyContent = "space-between";
            row.append(
              Object.assign(document.createElement("span"), {
                className: "text-sm",
                textContent: m.label.replace(/\b\w/g, (c) => c.toUpperCase()),
              }),
              Object.assign(document.createElement("strong"), {
                textContent: String(m.value),
              }),
            );
            body.append(row);
          }
          card.append(body);
          grid.append(card);
        }
        panel.append(grid);
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Insights");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
