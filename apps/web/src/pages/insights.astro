---
import AppShell from "../components/AppShell.astro";
import Button from "../lib/ui/Button.astro";
import EmptyState from "../lib/ui/EmptyState.astro";
import Notice from "../lib/ui/Notice.astro";
import PageHeader from "../lib/ui/PageHeader.astro";
import PageSection from "../lib/ui/PageSection.astro";
import PageShell from "../lib/ui/PageShell.astro";
import Region from "../lib/ui/Region.astro";
import Skeleton from "../lib/ui/Skeleton.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs insights" />
    <title>Insights · LILOs</title>
  </head>
  <body>
    <AppShell>
      <PageShell id="boot-not-configured"
        ><EmptyState
          heading="This deployment is not configured"
          description="Connect the platform runtime configuration to enable Insights."
        /></PageShell
      >
      <PageShell id="boot-loading" hidden
        ><Skeleton lines={3} label="Loading insights" /></PageShell
      >
      <PageShell id="boot-error" hidden><Region role="alert" /></PageShell>
      <PageShell id="workspace-empty" hidden
        ><EmptyState
          heading="No organization access yet"
          description="Ask an administrator to invite your account to an organization."
        /></PageShell
      >

      <PageShell id="insights-content" hidden>
        <PageHeader
          eyebrow="Operations"
          title="Insights"
          description="Client-facing reporting from observed operational and provider data."
        >
          <Button
            slot="actions"
            href="/automations?agent=agent.insights"
            variant="secondary"
            size="sm">Run cross-product agent</Button
          >
          <Button
            slot="actions"
            href="/integrations"
            variant="secondary"
            size="sm">Manage data sources</Button
          >
          <Region slot="meta" id="insights-reporting-controls" />
        </PageHeader>
        <PageSection eyebrow="Analytics" title="Website performance">
          <Region slot="actions" id="analytics-provenance" />
          <Region id="website-performance-panel"
            ><Skeleton lines={4} label="Loading website performance" /></Region
          >
        </PageSection>
        <PageSection eyebrow="Search Console" title="Organic search">
          <Region slot="actions" id="search-console-provenance" />
          <Region id="organic-search-panel" />
        </PageSection>
        <PageSection eyebrow="Operational data" title="Cross-product digest"
          ><Region id="digest-panel" /></PageSection
        >
        <Notice title="Reporting data sources"
          ><p>Connection and provider health are managed centrally.</p><Button
            slot="action"
            href="/integrations"
            variant="secondary"
            size="sm">Manage integrations</Button
          ></Notice
        >
      </PageShell>
    </AppShell>
    <script>
      import { fetchAnalyticsPerformance } from "../lib/analytics";
      import {
        fetchSearchConsolePerformance,
        type SearchConsolePerformanceReport,
      } from "../lib/search-console";
      import { fetchWebsites } from "../lib/seo";
      import type { ApiOutcome } from "../lib/api-client";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        emptyState,
        errorAlert,
        describeFailure,
        type BootRegions,
      } from "../lib/ui";
      import {
        reportingPeriodSelector,
        comparisonKPI,
        toTimeSeriesPoints,
        sourceFreshness,
        performanceSummary,
        formatDateRange,
        buildGscDataTable,
      } from "../lib/reporting";
      import { reportingTrendChart } from "../lib/reporting-chart";

      let organizationId = "";
      let currentPeriodDays = 28;

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("insights-content")!,
      };

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;

        await loadReportingData();
      }

      async function loadReportingData(): Promise<void> {
        const panel = document.getElementById("insights-reporting-controls")!;
        panel.replaceChildren();

        // Period selector
        const selector = reportingPeriodSelector(currentPeriodDays, (days) => {
          currentPeriodDays = days;
          void loadReportingData();
        });
        panel.append(selector);

        const [ga4Res, websitesRes] = await Promise.all([
          fetchAnalyticsPerformance(organizationId, currentPeriodDays),
          fetchWebsites(organizationId),
        ]);

        // Get first website for Search Console data
        let gscRes: ApiOutcome<SearchConsolePerformanceReport> | null = null;
        if (websitesRes.kind === "ok" && websitesRes.data.length > 0) {
          const firstWebsite = websitesRes.data[0];
          gscRes = await fetchSearchConsolePerformance(
            organizationId,
            firstWebsite.id,
            currentPeriodDays,
          );
        }

        // Date range label
        if (
          ga4Res.kind === "ok" &&
          ga4Res.data.connected &&
          ga4Res.data.range
        ) {
          const dateLabel = document.createElement("p");
          dateLabel.className = "ui-text-secondary";
          dateLabel.textContent = `${formatDateRange(ga4Res.data.range.start, ga4Res.data.range.end)} · vs ${formatDateRange(ga4Res.data.comparison_range?.start || "", ga4Res.data.comparison_range?.end || "")}`;
          panel.append(dateLabel);
        }

        renderWebsitePerformance(ga4Res);
        renderOrganicSearch(gscRes);
        renderDigest(ga4Res, gscRes);
      }

      function renderWebsitePerformance(
        ga4Res: Awaited<ReturnType<typeof fetchAnalyticsPerformance>>,
      ): void {
        const panel = document.getElementById("website-performance-panel")!;
        const provenancePanel = document.getElementById(
          "analytics-provenance",
        )!;
        panel.replaceChildren();
        provenancePanel.replaceChildren();

        if (ga4Res.kind !== "ok") {
          panel.append(errorAlert(describeFailure(ga4Res, "Performance")));
          return;
        }

        const data = ga4Res.data;
        if (!data.connected) {
          panel.append(
            emptyState(
              "No Analytics observations yet",
              "Connect and sync Google Analytics to report real website activity.",
              "Manage data sources",
              "/integrations",
            ),
          );
          return;
        }

        if (data.freshness) {
          const provenance = sourceFreshness(
            data.freshness.last_synced_at,
            data.freshness.status,
          );
          provenance.prepend(
            document.createTextNode(
              `Google Analytics · ${currentPeriodDays} days · `,
            ),
          );
          provenancePanel.append(provenance);
        }

        // KPI cards
        const kpiOrder = [
          "ga4.sessions",
          "ga4.totalUsers",
          "ga4.screenPageViews",
          "ga4.conversions",
        ];
        const kpiLabels: Record<string, string> = {
          "ga4.sessions": "Sessions",
          "ga4.totalUsers": "Users",
          "ga4.screenPageViews": "Page views",
          "ga4.conversions": "Conversions",
        };

        const kpiGrid = document.createElement("div");
        kpiGrid.className = "ui-card-grid ui-card-grid--sm";
        for (const key of kpiOrder) {
          const kpi = data.metrics[key];
          if (kpi) {
            kpiGrid.append(
              comparisonKPI(
                kpiLabels[key] || kpi.label,
                kpi.current,
                kpi.previous,
                kpi.delta,
                kpi.percent_delta,
                undefined,
                key,
                `${currentPeriodDays} days`,
              ),
            );
          }
        }
        panel.append(kpiGrid);

        // Daily trend chart
        if (data.series && data.series.length > 0) {
          const chartSection = document.createElement("div");
          chartSection.className =
            "ui-card ui-card--spaced ui-card--flush reporting-chart-card";
          const chartHeader = document.createElement("div");
          chartHeader.className = "ui-card__header";
          const chartTitle = document.createElement("h3");
          chartTitle.className = "ui-card__heading";
          chartTitle.textContent = "Website activity trend";
          chartHeader.append(chartTitle);
          chartSection.append(chartHeader);
          const chartBody = document.createElement("div");
          chartBody.className = "ui-card__body";
          chartBody.append(
            reportingTrendChart(
              [
                {
                  key: "sessions",
                  label: "Sessions",
                  points: toTimeSeriesPoints(data.series, "sessions"),
                },
                {
                  key: "users",
                  label: "Users",
                  points: toTimeSeriesPoints(data.series, "totalUsers"),
                },
                {
                  key: "page-views",
                  label: "Page views",
                  points: toTimeSeriesPoints(data.series, "screenPageViews"),
                },
                {
                  key: "conversions",
                  label: "Conversions",
                  points: toTimeSeriesPoints(data.series, "conversions"),
                },
              ],
              "sessions",
            ),
          );
          chartSection.append(chartBody);
          panel.append(chartSection);
        }
      }

      function renderOrganicSearch(
        gscRes: ApiOutcome<SearchConsolePerformanceReport> | null,
      ): void {
        const panel = document.getElementById("organic-search-panel")!;
        const provenancePanel = document.getElementById(
          "search-console-provenance",
        )!;
        panel.replaceChildren();
        provenancePanel.replaceChildren();

        if (!gscRes || gscRes.kind !== "ok" || !gscRes.data.connected) {
          panel.append(
            emptyState(
              "No Search Console data available",
              "Connect Search Console in SEO settings to see organic search performance.",
              "Set up Search Console",
              "/seo",
            ),
          );
          return;
        }

        const data = gscRes.data;

        if (data.freshness) {
          const provenance = sourceFreshness(
            data.freshness.last_synced_at,
            data.freshness.status,
          );
          provenance.prepend(
            document.createTextNode(
              `Google Search Console · ${currentPeriodDays} days · `,
            ),
          );
          provenancePanel.append(provenance);
        }

        // KPI cards
        const gscOrder = ["clicks", "impressions", "ctr", "position"];
        const gscLabels: Record<string, string> = {
          clicks: "Clicks",
          impressions: "Impressions",
          ctr: "CTR",
          position: "Avg position",
        };
        const gscFormatters: Record<string, (v: number | null) => string> = {
          clicks: (v) => (v !== null ? v.toLocaleString() : "—"),
          impressions: (v) => (v !== null ? v.toLocaleString() : "—"),
          ctr: (v) => (v !== null ? `${(v * 100).toFixed(1)}%` : "No data"),
          position: (v) => (v !== null ? v.toFixed(1) : "No data"),
        };

        const gscGrid = document.createElement("div");
        gscGrid.className = "ui-card-grid ui-card-grid--sm";
        for (const key of gscOrder) {
          const metric = data.metrics[key];
          if (metric) {
            const card = comparisonKPI(
              gscLabels[key] || key,
              metric.current as number | null,
              metric.previous as number | null,
              metric.delta as number | null,
              metric.percent_delta as number | null,
              undefined,
              key,
              `${currentPeriodDays} days`,
            );
            // Override value formatting for position/CTR
            const valueEl = card.querySelector(".ui-metric-card__value");
            if (valueEl) {
              valueEl.textContent =
                gscFormatters[key]?.(metric.current as number | null) || "—";
            }
            gscGrid.append(card);
          }
        }
        panel.append(gscGrid);

        // Daily series chart
        if (data.series && data.series.length > 0) {
          const chartSection = document.createElement("div");
          chartSection.className =
            "ui-card ui-card--spaced ui-card--flush reporting-chart-card";
          const chartHeader = document.createElement("div");
          chartHeader.className = "ui-card__header";
          const chartTitle = document.createElement("h3");
          chartTitle.className = "ui-card__heading";
          chartTitle.textContent = "Organic search trend";
          chartHeader.append(chartTitle);
          chartSection.append(chartHeader);
          const chartBody = document.createElement("div");
          chartBody.className = "ui-card__body";
          chartBody.append(
            reportingTrendChart(
              [
                {
                  key: "clicks",
                  label: "Clicks",
                  points: data.series.map((item) => ({
                    date: item.date,
                    value: item.clicks ?? null,
                  })),
                },
                {
                  key: "impressions",
                  label: "Impressions",
                  points: data.series.map((item) => ({
                    date: item.date,
                    value: item.impressions ?? null,
                  })),
                },
                {
                  key: "ctr",
                  label: "CTR",
                  points: data.series.map((item) => ({
                    date: item.date,
                    value: item.ctr ?? null,
                  })),
                  formatValue: (value) => `${(value * 100).toFixed(1)}%`,
                },
                {
                  key: "position",
                  label: "Avg position",
                  points: data.series.map((item) => ({
                    date: item.date,
                    value: item.position ?? null,
                  })),
                  formatValue: (value) => value.toFixed(1),
                },
              ],
              "clicks",
            ),
          );
          chartSection.append(chartBody);
          panel.append(chartSection);
        }

        // Top queries table
        if (data.top_queries && data.top_queries.length > 0) {
          const queriesSection = document.createElement("div");
          queriesSection.className = "ui-card ui-card--spaced ui-card--flush";
          const qHeader = document.createElement("div");
          qHeader.className = "ui-card__header";
          const qTitle = document.createElement("h3");
          qTitle.className = "ui-card__heading";
          qTitle.textContent = `Top search queries (${data.top_queries.length})`;
          qHeader.append(qTitle);
          queriesSection.append(qHeader);
          const qBody = document.createElement("div");
          qBody.className = "ui-card__body";
          const qTable = buildGscDataTable(
            ["Query", "Clicks", "Impressions", "CTR", "Position"],
            data.top_queries.slice(0, 5).map((q) => ({
              primary: q.query,
              clicks: q.clicks,
              impressions: q.impressions,
              ctr: `${(q.ctr * 100).toFixed(1)}%`,
              position: q.position.toFixed(1),
            })),
          );
          qBody.append(qTable);
          const viewAll = document.createElement("a");
          viewAll.className = "ui-button ui-button--ghost ui-button--sm";
          viewAll.href = "/seo";
          viewAll.textContent = "View all queries in SEO";
          qBody.append(viewAll);
          queriesSection.append(qBody);
          panel.append(queriesSection);
        }

        if (data.top_pages && data.top_pages.length > 0) {
          const pagesSection = document.createElement("div");
          pagesSection.className = "ui-card ui-card--spaced ui-card--flush";
          const header = document.createElement("div");
          header.className = "ui-card__header";
          header.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent: `Top landing pages (${data.top_pages.length})`,
            }),
          );
          const body = document.createElement("div");
          body.className = "ui-card__body";
          body.append(
            buildGscDataTable(
              ["Page", "Clicks", "Impressions", "CTR", "Position"],
              data.top_pages.slice(0, 5).map((page) => ({
                primary: page.page,
                clicks: page.clicks,
                impressions: page.impressions,
                ctr: `${(page.ctr * 100).toFixed(1)}%`,
                position: page.position.toFixed(1),
              })),
            ),
          );
          const viewAll = document.createElement("a");
          viewAll.className = "ui-button ui-button--ghost ui-button--sm";
          viewAll.href = "/seo";
          viewAll.textContent = "View all pages in SEO";
          body.append(viewAll);
          pagesSection.append(header, body);
          panel.append(pagesSection);
        }
      }

      function renderDigest(
        ga4Res: Awaited<ReturnType<typeof fetchAnalyticsPerformance>>,
        gscRes: ApiOutcome<SearchConsolePerformanceReport> | null,
      ): void {
        const panel = document.getElementById("digest-panel")!;
        panel.replaceChildren();

        const statements: string[] = [];
        if (ga4Res.kind === "ok" && ga4Res.data.connected) {
          const kpiLabels: Record<string, string> = {
            "ga4.sessions": "Sessions",
            "ga4.totalUsers": "Users",
            "ga4.screenPageViews": "Page views",
            "ga4.conversions": "Conversions",
          };
          for (const [key, label] of Object.entries(kpiLabels)) {
            const metric = ga4Res.data.metrics[key];
            if (
              metric?.percent_delta !== null &&
              metric?.percent_delta !== undefined
            ) {
              const pct = metric.percent_delta;
              const direction =
                Math.abs(pct) < 1
                  ? "was essentially unchanged"
                  : pct > 0
                    ? `increased ${Math.abs(pct).toFixed(1)}%`
                    : `decreased ${Math.abs(pct).toFixed(1)}%`;
              statements.push(
                `${label} ${direction} compared with the previous ${currentPeriodDays} days.`,
              );
            }
          }
        }
        if (gscRes && gscRes.kind === "ok" && gscRes.data.connected) {
          const gscLabels: Record<string, string> = {
            clicks: "Search clicks",
            impressions: "Search impressions",
            ctr: "Click-through rate",
            position: "Average search position",
          };
          for (const [key, label] of Object.entries(gscLabels)) {
            const metric = gscRes.data.metrics[key];
            if (
              metric?.percent_delta !== null &&
              metric?.percent_delta !== undefined
            ) {
              const pct = metric.percent_delta;
              const direction =
                Math.abs(pct) < 1
                  ? "was essentially unchanged"
                  : pct > 0
                    ? `increased ${Math.abs(pct).toFixed(1)}%`
                    : `decreased ${Math.abs(pct).toFixed(1)}%`;
              statements.push(
                `${label} ${direction} compared with the previous ${currentPeriodDays} days.`,
              );
            }
          }
        }

        const summary = performanceSummary(statements);
        if (summary) {
          panel.append(summary);
        }
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Insights");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
