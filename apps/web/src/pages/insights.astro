---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs insights" />
    <title>Insights · LILOs</title>
  </head>
  <body>
    <AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1>
        <p>No Supabase or API connection is configured for this build.</p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p class="loading-state">Loading insights…</p>
      </div>

      <div id="boot-error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <div class="empty-state">
          <span class="empty-state__icon" aria-hidden="true">○</span>
          <h3>No organization access yet</h3>
          <p>
            Your account is not a member of any organization. Ask an
            administrator to invite you.
          </p>
        </div>
      </div>

      <div id="insights-content" hidden>
        <div class="page-head">
          <div class="page-head__intro">
            <p class="eyebrow">Operations</p>
            <h1>Insights</h1>
            <p>
              Client-facing reporting from real operational data — no simulated
              or fabricated metrics.
            </p>
          </div>
          <div class="page-head__meta">
            <div class="page-head__actions">
              <a
                class="button button--secondary button--sm"
                href="/integrations">Manage data sources</a
              >
            </div>
          </div>
        </div>

        <div id="insights-readiness-panel"></div>
        <div id="insights-reporting-controls"></div>

        <div id="website-performance-panel">
          <div class="loading-state">Loading performance…</div>
        </div>

        <div id="organic-search-panel"></div>

        <div id="cross-product-panel"></div>

        <div id="digest-panel"></div>

        <div id="sources-panel"></div>
      </div>
    </AppShell>
    <script>
      import {
        fetchInsightsSummary,
        fetchProductReadiness,
        PRODUCT_LABELS,
      } from "../lib/workspace";
      import { summarizeReadiness } from "../lib/dashboard-logic";
      import { fetchAnalyticsPerformance } from "../lib/analytics";
      import {
        fetchSearchConsolePerformance,
        type SearchConsolePerformanceReport,
      } from "../lib/search-console";
      import { fetchWebsites } from "../lib/seo";
      import { apiGet, type ApiOutcome } from "../lib/api-client";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        emptyState,
        errorAlert,
        describeFailure,
        formatTimestamp,
        type BootRegions,
      } from "../lib/ui";
      import {
        reportingPeriodSelector,
        comparisonKPI,
        timeSeriesChart,
        toTimeSeriesPoints,
        sourceFreshness,
        performanceSummary,
        formatDateRange,
        buildGscDataTable,
      } from "../lib/reporting";

      let organizationId = "";
      let currentPeriodDays = 28;

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("insights-content")!,
      };

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;

        const [readinessResult, websiteReadinessRes] = await Promise.all([
          fetchProductReadiness(organizationId, "insights"),
          apiGet<Record<string, unknown>>(
            `/api/v1/organizations/${organizationId}/insights/website-readiness`,
          ),
        ]);

        renderReadiness(readinessResult, websiteReadinessRes);
        await loadReportingData();
      }

      async function loadReportingData(): Promise<void> {
        const panel = document.getElementById("insights-reporting-controls")!;
        panel.replaceChildren();

        // Period selector
        const selector = reportingPeriodSelector(currentPeriodDays, (days) => {
          currentPeriodDays = days;
          void loadReportingData();
        });
        panel.append(selector);

        const [ga4Res, websitesRes] = await Promise.all([
          fetchAnalyticsPerformance(organizationId, currentPeriodDays),
          fetchWebsites(organizationId),
        ]);

        // Get first website for Search Console data
        let gscRes: ApiOutcome<SearchConsolePerformanceReport> | null = null;
        if (websitesRes.kind === "ok" && websitesRes.data.length > 0) {
          const firstWebsite = websitesRes.data[0];
          gscRes = await fetchSearchConsolePerformance(
            organizationId,
            firstWebsite.id,
            currentPeriodDays,
          );
        }

        // Date range label
        if (
          ga4Res.kind === "ok" &&
          ga4Res.data.connected &&
          ga4Res.data.range
        ) {
          const dateLabel = document.createElement("p");
          dateLabel.className = "text-sm muted";
          dateLabel.style.marginTop = "0.5rem";
          dateLabel.textContent = `${formatDateRange(ga4Res.data.range.start, ga4Res.data.range.end)} · vs ${formatDateRange(ga4Res.data.comparison_range?.start || "", ga4Res.data.comparison_range?.end || "")}`;
          panel.append(dateLabel);
        }

        renderWebsitePerformance(ga4Res);
        renderOrganicSearch(gscRes);
        renderDigest(ga4Res, gscRes);

        // Cross-product and sources
        const summaryRes = await fetchInsightsSummary(organizationId);
        const sourceReadiness = await Promise.all(
          (["gbp", "reviews", "leads", "content", "seo"] as const).map((key) =>
            fetchProductReadiness(organizationId, key),
          ),
        );
        renderCrossProduct(summaryRes);
        renderSources(sourceReadiness, ga4Res);
      }

      function renderReadiness(
        outcome: Awaited<ReturnType<typeof fetchProductReadiness>>,
        websiteReadinessRes: ApiOutcome<Record<string, unknown>>,
      ): void {
        const panel = document.getElementById("insights-readiness-panel")!;
        panel.replaceChildren();

        if (outcome.kind !== "ok") {
          panel.append(errorAlert(describeFailure(outcome, "Insights")));
          return;
        }

        const summary = summarizeReadiness(outcome);
        if (summary.status !== "ready") {
          const alert = document.createElement("div");
          alert.className =
            summary.status === "blocked"
              ? "alert alert--warning"
              : "alert alert--info";
          alert.style.marginBottom = "0";
          alert.append(
            statusBadge(
              summary.status,
              summary.status === "blocked"
                ? "Needs attention"
                : "Setup required",
            ),
          );
          const text = document.createElement("p");
          text.className = "text-sm";
          text.textContent = summary.detail;
          alert.append(text);
          panel.append(alert);
        }

        // Website readiness summary card from the dedicated endpoint
        if (websiteReadinessRes.kind === "ok") {
          const wr = websiteReadinessRes.data;
          const card = document.createElement("div");
          card.className = "card";
          card.style.marginTop = "var(--space-4)";
          const header = document.createElement("div");
          header.className = "card__header";
          header.append(
            Object.assign(document.createElement("h3"), {
              className: "card__title",
              textContent: "Website readiness",
            }),
          );
          card.append(header);
          const body = document.createElement("div");
          body.className = "card__body";

          const facts: { label: string; ready: boolean; note: string }[] = [];
          const configured = !!wr.canonical_domain_configured;
          facts.push({
            label: "Domain",
            ready: configured,
            note: configured
              ? `Primary: ${wr.primary_domain || "Set"}`
              : "Not configured",
          });
          const scMapped = !!wr.search_console_mapped;
          const scReady = scMapped && wr.search_console_freshness === "fresh";
          facts.push({
            label: "Search Console",
            ready: scReady,
            note: scMapped
              ? readinessClientLabel(wr.search_console_freshness as string)
              : "Not mapped",
          });
          const gaMapped = !!wr.analytics_mapped;
          const gaReady = gaMapped && wr.analytics_freshness === "fresh";
          facts.push({
            label: "Analytics",
            ready: gaReady,
            note: gaMapped
              ? readinessClientLabel(wr.analytics_freshness as string)
              : "Not mapped",
          });
          const crawlDone = !!wr.crawl_ready;
          facts.push({
            label: "Crawl",
            ready: crawlDone,
            note: crawlDone
              ? wr.last_crawl_at
                ? `Last crawl: ${formatTimestamp(wr.last_crawl_at as string)}`
                : "Crawl ready"
              : "Not yet crawled",
          });

          for (const f of facts) {
            const row = document.createElement("div");
            row.className = "flex-row";
            row.style.cssText =
              "align-items:center;justify-content:space-between;margin-bottom:var(--space-2);gap:var(--space-3);";
            const labelText = document.createElement("span");
            labelText.className = "text-sm";
            labelText.textContent = f.label;
            const rightSide = document.createElement("div");
            rightSide.style.cssText =
              "display:flex;align-items:center;gap:var(--space-2);";
            rightSide.append(
              statusBadge(
                f.ready ? "ready" : "setup",
                f.ready ? "Ready" : "Needs attention",
              ),
            );
            const noteEl = document.createElement("span");
            noteEl.className = "text-xs muted";
            noteEl.textContent = f.note;
            rightSide.append(noteEl);
            row.append(labelText, rightSide);
            body.append(row);
          }

          card.append(body);
          panel.append(card);
        }
      }

      function readinessClientLabel(freshness: string): string {
        switch (freshness) {
          case "fresh":
            return "Synced";
          case "stale":
            return "Stale";
          case "never_synced":
            return "Mapped \u00b7 not yet synced";
          case "not_mapped":
            return "Not mapped";
          default:
            return freshness;
        }
      }

      function renderWebsitePerformance(
        ga4Res: Awaited<ReturnType<typeof fetchAnalyticsPerformance>>,
      ): void {
        const panel = document.getElementById("website-performance-panel")!;
        panel.replaceChildren();

        if (ga4Res.kind !== "ok") {
          panel.append(errorAlert(describeFailure(ga4Res, "Performance")));
          return;
        }

        const data = ga4Res.data;
        if (!data.connected) {
          panel.append(
            emptyState(
              "No Analytics observations yet",
              "Connect and sync Google Analytics to report real website activity.",
              "Manage data sources",
              "/integrations",
            ),
          );
          return;
        }

        // Section heading
        const heading = document.createElement("div");
        heading.className = "section-heading section-heading--first";
        const headingLeft = document.createElement("div");
        const eyebrow = document.createElement("p");
        eyebrow.className = "eyebrow";
        eyebrow.textContent = "Website performance";
        const title = document.createElement("h2");
        title.textContent = "Analytics";
        headingLeft.append(eyebrow, title);
        heading.append(headingLeft);

        // Freshness
        if (data.freshness) {
          const freshness = sourceFreshness(
            data.freshness.last_synced_at,
            data.freshness.status,
          );
          heading.append(freshness);
        }
        panel.append(heading);

        // KPI cards
        const kpiOrder = [
          "ga4.sessions",
          "ga4.totalUsers",
          "ga4.screenPageViews",
          "ga4.conversions",
        ];
        const kpiLabels: Record<string, string> = {
          "ga4.sessions": "Sessions",
          "ga4.totalUsers": "Users",
          "ga4.screenPageViews": "Page views",
          "ga4.conversions": "Conversions",
        };

        const kpiGrid = document.createElement("div");
        kpiGrid.className = "metric-grid";
        for (const key of kpiOrder) {
          const kpi = data.metrics[key];
          if (kpi) {
            kpiGrid.append(
              comparisonKPI(
                kpiLabels[key] || kpi.label,
                kpi.current,
                kpi.previous,
                kpi.delta,
                kpi.percent_delta,
                "",
              ),
            );
          }
        }
        panel.append(kpiGrid);

        // Daily trend chart
        if (data.series && data.series.length > 0) {
          const chartSection = document.createElement("div");
          chartSection.className = "card";
          chartSection.style.marginTop = "var(--space-5)";
          const chartHeader = document.createElement("div");
          chartHeader.className = "card__header";
          const chartTitle = document.createElement("h3");
          chartTitle.className = "card__title";
          chartTitle.textContent = "Daily sessions";
          chartHeader.append(chartTitle);
          chartSection.append(chartHeader);
          const chartBody = document.createElement("div");
          chartBody.className = "card__body";
          chartBody.style.padding = "0";
          const sessionData = toTimeSeriesPoints(data.series, "sessions");
          chartBody.append(timeSeriesChart(sessionData, "Sessions"));
          chartSection.append(chartBody);
          panel.append(chartSection);
        }
      }

      function renderOrganicSearch(
        gscRes: ApiOutcome<SearchConsolePerformanceReport> | null,
      ): void {
        const panel = document.getElementById("organic-search-panel")!;
        panel.replaceChildren();

        if (!gscRes || gscRes.kind !== "ok" || !gscRes.data.connected) {
          panel.append(
            emptyState(
              "No Search Console data available",
              "Connect Search Console in SEO settings to see organic search performance.",
              "Set up Search Console",
              "/seo",
            ),
          );
          return;
        }

        const data = gscRes.data;

        const heading = document.createElement("div");
        heading.className = "section-heading";
        const headingLeft = document.createElement("div");
        const eyebrow = document.createElement("p");
        eyebrow.className = "eyebrow";
        eyebrow.textContent = "Organic search";
        const title = document.createElement("h2");
        title.textContent = "Search Console";
        headingLeft.append(eyebrow, title);
        heading.append(headingLeft);

        if (data.freshness) {
          heading.append(
            sourceFreshness(
              data.freshness.last_synced_at,
              data.freshness.status,
            ),
          );
        }
        panel.append(heading);

        // KPI cards
        const gscOrder = ["clicks", "impressions", "ctr", "position"];
        const gscLabels: Record<string, string> = {
          clicks: "Clicks",
          impressions: "Impressions",
          ctr: "CTR",
          position: "Avg position",
        };
        const gscFormatters: Record<string, (v: number | null) => string> = {
          clicks: (v) => (v !== null ? v.toLocaleString() : "—"),
          impressions: (v) => (v !== null ? v.toLocaleString() : "—"),
          ctr: (v) => (v !== null ? `${(v * 100).toFixed(1)}%` : "—"),
          position: (v) => (v !== null ? v.toFixed(1) : "—"),
        };

        const gscGrid = document.createElement("div");
        gscGrid.className = "metric-grid";
        for (const key of gscOrder) {
          const metric = data.metrics[key];
          if (metric) {
            const card = comparisonKPI(
              gscLabels[key] || key,
              metric.current as number | null,
              metric.previous as number | null,
              metric.delta as number | null,
              metric.percent_delta as number | null,
              "",
              key,
            );
            // Override value formatting for position/CTR
            const valueEl = card.querySelector(".kpi-card__value");
            if (valueEl) {
              valueEl.textContent =
                gscFormatters[key]?.(metric.current as number | null) || "—";
            }
            gscGrid.append(card);
          }
        }
        panel.append(gscGrid);

        // Daily series chart
        if (data.series && data.series.length > 0) {
          const chartSection = document.createElement("div");
          chartSection.className = "card";
          chartSection.style.marginTop = "var(--space-5)";
          const chartHeader = document.createElement("div");
          chartHeader.className = "card__header";
          const chartTitle = document.createElement("h3");
          chartTitle.className = "card__title";
          chartTitle.textContent = "Daily impressions";
          chartHeader.append(chartTitle);
          chartSection.append(chartHeader);
          const chartBody = document.createElement("div");
          chartBody.className = "card__body";
          chartBody.style.padding = "0";
          const impressionData = data.series.map((s) => ({
            date: s.date,
            value: s.impressions ?? null,
          }));
          chartBody.append(timeSeriesChart(impressionData, "Impressions"));
          chartSection.append(chartBody);
          panel.append(chartSection);
        }

        // Top queries table
        if (data.top_queries && data.top_queries.length > 0) {
          const queriesSection = document.createElement("div");
          queriesSection.className = "card";
          queriesSection.style.marginTop = "var(--space-4)";
          const qHeader = document.createElement("div");
          qHeader.className = "card__header";
          const qTitle = document.createElement("h3");
          qTitle.className = "card__title";
          qTitle.textContent = `Top search queries (${data.top_queries.length})`;
          qHeader.append(qTitle);
          queriesSection.append(qHeader);
          const qBody = document.createElement("div");
          qBody.className = "card__body";
          qBody.style.padding = "0";
          const qTable = buildGscDataTable(
            ["Query", "Clicks", "Impressions", "CTR", "Position"],
            data.top_queries.map((q) => ({
              primary: q.query,
              clicks: q.clicks,
              impressions: q.impressions,
              ctr: `${(q.ctr * 100).toFixed(1)}%`,
              position: q.position.toFixed(1),
            })),
          );
          qBody.append(qTable);
          queriesSection.append(qBody);
          panel.append(queriesSection);
        }
      }

      function renderCrossProduct(
        summaryResult: Awaited<ReturnType<typeof fetchInsightsSummary>>,
      ): void {
        const panel = document.getElementById("cross-product-panel")!;
        panel.replaceChildren();

        if (summaryResult.kind !== "ok") {
          return;
        }

        const data = summaryResult.data;
        const groups: {
          title: string;
          metrics: { label: string; value: number }[];
        }[] = [];

        const gbpMetrics = [
          { label: "Locations", value: data.gbp?.locations ?? 0 },
          {
            label: "Publications",
            value: Object.values(data.gbp?.publications ?? {}).reduce(
              (a, b) => a + b,
              0,
            ),
          },
        ];
        groups.push({ title: "Business Profile", metrics: gbpMetrics });

        const reviewMetrics = Object.entries(data.reviews ?? {}).map(
          ([k, v]) => ({ label: k.replace(/_/g, " "), value: v }),
        );
        if (reviewMetrics.length > 0)
          groups.push({ title: "Reviews", metrics: reviewMetrics });

        const leadMetrics = Object.entries(data.leads ?? {}).map(([k, v]) => ({
          label: k.replace(/_/g, " "),
          value: v,
        }));
        if (leadMetrics.length > 0)
          groups.push({ title: "Leads", metrics: leadMetrics });

        const contentMetrics = Object.entries(
          data.content_publications ?? {},
        ).map(([k, v]) => ({ label: k.replace(/_/g, " "), value: v }));
        if (contentMetrics.length > 0)
          groups.push({ title: "Content", metrics: contentMetrics });

        const seoMetrics = [
          ...Object.entries(data.seo?.crawl_runs ?? {}).map(([k, v]) => ({
            label: `Crawl: ${k}`,
            value: v,
          })),
          ...Object.entries(data.seo?.opportunities ?? {}).map(([k, v]) => ({
            label: `Opportunities: ${k}`,
            value: v,
          })),
        ];
        if (seoMetrics.length > 0)
          groups.push({ title: "SEO", metrics: seoMetrics });

        if (
          groups.length === 0 ||
          groups.every((g) => g.metrics.every((m) => m.value === 0))
        ) {
          return;
        }

        const heading = document.createElement("div");
        heading.className = "section-heading";
        const headingLeft = document.createElement("div");
        const eyebrow = document.createElement("p");
        eyebrow.className = "eyebrow";
        eyebrow.textContent = "Activity";
        const title = document.createElement("h2");
        title.textContent = "Cross-product metrics";
        headingLeft.append(eyebrow, title);
        heading.append(headingLeft);
        panel.append(heading);

        const grid = document.createElement("div");
        grid.className = "directory-grid";
        for (const group of groups) {
          const card = document.createElement("article");
          card.className = "card";
          const cardHeader = document.createElement("div");
          cardHeader.className = "card__header";
          cardHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "card__title",
              textContent: group.title,
            }),
          );
          card.append(cardHeader);
          const body = document.createElement("div");
          body.className = "card__body";
          for (const m of group.metrics) {
            const row = document.createElement("div");
            row.className = "flex-row";
            row.style.justifyContent = "space-between";
            row.append(
              Object.assign(document.createElement("span"), {
                className: "text-sm",
                textContent: m.label.replace(/\b\w/g, (c) => c.toUpperCase()),
              }),
              Object.assign(document.createElement("strong"), {
                textContent: String(m.value),
              }),
            );
            body.append(row);
          }
          card.append(body);
          grid.append(card);
        }
        panel.append(grid);
      }

      function renderDigest(
        ga4Res: Awaited<ReturnType<typeof fetchAnalyticsPerformance>>,
        gscRes: ApiOutcome<SearchConsolePerformanceReport> | null,
      ): void {
        const panel = document.getElementById("digest-panel")!;
        panel.replaceChildren();

        const statements: string[] = [];
        if (ga4Res.kind === "ok" && ga4Res.data.connected) {
          const kpiLabels: Record<string, string> = {
            "ga4.sessions": "Sessions",
            "ga4.totalUsers": "Users",
            "ga4.screenPageViews": "Page views",
            "ga4.conversions": "Conversions",
          };
          for (const [key, label] of Object.entries(kpiLabels)) {
            const metric = ga4Res.data.metrics[key];
            if (
              metric?.percent_delta !== null &&
              metric?.percent_delta !== undefined
            ) {
              const pct = metric.percent_delta;
              const direction =
                Math.abs(pct) < 1
                  ? "was essentially unchanged"
                  : pct > 0
                    ? `increased ${Math.abs(pct).toFixed(1)}%`
                    : `decreased ${Math.abs(pct).toFixed(1)}%`;
              statements.push(
                `${label} ${direction} compared with the previous ${currentPeriodDays} days.`,
              );
            }
          }
        }
        if (gscRes && gscRes.kind === "ok" && gscRes.data.connected) {
          const gscLabels: Record<string, string> = {
            clicks: "Search clicks",
            impressions: "Search impressions",
            ctr: "Click-through rate",
            position: "Average search position",
          };
          for (const [key, label] of Object.entries(gscLabels)) {
            const metric = gscRes.data.metrics[key];
            if (
              metric?.percent_delta !== null &&
              metric?.percent_delta !== undefined
            ) {
              const pct = metric.percent_delta;
              const direction =
                Math.abs(pct) < 1
                  ? "was essentially unchanged"
                  : pct > 0
                    ? `increased ${Math.abs(pct).toFixed(1)}%`
                    : `decreased ${Math.abs(pct).toFixed(1)}%`;
              statements.push(
                `${label} ${direction} compared with the previous ${currentPeriodDays} days.`,
              );
            }
          }
        }

        const summary = performanceSummary(statements);
        if (summary) {
          panel.append(summary);
        }
      }

      function renderSources(
        readinessResults: Awaited<ReturnType<typeof fetchProductReadiness>>[],
        ga4Res: Awaited<ReturnType<typeof fetchAnalyticsPerformance>>,
      ): void {
        const panel = document.getElementById("sources-panel")!;
        panel.replaceChildren();

        const heading = document.createElement("div");
        heading.className = "section-heading";
        const headingLeft = document.createElement("div");
        const eyebrow = document.createElement("p");
        eyebrow.className = "eyebrow";
        eyebrow.textContent = "Data sources";
        const title = document.createElement("h2");
        title.textContent = "Connection status";
        headingLeft.append(eyebrow, title);
        heading.append(headingLeft);
        panel.append(heading);

        const grid = document.createElement("div");
        grid.className = "directory-grid";

        // GA4
        if (ga4Res.kind === "ok" && ga4Res.data.connected) {
          const card = document.createElement("div");
          card.className = "integration-card";
          card.innerHTML =
            '<div class="integration-card__header"><span class="integration-card__icon">A</span><div class="integration-card__title">Google Analytics</div></div>';
          const desc = document.createElement("p");
          desc.className = "integration-card__desc";
          desc.textContent = ga4Res.data.freshness.last_synced_at
            ? `Synced ${formatTimestamp(ga4Res.data.freshness.last_synced_at)}`
            : "Awaiting first sync";
          const footer = document.createElement("div");
          footer.className = "integration-card__footer";
          footer.append(statusBadge("ready", "Connected"));
          card.append(desc, footer);
          grid.append(card);
        }

        // Other products
        const sourceKeys = [
          "gbp",
          "reviews",
          "leads",
          "content",
          "seo",
        ] as const;
        for (let i = 0; i < sourceKeys.length; i++) {
          const key = sourceKeys[i];
          const summary = summarizeReadiness(readinessResults[i]);
          const card = document.createElement("div");
          card.className = "integration-card";

          const header = document.createElement("div");
          header.className = "integration-card__header";
          const icon = document.createElement("span");
          icon.className = "integration-card__icon";
          icon.textContent = PRODUCT_LABELS[key][0];
          const cardTitle = document.createElement("div");
          cardTitle.className = "integration-card__title";
          cardTitle.textContent = PRODUCT_LABELS[key];
          header.append(icon, cardTitle);

          const desc = document.createElement("p");
          desc.className = "integration-card__desc";
          desc.textContent = summary.detail;

          const footer = document.createElement("div");
          footer.className = "integration-card__footer";
          footer.append(
            statusBadge(
              summary.status,
              summary.status === "ready"
                ? "Operational"
                : summary.status === "blocked"
                  ? "Needs attention"
                  : summary.status === "setup"
                    ? "Setup required"
                    : summary.status,
            ),
          );
          const link = document.createElement("a");
          link.className = "button button--secondary button--sm";
          link.href = `/${key}`;
          link.textContent = "Open";
          footer.append(link);

          card.append(header, desc, footer);
          grid.append(card);
        }

        panel.append(grid);
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Insights");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
