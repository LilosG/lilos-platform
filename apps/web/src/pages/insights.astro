---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content="LILOs Insights workspace" /><title>
      Insights · LILOs
    </title></head
  >
  <body
    ><AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1><p>
          No Supabase or API connection is configured for this build.
        </p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p>Loading Insights…</p>
      </div>

      <div id="boot-error" class="alert alert--error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <h1>No organization access yet</h1><p>
          Your account is not a member of any organization. Ask an administrator
          to invite you.
        </p>
      </div>

      <div id="insights-content" hidden>
        <section id="overview" aria-labelledby="page-title">
          <p class="eyebrow">Insights</p><h1 id="page-title">Insights</h1>
        </section>

        <section aria-labelledby="readiness-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Product readiness</p><h2 id="readiness-title">
                Setup status
              </h2>
            </div>
          </div><div class="attention-card" id="readiness-panel">
            <p>Checking readiness…</p>
          </div>
        </section>

        <section aria-labelledby="sources-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Data sources</p><h2 id="sources-title">
                What insights will draw on
              </h2><p>
                Insights is a cross-product reporting view populated from real
                activity history across the connected products. Complete setup
                on each product's page to unlock reporting.
              </p>
            </div>
          </div><ul class="product-list" id="sources-list"></ul>
        </section>

        <section aria-labelledby="activity-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Activity</p><h2 id="activity-title">
                Real cross-product activity
              </h2><p>
                Counts below are derived live from real operational records — no
                simulated or fabricated metrics.
              </p>
            </div>
          </div><div class="attention-card" id="activity-panel">
            <p>Loading activity…</p>
          </div>
        </section>
      </div>
    </AppShell>
    <script>
      import {
        fetchMyOrganizations,
        fetchPrincipal,
        fetchProductReadiness,
        fetchInsightsSummary,
        PRODUCT_LABELS,
        type MyOrganization,
        type ProductKey,
      } from "../lib/workspace";
      import { selectDefaultOrganization } from "../lib/dashboard-logic";
      import { getCurrentSession, signOut } from "../lib/session";
      import { readPublicConfig } from "../lib/config";
      import type { ApiOutcome } from "../lib/api-client";

      // Products whose activity feeds this cross-product reporting view.
      // Insights itself is deliberately excluded from its own source list.
      const SOURCE_PRODUCTS: { key: ProductKey; href: string }[] = [
        { key: "gbp", href: "/gbp" },
        { key: "reviews", href: "/reviews" },
        { key: "leads", href: "/leads" },
        { key: "content", href: "/content" },
        { key: "seo", href: "/seo" },
      ];

      let organizationId = "";
      let organizations: MyOrganization[] = [];

      const regions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("insights-content")!,
      };

      function showOnly(region: HTMLElement): void {
        for (const key of Object.keys(regions) as (keyof typeof regions)[]) {
          regions[key].hidden = regions[key] !== region;
        }
      }

      function describeFailure(outcome: ApiOutcome<unknown>): string {
        switch (outcome.kind) {
          case "forbidden":
            return "You do not have permission to view Insights for this organization.";
          case "not-found":
            return "The requested resource could not be found.";
          case "disconnected":
            return "Could not reach the platform API.";
          case "unauthenticated":
            return "Your session has expired. Sign in again.";
          case "not-configured":
            return "This deployment is not configured.";
          case "error":
            return outcome.message;
          case "ok":
            return "";
        }
      }

      function goToLogin(): void {
        const next = encodeURIComponent(window.location.pathname);
        window.location.assign(`/login?next=${next}`);
      }

      function wireSignOut(): void {
        document
          .getElementById("sign-out-button")
          ?.addEventListener("click", async () => {
            await signOut();
            goToLogin();
          });
      }

      function badge(status: string, label = status): HTMLSpanElement {
        const el = document.createElement("span");
        el.className = `status status--${status}`;
        const dot = document.createElement("span");
        dot.setAttribute("aria-hidden", "true");
        dot.className = "status__dot";
        el.append(dot, document.createTextNode(label));
        return el;
      }

      function errorAlert(message: string): HTMLDivElement {
        const alert = document.createElement("div");
        alert.className = "alert alert--error";
        const text = document.createElement("p");
        text.textContent = message;
        alert.append(text);
        return alert;
      }

      async function renderReadiness(): Promise<void> {
        const panel = document.getElementById("readiness-panel")!;
        panel.replaceChildren();
        const outcome = await fetchProductReadiness(organizationId, "insights");
        if (outcome.kind !== "ok") {
          panel.append(errorAlert(describeFailure(outcome)));
          return;
        }
        const state = outcome.data.readiness_state;
        const label = state === "not_entitled" ? "setup" : state;
        panel.append(badge(label));
        for (const finding of outcome.data.blocking_requirements) {
          const reason = document.createElement("p");
          reason.textContent = finding.remediation;
          panel.append(reason);
        }
        if (
          outcome.data.blocking_requirements.length === 0 &&
          state === "ready"
        ) {
          const ready = document.createElement("p");
          ready.textContent = "Insights is ready to use.";
          panel.append(ready);
        }
      }

      async function renderActivity(): Promise<void> {
        const panel = document.getElementById("activity-panel")!;
        panel.replaceChildren();
        const outcome = await fetchInsightsSummary(organizationId);
        if (outcome.kind !== "ok") {
          panel.append(errorAlert(describeFailure(outcome)));
          return;
        }
        const s = outcome.data;
        const total = (counts: Record<string, number>): number =>
          Object.values(counts).reduce((sum, value) => sum + value, 0);
        const groups: {
          label: string;
          items: { name: string; value: number }[];
        }[] = [
          {
            label: "Workflow runs",
            items: Object.entries(s.workflow_runs).map(([name, value]) => ({
              name,
              value,
            })),
          },
          {
            label: "GBP",
            items: [
              { name: "locations", value: s.gbp.locations },
              { name: "profile_snapshots", value: s.gbp.profile_snapshots },
              {
                name: "publications (total)",
                value: total(s.gbp.publications),
              },
            ],
          },
          {
            label: "Reviews",
            items: Object.entries(s.reviews).map(([name, value]) => ({
              name,
              value,
            })),
          },
          {
            label: "Content publications",
            items: Object.entries(s.content_publications).map(
              ([name, value]) => ({
                name,
                value,
              }),
            ),
          },
          {
            label: "SEO",
            items: [
              { name: "crawl_runs (total)", value: total(s.seo.crawl_runs) },
              {
                name: "opportunities (total)",
                value: total(s.seo.opportunities),
              },
            ],
          },
          {
            label: "Leads",
            items: Object.entries(s.leads).map(([name, value]) => ({
              name,
              value,
            })),
          },
        ];
        const list = document.createElement("ul");
        list.className = "product-list";
        for (const group of groups) {
          const item = document.createElement("li");
          const heading = document.createElement("h3");
          heading.textContent = group.label;
          item.append(heading);
          const detail = document.createElement("p");
          detail.textContent = group.items
            .map((entry) => `${entry.name}: ${entry.value}`)
            .join(" · ");
          item.append(detail);
          list.append(item);
        }
        panel.append(list);
      }

      async function renderSources(): Promise<void> {
        const list = document.getElementById("sources-list")!;
        list.replaceChildren();
        const results = await Promise.all(
          SOURCE_PRODUCTS.map((source) =>
            fetchProductReadiness(organizationId, source.key),
          ),
        );
        SOURCE_PRODUCTS.forEach((source, index) => {
          const outcome = results[index];
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = PRODUCT_LABELS[source.key];
          const meta = document.createElement("p");
          const actions = document.createElement("div");

          if (outcome.kind !== "ok") {
            meta.textContent = describeFailure(outcome);
            actions.append(badge("missing", "unavailable"));
          } else {
            const state = outcome.data.readiness_state;
            const label = state === "not_entitled" ? "setup" : state;
            const blocking = outcome.data.blocking_requirements[0];
            meta.textContent =
              state === "ready"
                ? "Connected and ready."
                : (blocking?.remediation ?? "Setup required.");
            actions.append(badge(label));
          }

          info.append(name, meta);
          const link = document.createElement("a");
          link.href = source.href;
          link.className = "button button--secondary button--sm";
          link.textContent = `Open ${PRODUCT_LABELS[source.key]}`;
          actions.append(link);
          item.append(info, actions);
          list.append(item);
        });
      }

      /**
       * Populates the shared organization switcher in the topbar (rendered by
       * AppShell) from the caller's real memberships. Reuses the existing
       * `selectDefaultOrganization` helper for resolution — this is not a
       * second organization-selection mechanism; it wires the one already in
       * the shell that this page previously left dead and empty.
       */
      function populateSwitcher(): void {
        const select = document.getElementById(
          "organization-switcher",
        ) as HTMLSelectElement;
        select.replaceChildren();
        for (const organization of organizations) {
          const option = document.createElement("option");
          option.value = organization.organization_id;
          option.textContent = organization.organization_name;
          select.append(option);
        }
        select.hidden = organizations.length <= 1;
        select.addEventListener("change", () => {
          const chosen = organizations.find(
            (item) => item.organization_id === select.value,
          );
          if (chosen) void loadOrganization(chosen);
        });
      }

      async function loadOrganization(
        organization: MyOrganization,
      ): Promise<void> {
        organizationId = organization.organization_id;
        if (typeof window !== "undefined") {
          localStorage.setItem("selected_org_id", organizationId);
          const url = new URL(window.location.href);
          if (url.searchParams.get("org") !== organizationId) {
            url.searchParams.set("org", organizationId);
            window.history.replaceState({}, "", url.toString());
          }
        }
        document.getElementById("active-organization-name")!.textContent =
          organization.organization_name;
        (
          document.getElementById("organization-switcher") as HTMLSelectElement
        ).value = organizationId;

        await Promise.all([
          renderReadiness(),
          renderSources(),
          renderActivity(),
        ]);
      }

      async function boot(): Promise<void> {
        if (!readPublicConfig()) {
          showOnly(regions.notConfigured);
          return;
        }
        showOnly(regions.loading);

        const session = await getCurrentSession();
        if (session.status !== "signed-in") {
          goToLogin();
          return;
        }

        const principal = await fetchPrincipal();
        if (principal.kind === "unauthenticated") {
          goToLogin();
          return;
        }
        if (principal.kind !== "ok") {
          regions.error.textContent = describeFailure(principal);
          showOnly(regions.error);
          return;
        }
        document.getElementById("current-user-label")!.textContent =
          principal.data.auth_user_id;
        document.getElementById("current-user-initial")!.textContent =
          principal.data.auth_user_id.slice(0, 1).toUpperCase();
        document.getElementById("current-assurance-label")!.textContent =
          principal.data.assurance_level;
        const signOutButton = document.getElementById("sign-out-button")!;
        signOutButton.hidden = false;
        wireSignOut();

        const organizationsResult = await fetchMyOrganizations();
        if (organizationsResult.kind === "unauthenticated") {
          goToLogin();
          return;
        }
        if (organizationsResult.kind !== "ok") {
          regions.error.textContent = describeFailure(organizationsResult);
          showOnly(regions.error);
          return;
        }
        if (organizationsResult.data.length === 0) {
          showOnly(regions.empty);
          return;
        }
        organizations = organizationsResult.data;

        const organization = selectDefaultOrganization(organizations);
        if (!organization) {
          showOnly(regions.empty);
          return;
        }

        populateSwitcher();
        await loadOrganization(organization);

        showOnly(regions.content);
      }

      void boot();
    </script>
  </body>
</html>
