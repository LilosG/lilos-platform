---
import AppShell from "../components/AppShell.astro";
import EmptyState from "../lib/ui/EmptyState.astro";
import Notice from "../lib/ui/Notice.astro";
import PageHeader from "../lib/ui/PageHeader.astro";
import PageSection from "../lib/ui/PageSection.astro";
import PageShell from "../lib/ui/PageShell.astro";
import Region from "../lib/ui/Region.astro";
import Skeleton from "../lib/ui/Skeleton.astro";
import "../styles/global.css";
import "../styles/automations.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs Automations workspace" />
    <title>Automations · LILOs</title>
  </head>
  <body>
    <AppShell>
      <PageShell id="boot-not-configured">
        <EmptyState
          heading="This deployment is not configured"
          description="Connect the platform runtime configuration to enable Automations."
        />
      </PageShell>
      <PageShell id="boot-loading" hidden>
        <Skeleton lines={3} label="Loading automations" />
      </PageShell>
      <PageShell id="boot-error" hidden><Region role="alert" /></PageShell>
      <PageShell id="workspace-empty" hidden>
        <EmptyState
          heading="No organization access yet"
          description="Ask an administrator to invite your account to an organization."
        />
      </PageShell>

      <PageShell id="workspace-content" hidden>
        <PageHeader
          eyebrow="Operations"
          title="Automations"
          description="See what is running, what is queued, what runs on a schedule, and what needs attention."
        />

        <Region id="automation-action-status" live="polite" />

        <PageSection eyebrow="Health" title="Automation summary">
          <Region id="automation-metrics">
            <Skeleton lines={2} label="Loading automation health" />
          </Region>
        </PageSection>

        <Notice title="Location">
          <div class="ui-field">
            <label class="ui-field__label" for="automation-location-select"
              >Operate on</label
            >
            <select id="automation-location-select" class="ui-input">
              <option value="">Choose a location</option>
            </select>
            <p class="ui-field__description">
              Run-now actions and new schedules use this LILOs location.
            </p>
          </div>
        </Notice>

        <PageSection
          eyebrow="Agents"
          title="AI agents"
          description="Start an agent, see its current state immediately, stop an active run, and inspect details only when needed."
        >
          <Region id="agent-runtime-status">
            <Skeleton lines={2} label="Checking agent runtime" />
          </Region>
          <Region id="agent-start-actions" />
          <Region id="agent-run-history">
            <Skeleton lines={3} label="Loading agent runs" />
          </Region>
          <Region id="agent-run-detail" live="polite" />
        </PageSection>

        <PageSection
          eyebrow="Workflows"
          title="Other automations"
          description="Run or schedule recurring product workflows from the selected location."
        >
          <Region id="workflow-catalog">
            <Skeleton lines={4} label="Loading automation catalog" />
          </Region>
        </PageSection>

        <PageSection
          eyebrow="Recurring"
          title="Schedules"
          description="Pause, resume, change cadence, or cancel recurring work."
        >
          <Region id="schedule-list">
            <Skeleton lines={3} label="Loading schedules" />
          </Region>
        </PageSection>

        <PageSection eyebrow="Activity" title="Recent runs">
          <Region id="run-history">
            <Skeleton lines={4} label="Loading run history" />
          </Region>
        </PageSection>
      </PageShell>
    </AppShell>

    <script>
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        buildDataTable,
        cellMeta,
        healthSummary,
        statusBadge,
        emptyState,
        errorAlert,
        describeFailure,
        confirmInline,
      } from "../lib/ui";
      import { statusLabel, statusTone } from "../lib/status-language";
      import {
        listWorkflowTypes,
        listSchedules,
        listWorkflowRuns,
        startWorkflowRun,
        createSchedule,
        updateSchedule,
        type WorkflowTypeEntry,
        type WorkflowScheduleEntry,
        type WorkflowRunSummary,
      } from "../lib/workflows";
      import { fetchLocations, type LocationSummary } from "../lib/workspace";
      import {
        AGENT_WORKFLOWS,
        agentCapabilities,
        agentLabelForSkill,
        canControlAgent,
        decideAgentApproval,
        getAgentRun,
        listAgentRuns,
        resetAgentSession,
        startAgentRun,
        steerAgentRun,
        stopAgentRun,
        type AgentCapabilities,
        type AgentRunDetail,
        type AgentRunSummary,
      } from "../lib/agents";
      import {
        actionableWorkflowFailureCount,
        agentRunIsActive,
        presentAgentEvent,
        selectPendingAgentRun,
        scheduleRowActions,
        type PendingAgentSelection,
      } from "../lib/automation-agent-ui";

      const regions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("workspace-content")!,
      };

      const locationSelect = document.getElementById(
        "automation-location-select",
      ) as HTMLSelectElement;
      const actionStatus = document.getElementById("automation-action-status")!;

      const RUNNABLE_WORKFLOWS = new Set([
        "gbp.sync",
        "reviews.ingest",
        "gbp.generate_post",
        "agent.gbp",
        "agent.seo",
        "agent.content",
        "agent.reviews",
        "agent.insights",
      ]);
      const SCHEDULABLE_WORKFLOWS = new Set([
        "gbp.sync",
        "reviews.ingest",
        "gbp.generate_post",
        "agent.gbp",
        "agent.content",
        "agent.reviews",
        "agent.insights",
      ]);
      const DEFAULT_CRON: Record<string, string> = {
        "gbp.sync": "0 * * * *",
        "reviews.ingest": "0 * * * *",
        "gbp.generate_post": "0 16 * * 2",
        "agent.gbp": "0 16 * * 2",
        "agent.content": "0 17 * * 2",
        "agent.reviews": "0 18 * * *",
        "agent.insights": "0 15 * * 1",
      };
      const CADENCE_OPTIONS = [
        ["0 * * * *", "Hourly"],
        ["0 16 * * *", "Daily · 4 PM"],
        ["0 16 * * 2", "Weekly · Tuesday 4 PM"],
        ["0 16 1 * *", "Monthly · 1st at 4 PM"],
      ] as const;
      const RUNNING_AGENT_STATUSES = new Set([
        "running",
        "waiting_approval",
        "stopping",
      ]);
      const QUEUED_WORKFLOW_STATUSES = new Set(["queued", "retry_scheduled"]);
      const RUNNING_WORKFLOW_STATUSES = new Set([
        "running",
        "waiting",
        "waiting_approval",
        "stopping",
      ]);

      let activeOrgId = "";
      let locations: LocationSummary[] = [];
      let hermesCapabilities: AgentCapabilities | null = null;
      let selectedAgentRunId: string | null = null;
      let pendingAgentSelection: PendingAgentSelection | null = null;
      let agentHasActiveRuns = false;
      let agentRefreshInFlight = false;
      let liveRefreshInFlight = false;
      let catalogCache: WorkflowTypeEntry[] | null = null;
      let schedulesCache: WorkflowScheduleEntry[] | null = null;
      const agentSteerDrafts = new Map<string, string>();
      const requestedAgentWorkflow = new URLSearchParams(
        window.location.search,
      ).get("agent");

      function selectedLocationId(): string | undefined {
        return locationSelect.value || undefined;
      }

      function formatTime(iso: string | null): string {
        if (!iso) return "—";
        const date = new Date(iso);
        if (Number.isNaN(date.getTime())) return iso;
        return date.toLocaleString(undefined, {
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit",
        });
      }

      function elapsed(iso: string | null): string {
        if (!iso) return "";
        const timestamp = new Date(iso).getTime();
        if (!Number.isFinite(timestamp)) return "";
        const ms = Date.now() - timestamp;
        if (ms < 60_000) return "just now";
        if (ms < 3_600_000) return `${Math.round(ms / 60_000)}m ago`;
        if (ms < 86_400_000) return `${Math.round(ms / 3_600_000)}h ago`;
        return `${Math.round(ms / 86_400_000)}d ago`;
      }

      function scheduleLabel(cron: string): string {
        return (
          CADENCE_OPTIONS.find(([value]) => value === cron)?.[1] ??
          "Custom schedule"
        );
      }

      function nextExecutionISO(): string {
        return new Date(Date.now() + 60_000).toISOString();
      }

      function scheduleIsOverdue(schedule: WorkflowScheduleEntry): boolean {
        if (schedule.status !== "active" || !schedule.next_run_at) return false;
        const next = new Date(schedule.next_run_at).getTime();
        return Number.isFinite(next) && next < Date.now() - 5 * 60_000;
      }

      function setActionMessage(message: string, failure = false): void {
        actionStatus.replaceChildren();
        const node = document.createElement("div");
        node.className = failure
          ? "ui-alert ui-alert--danger"
          : "ui-alert ui-alert--success";
        node.textContent = message;
        actionStatus.append(node);
      }

      function setRowFailure(row: HTMLElement, message: string): void {
        row
          .querySelectorAll(".js-row-failure")
          .forEach((node) => node.remove());
        const node = document.createElement("p");
        node.className = "ui-alert ui-alert--danger js-row-failure";
        node.setAttribute("role", "alert");
        node.textContent = message;
        row.append(node);
      }

      function clearRowFailure(row: HTMLElement): void {
        row
          .querySelectorAll(".js-row-failure")
          .forEach((node) => node.remove());
      }

      function actionButton(
        label: string,
        handler: (button: HTMLButtonElement) => Promise<void>,
        variant: "primary" | "secondary" = "secondary",
      ): HTMLButtonElement {
        const button = document.createElement("button");
        button.type = "button";
        button.className = `ui-button ui-button--${variant} ui-button--sm`;
        button.textContent = label;
        button.addEventListener("click", () => void handler(button));
        return button;
      }

      function agentWorkflowLabel(workflowKey: string): string {
        return (
          AGENT_WORKFLOWS.find(([key]) => key === workflowKey)?.[1] ??
          workflowKey
        );
      }

      function proposalHref(reference: string): string {
        const [kind, id] = reference.split(":", 2);
        const routes: Record<string, string> = {
          "gbp-post-revision": "/gbp",
          "gbp-change-set": "/gbp",
          "seo-recommendation": "/seo",
          "content-item": "/content",
          "content-brief": "/content",
          "content-revision": "/content",
          "review-response-revision": "/reviews",
          "workflow-run": "/automations",
        };
        const route = routes[kind] ?? "/automations";
        return `${route}?reference=${encodeURIComponent(reference)}${id ? `&id=${encodeURIComponent(id)}` : ""}`;
      }

      function renderPendingAgentRun(workflowKey: string): void {
        const region = document.getElementById("agent-run-detail")!;
        const card = document.createElement("article");
        card.className = "ui-card ui-stack";
        const heading = document.createElement("h3");
        heading.textContent = `${agentWorkflowLabel(workflowKey)} · Queued`;
        const copy = document.createElement("p");
        copy.className = "agent-run__pending";
        copy.textContent =
          "Waiting for a worker to start this run. It will move to Running when execution actually begins.";
        card.append(heading, copy);
        region.replaceChildren(card);
      }

      async function startAgent(
        workflowKey: string,
        button: HTMLButtonElement,
      ): Promise<void> {
        const locationId = selectedLocationId();
        if (!locationId) {
          setActionMessage(
            "Choose a location before starting agent work.",
            true,
          );
          return;
        }
        if (!hermesCapabilities?.available) {
          setActionMessage("Agent runtime is unavailable.", true);
          return;
        }
        const requestedAtMs = Date.now();
        const originalLabel = button.textContent ?? "Run agent";
        button.disabled = true;
        button.textContent = "Starting…";
        const result = await startAgentRun(activeOrgId, workflowKey, {
          locationId,
          idempotencyKey: `operator-${workflowKey}-${requestedAtMs}`,
        });
        if (result.kind === "ok") {
          pendingAgentSelection = {
            skillKey: result.data.skill_key,
            locationId,
            requestedAtMs,
          };
          selectedAgentRunId = null;
          agentHasActiveRuns = true;
          renderPendingAgentRun(workflowKey);
          setActionMessage(`${agentWorkflowLabel(workflowKey)} queued.`);
          await refreshLiveAgentSurfaces();
        } else {
          setActionMessage(
            describeFailure(result, agentWorkflowLabel(workflowKey)),
            true,
          );
        }
        button.disabled = false;
        button.textContent = originalLabel;
      }

      function renderAgentRuntime(capabilities: AgentCapabilities): void {
        const region = document.getElementById("agent-runtime-status")!;
        region.replaceChildren();

        const alert = document.createElement("div");
        alert.className = capabilities.available
          ? "ui-alert ui-alert--success"
          : "ui-alert ui-alert--warning";
        alert.textContent = capabilities.available
          ? "Agent runtime ready"
          : `Agent runtime unavailable · ${capabilities.reason_code ?? "CAPABILITY_UNAVAILABLE"}`;
        region.append(alert);

        if (capabilities.available) {
          const diagnostics = document.createElement("details");
          diagnostics.className = "agent-run__disclosure";
          const summary = document.createElement("summary");
          summary.textContent = "Runtime diagnostics";
          const detail = document.createElement("p");
          detail.className = "ui-text-secondary";
          detail.textContent = `Hermes ${capabilities.runtime_release ?? "release unavailable"} · runtime ${capabilities.runtime_version ?? "version unavailable"} · ${capabilities.model ?? "model unavailable"} · ${capabilities.sanctioned_tools?.length ?? 0} sanctioned tools`;
          diagnostics.append(summary, detail);
          region.append(diagnostics);
        }

        const actions = document.getElementById("agent-start-actions")!;
        actions.replaceChildren();
        const wrapper = document.createElement("div");
        wrapper.className = "ui-inline";
        for (const [workflowKey, label] of AGENT_WORKFLOWS) {
          const button = actionButton(
            label,
            (node) => startAgent(workflowKey, node),
            workflowKey === requestedAgentWorkflow ? "primary" : "secondary",
          );
          button.disabled = !capabilities.available;
          wrapper.append(button);
        }
        actions.append(wrapper);
      }

      async function controlAgent(
        detail: AgentRunDetail,
        action: "stop" | "approve" | "deny" | "steer",
        text?: string,
      ): Promise<void> {
        const result =
          action === "stop"
            ? await stopAgentRun(activeOrgId, detail.id)
            : action === "steer"
              ? await steerAgentRun(activeOrgId, detail.id, text ?? "")
              : await decideAgentApproval(
                  activeOrgId,
                  detail.id,
                  action === "approve" ? "once" : "deny",
                );
        if (result.kind !== "ok") {
          setActionMessage(describeFailure(result, `Agent ${action}`), true);
        } else if (action === "steer") {
          agentSteerDrafts.delete(detail.id);
          setActionMessage("Steer instruction sent.");
        } else if (action === "stop") {
          setActionMessage("Stop requested.");
        } else if (action === "approve") {
          setActionMessage("One-time approval sent.");
        } else {
          setActionMessage("Approval request denied.");
        }
        await refreshLiveAgentSurfaces();
      }

      function renderAgentDetail(detail: AgentRunDetail): void {
        const region = document.getElementById("agent-run-detail")!;
        region.replaceChildren();

        const card = document.createElement("article");
        card.className = "ui-card ui-stack";
        const headingRow = document.createElement("div");
        headingRow.className = "agent-run__summary";
        const heading = document.createElement("h3");
        heading.textContent = agentLabelForSkill(detail.skill_key);
        headingRow.append(
          heading,
          statusBadge(statusTone(detail.status), statusLabel(detail.status)),
        );
        card.append(headingRow);

        const meta = document.createElement("p");
        meta.className = "agent-run__summary-meta";
        meta.textContent = `${formatTime(detail.started_at ?? detail.created_at)}${detail.safe_error_code ? ` · ${detail.safe_error_code}` : ""}`;
        card.append(meta);

        const controls = document.createElement("div");
        controls.className = "ui-inline";
        if (
          ["running", "waiting_approval"].includes(detail.status) &&
          canControlAgent(hermesCapabilities ?? detail.capabilities, "run_stop")
        ) {
          controls.append(
            actionButton("Stop", () => controlAgent(detail, "stop")),
          );
        }
        if (
          detail.status === "running" &&
          canControlAgent(
            hermesCapabilities ?? detail.capabilities,
            "run_steer",
          )
        ) {
          const input = document.createElement("input");
          input.className = "ui-input";
          input.placeholder = "Steer this active run";
          input.maxLength = 4000;
          input.value = agentSteerDrafts.get(detail.id) ?? "";
          input.addEventListener("input", () => {
            agentSteerDrafts.set(detail.id, input.value);
          });
          controls.append(
            input,
            actionButton("Steer", async () => {
              const value = input.value.trim();
              if (!value) {
                setActionMessage("Enter a steer instruction first.", true);
                return;
              }
              await controlAgent(detail, "steer", value);
            }),
          );
        }
        if (
          detail.current_approval &&
          canControlAgent(
            hermesCapabilities ?? detail.capabilities,
            "run_approval_response",
          )
        ) {
          controls.append(
            actionButton(
              "Approve once",
              () => controlAgent(detail, "approve"),
              "primary",
            ),
            actionButton("Deny", () => controlAgent(detail, "deny")),
          );
        }
        if (
          detail.location_id &&
          !["queued", "running", "waiting_approval", "stopping"].includes(
            detail.status,
          )
        ) {
          controls.append(
            actionButton("Reset scoped session", async () => {
              const result = await resetAgentSession(
                activeOrgId,
                detail.skill_key,
                detail.location_id!,
              );
              setActionMessage(
                result.kind === "ok"
                  ? "Scoped agent session reset."
                  : describeFailure(result, "Session reset"),
                result.kind !== "ok",
              );
            }),
          );
        }
        if (controls.childNodes.length) card.append(controls);

        if (detail.output_references.length) {
          const outputs = document.createElement("div");
          outputs.className = "ui-inline";
          for (const reference of detail.output_references) {
            const link = document.createElement("a");
            link.className = "ui-button ui-button--secondary ui-button--sm";
            link.href = proposalHref(reference);
            link.textContent = reference;
            outputs.append(link);
          }
          card.append(outputs);
        }

        if (detail.final_output?.text) {
          const resultDisclosure = document.createElement("details");
          resultDisclosure.className = "agent-run__disclosure";
          const resultSummary = document.createElement("summary");
          resultSummary.textContent = "View governed result";
          const output = document.createElement("pre");
          output.textContent = detail.final_output.text;
          resultDisclosure.append(resultSummary, output);
          card.append(resultDisclosure);
        }

        const diagnostics = document.createElement("details");
        diagnostics.className = "agent-run__disclosure";
        const diagnosticsSummary = document.createElement("summary");
        diagnosticsSummary.textContent = "Run details";
        const diagnosticsBody = document.createElement("div");
        diagnosticsBody.className = "agent-run__diagnostics";
        const identity = document.createElement("p");
        identity.textContent = `Workflow ${detail.workflow_run_id} · Hermes ${detail.hermes_run_id ?? "starting"} · session ${detail.hermes_session_id} · audit ${detail.audit_correlation_id}`;
        const telemetry = document.createElement("p");
        telemetry.textContent = `Location ${detail.location_id ?? "organization-wide"} · ${detail.provider}/${detail.model ?? "model unavailable"} · ${detail.usage.input_tokens ?? "—"} input / ${detail.usage.output_tokens ?? "—"} output tokens · ${detail.usage.latency_ms ?? "—"} ms`;
        diagnosticsBody.append(identity, telemetry);
        if (detail.source_references.length) {
          const evidence = document.createElement("p");
          evidence.textContent = `Observed evidence · ${detail.source_references.join(" · ")}`;
          diagnosticsBody.append(evidence);
        }
        diagnostics.append(diagnosticsSummary, diagnosticsBody);
        card.append(diagnostics);

        const logsDisclosure = document.createElement("details");
        logsDisclosure.className = "agent-run__disclosure";
        const logsSummary = document.createElement("summary");
        logsSummary.textContent = `View logs (${detail.events.length})`;
        logsDisclosure.append(logsSummary);
        if (!detail.events.length) {
          const empty = document.createElement("p");
          empty.className = "ui-muted";
          empty.textContent = "No structured activity has arrived yet.";
          logsDisclosure.append(empty);
        } else {
          const events = document.createElement("ol");
          events.className = "agent-run__logs";
          for (const event of detail.events) {
            const item = document.createElement("li");
            const presentation = presentAgentEvent(event);
            const label = document.createElement("span");
            label.className = `agent-run__event-label agent-run__event-label--${presentation.outcome}`;
            label.textContent = `${event.sequence}. ${presentation.label}`;
            const raw = document.createElement("code");
            raw.className = "agent-run__event-raw";
            raw.textContent = JSON.stringify(event.event_document);
            item.append(label, raw);
            events.append(item);
          }
          logsDisclosure.append(events);
        }
        card.append(logsDisclosure);
        region.append(card);
      }

      async function openAgentRun(run: AgentRunSummary): Promise<void> {
        pendingAgentSelection = null;
        selectedAgentRunId = run.id;
        const result = await getAgentRun(activeOrgId, run.id);
        if (result.kind === "ok") renderAgentDetail(result.data);
        else setActionMessage(describeFailure(result, "Agent run"), true);
      }

      async function stopAgentSummary(
        run: AgentRunSummary,
        button: HTMLButtonElement,
      ): Promise<void> {
        button.disabled = true;
        button.textContent = "Stopping…";
        const result = await stopAgentRun(activeOrgId, run.id);
        if (result.kind === "ok") {
          setActionMessage(
            `${agentLabelForSkill(run.skill_key)} stop requested.`,
          );
          await refreshLiveAgentSurfaces();
          return;
        }
        setActionMessage(describeFailure(result, "Stop agent"), true);
        button.disabled = false;
        button.textContent = "Stop";
      }

      function renderAgentRuns(items: AgentRunSummary[]): void {
        const region = document.getElementById("agent-run-history")!;
        region.replaceChildren();
        if (!items.length) {
          region.append(
            emptyState(
              "No agent runs",
              "Start an agent above when work is needed.",
            ),
          );
          return;
        }

        const ordered = [...items].sort((a, b) => {
          const rank = (run: AgentRunSummary): number =>
            RUNNING_AGENT_STATUSES.has(run.status)
              ? 0
              : run.status === "queued"
                ? 1
                : 2;
          const rankDelta = rank(a) - rank(b);
          if (rankDelta !== 0) return rankDelta;
          return (
            new Date(b.created_at ?? 0).getTime() -
            new Date(a.created_at ?? 0).getTime()
          );
        });

        region.append(
          buildDataTable(
            [
              {
                key: "agent",
                header: "Agent",
                render: (run: AgentRunSummary) =>
                  cellMeta(
                    agentLabelForSkill(run.skill_key),
                    run.location_id
                      ? (locations.find((item) => item.id === run.location_id)
                          ?.name ?? "Location scoped")
                      : "Organization scoped",
                  ),
              },
              {
                key: "status",
                header: "Status",
                render: (run: AgentRunSummary) =>
                  statusBadge(statusTone(run.status), statusLabel(run.status)),
              },
              {
                key: "started",
                header: "Started / queued",
                render: (run: AgentRunSummary) => {
                  const at = run.started_at ?? run.created_at;
                  const ago = elapsed(at);
                  return ago ? `${ago} · ${formatTime(at)}` : formatTime(at);
                },
              },
              {
                key: "failure",
                header: "Failure",
                render: (run: AgentRunSummary) => run.safe_error_code ?? "—",
              },
              {
                key: "actions",
                header: "Actions",
                width: "content",
                render: (run: AgentRunSummary) => {
                  const actions = document.createElement("div");
                  actions.className = "ui-inline ui-inline--tight";
                  if (
                    ["running", "waiting_approval"].includes(run.status) &&
                    hermesCapabilities &&
                    canControlAgent(hermesCapabilities, "run_stop")
                  ) {
                    actions.append(
                      actionButton("Stop", (button) =>
                        stopAgentSummary(run, button),
                      ),
                    );
                  }
                  actions.append(
                    actionButton("Open run", async () => openAgentRun(run)),
                  );
                  return actions;
                },
              },
            ],
            ordered,
            { disclosure: { initialRows: 12, noun: "runs" } },
          ),
        );
      }

      async function loadAgentData(): Promise<void> {
        if (!activeOrgId || agentRefreshInFlight) return;
        agentRefreshInFlight = true;
        try {
          const [capabilities, runs] = await Promise.all([
            agentCapabilities(activeOrgId),
            listAgentRuns(activeOrgId, selectedLocationId()),
          ]);
          if (capabilities.kind === "ok") {
            hermesCapabilities = capabilities.data;
            renderAgentRuntime(capabilities.data);
          } else {
            hermesCapabilities = null;
            renderAgentRuntime({
              available: false,
              reason_code: "CAPABILITY_PROBE_FAILED",
              features: {},
            });
          }
          if (runs.kind === "ok") {
            if (pendingAgentSelection) {
              if (Date.now() - pendingAgentSelection.requestedAtMs > 60_000) {
                pendingAgentSelection = null;
                setActionMessage(
                  "The queued agent did not expose a run identity within 60 seconds. Check Recent runs before retrying.",
                  true,
                );
              } else {
                const candidate = selectPendingAgentRun(
                  runs.data,
                  pendingAgentSelection,
                );
                if (candidate) {
                  selectedAgentRunId = candidate.id;
                  pendingAgentSelection = null;
                }
              }
            }
            agentHasActiveRuns =
              Boolean(pendingAgentSelection) ||
              runs.data.some(agentRunIsActive);
            renderAgentRuns(runs.data);
          } else {
            agentHasActiveRuns = Boolean(pendingAgentSelection);
            document
              .getElementById("agent-run-history")!
              .replaceChildren(errorAlert(describeFailure(runs, "Agent runs")));
          }
          if (selectedAgentRunId) {
            const detail = await getAgentRun(activeOrgId, selectedAgentRunId);
            if (detail.kind === "ok") renderAgentDetail(detail.data);
          }
        } finally {
          agentRefreshInFlight = false;
        }
      }

      async function runNow(
        workflow: WorkflowTypeEntry,
        button: HTMLButtonElement,
      ): Promise<void> {
        const locationId = selectedLocationId();
        if (!locationId) {
          setActionMessage(
            "Choose a location before running this automation.",
            true,
          );
          return;
        }
        button.disabled = true;
        button.textContent = "Starting…";
        const result = await startWorkflowRun(activeOrgId, workflow.key, {
          locationId,
          idempotencyKey: `operator-${workflow.key}-${Date.now()}`,
          execute: true,
        });
        if (result.kind === "ok") {
          setActionMessage(`${workflow.display_name} queued.`);
          await loadAutomationData();
        } else {
          setActionMessage(
            describeFailure(result, workflow.display_name),
            true,
          );
        }
        button.disabled = false;
        button.textContent = "Run now";
      }

      async function createWorkflowSchedule(
        workflow: WorkflowTypeEntry,
        button: HTMLButtonElement,
      ): Promise<void> {
        const locationId = selectedLocationId();
        if (!locationId) {
          setActionMessage(
            "Choose a location before creating a schedule.",
            true,
          );
          return;
        }
        button.disabled = true;
        button.textContent = "Scheduling…";
        const cron = DEFAULT_CRON[workflow.key] ?? "0 16 * * *";
        const result = await createSchedule(activeOrgId, {
          workflow_key: workflow.key,
          key: `${workflow.key}.${locationId}`,
          cron_expression: cron,
          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC",
          next_run_at: nextExecutionISO(),
          location_id: locationId,
        });
        if (result.kind === "ok") {
          setActionMessage(`${workflow.display_name} schedule created.`);
          await loadAutomationData();
        } else {
          setActionMessage(describeFailure(result, "Schedule"), true);
        }
        button.disabled = false;
        button.textContent = "Create schedule";
      }

      async function toggleSchedule(
        schedule: WorkflowScheduleEntry,
        button: HTMLButtonElement,
      ): Promise<void> {
        const nextStatus = schedule.status === "active" ? "paused" : "active";
        const row = button.parentElement;
        if (row) clearRowFailure(row);
        button.disabled = true;
        const result = await updateSchedule(activeOrgId, schedule.id, {
          status: nextStatus,
          next_run_at: nextStatus === "active" ? nextExecutionISO() : undefined,
        });
        if (result.kind === "ok") {
          setActionMessage(`Schedule ${nextStatus}.`);
          await loadAutomationData();
          return;
        }
        const failure = describeFailure(result, "Schedule");
        setActionMessage(failure, true);
        if (row) setRowFailure(row, failure);
        button.disabled = false;
      }

      async function cancelSchedule(
        schedule: WorkflowScheduleEntry,
        button: HTMLButtonElement,
      ): Promise<void> {
        button.disabled = true;
        const result = await updateSchedule(activeOrgId, schedule.id, {
          status: "cancelled",
        });
        if (result.kind === "ok") {
          setActionMessage("Schedule cancelled. It will not run again.");
          await loadAutomationData();
          return;
        }
        const failure = describeFailure(result, "Schedule");
        setActionMessage(failure, true);
        const row = button.parentElement;
        if (row) setRowFailure(row, failure);
        button.disabled = false;
      }

      async function changeCadence(
        schedule: WorkflowScheduleEntry,
        select: HTMLSelectElement,
      ): Promise<void> {
        select.disabled = true;
        const result = await updateSchedule(activeOrgId, schedule.id, {
          cron_expression: select.value,
          next_run_at: nextExecutionISO(),
        });
        if (result.kind === "ok") {
          setActionMessage("Schedule cadence updated.");
          await loadAutomationData();
          return;
        }
        const failure = describeFailure(result, "Schedule");
        setActionMessage(failure, true);
        const row = select.parentElement;
        if (row) setRowFailure(row, failure);
        select.disabled = false;
      }

      function workflowActions(
        workflow: WorkflowTypeEntry,
        schedules: WorkflowScheduleEntry[],
      ): HTMLElement | string {
        if (!RUNNABLE_WORKFLOWS.has(workflow.key)) return "Product-managed";
        const wrapper = document.createElement("div");
        wrapper.className = "ui-inline";
        wrapper.append(
          actionButton(
            "Run now",
            (button) => runNow(workflow, button),
            "primary",
          ),
        );
        const schedule = schedules.find(
          (item) =>
            item.workflow_key === workflow.key &&
            item.location_id === selectedLocationId() &&
            item.status !== "cancelled",
        );
        if (!schedule && SCHEDULABLE_WORKFLOWS.has(workflow.key)) {
          wrapper.append(
            actionButton("Create schedule", (button) =>
              createWorkflowSchedule(workflow, button),
            ),
          );
        }
        return wrapper;
      }

      function scheduleActions(schedule: WorkflowScheduleEntry): HTMLElement {
        const wrapper = document.createElement("div");
        wrapper.className = "ui-inline";
        const cadence = document.createElement("select");
        cadence.className = "ui-input";
        cadence.setAttribute("aria-label", "Schedule cadence");
        for (const [value, label] of CADENCE_OPTIONS) {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = label;
          option.selected = value === schedule.cron_expression;
          cadence.append(option);
        }
        if (
          !CADENCE_OPTIONS.some(([value]) => value === schedule.cron_expression)
        ) {
          const option = document.createElement("option");
          option.value = schedule.cron_expression;
          option.textContent = `Custom · ${schedule.cron_expression}`;
          option.selected = true;
          cadence.prepend(option);
        }
        cadence.addEventListener(
          "change",
          () => void changeCadence(schedule, cadence),
        );
        wrapper.append(cadence);

        const rowActions = scheduleRowActions(schedule.status);
        if (rowActions.canToggle && rowActions.toggleLabel) {
          wrapper.append(
            actionButton(rowActions.toggleLabel, (button) =>
              toggleSchedule(schedule, button),
            ),
          );
        }
        if (rowActions.canCancel) {
          const cancelBtn = actionButton("Cancel", async (button) => {
            button.disabled = true;
            wrapper.append(
              confirmInline(
                "Cancel this schedule? It will stop recurring and cannot be resumed.",
                () => void cancelSchedule(schedule, button),
                () => {
                  button.disabled = false;
                },
                "Cancel schedule",
                "Keep schedule",
              ),
            );
          });
          cancelBtn.setAttribute(
            "aria-label",
            `Cancel schedule ${schedule.key}`,
          );
          wrapper.append(cancelBtn);
        }
        return wrapper;
      }

      function renderMetrics(
        catalog: WorkflowTypeEntry[] | null,
        schedules: WorkflowScheduleEntry[] | null,
        runs: WorkflowRunSummary[] | null,
      ): void {
        const panel = document.getElementById("automation-metrics")!;
        panel.replaceChildren();
        const failed = runs ? actionableWorkflowFailureCount(runs) : undefined;
        const activeSchedules = schedules?.filter(
          (schedule) => schedule.status === "active",
        ).length;
        const overdue = schedules?.filter(scheduleIsOverdue).length;
        const running = runs?.filter((run) =>
          RUNNING_WORKFLOW_STATUSES.has(run.status),
        ).length;
        const queued = runs?.filter((run) =>
          QUEUED_WORKFLOW_STATUSES.has(run.status),
        ).length;
        panel.append(
          healthSummary([
            {
              label: "Needs attention",
              value: runs ? (failed ?? 0) : null,
              format: { unit: "count" },
              tone: failed ? "critical" : "neutral",
              meta: runs
                ? failed
                  ? "Unresolved workflow failures"
                  : "No unresolved failures"
                : "Run history unavailable",
            },
            {
              label: "Running now",
              value: runs ? (running ?? 0) : null,
              format: { unit: "count" },
              tone: running ? "attention" : "neutral",
              meta: runs ? "Execution has started" : "Run history unavailable",
            },
            {
              label: "Queued / retrying",
              value: runs ? (queued ?? 0) : null,
              format: { unit: "count" },
              tone: queued ? "attention" : "neutral",
              meta: runs ? "Waiting for execution" : "Run history unavailable",
            },
            {
              label: "Overdue schedules",
              value: schedules ? (overdue ?? 0) : null,
              format: { unit: "count" },
              tone: overdue ? "critical" : "neutral",
              meta: schedules
                ? overdue
                  ? "Scheduler attention required"
                  : "Scheduler current"
                : "Schedules unavailable",
            },
            {
              label: "Active schedules",
              value: schedules ? (activeSchedules ?? 0) : null,
              format: { unit: "count" },
              meta: schedules ? "Recurring work" : "Schedules unavailable",
            },
            {
              label: "Available automations",
              value: catalog && catalog.length > 0 ? catalog.length : null,
              format: { unit: "count" },
              meta: catalog
                ? "Governed workflow catalog"
                : "Catalog unavailable",
            },
          ]),
        );
      }

      function renderCatalog(
        items: WorkflowTypeEntry[],
        schedules: WorkflowScheduleEntry[],
        runs: WorkflowRunSummary[],
      ): void {
        const container = document.getElementById("workflow-catalog")!;
        container.replaceChildren();
        if (!items.length) {
          container.append(
            emptyState(
              "No automations available",
              "Governed automations will appear here when enabled.",
            ),
          );
          return;
        }
        container.append(
          buildDataTable(
            [
              {
                key: "workflow",
                header: "Automation",
                render: (workflow: WorkflowTypeEntry) =>
                  cellMeta(
                    workflow.display_name,
                    RUNNABLE_WORKFLOWS.has(workflow.key)
                      ? "Operator runnable"
                      : "Triggered from its product workflow",
                  ),
              },
              {
                key: "schedule",
                header: "Schedule",
                render: (workflow: WorkflowTypeEntry) => {
                  const schedule = schedules.find(
                    (item) =>
                      item.workflow_key === workflow.key &&
                      item.location_id === selectedLocationId() &&
                      item.status !== "cancelled",
                  );
                  return schedule
                    ? `${scheduleLabel(schedule.cron_expression)} · ${statusLabel(schedule.status)}`
                    : SCHEDULABLE_WORKFLOWS.has(workflow.key)
                      ? "Not scheduled"
                      : "Product-managed";
                },
              },
              {
                key: "lastRun",
                header: "Last run",
                render: (workflow: WorkflowTypeEntry) => {
                  const run = runs.find(
                    (item) =>
                      item.workflow_key === workflow.key &&
                      item.location_id === selectedLocationId(),
                  );
                  return run?.created_at
                    ? `${elapsed(run.created_at)} · ${formatTime(run.created_at)}`
                    : "Not run yet";
                },
              },
              {
                key: "result",
                header: "Status",
                render: (workflow: WorkflowTypeEntry) => {
                  const run = runs.find(
                    (item) =>
                      item.workflow_key === workflow.key &&
                      item.location_id === selectedLocationId(),
                  );
                  return run
                    ? statusBadge(
                        statusTone(run.status),
                        statusLabel(run.status),
                      )
                    : statusBadge("neutral", "No result");
                },
              },
              {
                key: "actions",
                header: "Actions",
                render: (workflow: WorkflowTypeEntry) =>
                  workflowActions(workflow, schedules),
              },
            ],
            items,
          ),
        );
      }

      function durationLabel(run: WorkflowRunSummary): string {
        if (!run.completed_at) return "—";
        const end = new Date(run.completed_at).getTime();
        const start = run.started_at
          ? new Date(run.started_at).getTime()
          : run.created_at
            ? new Date(run.created_at).getTime()
            : end;
        const seconds = Math.max(0, Math.round((end - start) / 1000));
        if (seconds < 60) return `${seconds}s`;
        if (seconds < 3600)
          return `${Math.round(seconds / 60)}m ${seconds % 60}s`;
        return `${Math.floor(seconds / 3600)}h ${Math.round((seconds % 3600) / 60)}m`;
      }

      function renderRuns(items: WorkflowRunSummary[]): void {
        const container = document.getElementById("run-history")!;
        container.replaceChildren();
        if (!items.length) {
          container.append(
            emptyState(
              "No runs recorded",
              "Automation runs will appear here with their execution state.",
            ),
          );
          return;
        }
        container.append(
          buildDataTable(
            [
              {
                key: "workflow",
                header: "Automation",
                render: (run: WorkflowRunSummary) =>
                  cellMeta(
                    run.workflow_name ?? "Automation",
                    statusLabel(run.trigger_type),
                  ),
              },
              {
                key: "status",
                header: "Status",
                render: (run: WorkflowRunSummary) =>
                  statusBadge(statusTone(run.status), statusLabel(run.status)),
              },
              {
                key: "started",
                header: "Created",
                render: (run: WorkflowRunSummary) =>
                  run.created_at
                    ? `${elapsed(run.created_at)} · ${formatTime(run.created_at)}`
                    : "Time unavailable",
              },
              {
                key: "duration",
                header: "Duration",
                render: (run: WorkflowRunSummary) => durationLabel(run),
              },
              {
                key: "recovery",
                header: "Failure / retry",
                render: (run: WorkflowRunSummary) => {
                  if (run.failure_code) {
                    const attempts = run.job_attempt_count ?? 0;
                    const maxAttempts = run.job_max_attempts ?? 0;
                    return `${run.failure_code} · attempt ${attempts}/${maxAttempts}`;
                  }
                  if (run.status === "retry_scheduled")
                    return "Retry scheduled";
                  if (run.status === "queued") return "Waiting for worker";
                  return "—";
                },
              },
            ],
            items,
            { disclosure: { initialRows: 10, noun: "runs" } },
          ),
        );
      }

      function renderSchedules(items: WorkflowScheduleEntry[]): void {
        const container = document.getElementById("schedule-list")!;
        container.replaceChildren();
        if (!items.length) {
          container.append(
            emptyState(
              "No schedules configured",
              "Use Create schedule in the automation catalog to enable recurring work.",
            ),
          );
          return;
        }
        container.append(
          buildDataTable(
            [
              {
                key: "workflow",
                header: "Automation",
                render: (schedule: WorkflowScheduleEntry) =>
                  cellMeta(
                    schedule.workflow_name ??
                      schedule.workflow_key ??
                      "Automation",
                    schedule.location_id
                      ? (locations.find(
                          (location) => location.id === schedule.location_id,
                        )?.name ?? "Location scoped")
                      : "Organization scoped",
                  ),
              },
              {
                key: "status",
                header: "Status",
                render: (schedule: WorkflowScheduleEntry) =>
                  scheduleIsOverdue(schedule)
                    ? statusBadge("warning", "Overdue")
                    : statusBadge(
                        schedule.status === "active" ? "ready" : "neutral",
                        statusLabel(schedule.status),
                      ),
              },
              {
                key: "cadence",
                header: "Cadence",
                render: (schedule: WorkflowScheduleEntry) =>
                  `${scheduleLabel(schedule.cron_expression)} · ${schedule.timezone}`,
              },
              {
                key: "lastRun",
                header: "Last run",
                render: (schedule: WorkflowScheduleEntry) =>
                  schedule.last_run_at
                    ? `${elapsed(schedule.last_run_at)} · ${formatTime(schedule.last_run_at)}`
                    : "Not run yet",
              },
              {
                key: "nextRun",
                header: "Next run",
                render: (schedule: WorkflowScheduleEntry) =>
                  schedule.next_run_at
                    ? `${formatTime(schedule.next_run_at)}${scheduleIsOverdue(schedule) ? " · overdue" : ""}`
                    : "Not scheduled",
              },
              {
                key: "actions",
                header: "Actions",
                render: (schedule: WorkflowScheduleEntry) =>
                  scheduleActions(schedule),
              },
            ],
            items,
          ),
        );
      }

      async function loadLocations(): Promise<void> {
        locationSelect.replaceChildren();
        const placeholder = document.createElement("option");
        placeholder.value = "";
        placeholder.textContent = "Choose a location";
        locationSelect.append(placeholder);
        const result = await fetchLocations(activeOrgId);
        if (result.kind !== "ok") {
          locations = [];
          setActionMessage(describeFailure(result, "Locations"), true);
          return;
        }
        locations = result.data.filter(
          (location) => location.status === "active",
        );
        for (const location of locations) {
          const option = document.createElement("option");
          option.value = location.id;
          option.textContent = location.name;
          locationSelect.append(option);
        }
        const preferred =
          locations.find((location) => location.is_primary) ??
          (locations.length === 1 ? locations[0] : undefined);
        if (preferred) locationSelect.value = preferred.id;
      }

      async function refreshWorkflowRunSurfaces(): Promise<void> {
        if (!activeOrgId) return;
        const runs = await listWorkflowRuns(activeOrgId, { limit: 40 });
        if (runs.kind !== "ok") return;
        renderRuns(runs.data);
        if (catalogCache) {
          renderCatalog(catalogCache, schedulesCache ?? [], runs.data);
        }
        renderMetrics(catalogCache, schedulesCache, runs.data);
      }

      async function refreshLiveAgentSurfaces(): Promise<void> {
        if (liveRefreshInFlight) return;
        liveRefreshInFlight = true;
        try {
          await loadAgentData();
          await refreshWorkflowRunSurfaces();
        } finally {
          liveRefreshInFlight = false;
        }
      }

      async function loadAutomationData(): Promise<void> {
        if (!activeOrgId) return;
        const [catalog, schedules, runs] = await Promise.all([
          listWorkflowTypes(activeOrgId),
          listSchedules(activeOrgId),
          listWorkflowRuns(activeOrgId, { limit: 40 }),
        ]);
        catalogCache = catalog.kind === "ok" ? catalog.data : null;
        schedulesCache = schedules.kind === "ok" ? schedules.data : null;

        if (catalog.kind === "ok") {
          renderCatalog(
            catalog.data,
            schedules.kind === "ok" ? schedules.data : [],
            runs.kind === "ok" ? runs.data : [],
          );
        } else {
          document
            .getElementById("workflow-catalog")!
            .replaceChildren(errorAlert(describeFailure(catalog, "Catalog")));
        }
        if (schedules.kind === "ok") renderSchedules(schedules.data);
        else {
          document
            .getElementById("schedule-list")!
            .replaceChildren(
              errorAlert(describeFailure(schedules, "Schedules")),
            );
        }
        if (runs.kind === "ok") renderRuns(runs.data);
        else {
          document
            .getElementById("run-history")!
            .replaceChildren(errorAlert(describeFailure(runs, "Run history")));
        }
        renderMetrics(
          catalog.kind === "ok" ? catalog.data : null,
          schedules.kind === "ok" ? schedules.data : null,
          runs.kind === "ok" ? runs.data : null,
        );
        await loadAgentData();
      }

      locationSelect.addEventListener("change", () => {
        selectedAgentRunId = null;
        pendingAgentSelection = null;
        agentSteerDrafts.clear();
        document.getElementById("agent-run-detail")!.replaceChildren();
        void loadAutomationData();
      });

      async function loadOrganization(
        organization: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(organization);
        activeOrgId = organization.organization_id;
        selectedAgentRunId = null;
        pendingAgentSelection = null;
        agentHasActiveRuns = false;
        catalogCache = null;
        schedulesCache = null;
        agentSteerDrafts.clear();
        actionStatus.replaceChildren();
        document.getElementById("agent-run-detail")!.replaceChildren();
        await loadLocations();
        await loadAutomationData();
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Automations");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, loadOrganization);
        await loadOrganization({
          organization_id: result.context.organizationId,
          organization_name: result.context.organizationName,
          organization_slug: "",
          organization_status: result.context.organizationStatus,
          membership_id: "",
          membership_status: "active",
          membership_type: result.context.membershipType,
        });
        if (requestedAgentWorkflow) {
          document
            .getElementById("agent-runtime-status")
            ?.scrollIntoView({ block: "start" });
        }
      }

      void boot();
      window.setInterval(() => {
        if (!document.hidden && agentHasActiveRuns) {
          void refreshLiveAgentSurfaces();
        }
      }, 5_000);
    </script>
  </body>
</html>
