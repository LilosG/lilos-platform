---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content="LILOs Automations workspace" /><title>
      Automations · LILOs
    </title></head
  >
  <body
    ><AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1><p>
          No Supabase or API connection is configured for this build.
        </p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p>Loading Automations…</p>
      </div>

      <div id="boot-error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <h1>No organization access yet</h1><p>
          Your account is not a member of any organization. Ask an administrator
          to invite you.
        </p>
      </div>

      <div id="workspace-content" hidden>
        <div class="page-head">
          <div class="page-head__intro">
            <p class="eyebrow">Operations</p>
            <h1>Automations</h1>
            <p>
              Scheduled workflows, background tasks, and governed automation
              runs for this organization.
            </p>
          </div>
        </div>

        <!-- Workflow catalog -->
        <section
          aria-labelledby="automations-workflows-title"
          style="margin-bottom: var(--space-8);"
        >
          <div class="section-heading">
            <div>
              <p class="eyebrow">Workflows</p>
              <h2 id="automations-workflows-title">Automation catalog</h2>
            </div>
          </div>
          <div
            id="workflow-catalog"
            class="grid grid--3col"
            style="--grid-min: 280px;"
          >
            <p class="text-sm muted">Loading catalog…</p>
          </div>
        </section>

        <!-- Schedules -->
        <section
          aria-labelledby="automations-schedules-title"
          style="margin-bottom: var(--space-8);"
        >
          <div class="section-heading">
            <div>
              <p class="eyebrow">Schedules</p>
              <h2 id="automations-schedules-title">Recurring execution</h2>
            </div>
          </div>
          <div id="schedule-list">
            <p class="text-sm muted">Loading schedules…</p>
          </div>
        </section>

        <!-- Recent runs -->
        <section aria-labelledby="automations-runs-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Activity</p>
              <h2 id="automations-runs-title">Recent runs</h2>
            </div>
          </div>
          <div id="run-history">
            <p class="text-sm muted">Loading run history…</p>
          </div>
        </section>
      </div>
    </AppShell>
    <script>
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
      } from "../lib/ui";
      import {
        listWorkflowTypes,
        listSchedules,
        listWorkflowRuns,
        type WorkflowTypeEntry,
        type WorkflowScheduleEntry,
        type WorkflowRunSummary,
      } from "../lib/workflows";

      const regions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("workspace-content")!,
      };

      let activeOrgId = "";

      // ------------------------------------------------------------------
      // Status badge helper
      // ------------------------------------------------------------------
      function statusBadge(status: string): string {
        const mapping: Record<string, string> = {
          active: '<span class="badge badge--success">Active</span>',
          paused: '<span class="badge badge--warning">Paused</span>',
          cancelled: '<span class="badge badge--muted">Cancelled</span>',
          completed: '<span class="badge badge--success">Completed</span>',
          running: '<span class="badge badge--info">Running</span>',
          queued: '<span class="badge badge--info">Queued</span>',
          failed: '<span class="badge badge--danger">Failed</span>',
          dead_lettered:
            '<span class="badge badge--danger">Dead-lettered</span>',
          retry_scheduled: '<span class="badge badge--warning">Retrying</span>',
          escalated: '<span class="badge badge--danger">Escalated</span>',
          cancelled_workflow:
            '<span class="badge badge--muted">Cancelled</span>',
          waiting_approval:
            '<span class="badge badge--warning">Awaiting Approval</span>',
          not_persisted:
            '<span class="badge badge--muted">Not activated</span>',
        };
        return (
          mapping[status] ?? `<span class="badge badge--muted">${status}</span>`
        );
      }

      function formatTime(iso: string | null): string {
        if (!iso) return "—";
        try {
          const d = new Date(iso);
          return d.toLocaleString(undefined, {
            month: "short",
            day: "numeric",
            hour: "numeric",
            minute: "2-digit",
          });
        } catch {
          return iso;
        }
      }

      function elapsed(iso: string | null): string {
        if (!iso) return "";
        try {
          const ms = Date.now() - new Date(iso).getTime();
          if (ms < 60_000) return "just now";
          if (ms < 3_600_000) return `${Math.round(ms / 60_000)}m ago`;
          if (ms < 86_400_000) return `${Math.round(ms / 3_600_000)}h ago`;
          return `${Math.round(ms / 86_400_000)}d ago`;
        } catch {
          return "";
        }
      }

      // ------------------------------------------------------------------
      // Render catalog cards
      // ------------------------------------------------------------------
      function renderCatalog(items: WorkflowTypeEntry[]): void {
        const container = document.getElementById("workflow-catalog")!;
        if (items.length === 0) {
          container.innerHTML =
            '<p class="text-sm muted">No workflow types registered.</p>';
          return;
        }
        container.innerHTML = items
          .map(
            (w) => `
            <div class="card">
              <div class="card__body">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                  <div>
                    <h3 class="card__title" style="font-size:var(--text-base);">${w.display_name}</h3>
                    <p class="text-xs muted">${w.key}</p>
                  </div>
                  ${statusBadge(w.definition_status)}
                </div>
                <div style="margin-top:var(--space-2);font-size:var(--text-xs);color:var(--color-muted);">
                  Product: ${w.product_key}
                  ${w.latest_version ? ` · v${w.latest_version}` : ""}
                </div>
              </div>
            </div>`,
          )
          .join("");
      }

      // ------------------------------------------------------------------
      // Render schedules
      // ------------------------------------------------------------------
      function renderSchedules(items: WorkflowScheduleEntry[]): void {
        const container = document.getElementById("schedule-list")!;
        if (items.length === 0) {
          container.innerHTML = `
            <div class="empty-state">
              <span class="empty-state__icon" aria-hidden="true">○</span>
              <h3>No schedules configured</h3>
              <p>Recurring workflows such as GBP sync and review ingestion are
                 configured here. Schedules are created by organization
                 administrators.</p>
            </div>`;
          return;
        }
        const rows = items
          .map(
            (s) => `
            <tr>
              <td>
                <div class="text-sm fw-medium">${s.workflow_name ?? s.workflow_key ?? s.key}</div>
                <div class="text-xs muted">${s.key}</div>
              </td>
              <td><code class="text-xs">${s.cron_expression}</code></td>
              <td>${statusBadge(s.status)}</td>
              <td>
                <div class="text-xs">${formatTime(s.last_run_at)}</div>
              </td>
              <td>
                <div class="text-xs">${formatTime(s.next_run_at)}</div>
              </td>
            </tr>`,
          )
          .join("");
        container.innerHTML = `
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Workflow</th>
                  <th>Schedule</th>
                  <th>Status</th>
                  <th>Last run</th>
                  <th>Next run</th>
                </tr>
              </thead>
              <tbody>${rows}</tbody>
            </table>
          </div>`;
      }

      // ------------------------------------------------------------------
      // Render run history
      // ------------------------------------------------------------------
      function renderRuns(items: WorkflowRunSummary[]): void {
        const container = document.getElementById("run-history")!;
        if (items.length === 0) {
          container.innerHTML = `
            <div class="empty-state">
              <span class="empty-state__icon" aria-hidden="true">○</span>
              <h3>No runs recorded</h3>
              <p>Workflow runs will appear here as automated and manual
                 executions complete.</p>
            </div>`;
          return;
        }
        const rows = items
          .map(
            (r) => `
            <tr>
              <td>
                <div class="text-sm fw-medium">${r.workflow_name ?? r.workflow_key ?? "—"}</div>
                <div class="text-xs muted">${r.trigger_type}</div>
              </td>
              <td>${statusBadge(r.status)}</td>
              <td>
                <div class="text-xs">${formatTime(r.created_at)}</div>
                <div class="text-xs muted">${elapsed(r.created_at)}</div>
              </td>
              <td class="text-xs muted">
                ${r.job_attempt_count != null ? `Attempt ${r.job_attempt_count}` : "—"}
                ${r.failure_code ? `<br/><span class="text-xs" style="color:var(--color-danger);">${r.failure_code}</span>` : ""}
              </td>
            </tr>`,
          )
          .join("");
        container.innerHTML = `
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Workflow</th>
                  <th>Status</th>
                  <th>Started</th>
                  <th>Details</th>
                </tr>
              </thead>
              <tbody>${rows}</tbody>
            </table>
          </div>`;
      }

      // ------------------------------------------------------------------
      // Load all data
      // ------------------------------------------------------------------
      async function loadAutomationData(): Promise<void> {
        if (!activeOrgId) return;

        const [cat, sched, runs] = await Promise.all([
          listWorkflowTypes(activeOrgId),
          listSchedules(activeOrgId),
          listWorkflowRuns(activeOrgId, { limit: 20 }),
        ]);

        if (cat.kind === "ok") {
          renderCatalog(cat.data);
        } else {
          document.getElementById("workflow-catalog")!.innerHTML =
            '<p class="text-sm muted">Could not load workflow catalog.</p>';
        }

        if (sched.kind === "ok") {
          renderSchedules(sched.data);
        } else {
          document.getElementById("schedule-list")!.innerHTML =
            '<p class="text-sm muted">Could not load schedules.</p>';
        }

        if (runs.kind === "ok") {
          renderRuns(runs.data);
        } else {
          document.getElementById("run-history")!.innerHTML =
            '<p class="text-sm muted">Could not load run history.</p>';
        }
      }

      // ------------------------------------------------------------------
      // Boot
      // ------------------------------------------------------------------
      async function loadOrganization(
        organization: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(organization);
        activeOrgId = organization.organization_id;
        await loadAutomationData();
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Automations");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, loadOrganization);
        await loadOrganization({
          organization_id: result.context.organizationId,
          organization_name: result.context.organizationName,
          organization_slug: "",
          organization_status: result.context.organizationStatus,
          membership_id: "",
          membership_status: "active",
          membership_type: result.context.membershipType,
        });
      }

      void boot();
    </script>
  </body>
</html>
