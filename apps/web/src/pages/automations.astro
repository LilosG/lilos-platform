---
import AppShell from "../components/AppShell.astro";
import CardGrid from "../lib/ui/CardGrid.astro";
import EmptyState from "../lib/ui/EmptyState.astro";
import Notice from "../lib/ui/Notice.astro";
import PageHeader from "../lib/ui/PageHeader.astro";
import PageSection from "../lib/ui/PageSection.astro";
import PageShell from "../lib/ui/PageShell.astro";
import Region from "../lib/ui/Region.astro";
import Skeleton from "../lib/ui/Skeleton.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content="LILOs Automations workspace" /><title>
      Automations · LILOs
    </title></head
  >
  <body
    ><AppShell>
      <PageShell id="boot-not-configured"><EmptyState heading="This deployment is not configured" description="Connect the platform runtime configuration to enable Automations." /></PageShell>
      <PageShell id="boot-loading" hidden><Skeleton lines={3} label="Loading automations" /></PageShell>
      <PageShell id="boot-error" hidden><Region role="alert" /></PageShell>
      <PageShell id="workspace-empty" hidden><EmptyState heading="No organization access yet" description="Ask an administrator to invite your account to an organization." /></PageShell>

      <PageShell id="workspace-content" hidden>
        <PageHeader eyebrow="Operations" title="Automations" description="Monitor governed workflows, recurring schedules, outcomes, retries, and upcoming execution." />
        <Notice title="Automation dependencies"><p>Provider connection health is managed centrally.</p></Notice>
        <PageSection eyebrow="Health" title="Automation summary"><CardGrid id="automation-metrics" minimum="sm" /></PageSection>
        <PageSection eyebrow="Workflows" title="Automation catalog" description="Every row combines its schedule with the latest recorded outcome and failure history.">
          <Region id="workflow-catalog"><Skeleton lines={4} label="Loading automation catalog" /></Region>
        </PageSection>
        <PageSection eyebrow="Activity" title="Recent runs">
          <Region id="run-history"><Skeleton lines={4} label="Loading run history" /></Region>
        </PageSection>
      </PageShell>
    </AppShell>
    <script>
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        buildDataTable,
        cellMeta,
        metricCard,
        statusBadge,
        emptyState,
        errorAlert,
        describeFailure,
      } from "../lib/ui";
      import { statusLabel, statusTone } from "../lib/status-language";
      import {
        listWorkflowTypes,
        listSchedules,
        listWorkflowRuns,
        type WorkflowTypeEntry,
        type WorkflowScheduleEntry,
        type WorkflowRunSummary,
      } from "../lib/workflows";

      const regions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("workspace-content")!,
      };

      let activeOrgId = "";

      function formatTime(iso: string | null): string {
        if (!iso) return "—";
        try {
          const d = new Date(iso);
          return d.toLocaleString(undefined, {
            month: "short",
            day: "numeric",
            hour: "numeric",
            minute: "2-digit",
          });
        } catch {
          return iso;
        }
      }

      function elapsed(iso: string | null): string {
        if (!iso) return "";
        try {
          const ms = Date.now() - new Date(iso).getTime();
          if (ms < 60_000) return "just now";
          if (ms < 3_600_000) return `${Math.round(ms / 60_000)}m ago`;
          if (ms < 86_400_000) return `${Math.round(ms / 3_600_000)}h ago`;
          return `${Math.round(ms / 86_400_000)}d ago`;
        } catch {
          return "";
        }
      }

      function scheduleLabel(cron: string): string {
        const labels: Record<string, string> = {
          "0 * * * *": "Every hour",
          "0 0 * * *": "Daily",
          "0 0 * * 1": "Weekly",
          "0 0 1 * *": "Monthly",
        };
        return labels[cron] ?? "Custom schedule";
      }

      function renderMetrics(
        catalog: WorkflowTypeEntry[] | null,
        schedules: WorkflowScheduleEntry[] | null,
        runs: WorkflowRunSummary[] | null,
      ): void {
        const panel = document.getElementById("automation-metrics")!;
        panel.replaceChildren();
        const failed = runs?.filter((run) =>
          ["failed", "dead_lettered", "escalated"].includes(run.status),
        ).length;
        const active = schedules?.filter(
          (schedule) => schedule.status === "active",
        ).length;
        panel.append(
          metricCard(
            "Available automations",
            catalog && catalog.length > 0 ? String(catalog.length) : "No data",
            catalog ? "Governed workflow catalog" : "Catalog unavailable",
          ),
          metricCard(
            "Active schedules",
            schedules && schedules.length > 0 ? String(active) : "No data",
            schedules ? "Recurring work" : "Schedules unavailable",
          ),
          metricCard(
            "Recent runs",
            runs && runs.length > 0 ? String(runs.length) : "No data",
            runs ? "Latest recorded activity" : "Run history unavailable",
          ),
          metricCard(
            "Needs attention",
            runs && runs.length > 0 ? String(failed) : "No data",
            runs ? "Failed or escalated runs" : "Run history unavailable",
          ),
        );
      }

      // ------------------------------------------------------------------
      // Render catalog rows with their real schedule and run context.
      // ------------------------------------------------------------------
      function renderCatalog(
        items: WorkflowTypeEntry[],
        schedules: WorkflowScheduleEntry[],
        runs: WorkflowRunSummary[],
      ): void {
        const container = document.getElementById("workflow-catalog")!;
        container.replaceChildren();
        if (items.length === 0) {
          container.append(
            emptyState(
              "No automations available",
              "Governed automations will appear here when they are enabled for this workspace.",
            ),
          );
          return;
        }
        container.append(
          buildDataTable(
            [
              {
                key: "workflow",
                header: "Automation",
                render: (workflow: WorkflowTypeEntry) =>
                  cellMeta(
                    workflow.display_name,
                    `${statusLabel(workflow.product_key)} · version ${workflow.latest_version ?? "not published"}`,
                  ),
              },
              {
                key: "schedule",
                header: "Schedule",
                render: (workflow: WorkflowTypeEntry) => {
                  const schedule = schedules.find(
                    (item) => item.workflow_key === workflow.key,
                  );
                  return schedule
                    ? `${scheduleLabel(schedule.cron_expression)} · ${schedule.timezone}`
                    : "Manual only";
                },
              },
              {
                key: "lastRun",
                header: "Last run",
                width: "content",
                render: (workflow: WorkflowTypeEntry) => {
                  const run = runs.find(
                    (item) => item.workflow_key === workflow.key,
                  );
                  return run?.created_at
                    ? `${elapsed(run.created_at)} · ${formatTime(run.created_at)}`
                    : "Not run yet";
                },
              },
              {
                key: "result",
                header: "Result",
                render: (workflow: WorkflowTypeEntry) => {
                  const run = runs.find(
                    (item) => item.workflow_key === workflow.key,
                  );
                  return run
                    ? statusBadge(statusTone(run.status), statusLabel(run.status))
                    : statusBadge("neutral", "No result");
                },
              },
              {
                key: "nextRun",
                header: "Next run",
                width: "content",
                render: (workflow: WorkflowTypeEntry) => {
                  const schedule = schedules.find(
                    (item) => item.workflow_key === workflow.key,
                  );
                  return schedule?.next_run_at
                    ? formatTime(schedule.next_run_at)
                    : "Not scheduled";
                },
              },
              {
                key: "failures",
                header: "Failures",
                format: { unit: "count" },
                render: (workflow: WorkflowTypeEntry) =>
                  runs.filter(
                    (run) =>
                      run.workflow_key === workflow.key &&
                      ["failed", "dead_lettered", "escalated"].includes(
                        run.status,
                      ),
                  ).length,
              },
            ],
            items,
          ),
        );
      }

      // ------------------------------------------------------------------
      // Render run history
      // ------------------------------------------------------------------
      function renderRuns(items: WorkflowRunSummary[]): void {
        const container = document.getElementById("run-history")!;
        container.replaceChildren();
        if (items.length === 0) {
          container.append(
            emptyState(
              "No runs recorded",
              "Completed and failed automation runs will appear here with their recovery state.",
            ),
          );
          return;
        }
        container.append(
          buildDataTable(
            [
              {
                key: "workflow",
                header: "Automation",
                render: (run: WorkflowRunSummary) =>
                  cellMeta(
                    run.workflow_name ?? "Automation",
                    statusLabel(run.trigger_type),
                  ),
              },
              {
                key: "status",
                header: "Result",
                render: (run: WorkflowRunSummary) =>
                  statusBadge(statusTone(run.status), statusLabel(run.status)),
              },
              {
                key: "started",
                header: "Started",
                render: (run: WorkflowRunSummary) =>
                  run.created_at
                    ? `${elapsed(run.created_at)} · ${formatTime(run.created_at)}`
                    : "Time unavailable",
              },
              {
                key: "recovery",
                header: "Recovery",
                render: (run: WorkflowRunSummary) =>
                  ["failed", "dead_lettered", "escalated"].includes(run.status)
                    ? run.job_attempt_count !== null &&
                      run.job_max_attempts !== null &&
                      run.job_attempt_count < run.job_max_attempts
                      ? `Retry eligible · attempt ${run.job_attempt_count} of ${run.job_max_attempts}`
                      : "Needs operator review"
                    : "No action required",
              },
            ],
            items,
          ),
        );
      }

      // ------------------------------------------------------------------
      // Load all data
      // ------------------------------------------------------------------
      async function loadAutomationData(): Promise<void> {
        if (!activeOrgId) return;

        const [cat, sched, runs] = await Promise.all([
          listWorkflowTypes(activeOrgId),
          listSchedules(activeOrgId),
          listWorkflowRuns(activeOrgId, { limit: 20 }),
        ]);

        if (cat.kind === "ok") {
          renderCatalog(
            cat.data,
            sched.kind === "ok" ? sched.data : [],
            runs.kind === "ok" ? runs.data : [],
          );
        } else {
          document
            .getElementById("workflow-catalog")!
            .replaceChildren(errorAlert(describeFailure(cat, "Catalog")));
        }

        if (runs.kind === "ok") {
          renderRuns(runs.data);
        } else {
          document
            .getElementById("run-history")!
            .replaceChildren(errorAlert(describeFailure(runs, "Run history")));
        }
        renderMetrics(
          cat.kind === "ok" ? cat.data : null,
          sched.kind === "ok" ? sched.data : null,
          runs.kind === "ok" ? runs.data : null,
        );
      }

      // ------------------------------------------------------------------
      // Boot
      // ------------------------------------------------------------------
      async function loadOrganization(
        organization: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(organization);
        activeOrgId = organization.organization_id;
        await loadAutomationData();
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Automations");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, loadOrganization);
        await loadOrganization({
          organization_id: result.context.organizationId,
          organization_name: result.context.organizationName,
          organization_slug: "",
          organization_status: result.context.organizationStatus,
          membership_id: "",
          membership_status: "active",
          membership_type: result.context.membershipType,
        });
      }

      void boot();
    </script>
  </body>
</html>
