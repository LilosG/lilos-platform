---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta
      name="description"
      content="LILOs Business Profile workspace"
    /><title>Business Profile · LILOs</title></head
  >
  <body
    ><AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1><p>
          No Supabase or API connection is configured for this build.
        </p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p>Loading Business Profile…</p>
      </div>

      <div id="boot-error" class="alert alert--error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <h1>No organization access yet</h1><p>
          Your account is not a member of any organization. Ask an administrator
          to invite you.
        </p>
      </div>

      <div id="gbp-content" hidden>
        <section id="overview" aria-labelledby="page-title">
          <p class="eyebrow">Business Profile</p><h1 id="page-title">
            Google Business Profile
          </h1>
        </section>

        <section aria-labelledby="readiness-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Product readiness</p><h2 id="readiness-title">
                Setup status
              </h2>
            </div>
          </div><div class="attention-card" id="readiness-panel">
            <p>Checking readiness…</p>
          </div>
        </section>

        <section aria-labelledby="connection-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Google connection</p><h2 id="connection-title">
                Connect Google Business Profile
              </h2>
            </div>
          </div>
          <div id="connection-callback-banner"></div>
          <div class="attention-card" id="connection-panel">
            <p>Checking connection…</p>
          </div>
        </section>

        <section aria-labelledby="accounts-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Google connection</p><h2 id="accounts-title">
                Discovered accounts
              </h2>
            </div>
          </div><ul class="product-list" id="accounts-list"></ul>
        </section>

        <section aria-labelledby="locations-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Mapping</p><h2 id="locations-title">
                Google Business locations
              </h2>
            </div>
          </div><ul class="product-list" id="locations-list"></ul>
        </section>

        <section
          id="operations-section"
          aria-labelledby="operations-title"
          hidden
        >
          <div class="section-heading">
            <div>
              <p class="eyebrow">Operations</p><h2 id="operations-title">
                Categories, hours, media, posts, and suspension
              </h2>
            </div>
          </div><div class="split">
            <article>
              <p class="eyebrow">Completeness</p><div id="completeness-body">
              </div><h3>Propose a change</h3><label
                class="sr-only"
                for="change-capability-key">Capability key</label
              ><input
                id="change-capability-key"
                type="text"
                placeholder="capability key (e.g. categories)"
              /><label class="sr-only" for="change-field">Field</label><input
                id="change-field"
                type="text"
                placeholder="field name"
              /><label class="sr-only" for="change-value">Value</label><input
                id="change-value"
                type="text"
                placeholder="new value"
              /><button type="button" class="button" id="propose-change-button"
                >Propose change</button
              ><h3>Propose special hours</h3><label
                class="sr-only"
                for="special-hours-date">Service date</label
              ><input id="special-hours-date" type="date" /><label
                class="sr-only"
                for="special-hours-opens">Opens</label
              ><input
                id="special-hours-opens"
                type="time"
                value="09:00"
              /><label class="sr-only" for="special-hours-closes">Closes</label
              ><input
                id="special-hours-closes"
                type="time"
                value="17:00"
              /><button type="button" class="button" id="propose-hours-button"
                >Propose special hours</button
              ><h3>Propose media</h3><label
                class="sr-only"
                for="media-reference">Media URL</label
              ><input
                id="media-reference"
                type="text"
                placeholder="https://example.com/photo.jpg"
              /><button type="button" class="button" id="propose-media-button"
                >Propose media</button
              ><h3>Draft a post</h3><label class="sr-only" for="post-content"
                >Post content</label
              ><textarea id="post-content" rows="3"></textarea><button
                type="button"
                class="button"
                id="create-post-button">Draft post</button
              ><h3>Report suspension</h3><label
                class="sr-only"
                for="suspension-status">Provider status</label
              ><input
                id="suspension-status"
                type="text"
                placeholder="e.g. SUSPENDED"
              /><button
                type="button"
                class="button button--secondary"
                id="report-suspension-button">Report suspension case</button
              ><p id="operations-status" role="status" aria-live="polite"></p>
            </article><article id="operations-activity">
              <p class="eyebrow">Change sets</p><ol
                class="timeline"
                id="change-sets-list"
              >
              </ol><p class="eyebrow">Special hours</p><ol
                class="timeline"
                id="special-hours-list"
              >
              </ol><p class="eyebrow">Media</p><ol
                class="timeline"
                id="media-list"
              >
              </ol><p class="eyebrow">Posts</p><ol
                class="timeline"
                id="posts-list"
              >
              </ol><p class="eyebrow">Suspension cases</p><ol
                class="timeline"
                id="suspension-cases-list"
              >
              </ol><p class="eyebrow">Audit history</p><ol
                class="timeline"
                id="operations-audit-list"
              >
              </ol>
            </article>
          </div>
        </section>
      </div>
    </AppShell>
    <script>
      import {
        fetchGBPAccounts,
        fetchGBPLocations,
        fetchPlatformLocations,
        confirmLocationMapping,
        type GBPAccountSummary,
        type GBPLocationSummary,
        type PlatformLocation,
      } from "../lib/gbp";
      import {
        beginConnection,
        disconnectConnection,
        fetchConnectionStatus,
        discoverResources,
        type DiscoveryResult,
      } from "../lib/gbp-connection";
      import {
        createPostRevision,
        decideChangeSet,
        decidePostRevision,
        decideSpecialHours,
        fetchChangeSets,
        fetchCompleteness,
        fetchMedia,
        fetchOperationsAudit,
        fetchPostRevisions,
        fetchSpecialHours,
        fetchSuspensionCases,
        proposeChangeSet,
        proposeMedia,
        proposeSpecialHours,
        publishPost,
        reportSuspensionCase,
        type ChangeSet,
        type GBPPostRevisionItem,
        type SpecialHours,
      } from "../lib/gbp-operations";
      import {
        fetchMyOrganizations,
        fetchPrincipal,
        fetchProductReadiness,
      } from "../lib/workspace";
      import { selectDefaultOrganization } from "../lib/dashboard-logic";
      import { getCurrentSession, signOut } from "../lib/session";
      import { readPublicConfig } from "../lib/config";
      import { startWorkflowRun } from "../lib/workflows";
      import type { ApiOutcome } from "../lib/api-client";

      let organizationId = "";
      let selectedPlatformLocationId: string | null = null;
      let selectedGbpLocationId: string | null = null;
      let platformLocationsCache: PlatformLocation[] = [];

      const regions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("gbp-content")!,
      };

      function showOnly(region: HTMLElement): void {
        for (const key of Object.keys(regions) as (keyof typeof regions)[]) {
          regions[key].hidden = regions[key] !== region;
        }
      }

      function describeFailure(outcome: ApiOutcome<unknown>): string {
        switch (outcome.kind) {
          case "forbidden":
            return "You do not have permission to view Business Profile for this organization.";
          case "not-found":
            return "The requested resource could not be found.";
          case "disconnected":
            return "Could not reach the platform API.";
          case "unauthenticated":
            return "Your session has expired. Sign in again.";
          case "not-configured":
            return "This deployment is not configured.";
          case "error":
            return outcome.message;
          case "ok":
            return "";
        }
      }

      function goToLogin(): void {
        const next = encodeURIComponent(window.location.pathname);
        window.location.assign(`/login?next=${next}`);
      }

      function wireSignOut(): void {
        document
          .getElementById("sign-out-button")
          ?.addEventListener("click", async () => {
            await signOut();
            goToLogin();
          });
      }

      function errorAlert(message: string): HTMLDivElement {
        const alert = document.createElement("div");
        alert.className = "alert alert--error";
        const text = document.createElement("p");
        text.textContent = message;
        alert.append(text);
        return alert;
      }

      function emptyState(
        heading: string,
        description: string,
      ): HTMLDivElement {
        const wrap = document.createElement("div");
        wrap.className = "empty-state";
        const title = document.createElement("h3");
        title.textContent = heading;
        const body = document.createElement("p");
        body.textContent = description;
        wrap.append(title, body);
        return wrap;
      }

      function renderReadiness(
        outcome: Awaited<ReturnType<typeof fetchProductReadiness>>,
      ): void {
        const panel = document.getElementById("readiness-panel")!;
        panel.replaceChildren();
        if (outcome.kind !== "ok") {
          panel.append(errorAlert(describeFailure(outcome)));
          return;
        }
        const state = outcome.data.readiness_state;
        const label = state === "not_entitled" ? "setup" : state;
        const badge = document.createElement("span");
        badge.className = `status status--${label}`;
        const dot = document.createElement("span");
        dot.setAttribute("aria-hidden", "true");
        dot.className = "status__dot";
        badge.append(dot, document.createTextNode(label));
        panel.append(badge);
        for (const finding of outcome.data.blocking_requirements) {
          const reason = document.createElement("p");
          reason.textContent = finding.remediation;
          panel.append(reason);
        }
        if (
          outcome.data.blocking_requirements.length === 0 &&
          state === "ready"
        ) {
          const ready = document.createElement("p");
          ready.textContent = "Business Profile is ready to use.";
          panel.append(ready);
        }
      }

      function statusBadge(label: string, kind: string): HTMLSpanElement {
        const badge = document.createElement("span");
        badge.className = `status status--${kind}`;
        const dot = document.createElement("span");
        dot.setAttribute("aria-hidden", "true");
        dot.className = "status__dot";
        badge.append(dot, document.createTextNode(label));
        return badge;
      }

      function renderCallbackBanner(): void {
        const banner = document.getElementById("connection-callback-banner")!;
        banner.replaceChildren();
        const params = new URLSearchParams(window.location.search);
        const connected = params.get("connected");
        if (connected === null) return;
        if (connected === "1") {
          const success = document.createElement("div");
          success.className = "alert alert--success";
          const text = document.createElement("p");
          text.textContent = "Google Business Profile connected.";
          success.append(text);
          banner.append(success);
        } else {
          const reason = params.get("reason") ?? "error";
          banner.append(
            errorAlert(`Google Business Profile connection failed: ${reason}.`),
          );
        }
        params.delete("connected");
        params.delete("reason");
        const query = params.toString();
        window.history.replaceState(
          {},
          "",
          `${window.location.pathname}${query ? `?${query}` : ""}`,
        );
      }

      async function beginOrReconnect(): Promise<void> {
        const panel = document.getElementById("connection-panel")!;
        panel.replaceChildren(document.createTextNode("Connecting…"));
        const outcome = await beginConnection(organizationId);
        if (outcome.kind !== "ok") {
          panel.replaceChildren(errorAlert(describeFailure(outcome)));
          return;
        }
        window.location.assign(outcome.data.authorization_url);
      }

      function confirmDisconnect(
        panel: HTMLElement,
        trigger: HTMLButtonElement,
      ): void {
        trigger.hidden = true;
        const prompt = document.createElement("div");
        const message = document.createElement("p");
        message.textContent =
          "Disconnect this Google Business Profile connection?";
        const confirmButton = document.createElement("button");
        confirmButton.type = "button";
        confirmButton.className = "button button--secondary";
        confirmButton.textContent = "Confirm disconnect";
        confirmButton.addEventListener("click", () => void performDisconnect());
        const cancelButton = document.createElement("button");
        cancelButton.type = "button";
        cancelButton.className = "button";
        cancelButton.textContent = "Cancel";
        cancelButton.addEventListener("click", () => {
          prompt.remove();
          trigger.hidden = false;
        });
        prompt.append(message, confirmButton, cancelButton);
        panel.append(prompt);
      }

      async function performDisconnect(): Promise<void> {
        const outcome = await disconnectConnection(organizationId);
        if (outcome.kind !== "ok") {
          document
            .getElementById("connection-panel")!
            .append(errorAlert(describeFailure(outcome)));
          return;
        }
        renderConnection(await fetchConnectionStatus(organizationId));
      }

      async function performDiscovery(
        button: HTMLButtonElement,
      ): Promise<void> {
        button.disabled = true;
        button.textContent = "Discovering…";
        const outcome = await discoverResources(organizationId);
        if (outcome.kind !== "ok") {
          const msg =
            outcome.kind === "error" && outcome.code === "RECONNECT_REQUIRED"
              ? "Google access token expired. Reconnect your Google account."
              : describeFailure(outcome);
          document.getElementById("connection-panel")!.append(errorAlert(msg));
          button.textContent = "Discover accounts and locations";
          button.disabled = false;
          return;
        }
        const result = outcome.data;
        button.textContent = `Discovered ${result.accounts_discovered} account(s), ${result.locations_discovered} location(s)`;
        // Refresh accounts and locations
        const [accounts, locations, pLocs] = await Promise.all([
          fetchGBPAccounts(organizationId),
          fetchGBPLocations(organizationId),
          fetchPlatformLocations(organizationId),
        ]);
        if (pLocs.kind === "ok") platformLocationsCache = pLocs.data;
        renderAccounts(accounts.kind === "ok" ? accounts.data : []);
        renderLocations(locations.kind === "ok" ? locations.data : []);
      }

      function renderConnection(
        outcome: Awaited<ReturnType<typeof fetchConnectionStatus>>,
      ): void {
        const panel = document.getElementById("connection-panel")!;
        panel.replaceChildren();

        if (outcome.kind === "forbidden") {
          panel.append(
            errorAlert(
              "You do not have permission to manage the Google connection for this organization.",
            ),
          );
          return;
        }
        if (
          outcome.kind === "error" &&
          outcome.code === "INTEGRATION_NOT_CONFIGURED"
        ) {
          panel.append(
            emptyState(
              "Google connection is not configured",
              "This deployment has not been configured with Google OAuth credentials yet.",
            ),
          );
          return;
        }
        if (outcome.kind !== "ok") {
          panel.append(errorAlert(describeFailure(outcome)));
          return;
        }

        const connectionState = outcome.data;
        if (
          connectionState === null ||
          connectionState.status === "disconnected"
        ) {
          const connectButton = document.createElement("button");
          connectButton.type = "button";
          connectButton.className = "button";
          connectButton.textContent = "Connect Google";
          connectButton.addEventListener(
            "click",
            () => void beginOrReconnect(),
          );
          panel.append(connectButton);
          return;
        }

        const badgeKind =
          connectionState.status === "connected"
            ? "ready"
            : connectionState.status === "reconnect_required"
              ? "blocked"
              : "setup";
        panel.append(statusBadge(connectionState.status, badgeKind));

        if (connectionState.last_verified_at) {
          const verified = document.createElement("p");
          verified.textContent = `Last verified ${connectionState.last_verified_at}`;
          panel.append(verified);
        }

        if (connectionState.status === "reconnect_required") {
          const reconnectButton = document.createElement("button");
          reconnectButton.type = "button";
          reconnectButton.className = "button";
          reconnectButton.textContent = "Reconnect Google";
          reconnectButton.addEventListener(
            "click",
            () => void beginOrReconnect(),
          );
          panel.append(reconnectButton);
        }

        if (
          connectionState.status === "connected" ||
          connectionState.status === "degraded"
        ) {
          const discoverButton = document.createElement("button");
          discoverButton.type = "button";
          discoverButton.className = "button";
          discoverButton.textContent = "Discover accounts and locations";
          discoverButton.addEventListener(
            "click",
            () => void performDiscovery(discoverButton),
          );
          panel.append(discoverButton);

          const disconnectButton = document.createElement("button");
          disconnectButton.type = "button";
          disconnectButton.className = "button button--secondary";
          disconnectButton.textContent = "Disconnect";
          disconnectButton.addEventListener("click", () =>
            confirmDisconnect(panel, disconnectButton),
          );
          panel.append(disconnectButton);
        }
      }

      function renderAccounts(accounts: GBPAccountSummary[]): void {
        const list = document.getElementById("accounts-list")!;
        list.replaceChildren();
        if (accounts.length === 0) {
          const empty = document.createElement("li");
          empty.append(
            emptyState(
              "No Google accounts discovered",
              "Connect a Google account and click 'Discover accounts and locations' to find accessible GBP accounts.",
            ),
          );
          list.append(empty);
          return;
        }
        for (const account of accounts) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = account.display_name;
          const meta = document.createElement("p");
          meta.textContent = account.account_type ?? "Account";
          info.append(name, meta);
          const badge = document.createElement("span");
          badge.className = `status status--${account.status === "selected" ? "ready" : "setup"}`;
          const dot = document.createElement("span");
          dot.setAttribute("aria-hidden", "true");
          dot.className = "status__dot";
          badge.append(dot, document.createTextNode(account.status));
          item.append(info, badge);
          list.append(item);
        }
      }

      function renderLocations(locations: GBPLocationSummary[]): void {
        const list = document.getElementById("locations-list")!;
        list.replaceChildren();
        if (locations.length === 0) {
          const empty = document.createElement("li");
          empty.append(
            emptyState(
              "No Google Business locations discovered",
              "Click 'Discover accounts and locations' after connecting a Google account.",
            ),
          );
          list.append(empty);
          return;
        }
        for (const location of locations) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const name = document.createElement("h3");
          name.textContent = location.business_name;
          const meta = document.createElement("p");
          meta.textContent = location.last_synced_at
            ? `Last synced ${location.last_synced_at}`
            : "Not yet synced";
          info.append(name, meta);
          const badgeStatus =
            location.mapping_status === "confirmed"
              ? "ready"
              : location.mapping_status === "conflicted" ||
                  location.mapping_status === "disconnected"
                ? "blocked"
                : "setup";
          const badge = document.createElement("span");
          badge.className = `status status--${badgeStatus}`;
          const dot = document.createElement("span");
          dot.setAttribute("aria-hidden", "true");
          dot.className = "status__dot";
          badge.append(dot, document.createTextNode(location.mapping_status));
          item.append(info, badge);
          if (location.mapping_status === "confirmed" && location.location_id) {
            const openButton = document.createElement("button");
            openButton.type = "button";
            openButton.className = "button button--secondary";
            openButton.textContent = "Open operations";
            openButton.addEventListener(
              "click",
              () => void openOperations(location.location_id!, location.id),
            );
            item.append(openButton);
          } else if (
            location.mapping_status === "unmapped" &&
            platformLocationsCache.length > 0
          ) {
            const mapContainer = document.createElement("div");
            mapContainer.className = "mapping-controls";
            const select = document.createElement("select");
            select.innerHTML =
              '<option value="">Select a location…</option>' +
              platformLocationsCache
                .map((l) => `<option value="${l.id}">${l.name}</option>`)
                .join("");
            const mapButton = document.createElement("button");
            mapButton.type = "button";
            mapButton.className = "button button--secondary button--sm";
            mapButton.textContent = "Map";
            mapButton.addEventListener("click", async () => {
              const platformLocId = select.value;
              if (!platformLocId) return;
              mapButton.disabled = true;
              mapButton.textContent = "Mapping…";
              const result = await confirmLocationMapping(
                organizationId,
                platformLocId,
                location.id,
                false,
              );
              if (result.kind === "ok") {
                // Refresh
                const locs = await fetchGBPLocations(organizationId);
                renderLocations(locs.kind === "ok" ? locs.data : []);
              } else {
                mapButton.textContent = "Map";
                mapButton.disabled = false;
                item.append(errorAlert(describeFailure(result)));
              }
            });
            mapContainer.append(select, mapButton);
            item.append(mapContainer);
          }
          list.append(item);
        }
      }

      function setOperationsStatus(message: string): void {
        document.getElementById("operations-status")!.textContent = message;
      }

      async function openOperations(
        platformLocationId: string,
        gbpLocationId: string,
      ): Promise<void> {
        selectedPlatformLocationId = platformLocationId;
        selectedGbpLocationId = gbpLocationId;
        document.getElementById("operations-section")!.hidden = false;
        await Promise.all([
          renderCompleteness(),
          renderChangeSets(),
          renderSpecialHours(),
          renderMedia(),
          renderPosts(),
          renderSuspensionCases(),
          renderOperationsAudit(),
        ]);
      }

      async function renderCompleteness(): Promise<void> {
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
        const panel = document.getElementById("completeness-body")!;
        panel.replaceChildren();
        const outcome = await fetchCompleteness(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );
        if (outcome.kind !== "ok") {
          panel.append(document.createTextNode(describeFailure(outcome)));
          return;
        }
        const summary = document.createElement("p");
        summary.textContent = outcome.data.complete
          ? "All supported fields are known."
          : `Missing: ${outcome.data.unknown.join(", ") || "none"}`;
        panel.append(summary);
      }

      async function renderChangeSets(): Promise<void> {
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
        const list = document.getElementById("change-sets-list")!;
        list.replaceChildren();
        const outcome = await fetchChangeSets(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No change sets proposed yet.";
          list.append(item);
          return;
        }
        for (const changeSet of outcome.data) {
          list.append(changeSetRow(changeSet));
        }
      }

      function changeSetRow(changeSet: ChangeSet): HTMLLIElement {
        const item = document.createElement("li");
        const strong = document.createElement("strong");
        strong.textContent = `Revision ${changeSet.revision} — ${changeSet.status}`;
        const span = document.createElement("span");
        span.textContent = JSON.stringify(changeSet.field_changes);
        item.append(strong, span);
        if (changeSet.status === "awaiting_approval") {
          const approveButton = document.createElement("button");
          approveButton.type = "button";
          approveButton.textContent = "Approve";
          approveButton.addEventListener("click", async () => {
            if (!selectedPlatformLocationId) return;
            await decideChangeSet(
              organizationId,
              selectedPlatformLocationId,
              changeSet.id,
              true,
            );
            await renderChangeSets();
          });
          item.append(approveButton);
        }
        return item;
      }

      async function renderSpecialHours(): Promise<void> {
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
        const list = document.getElementById("special-hours-list")!;
        list.replaceChildren();
        const outcome = await fetchSpecialHours(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No special hours proposed yet.";
          list.append(item);
          return;
        }
        for (const hours of outcome.data) {
          list.append(specialHoursRow(hours));
        }
      }

      function specialHoursRow(hours: SpecialHours): HTMLLIElement {
        const item = document.createElement("li");
        const strong = document.createElement("strong");
        strong.textContent = `${hours.service_date} — ${hours.status}`;
        item.append(strong);
        if (hours.status === "awaiting_approval") {
          const approveButton = document.createElement("button");
          approveButton.type = "button";
          approveButton.textContent = "Approve";
          approveButton.addEventListener("click", async () => {
            if (!selectedPlatformLocationId) return;
            await decideSpecialHours(
              organizationId,
              selectedPlatformLocationId,
              hours.id,
              true,
            );
            await renderSpecialHours();
          });
          item.append(approveButton);
        }
        return item;
      }

      async function renderMedia(): Promise<void> {
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
        const list = document.getElementById("media-list")!;
        list.replaceChildren();
        const outcome = await fetchMedia(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No media proposed yet.";
          list.append(item);
          return;
        }
        for (const media of outcome.data) {
          const item = document.createElement("li");
          const strong = document.createElement("strong");
          strong.textContent = `${media.media_type} — ${media.status}`;
          item.append(strong);
          list.append(item);
        }
      }

      async function renderPosts(): Promise<void> {
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
        const list = document.getElementById("posts-list")!;
        list.replaceChildren();
        const outcome = await fetchPostRevisions(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No posts drafted yet.";
          list.append(item);
          return;
        }
        for (const post of outcome.data) {
          list.append(postRow(post));
        }
      }

      function postRow(post: GBPPostRevisionItem): HTMLLIElement {
        const item = document.createElement("li");
        const strong = document.createElement("strong");
        strong.textContent = `${post.content} — ${post.status}`;
        item.append(strong);
        if (post.status === "awaiting_approval") {
          const approveButton = document.createElement("button");
          approveButton.type = "button";
          approveButton.textContent = "Approve";
          approveButton.addEventListener("click", async () => {
            if (!selectedPlatformLocationId) return;
            await decidePostRevision(
              organizationId,
              selectedPlatformLocationId,
              post.id,
              true,
            );
            await renderPosts();
          });
          item.append(approveButton);
        }
        if (post.status === "approved") {
          const publishButton = document.createElement("button");
          publishButton.type = "button";
          publishButton.textContent = "Reserve publication";
          publishButton.addEventListener("click", async () => {
            if (!selectedPlatformLocationId) return;
            setOperationsStatus("Starting publication workflow…");
            const workflowStart = await startWorkflowRun(
              organizationId,
              "gbp.publish_post",
              {
                locationId: selectedPlatformLocationId,
                idempotencyKey: `web-post-publish-start-${post.id}-${Date.now()}`,
              },
            );
            if (workflowStart.kind !== "ok") {
              setOperationsStatus(describeFailure(workflowStart));
              return;
            }
            const result = await publishPost(
              organizationId,
              selectedPlatformLocationId,
              post.id,
              workflowStart.data.workflow_run_id,
            );
            setOperationsStatus(
              result.kind === "ok"
                ? "Post publication reserved. Live dispatch is not yet configured."
                : describeFailure(result),
            );
            await renderPosts();
          });
          item.append(publishButton);
        }
        return item;
      }

      async function renderSuspensionCases(): Promise<void> {
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
        const list = document.getElementById("suspension-cases-list")!;
        list.replaceChildren();
        const outcome = await fetchSuspensionCases(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No suspension cases reported.";
          list.append(item);
          return;
        }
        for (const suspensionCase of outcome.data) {
          const item = document.createElement("li");
          const strong = document.createElement("strong");
          strong.textContent = `${suspensionCase.provider_status} — ${suspensionCase.status}`;
          item.append(strong);
          list.append(item);
        }
      }

      async function renderOperationsAudit(): Promise<void> {
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
        const list = document.getElementById("operations-audit-list")!;
        list.replaceChildren();
        const outcome = await fetchOperationsAudit(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No audit history yet.";
          list.append(item);
          return;
        }
        for (const event of outcome.data) {
          const item = document.createElement("li");
          const strong = document.createElement("strong");
          strong.textContent = event.summary;
          const span = document.createElement("span");
          span.textContent = `${event.event_type} · ${new Date(event.occurred_at).toLocaleString()}`;
          item.append(strong, span);
          list.append(item);
        }
      }

      function wireOperationsComposer(): void {
        document
          .getElementById("propose-change-button")
          ?.addEventListener("click", async () => {
            if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
            const capabilityKey = (
              document.getElementById(
                "change-capability-key",
              ) as HTMLInputElement
            ).value.trim();
            const field = (
              document.getElementById("change-field") as HTMLInputElement
            ).value.trim();
            const value = (
              document.getElementById("change-value") as HTMLInputElement
            ).value.trim();
            if (!capabilityKey || !field || !value) {
              setOperationsStatus(
                "Enter a capability key, field, and value first.",
              );
              return;
            }
            const result = await proposeChangeSet(
              organizationId,
              selectedPlatformLocationId,
              selectedGbpLocationId,
              {
                capabilityKey,
                field,
                value,
                idempotencyKey: `web-change-${Date.now()}`,
              },
            );
            setOperationsStatus(
              result.kind === "ok"
                ? "Change proposed."
                : describeFailure(result),
            );
            if (result.kind === "ok") await renderChangeSets();
          });

        document
          .getElementById("propose-hours-button")
          ?.addEventListener("click", async () => {
            if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
            const serviceDate = (
              document.getElementById("special-hours-date") as HTMLInputElement
            ).value;
            const opens = (
              document.getElementById("special-hours-opens") as HTMLInputElement
            ).value;
            const closes = (
              document.getElementById(
                "special-hours-closes",
              ) as HTMLInputElement
            ).value;
            if (!serviceDate) {
              setOperationsStatus("Select a service date first.");
              return;
            }
            const result = await proposeSpecialHours(
              organizationId,
              selectedPlatformLocationId,
              selectedGbpLocationId,
              { serviceDate, opens: `${opens}:00`, closes: `${closes}:00` },
            );
            setOperationsStatus(
              result.kind === "ok"
                ? "Special hours proposed."
                : describeFailure(result),
            );
            if (result.kind === "ok") await renderSpecialHours();
          });

        document
          .getElementById("propose-media-button")
          ?.addEventListener("click", async () => {
            if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
            const reference = (
              document.getElementById("media-reference") as HTMLInputElement
            ).value.trim();
            if (!reference) {
              setOperationsStatus("Enter a media URL first.");
              return;
            }
            const result = await proposeMedia(
              organizationId,
              selectedPlatformLocationId,
              selectedGbpLocationId,
              {
                mediaType: "photo",
                sourceReference: reference,
                rightsAuthority: "Business owner upload",
              },
            );
            setOperationsStatus(
              result.kind === "ok"
                ? "Media proposed."
                : describeFailure(result),
            );
            if (result.kind === "ok") await renderMedia();
          });

        document
          .getElementById("create-post-button")
          ?.addEventListener("click", async () => {
            if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
            const content = (
              document.getElementById("post-content") as HTMLTextAreaElement
            ).value;
            if (!content.trim()) {
              setOperationsStatus("Enter post content first.");
              return;
            }
            const result = await createPostRevision(
              organizationId,
              selectedPlatformLocationId,
              selectedGbpLocationId,
              { postType: "standard", content },
            );
            setOperationsStatus(
              result.kind === "ok" ? "Post drafted." : describeFailure(result),
            );
            if (result.kind === "ok") await renderPosts();
          });

        document
          .getElementById("report-suspension-button")
          ?.addEventListener("click", async () => {
            if (!selectedPlatformLocationId || !selectedGbpLocationId) return;
            const status = (
              document.getElementById("suspension-status") as HTMLInputElement
            ).value.trim();
            if (!status) {
              setOperationsStatus("Enter a provider status first.");
              return;
            }
            const result = await reportSuspensionCase(
              organizationId,
              selectedPlatformLocationId,
              selectedGbpLocationId,
              { providerStatus: status },
            );
            setOperationsStatus(
              result.kind === "ok"
                ? "Suspension case reported."
                : describeFailure(result),
            );
            if (result.kind === "ok") await renderSuspensionCases();
          });
      }

      async function boot(): Promise<void> {
        if (!readPublicConfig()) {
          showOnly(regions.notConfigured);
          return;
        }
        showOnly(regions.loading);

        const session = await getCurrentSession();
        if (session.status !== "signed-in") {
          goToLogin();
          return;
        }

        const principal = await fetchPrincipal();
        if (principal.kind === "unauthenticated") {
          goToLogin();
          return;
        }
        if (principal.kind !== "ok") {
          regions.error.textContent = describeFailure(principal);
          showOnly(regions.error);
          return;
        }
        document.getElementById("current-user-label")!.textContent =
          principal.data.auth_user_id;
        document.getElementById("current-user-initial")!.textContent =
          principal.data.auth_user_id.slice(0, 1).toUpperCase();
        document.getElementById("current-assurance-label")!.textContent =
          principal.data.assurance_level;
        const signOutButton = document.getElementById("sign-out-button")!;
        signOutButton.hidden = false;
        wireSignOut();

        const organizations = await fetchMyOrganizations();
        if (organizations.kind === "unauthenticated") {
          goToLogin();
          return;
        }
        if (organizations.kind !== "ok") {
          regions.error.textContent = describeFailure(organizations);
          showOnly(regions.error);
          return;
        }
        if (organizations.data.length === 0) {
          showOnly(regions.empty);
          return;
        }
        const organization = selectDefaultOrganization(organizations.data);
        if (!organization) {
          showOnly(regions.empty);
          return;
        }
        document.getElementById("active-organization-name")!.textContent =
          organization.organization_name;
        organizationId = organization.organization_id;
        wireOperationsComposer();
        renderCallbackBanner();

        const [readiness, connection, accounts, locations, pLocs] =
          await Promise.all([
            fetchProductReadiness(organization.organization_id, "gbp"),
            fetchConnectionStatus(organization.organization_id),
            fetchGBPAccounts(organization.organization_id),
            fetchGBPLocations(organization.organization_id),
            fetchPlatformLocations(organization.organization_id),
          ]);

        if (pLocs.kind === "ok") platformLocationsCache = pLocs.data;

        renderReadiness(readiness);
        renderConnection(connection);
        renderAccounts(accounts.kind === "ok" ? accounts.data : []);
        renderLocations(locations.kind === "ok" ? locations.data : []);
        if (accounts.kind !== "ok" && accounts.kind !== "not-found") {
          document
            .getElementById("accounts-list")!
            .before(
              errorAlert(`Accounts unavailable: ${describeFailure(accounts)}`),
            );
        }
        if (locations.kind !== "ok" && locations.kind !== "not-found") {
          document
            .getElementById("locations-list")!
            .before(
              errorAlert(
                `Locations unavailable: ${describeFailure(locations)}`,
              ),
            );
        }

        showOnly(regions.content);
      }

      void boot();
    </script>
  </body>
</html>
