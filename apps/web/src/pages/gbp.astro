---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs Business Profile workspace" />
    <title>Business Profile · LILOs</title>
  </head>
  <body>
    <AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1>
        <p>No Supabase or API connection is configured for this build.</p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p class="loading-state">Loading Business Profile…</p>
      </div>

      <div id="boot-error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <div class="empty-state">
          <span class="empty-state__icon" aria-hidden="true">○</span>
          <h3>No organization access yet</h3>
          <p>
            Your account is not a member of any organization. Ask an
            administrator to invite you.
          </p>
        </div>
      </div>

      <div id="gbp-content" hidden>
        <div class="page-head">
          <div class="page-head__intro">
            <p class="eyebrow">Operations</p>
            <h1>Business Profile</h1>
            <p>
              Manage your Google Business Profile location data, hours, posts,
              and media.
            </p>
          </div>
          <div class="page-head__meta">
            <div class="page-head__actions">
              <a
                class="button button--secondary button--sm"
                href="/integrations">Manage connection</a
              >
            </div>
          </div>
        </div>

        <div id="connection-status-panel"></div>

        <div id="location-picker-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Location</p>
              <h2>Business location</h2>
            </div>
          </div>
          <div id="location-picker-panel">
            <div class="loading-state">Loading locations…</div>
          </div>
        </div>

        <div id="gbp-workspace" hidden>
          <div class="tabs" role="tablist" id="gbp-tabs">
            <button
              class="tabs__tab"
              role="tab"
              aria-selected="true"
              data-tab="overview">Overview</button
            >
            <button
              class="tabs__tab"
              role="tab"
              aria-selected="false"
              data-tab="profile">Profile</button
            >
            <button
              class="tabs__tab"
              role="tab"
              aria-selected="false"
              data-tab="hours">Hours</button
            >
            <button
              class="tabs__tab"
              role="tab"
              aria-selected="false"
              data-tab="posts">Posts</button
            >
            <button
              class="tabs__tab"
              role="tab"
              aria-selected="false"
              data-tab="media">Media</button
            >
          </div>

          <div id="tab-overview" class="tab-panel"></div>
          <div id="tab-profile" class="tab-panel" hidden>
            <select
              id="change-task"
              class="sr-only"
              aria-label="What to edit"
              hidden
            >
              <option value="">Choose what to edit…</option>
              <option value="profile.description">Business description</option>
            </select>
          </div>
          <div id="tab-hours" class="tab-panel" hidden></div>
          <div id="tab-posts" class="tab-panel" hidden></div>
          <div id="tab-media" class="tab-panel" hidden></div>
        </div>
      </div>
    </AppShell>
    <script>
      import {
        fetchGBPLocations,
        fetchPlatformLocations,
        confirmLocationMapping,
        workspaceContextFor,
        type GBPLocationSummary,
        type PlatformLocation,
      } from "../lib/gbp";
      import { fetchConnectionStatus } from "../lib/gbp-connection";
      import {
        createPostRevision,
        decideChangeSet,
        decidePostRevision,
        decideSpecialHours,
        fetchChangeSets,
        fetchCompleteness,
        fetchMedia,
        fetchOperationsAudit,
        fetchPostRevisions,
        fetchSpecialHours,
        fetchSuspensionCases,
        proposeChangeSet,
        proposeMedia,
        proposeSpecialHours,
        publishPost,
      } from "../lib/gbp-operations";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        emptyState,
        errorAlert,
        describeFailure,
        formatTimestamp,
        type BootRegions,
      } from "../lib/ui";
      import { startWorkflowRun } from "../lib/workflows";

      let organizationId = "";
      let selectedPlatformLocationId: string | null = null;
      let selectedGbpLocationId: string | null = null;
      let platformLocationsCache: PlatformLocation[] = [];

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("gbp-content")!,
      };

      // Tab switching
      document.querySelectorAll<HTMLElement>("[data-tab]").forEach((tab) => {
        tab.addEventListener("click", () => {
          document.querySelectorAll<HTMLElement>("[data-tab]").forEach((t) => {
            t.setAttribute("aria-selected", t === tab ? "true" : "false");
          });
          document
            .querySelectorAll<HTMLElement>(".tab-panel")
            .forEach((panel) => {
              panel.hidden = !panel.id.endsWith(tab.dataset.tab!);
            });
        });
      });

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;

        const [connectionResult, locationsResult, platformLocsResult] =
          await Promise.all([
            fetchConnectionStatus(organizationId),
            fetchGBPLocations(organizationId),
            fetchPlatformLocations(organizationId),
          ]);

        if (platformLocsResult.kind === "ok")
          platformLocationsCache = platformLocsResult.data;

        renderConnectionStatus(connectionResult);
        renderLocationPicker(
          locationsResult.kind === "ok" ? locationsResult.data : [],
        );
      }

      function renderConnectionStatus(
        outcome: Awaited<ReturnType<typeof fetchConnectionStatus>>,
      ): void {
        const panel = document.getElementById("connection-status-panel")!;
        panel.replaceChildren();

        if (
          outcome.kind === "error" &&
          outcome.code === "INTEGRATION_NOT_CONFIGURED"
        ) {
          const alert = document.createElement("div");
          alert.className = "alert alert--warning";
          const text = document.createElement("p");
          text.textContent =
            "Google is not connected. Connect in Integrations to start using Business Profile.";
          alert.append(text);
          const link = document.createElement("a");
          link.className = "button button--secondary button--sm";
          link.href = "/integrations";
          link.textContent = "Go to Integrations";
          alert.append(link);
          panel.append(alert);
          return;
        }
        if (outcome.kind !== "ok") {
          panel.append(
            errorAlert(describeFailure(outcome, "Google connection")),
          );
          return;
        }

        const state = outcome.data;
        if (state === null || state.status === "disconnected") {
          const alert = document.createElement("div");
          alert.className = "alert alert--info";
          const text = document.createElement("p");
          text.textContent =
            "Google is not connected. Connect in Integrations to discover and map your Business Profile locations.";
          alert.append(text);
          const link = document.createElement("a");
          link.className = "button button--secondary button--sm";
          link.href = "/integrations";
          link.textContent = "Connect Google";
          alert.append(link);
          panel.append(alert);
          return;
        }

        if (state.status === "reconnect_required") {
          const alert = document.createElement("div");
          alert.className = "alert alert--error";
          const text = document.createElement("p");
          text.textContent =
            "Google connection needs attention. Reconnect in Integrations.";
          alert.append(text);
          const link = document.createElement("a");
          link.className = "button button--secondary button--sm";
          link.href = "/integrations";
          link.textContent = "Reconnect";
          alert.append(link);
          panel.append(alert);
          return;
        }

        const info = document.createElement("div");
        info.className = "alert alert--success";
        info.style.marginBottom = "0";
        const badge = statusBadge(
          state.status === "connected" ? "ready" : "degraded",
          state.status,
        );
        const text = document.createElement("p");
        text.className = "text-sm";
        text.textContent = state.last_verified_at
          ? `Last synced ${formatTimestamp(state.last_verified_at)}`
          : "Connected";
        info.append(badge, text);
        panel.append(info);
      }

      function renderLocationPicker(locations: GBPLocationSummary[]): void {
        const panel = document.getElementById("location-picker-panel")!;
        panel.replaceChildren();

        const confirmed = locations.filter(
          (l) => l.mapping_status === "confirmed",
        );

        if (locations.length === 0) {
          panel.append(
            emptyState(
              "No Business Profile locations discovered",
              "Connect Google in Integrations and discover your accounts and locations to get started.",
              "Go to Integrations",
              "/integrations",
            ),
          );
          return;
        }

        if (confirmed.length > 0) {
          const list = document.createElement("ul");
          list.className = "product-list";
          for (const loc of confirmed) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = loc.business_name;
            const detail = document.createElement("p");
            detail.textContent = loc.last_synced_at
              ? `Last synced ${formatTimestamp(loc.last_synced_at)}`
              : "Not yet synced";
            info.append(name, detail);
            const openBtn = document.createElement("button");
            openBtn.type = "button";
            openBtn.className = "button button--sm";
            openBtn.textContent = "Open";
            openBtn.addEventListener("click", () => void openWorkspace(loc));
            item.append(info, openBtn);
            list.append(item);
          }
          panel.append(list);
        }

        const unmapped = locations.filter(
          (l) =>
            l.mapping_status === "unmapped" &&
            platformLocationsCache.length > 0,
        );
        if (unmapped.length > 0) {
          const heading = document.createElement("p");
          heading.className = "eyebrow";
          heading.style.marginTop = "1rem";
          heading.textContent = "Unmapped locations";
          panel.append(heading);
          const list = document.createElement("ul");
          list.className = "product-list";
          for (const loc of unmapped) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = loc.business_name;
            const detail = document.createElement("p");
            detail.textContent =
              "Map to a platform location to start managing.";
            info.append(name, detail);

            const select = document.createElement("select");
            select.className = "button button--secondary button--sm";
            const placeholder = document.createElement("option");
            placeholder.value = "";
            placeholder.textContent = "Select location…";
            select.append(placeholder);
            for (const pLoc of platformLocationsCache) {
              const opt = document.createElement("option");
              opt.value = pLoc.id;
              opt.textContent = pLoc.name;
              select.append(opt);
            }
            const mapBtn = document.createElement("button");
            mapBtn.type = "button";
            mapBtn.className = "button button--secondary button--sm";
            mapBtn.textContent = "Map";
            mapBtn.addEventListener("click", async () => {
              if (!select.value) return;
              mapBtn.disabled = true;
              mapBtn.textContent = "Mapping…";
              const result = await confirmLocationMapping(
                organizationId,
                select.value,
                loc.id,
                false,
              );
              if (result.kind === "ok") {
                const locs = await fetchGBPLocations(organizationId);
                renderLocationPicker(locs.kind === "ok" ? locs.data : []);
              } else {
                mapBtn.disabled = false;
                mapBtn.textContent = "Map";
                panel.append(errorAlert(describeFailure(result, "Mapping")));
              }
            });
            item.append(info, select, mapBtn);
            list.append(item);
          }
          panel.append(list);
        }
      }

      async function openWorkspace(loc: GBPLocationSummary): Promise<void> {
        const context = workspaceContextFor(loc);
        if (!context) return;
        selectedPlatformLocationId = context.platformLocationId;
        selectedGbpLocationId = context.gbpLocationId;
        document.getElementById("gbp-workspace")!.hidden = false;
        document.getElementById("location-picker-section")!.hidden = true;

        // Update page title to show selected location
        const titleEl = document.querySelector(
          "#gbp-content .page-head__intro h1",
        );
        if (titleEl) titleEl.textContent = loc.business_name;

        await Promise.all([
          renderOverview(),
          renderProfile(),
          renderHours(),
          renderPosts(),
          renderMedia(),
        ]);
      }

      // ---- Overview tab ----
      async function renderOverview(): Promise<void> {
        const panel = document.getElementById("tab-overview")!;
        panel.replaceChildren();
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;

        const [completenessResult, auditResult, suspensionResult] =
          await Promise.all([
            fetchCompleteness(
              organizationId,
              selectedPlatformLocationId,
              selectedGbpLocationId,
            ),
            fetchOperationsAudit(
              organizationId,
              selectedPlatformLocationId,
              selectedGbpLocationId,
            ),
            fetchSuspensionCases(
              organizationId,
              selectedPlatformLocationId,
              selectedGbpLocationId,
            ),
          ]);

        // Completeness
        const compCard = document.createElement("div");
        compCard.className = "card";
        const compHeader = document.createElement("div");
        compHeader.className = "card__header";
        compHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "card__title",
            textContent: "Profile completeness",
          }),
        );
        compCard.append(compHeader);
        const compBody = document.createElement("div");
        compBody.className = "card__body";
        if (completenessResult.kind === "ok") {
          compBody.append(
            statusBadge(
              completenessResult.data.complete ? "ready" : "setup",
              completenessResult.data.complete ? "Complete" : "Incomplete",
            ),
          );
          if (!completenessResult.data.complete) {
            const missing = document.createElement("p");
            missing.className = "text-sm muted";
            missing.style.marginTop = "0.5rem";
            missing.textContent = `Missing: ${completenessResult.data.unknown.join(", ") || "none"}`;
            compBody.append(missing);
          }
        } else {
          compBody.append(
            errorAlert(describeFailure(completenessResult, "Completeness")),
          );
        }
        compCard.append(compBody);
        panel.append(compCard);

        // Items needing attention
        const attentionCard = document.createElement("div");
        attentionCard.className = "card";
        const attentionHeader = document.createElement("div");
        attentionHeader.className = "card__header";
        attentionHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "card__title",
            textContent: "Needs attention",
          }),
        );
        attentionCard.append(attentionHeader);
        const attentionBody = document.createElement("div");
        attentionBody.className = "card__body";
        const pending = [];
        if (
          suspensionResult.kind === "ok" &&
          suspensionResult.data.length > 0
        ) {
          pending.push(`${suspensionResult.data.length} suspension case(s)`);
        }
        if (pending.length === 0) {
          attentionBody.append(
            emptyState("All clear", "No items need immediate attention."),
          );
        } else {
          for (const item of pending) {
            const p = document.createElement("p");
            p.className = "text-sm";
            p.textContent = `• ${item}`;
            attentionBody.append(p);
          }
        }
        attentionCard.append(attentionBody);
        panel.append(attentionCard);

        // Recent activity
        const activityCard = document.createElement("div");
        activityCard.className = "card";
        const activityHeader = document.createElement("div");
        activityHeader.className = "card__header";
        activityHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "card__title",
            textContent: "Recent activity",
          }),
        );
        activityCard.append(activityHeader);
        const activityBody = document.createElement("div");
        activityBody.className = "card__body";
        if (auditResult.kind === "ok" && auditResult.data.length > 0) {
          const list = document.createElement("ol");
          list.className = "timeline";
          for (const event of auditResult.data.slice(0, 10)) {
            const item = document.createElement("li");
            const strong = document.createElement("strong");
            strong.textContent = event.summary;
            const span = document.createElement("span");
            span.textContent = `${event.event_type} · ${formatTimestamp(event.occurred_at)}`;
            item.append(strong, span);
            list.append(item);
          }
          activityBody.append(list);
        } else {
          activityBody.append(
            emptyState(
              "No activity yet",
              "Operations and changes will appear here.",
            ),
          );
        }
        activityCard.append(activityBody);
        panel.append(activityCard);
      }

      // ---- Profile tab ----
      async function renderProfile(): Promise<void> {
        const panel = document.getElementById("tab-profile")!;
        panel.replaceChildren();
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;

        const [changeSetsResult] = await Promise.all([
          fetchChangeSets(
            organizationId,
            selectedPlatformLocationId,
            selectedGbpLocationId,
          ),
        ]);

        // Propose change form
        const formCard = document.createElement("div");
        formCard.className = "card";
        const formHeader = document.createElement("div");
        formHeader.className = "card__header";
        formHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "card__title",
            textContent: "Propose a change",
          }),
        );
        formCard.append(formHeader);
        const formBody = document.createElement("div");
        formBody.className = "card__body";

        const grid = document.createElement("div");
        grid.className = "form-grid";
        const taskField = document.createElement("div");
        taskField.className = "field";
        const taskLabel = document.createElement("label");
        taskLabel.htmlFor = "change-task";
        taskLabel.textContent = "What to edit";
        const taskSelect = document.createElement("select");
        taskSelect.id = "change-task";
        taskSelect.className = "button button--secondary";
        const taskOptions = [
          { value: "", label: "Choose what to edit…" },
          { value: "profile.description", label: "Business description" },
          { value: "regularHours.regularHours", label: "Business hours" },
          { value: "phoneNumbers.phoneNumbers", label: "Phone number" },
          { value: "websiteUri.websiteUri", label: "Website URL" },
          { value: "categories.categories", label: "Categories" },
        ];
        for (const opt of taskOptions) {
          const o = document.createElement("option");
          o.value = opt.value;
          o.textContent = opt.label;
          taskSelect.append(o);
        }
        taskField.append(taskLabel, taskSelect);
        grid.append(taskField);

        const valueField = document.createElement("div");
        valueField.className = "field";
        const valueLabel = document.createElement("label");
        valueLabel.htmlFor = "change-value";
        valueLabel.textContent = "New value";
        const valueInput = document.createElement("input");
        valueInput.id = "change-value";
        valueInput.type = "text";
        valueInput.placeholder = "new value";
        valueField.append(valueLabel, valueInput);
        grid.append(valueField);
        formBody.append(grid);

        const proposeBtn = document.createElement("button");
        proposeBtn.type = "button";
        proposeBtn.className = "button";
        proposeBtn.textContent = "Propose change";
        const status = document.createElement("p");
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        status.className = "text-sm muted";
        proposeBtn.addEventListener("click", async () => {
          const task = taskSelect.value.trim();
          const value = valueInput.value.trim();
          if (!task || !value) {
            status.textContent = "Choose what to edit and enter a value first.";
            return;
          }
          const [capabilityKey, field] = task.split(".");
          const result = await proposeChangeSet(
            organizationId,
            selectedPlatformLocationId!,
            selectedGbpLocationId!,
            {
              capabilityKey,
              field,
              value,
              idempotencyKey: `web-change-${Date.now()}`,
            },
          );
          status.textContent =
            result.kind === "ok"
              ? "Change proposed."
              : describeFailure(result, "Propose");
          if (result.kind === "ok") await renderProfile();
        });

        const actions = document.createElement("div");
        actions.className = "form-actions";
        actions.style.borderTop = "none";
        actions.style.paddingTop = "0.5rem";
        actions.append(proposeBtn, status);
        formBody.append(actions);
        formCard.append(formBody);
        panel.append(formCard);

        // Pending changes
        if (
          changeSetsResult.kind === "ok" &&
          changeSetsResult.data.length > 0
        ) {
          const pendingCard = document.createElement("div");
          pendingCard.className = "card";
          const pendingHeader = document.createElement("div");
          pendingHeader.className = "card__header";
          pendingHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "card__title",
              textContent: "Pending changes",
            }),
          );
          pendingCard.append(pendingHeader);
          const pendingBody = document.createElement("div");
          pendingBody.className = "card__body";
          const list = document.createElement("ul");
          list.className = "product-list";
          for (const cs of changeSetsResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = `Revision ${cs.revision}`;
            const detail = document.createElement("p");
            detail.textContent = `Status: ${cs.status}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(
                cs.status === "awaiting_approval" ? "setup" : "ready",
                cs.status,
              ),
            );
            if (cs.status === "awaiting_approval") {
              const approveBtn = document.createElement("button");
              approveBtn.type = "button";
              approveBtn.className = "button button--sm";
              approveBtn.textContent = "Approve";
              approveBtn.addEventListener("click", async () => {
                await decideChangeSet(
                  organizationId,
                  selectedPlatformLocationId!,
                  cs.id,
                  true,
                );
                await renderProfile();
              });
              item.append(approveBtn);
            }
            list.append(item);
          }
          pendingBody.append(list);
          pendingCard.append(pendingBody);
          panel.append(pendingCard);
        }
      }

      // ---- Hours tab ----
      async function renderHours(): Promise<void> {
        const panel = document.getElementById("tab-hours")!;
        panel.replaceChildren();
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;

        const hoursResult = await fetchSpecialHours(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );

        // Propose special hours form
        const formCard = document.createElement("div");
        formCard.className = "card";
        const formHeader = document.createElement("div");
        formHeader.className = "card__header";
        formHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "card__title",
            textContent: "Add special hours",
          }),
        );
        formCard.append(formHeader);
        const formBody = document.createElement("div");
        formBody.className = "card__body";

        const grid = document.createElement("div");
        grid.className = "form-grid";
        const dateField = document.createElement("div");
        dateField.className = "field";
        dateField.append(
          Object.assign(document.createElement("label"), {
            htmlFor: "special-hours-date",
            textContent: "Service date",
          }),
        );
        const dateInput = document.createElement("input");
        dateInput.id = "special-hours-date";
        dateInput.type = "date";
        dateField.append(dateInput);
        grid.append(dateField);

        const opensField = document.createElement("div");
        opensField.className = "field";
        opensField.append(
          Object.assign(document.createElement("label"), {
            htmlFor: "special-hours-opens",
            textContent: "Opens",
          }),
        );
        const opensInput = document.createElement("input");
        opensInput.id = "special-hours-opens";
        opensInput.type = "time";
        opensInput.value = "09:00";
        opensField.append(opensInput);
        grid.append(opensField);

        const closesField = document.createElement("div");
        closesField.className = "field";
        closesField.append(
          Object.assign(document.createElement("label"), {
            htmlFor: "special-hours-closes",
            textContent: "Closes",
          }),
        );
        const closesInput = document.createElement("input");
        closesInput.id = "special-hours-closes";
        closesInput.type = "time";
        closesInput.value = "17:00";
        closesField.append(closesInput);
        grid.append(closesField);
        formBody.append(grid);

        const proposeBtn = document.createElement("button");
        proposeBtn.type = "button";
        proposeBtn.className = "button";
        proposeBtn.textContent = "Propose special hours";
        const status = document.createElement("p");
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        status.className = "text-sm muted";
        proposeBtn.addEventListener("click", async () => {
          const serviceDate = dateInput.value;
          if (!serviceDate) {
            status.textContent = "Select a service date first.";
            return;
          }
          const result = await proposeSpecialHours(
            organizationId,
            selectedPlatformLocationId!,
            selectedGbpLocationId!,
            {
              serviceDate,
              opens: `${opensInput.value}:00`,
              closes: `${closesInput.value}:00`,
            },
          );
          status.textContent =
            result.kind === "ok"
              ? "Special hours proposed."
              : describeFailure(result, "Propose");
          if (result.kind === "ok") await renderHours();
        });

        const actions = document.createElement("div");
        actions.className = "form-actions";
        actions.style.borderTop = "none";
        actions.style.paddingTop = "0.5rem";
        actions.append(proposeBtn, status);
        formBody.append(actions);
        formCard.append(formBody);
        panel.append(formCard);

        // Existing special hours
        if (hoursResult.kind === "ok" && hoursResult.data.length > 0) {
          const listCard = document.createElement("div");
          listCard.className = "card";
          const listHeader = document.createElement("div");
          listHeader.className = "card__header";
          listHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "card__title",
              textContent: "Special hours",
            }),
          );
          listCard.append(listHeader);
          const listBody = document.createElement("div");
          listBody.className = "card__body";
          const list = document.createElement("ul");
          list.className = "product-list";
          for (const hours of hoursResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = hours.service_date;
            const detail = document.createElement("p");
            detail.textContent = `Status: ${hours.status}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(
                hours.status === "awaiting_approval" ? "setup" : "ready",
                hours.status,
              ),
            );
            if (hours.status === "awaiting_approval") {
              const approveBtn = document.createElement("button");
              approveBtn.type = "button";
              approveBtn.className = "button button--sm";
              approveBtn.textContent = "Approve";
              approveBtn.addEventListener("click", async () => {
                await decideSpecialHours(
                  organizationId,
                  selectedPlatformLocationId!,
                  hours.id,
                  true,
                );
                await renderHours();
              });
              item.append(approveBtn);
            }
            list.append(item);
          }
          listBody.append(list);
          listCard.append(listBody);
          panel.append(listCard);
        }
      }

      // ---- Posts tab ----
      async function renderPosts(): Promise<void> {
        const panel = document.getElementById("tab-posts")!;
        panel.replaceChildren();
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;

        const postsResult = await fetchPostRevisions(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );

        // Draft post form
        const formCard = document.createElement("div");
        formCard.className = "card";
        const formHeader = document.createElement("div");
        formHeader.className = "card__header";
        formHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "card__title",
            textContent: "Draft a post",
          }),
        );
        formCard.append(formHeader);
        const formBody = document.createElement("div");
        formBody.className = "card__body";
        const contentArea = document.createElement("textarea");
        contentArea.id = "post-content";
        contentArea.rows = 3;
        contentArea.placeholder = "Write your post…";
        formBody.append(contentArea);
        const draftBtn = document.createElement("button");
        draftBtn.type = "button";
        draftBtn.className = "button";
        draftBtn.textContent = "Draft post";
        const status = document.createElement("p");
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        status.className = "text-sm muted";
        draftBtn.addEventListener("click", async () => {
          const content = contentArea.value;
          if (!content.trim()) {
            status.textContent = "Enter post content first.";
            return;
          }
          const result = await createPostRevision(
            organizationId,
            selectedPlatformLocationId!,
            selectedGbpLocationId!,
            { postType: "standard", content },
          );
          status.textContent =
            result.kind === "ok"
              ? "Post drafted."
              : describeFailure(result, "Draft");
          if (result.kind === "ok") await renderPosts();
        });
        const actions = document.createElement("div");
        actions.className = "form-actions";
        actions.style.borderTop = "none";
        actions.style.paddingTop = "0.5rem";
        actions.append(draftBtn, status);
        formBody.append(actions);
        formCard.append(formBody);
        panel.append(formCard);

        // Posts list
        if (postsResult.kind === "ok" && postsResult.data.length > 0) {
          const listCard = document.createElement("div");
          listCard.className = "card";
          const listHeader = document.createElement("div");
          listHeader.className = "card__header";
          listHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "card__title",
              textContent: "Posts",
            }),
          );
          listCard.append(listHeader);
          const listBody = document.createElement("div");
          listBody.className = "card__body";
          const list = document.createElement("ul");
          list.className = "product-list";
          for (const post of postsResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent =
              post.content.length > 80
                ? post.content.slice(0, 80) + "…"
                : post.content;
            const detail = document.createElement("p");
            detail.textContent = `Status: ${post.status}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(
                post.status === "awaiting_approval"
                  ? "setup"
                  : post.status === "approved"
                    ? "ready"
                    : "neutral",
                post.status,
              ),
            );
            if (post.status === "awaiting_approval") {
              const approveBtn = document.createElement("button");
              approveBtn.type = "button";
              approveBtn.className = "button button--sm";
              approveBtn.textContent = "Approve";
              approveBtn.addEventListener("click", async () => {
                await decidePostRevision(
                  organizationId,
                  selectedPlatformLocationId!,
                  post.id,
                  true,
                );
                await renderPosts();
              });
              item.append(approveBtn);
            }
            if (post.status === "approved") {
              const publishBtn = document.createElement("button");
              publishBtn.type = "button";
              publishBtn.className = "button button--sm";
              publishBtn.textContent = "Publish";
              publishBtn.addEventListener("click", async () => {
                status.textContent = "Starting publication…";
                const workflowStart = await startWorkflowRun(
                  organizationId,
                  "gbp.publish_post",
                  {
                    locationId: selectedPlatformLocationId!,
                    idempotencyKey: `web-post-publish-${post.id}-${Date.now()}`,
                  },
                );
                if (workflowStart.kind !== "ok") {
                  status.textContent = describeFailure(
                    workflowStart,
                    "Publish",
                  );
                  return;
                }
                const result = await publishPost(
                  organizationId,
                  selectedPlatformLocationId!,
                  post.id,
                  workflowStart.data.workflow_run_id,
                );
                status.textContent =
                  result.kind === "ok"
                    ? "Post publication reserved."
                    : describeFailure(result, "Publish");
                if (result.kind === "ok") await renderPosts();
              });
              item.append(publishBtn);
            }
            list.append(item);
          }
          listBody.append(list);
          listCard.append(listBody);
          panel.append(listCard);
        }
      }

      // ---- Media tab ----
      async function renderMedia(): Promise<void> {
        const panel = document.getElementById("tab-media")!;
        panel.replaceChildren();
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;

        const mediaResult = await fetchMedia(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );

        // Propose media form
        const formCard = document.createElement("div");
        formCard.className = "card";
        const formHeader = document.createElement("div");
        formHeader.className = "card__header";
        formHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "card__title",
            textContent: "Upload media",
          }),
        );
        formCard.append(formHeader);
        const formBody = document.createElement("div");
        formBody.className = "card__body";
        const urlField = document.createElement("div");
        urlField.className = "field";
        urlField.append(
          Object.assign(document.createElement("label"), {
            htmlFor: "media-reference",
            textContent: "Media URL",
          }),
        );
        const urlInput = document.createElement("input");
        urlInput.id = "media-reference";
        urlInput.type = "text";
        urlInput.placeholder = "https://example.com/photo.jpg";
        urlField.append(urlInput);
        formBody.append(urlField);
        const proposeBtn = document.createElement("button");
        proposeBtn.type = "button";
        proposeBtn.className = "button";
        proposeBtn.textContent = "Propose media";
        const status = document.createElement("p");
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        status.className = "text-sm muted";
        proposeBtn.addEventListener("click", async () => {
          const reference = urlInput.value.trim();
          if (!reference) {
            status.textContent = "Enter a media URL first.";
            return;
          }
          const result = await proposeMedia(
            organizationId,
            selectedPlatformLocationId!,
            selectedGbpLocationId!,
            {
              mediaType: "photo",
              sourceReference: reference,
              rightsAuthority: "Business owner upload",
            },
          );
          status.textContent =
            result.kind === "ok"
              ? "Media proposed."
              : describeFailure(result, "Propose");
          if (result.kind === "ok") await renderMedia();
        });
        const actions = document.createElement("div");
        actions.className = "form-actions";
        actions.style.borderTop = "none";
        actions.style.paddingTop = "0.5rem";
        actions.append(proposeBtn, status);
        formBody.append(actions);
        formCard.append(formBody);
        panel.append(formCard);

        // Media list
        if (mediaResult.kind === "ok" && mediaResult.data.length > 0) {
          const listCard = document.createElement("div");
          listCard.className = "card";
          const listHeader = document.createElement("div");
          listHeader.className = "card__header";
          listHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "card__title",
              textContent: "Media",
            }),
          );
          listCard.append(listHeader);
          const listBody = document.createElement("div");
          listBody.className = "card__body";
          const list = document.createElement("ul");
          list.className = "product-list";
          for (const media of mediaResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = media.media_type;
            const detail = document.createElement("p");
            detail.textContent = `Status: ${media.status}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(
                media.status === "awaiting_approval" ? "setup" : "ready",
                media.status,
              ),
            );
            list.append(item);
          }
          listBody.append(list);
          listCard.append(listBody);
          panel.append(listCard);
        }
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Business Profile");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
