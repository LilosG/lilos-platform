---
import AppShell from "../components/AppShell.astro";
import Button from "../lib/ui/Button.astro";
import EmptyState from "../lib/ui/EmptyState.astro";
import PageHeader from "../lib/ui/PageHeader.astro";
import PageSection from "../lib/ui/PageSection.astro";
import PageShell from "../lib/ui/PageShell.astro";
import Region from "../lib/ui/Region.astro";
import Skeleton from "../lib/ui/Skeleton.astro";
import Tabs from "../lib/ui/Tabs.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LILOs Business Profile workspace" />
    <title>Business Profile · LILOs</title>
  </head>
  <body>
    <AppShell>
      <PageShell id="boot-not-configured"
        ><EmptyState
          heading="This deployment is not configured"
          description="Connect the platform runtime configuration to enable Business Profile."
        /></PageShell
      >
      <PageShell id="boot-loading" hidden
        ><Skeleton lines={3} label="Loading Business Profile" /></PageShell
      >
      <PageShell id="boot-error" hidden><Region role="alert" /></PageShell>
      <PageShell id="workspace-empty" hidden
        ><EmptyState
          heading="No organization access yet"
          description="Ask an administrator to invite your account to an organization."
        /></PageShell
      >

      <PageShell id="gbp-content" hidden>
        <PageHeader
          eyebrow="Operations"
          title="Business Profile"
          titleId="gbp-page-title"
          description="Review confirmed mappings and operate the Business Profile records available to this workspace."
        >
          <Button
            slot="actions"
            href="/automations?agent=agent.gbp"
            variant="secondary"
            size="sm">Run GBP agent</Button
          >
          <Button
            slot="actions"
            id="change-gbp-location"
            variant="secondary"
            size="sm"
            hidden>Change location</Button
          >
          <Button
            slot="actions"
            href="/integrations"
            variant="secondary"
            size="sm">Manage connection</Button
          >
        </PageHeader>

        <Region id="connection-status-panel" />

        <PageSection
          id="location-picker-section"
          eyebrow="Location"
          title="Business location"
          description="Choose a confirmed provider mapping to open its available operational records."
        >
          <Region id="location-picker-panel"
            ><Skeleton lines={2} label="Loading locations" /></Region
          >
        </PageSection>

        <Region id="gbp-workspace" hidden>
          <Tabs
            id="gbp-tabs"
            label="Business Profile workspace"
            items={[
              { id: "overview", label: "Overview" },
              { id: "profile", label: "Profile changes" },
              { id: "hours", label: "Special hours" },
              { id: "posts", label: "Posts" },
              { id: "media", label: "Media records" },
            ]}
          >
            <Region id="tab-overview" tabPanel="overview" />
            <Region id="tab-profile" tabPanel="profile" hidden />
            <Region id="tab-hours" tabPanel="hours" hidden />
            <Region id="tab-posts" tabPanel="posts" hidden />
            <Region id="tab-media" tabPanel="media" hidden />
          </Tabs>
        </Region>
      </PageShell>
    </AppShell>
    <script>
      import {
        fetchGBPLocations,
        workspaceContextFor,
        type GBPLocationSummary,
      } from "../lib/gbp";
      import { fetchConnectionStatus } from "../lib/gbp-connection";
      import {
        createPostRevision,
        decideChangeSet,
        decidePostRevision,
        decideSpecialHours,
        fetchChangeSets,
        fetchCompleteness,
        fetchMedia,
        fetchOperationsAudit,
        fetchPostRevisions,
        fetchProviderPosts,
        fetchSpecialHours,
        fetchSuspensionCases,
        postPresentation,
        postPublicationIdempotencyKey,
        proposeChangeSet,
        proposeMedia,
        proposeSpecialHours,
        providerPostCounts,
        publishPost,
        reconcileProviderPosts,
        recoverPostPublication,
      } from "../lib/gbp-operations";
      import {
        bootWorkspace,
        applyBootResult,
        populateSwitcher,
        setActiveOrganization,
        statusBadge,
        emptyState,
        errorAlert,
        createSelectControl,
        buildDataTable,
        cellMeta,
        describeFailure,
        formatTimestamp,
        type BootRegions,
      } from "../lib/ui";
      import { startWorkflowRun } from "../lib/workflows";
      import { statusLabel, statusTone } from "../lib/status-language";

      let organizationId = "";
      let selectedPlatformLocationId: string | null = null;
      let selectedGbpLocationId: string | null = null;
      let googleConnectionReady = false;
      let postsStatusMessage = "";

      type LocationOperationalRow = {
        location: GBPLocationSummary;
        managedPosts: Awaited<ReturnType<typeof fetchPostRevisions>> | null;
        providerPosts: Awaited<ReturnType<typeof fetchProviderPosts>> | null;
        media: Awaited<ReturnType<typeof fetchMedia>> | null;
        specialHours: Awaited<ReturnType<typeof fetchSpecialHours>> | null;
      };

      const regions: BootRegions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        content: document.getElementById("gbp-content")!,
      };

      document
        .getElementById("change-gbp-location")!
        .addEventListener("click", showLocationPicker);

      async function loadOrganization(
        org: import("../lib/workspace").MyOrganization,
      ): Promise<void> {
        setActiveOrganization(org);
        organizationId = org.organization_id;
        selectedPlatformLocationId = null;
        selectedGbpLocationId = null;
        showLocationPicker();

        const [connectionResult, locationsResult] = await Promise.all([
          fetchConnectionStatus(organizationId),
          fetchGBPLocations(organizationId),
        ]);

        renderConnectionStatus(connectionResult);
        if (locationsResult.kind === "ok") {
          await renderLocationPicker(
            locationsResult.data,
            googleConnectionReady,
          );
        } else {
          const panel = document.getElementById("location-picker-panel")!;
          panel.replaceChildren(
            errorAlert(
              describeFailure(locationsResult, "Business Profile locations"),
            ),
          );
        }
      }

      function renderConnectionStatus(
        outcome: Awaited<ReturnType<typeof fetchConnectionStatus>>,
      ): void {
        const panel = document.getElementById("connection-status-panel")!;
        panel.replaceChildren();
        googleConnectionReady = false;

        if (
          outcome.kind === "error" &&
          outcome.code === "INTEGRATION_NOT_CONFIGURED"
        ) {
          const alert = document.createElement("div");
          alert.className = "ui-notice ui-notice--warning";
          const text = document.createElement("p");
          text.textContent =
            "Google is not connected. Connect in Integrations to start using Business Profile.";
          alert.append(text);
          const link = document.createElement("a");
          link.className = "ui-button ui-button--secondary ui-button--sm";
          link.href = "/integrations";
          link.textContent = "Go to Integrations";
          alert.append(link);
          panel.append(alert);
          return;
        }
        if (outcome.kind !== "ok") {
          panel.append(
            errorAlert(describeFailure(outcome, "Google connection")),
          );
          return;
        }

        const state = outcome.data;
        if (state === null || state.status === "disconnected") {
          const alert = document.createElement("div");
          alert.className = "ui-notice ui-notice--warning";
          const text = document.createElement("p");
          text.textContent =
            "Google is not connected. Connect in Integrations to discover and map your Business Profile locations.";
          alert.append(text);
          const link = document.createElement("a");
          link.className = "ui-button ui-button--secondary ui-button--sm";
          link.href = "/integrations";
          link.textContent = "Connect Google";
          alert.append(link);
          panel.append(alert);
          return;
        }

        if (state.status === "reconnect_required") {
          const alert = document.createElement("div");
          alert.className = "ui-notice ui-notice--warning";
          const text = document.createElement("p");
          text.textContent =
            "Google connection needs attention. Reconnect in Integrations.";
          alert.append(text);
          const link = document.createElement("a");
          link.className = "ui-button ui-button--secondary ui-button--sm";
          link.href = "/integrations";
          link.textContent = "Reconnect";
          alert.append(link);
          panel.append(alert);
          return;
        }

        googleConnectionReady = true;
        const info = document.createElement("div");
        info.className = "ui-notice ui-notice--success";
        const detail = document.createElement("div");
        const label = document.createElement("strong");
        label.textContent = "Google Business Profile";
        const text = document.createElement("p");
        text.className = "ui-card__description";
        text.textContent = state.last_verified_at
          ? `Connected · verified ${formatTimestamp(state.last_verified_at)}`
          : "Connected";
        detail.append(label, text);
        const link = document.createElement("a");
        link.href = "/integrations";
        link.textContent = "Manage integrations";
        info.append(detail, link);
        panel.append(info);
      }

      async function renderLocationPicker(
        locations: GBPLocationSummary[],
        connectionReady: boolean,
      ): Promise<void> {
        const panel = document.getElementById("location-picker-panel")!;
        panel.replaceChildren();

        if (locations.length === 0) {
          panel.append(
            emptyState(
              "No managed Business Profile locations",
              "Connect Google in Integrations and discover your accounts and locations to get started.",
              "Go to Integrations",
              "/integrations",
            ),
          );
          return;
        }

        const rows: LocationOperationalRow[] = await Promise.all(
          locations.map(async (location) => {
            const context = workspaceContextFor(location);
            if (!context) {
              return {
                location,
                managedPosts: null,
                providerPosts: null,
                media: null,
                specialHours: null,
              };
            }
            const [managedPosts, providerPosts, media, specialHours] =
              await Promise.all([
                fetchPostRevisions(
                  organizationId,
                  context.platformLocationId,
                  context.gbpLocationId,
                ),
                fetchProviderPosts(
                  organizationId,
                  context.platformLocationId,
                  context.gbpLocationId,
                ),
                fetchMedia(
                  organizationId,
                  context.platformLocationId,
                  context.gbpLocationId,
                ),
                fetchSpecialHours(
                  organizationId,
                  context.platformLocationId,
                  context.gbpLocationId,
                ),
              ]);
            return {
              location,
              managedPosts,
              providerPosts,
              media,
              specialHours,
            };
          }),
        );

        panel.append(
          buildDataTable(
            [
              {
                key: "location",
                header: "Location",
                render: ({ location }) => location.business_name,
              },
              {
                key: "mapping",
                header: "Mapping",
                render: ({ location }) =>
                  mappingFact(location, connectionReady),
              },
              {
                key: "sync",
                header: "Discovery and sync",
                render: ({ location }) =>
                  cellMeta(
                    `Discovered ${formatTimestamp(location.last_discovered_at)}`,
                    location.last_synced_at
                      ? `Last successful sync ${formatTimestamp(location.last_synced_at)}`
                      : "First sync pending",
                  ),
              },
              {
                key: "records",
                header: "Operational records",
                render: (row) => operationalRecordFact(row),
              },
              {
                key: "actions",
                header: "Actions",
                width: "content",
                render: ({ location }) =>
                  locationOpenButton(location, connectionReady),
              },
            ],
            rows,
          ),
        );
      }

      function mappingFact(
        location: GBPLocationSummary,
        connectionReady: boolean,
      ): HTMLDivElement {
        const fact = document.createElement("div");
        fact.className = "ui-stack ui-stack--1";
        fact.append(
          statusBadge(
            location.mapping_status === "confirmed" ? "ready" : "setup",
            statusLabel(location.mapping_status),
          ),
          Object.assign(document.createElement("span"), {
            className: "ui-text-secondary",
            textContent: location.write_enabled
              ? "Provider writes enabled"
              : "Read only",
          }),
        );
        if (!connectionReady) {
          fact.append(
            Object.assign(document.createElement("span"), {
              className: "ui-text-secondary",
              textContent: "Reconnect to resume operations",
            }),
          );
        }
        return fact;
      }

      function operationalRecordFact(
        row: LocationOperationalRow,
      ): HTMLDivElement {
        const providerCounts =
          row.providerPosts?.kind === "ok"
            ? providerPostCounts(row.providerPosts.data)
            : null;
        const posts =
          row.managedPosts?.kind === "ok" && providerCounts
            ? `${row.managedPosts.data.length} managed post${row.managedPosts.data.length === 1 ? "" : "s"} · ${providerCounts.live} live on Google`
            : "Posts unavailable";
        const media =
          row.media?.kind === "ok"
            ? `${row.media.data.length} media record${row.media.data.length === 1 ? "" : "s"}`
            : "Media unavailable";
        const hours =
          row.specialHours?.kind === "ok"
            ? `${row.specialHours.data.length} special-hours record${row.specialHours.data.length === 1 ? "" : "s"}`
            : "Special hours unavailable";
        return cellMeta(posts, `${media} · ${hours}`);
      }

      function locationOpenButton(
        location: GBPLocationSummary,
        connectionReady: boolean,
      ): HTMLButtonElement {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "ui-button ui-button--primary ui-button--sm";
        button.textContent = "Open";
        button.disabled = !connectionReady || !workspaceContextFor(location);
        button.addEventListener("click", () => void openWorkspace(location));
        return button;
      }

      async function openWorkspace(loc: GBPLocationSummary): Promise<void> {
        if (!googleConnectionReady) return;
        const context = workspaceContextFor(loc);
        if (!context) return;
        selectedPlatformLocationId = context.platformLocationId;
        selectedGbpLocationId = context.gbpLocationId;
        document.getElementById("gbp-workspace")!.hidden = false;
        document.getElementById("location-picker-section")!.hidden = true;
        document.getElementById("change-gbp-location")!.hidden = false;

        // Update page title to show selected location
        const titleEl = document.getElementById("gbp-page-title");
        if (titleEl) titleEl.textContent = loc.business_name;

        await Promise.all([
          renderOverview(),
          renderProfile(),
          renderHours(),
          renderPosts(),
          renderMedia(),
        ]);
      }

      function showLocationPicker(): void {
        selectedPlatformLocationId = null;
        selectedGbpLocationId = null;
        document.getElementById("gbp-workspace")!.hidden = true;
        document.getElementById("location-picker-section")!.hidden = false;
        document.getElementById("change-gbp-location")!.hidden = true;
        const title = document.getElementById("gbp-page-title");
        if (title) title.textContent = "Business Profile";
      }

      // ---- Overview tab ----
      async function renderOverview(): Promise<void> {
        const panel = document.getElementById("tab-overview")!;
        panel.replaceChildren();
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;

        const [completenessResult, auditResult, suspensionResult] =
          await Promise.all([
            fetchCompleteness(
              organizationId,
              selectedPlatformLocationId,
              selectedGbpLocationId,
            ),
            fetchOperationsAudit(
              organizationId,
              selectedPlatformLocationId,
              selectedGbpLocationId,
            ),
            fetchSuspensionCases(
              organizationId,
              selectedPlatformLocationId,
              selectedGbpLocationId,
            ),
          ]);

        // Completeness
        const compCard = document.createElement("div");
        compCard.className = "ui-card";
        const compHeader = document.createElement("div");
        compHeader.className = "ui-card__header";
        compHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "ui-card__heading",
            textContent: "Profile completeness",
          }),
        );
        compCard.append(compHeader);
        const compBody = document.createElement("div");
        compBody.className = "ui-card__body";
        if (completenessResult.kind === "ok") {
          compBody.append(
            statusBadge(
              completenessResult.data.complete ? "ready" : "setup",
              completenessResult.data.complete ? "Complete" : "Incomplete",
            ),
          );
          if (!completenessResult.data.complete) {
            const missing = document.createElement("p");
            missing.className = "ui-card__description";
            missing.textContent = `Missing: ${completenessResult.data.unknown.join(", ") || "none"}`;
            compBody.append(missing);
          }
        } else {
          compBody.append(
            errorAlert(describeFailure(completenessResult, "Completeness")),
          );
        }
        compCard.append(compBody);
        panel.append(compCard);

        // Items needing attention
        const attentionCard = document.createElement("div");
        attentionCard.className = "ui-card";
        const attentionHeader = document.createElement("div");
        attentionHeader.className = "ui-card__header";
        attentionHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "ui-card__heading",
            textContent: "Needs attention",
          }),
        );
        attentionCard.append(attentionHeader);
        const attentionBody = document.createElement("div");
        attentionBody.className = "ui-card__body";
        const pending = [];
        if (
          suspensionResult.kind === "ok" &&
          suspensionResult.data.length > 0
        ) {
          pending.push(`${suspensionResult.data.length} suspension case(s)`);
        }
        if (pending.length === 0) {
          attentionBody.append(
            emptyState("All clear", "No items need immediate attention."),
          );
        } else {
          for (const item of pending) {
            const p = document.createElement("p");
            p.className = "ui-text-secondary";
            p.textContent = `• ${item}`;
            attentionBody.append(p);
          }
        }
        attentionCard.append(attentionBody);
        panel.append(attentionCard);

        // Recent activity
        const activityCard = document.createElement("div");
        activityCard.className = "ui-card";
        const activityHeader = document.createElement("div");
        activityHeader.className = "ui-card__header";
        activityHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "ui-card__heading",
            textContent: "Recent activity",
          }),
        );
        activityCard.append(activityHeader);
        const activityBody = document.createElement("div");
        activityBody.className = "ui-card__body";
        if (auditResult.kind === "ok" && auditResult.data.length > 0) {
          const list = document.createElement("ol");
          list.className = "ui-record-list";
          for (const event of auditResult.data.slice(0, 10)) {
            const item = document.createElement("li");
            const strong = document.createElement("strong");
            strong.textContent = event.summary;
            const span = document.createElement("span");
            span.textContent = formatTimestamp(event.occurred_at);
            item.append(strong, span);
            list.append(item);
          }
          activityBody.append(list);
        } else {
          activityBody.append(
            emptyState(
              "No activity yet",
              "Operations and changes will appear here.",
            ),
          );
        }
        activityCard.append(activityBody);
        panel.append(activityCard);
      }

      // ---- Profile tab ----
      async function renderProfile(): Promise<void> {
        const panel = document.getElementById("tab-profile")!;
        panel.replaceChildren();
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;

        const [changeSetsResult] = await Promise.all([
          fetchChangeSets(
            organizationId,
            selectedPlatformLocationId,
            selectedGbpLocationId,
          ),
        ]);

        // Propose change form
        const formCard = document.createElement("div");
        formCard.className = "ui-card";
        const formHeader = document.createElement("div");
        formHeader.className = "ui-card__header";
        formHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "ui-card__heading",
            textContent: "Propose a change",
          }),
        );
        formCard.append(formHeader);
        const formBody = document.createElement("div");
        formBody.className = "ui-card__body";

        const grid = document.createElement("div");
        grid.className = "ui-form-grid";
        const taskOptions = [
          { value: "", label: "Choose what to edit…" },
          { value: "profile.description", label: "Business description" },
          { value: "regularHours.regularHours", label: "Business hours" },
          { value: "phoneNumbers.phoneNumbers", label: "Phone number" },
          { value: "websiteUri.websiteUri", label: "Website URL" },
          { value: "categories.categories", label: "Categories" },
        ];
        const taskSelect = createSelectControl(
          "change-task",
          "What to edit",
          taskOptions,
          "",
          "Choose what to edit…",
        );
        grid.append(taskSelect.root);

        const valueField = document.createElement("div");
        valueField.className = "ui-field";
        const valueLabel = document.createElement("label");
        valueLabel.className = "ui-field__label";
        valueLabel.htmlFor = "change-value";
        valueLabel.textContent = "New value";
        const valueInput = document.createElement("input");
        valueInput.className = "ui-input";
        valueInput.id = "change-value";
        valueInput.type = "text";
        valueInput.placeholder = "new value";
        valueField.append(valueLabel, valueInput);
        grid.append(valueField);
        formBody.append(grid);

        const proposeBtn = document.createElement("button");
        proposeBtn.type = "button";
        proposeBtn.className = "ui-button ui-button--primary ui-button--md";
        proposeBtn.textContent = "Propose change";
        const status = document.createElement("p");
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        status.className = "ui-text-secondary";
        proposeBtn.addEventListener("click", async () => {
          const task = taskSelect.input.value.trim();
          const value = valueInput.value.trim();
          if (!task || !value) {
            status.textContent = "Choose what to edit and enter a value first.";
            return;
          }
          const [capabilityKey, field] = task.split(".");
          const result = await proposeChangeSet(
            organizationId,
            selectedPlatformLocationId!,
            selectedGbpLocationId!,
            {
              capabilityKey,
              field,
              value,
              idempotencyKey: `web-change-${Date.now()}`,
            },
          );
          status.textContent =
            result.kind === "ok"
              ? "Change proposed."
              : describeFailure(result, "Propose");
          if (result.kind === "ok") await renderProfile();
        });

        const actions = document.createElement("div");
        actions.className = "ui-inline ui-inline--center";
        actions.append(proposeBtn, status);
        formBody.append(actions);
        formCard.append(formBody);
        panel.append(formCard);

        // Pending changes
        if (
          changeSetsResult.kind === "ok" &&
          changeSetsResult.data.length > 0
        ) {
          const pendingCard = document.createElement("div");
          pendingCard.className = "ui-card";
          const pendingHeader = document.createElement("div");
          pendingHeader.className = "ui-card__header";
          pendingHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent: "Pending changes",
            }),
          );
          pendingCard.append(pendingHeader);
          const pendingBody = document.createElement("div");
          pendingBody.className = "ui-card__body";
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const cs of changeSetsResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = `Revision ${cs.revision}`;
            const detail = document.createElement("p");
            detail.textContent = `Status: ${statusLabel(cs.status)}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(statusTone(cs.status), statusLabel(cs.status)),
            );
            if (cs.status === "awaiting_approval") {
              const approveBtn = document.createElement("button");
              approveBtn.type = "button";
              approveBtn.className =
                "ui-button ui-button--primary ui-button--sm";
              approveBtn.textContent = "Approve";
              approveBtn.addEventListener("click", async () => {
                await decideChangeSet(
                  organizationId,
                  selectedPlatformLocationId!,
                  cs.id,
                  true,
                );
                await renderProfile();
              });
              item.append(approveBtn);
            }
            list.append(item);
          }
          pendingBody.append(list);
          pendingCard.append(pendingBody);
          panel.append(pendingCard);
        }
      }

      // ---- Hours tab ----
      async function renderHours(): Promise<void> {
        const panel = document.getElementById("tab-hours")!;
        panel.replaceChildren();
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;

        const hoursResult = await fetchSpecialHours(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );

        // Propose special hours form
        const formCard = document.createElement("div");
        formCard.className = "ui-card";
        const formHeader = document.createElement("div");
        formHeader.className = "ui-card__header";
        formHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "ui-card__heading",
            textContent: "Add special hours",
          }),
        );
        formCard.append(formHeader);
        const formBody = document.createElement("div");
        formBody.className = "ui-card__body";

        const grid = document.createElement("div");
        grid.className = "ui-form-grid";
        const dateField = document.createElement("div");
        dateField.className = "ui-field";
        dateField.append(
          Object.assign(document.createElement("label"), {
            className: "ui-field__label",
            htmlFor: "special-hours-date",
            textContent: "Service date",
          }),
        );
        const dateInput = document.createElement("input");
        dateInput.className = "ui-input";
        dateInput.id = "special-hours-date";
        dateInput.type = "date";
        dateField.append(dateInput);
        grid.append(dateField);

        const opensField = document.createElement("div");
        opensField.className = "ui-field";
        opensField.append(
          Object.assign(document.createElement("label"), {
            className: "ui-field__label",
            htmlFor: "special-hours-opens",
            textContent: "Opens",
          }),
        );
        const opensInput = document.createElement("input");
        opensInput.className = "ui-input";
        opensInput.id = "special-hours-opens";
        opensInput.type = "time";
        opensInput.value = "09:00";
        opensField.append(opensInput);
        grid.append(opensField);

        const closesField = document.createElement("div");
        closesField.className = "ui-field";
        closesField.append(
          Object.assign(document.createElement("label"), {
            className: "ui-field__label",
            htmlFor: "special-hours-closes",
            textContent: "Closes",
          }),
        );
        const closesInput = document.createElement("input");
        closesInput.className = "ui-input";
        closesInput.id = "special-hours-closes";
        closesInput.type = "time";
        closesInput.value = "17:00";
        closesField.append(closesInput);
        grid.append(closesField);
        formBody.append(grid);

        const proposeBtn = document.createElement("button");
        proposeBtn.type = "button";
        proposeBtn.className = "ui-button ui-button--primary ui-button--md";
        proposeBtn.textContent = "Propose special hours";
        const status = document.createElement("p");
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        status.className = "ui-text-secondary";
        proposeBtn.addEventListener("click", async () => {
          const serviceDate = dateInput.value;
          if (!serviceDate) {
            status.textContent = "Select a service date first.";
            return;
          }
          const result = await proposeSpecialHours(
            organizationId,
            selectedPlatformLocationId!,
            selectedGbpLocationId!,
            {
              serviceDate,
              opens: `${opensInput.value}:00`,
              closes: `${closesInput.value}:00`,
            },
          );
          status.textContent =
            result.kind === "ok"
              ? "Special hours proposed."
              : describeFailure(result, "Propose");
          if (result.kind === "ok") await renderHours();
        });

        const actions = document.createElement("div");
        actions.className = "ui-inline ui-inline--center";
        actions.append(proposeBtn, status);
        formBody.append(actions);
        formCard.append(formBody);
        panel.append(formCard);

        // Existing special hours
        if (hoursResult.kind === "ok" && hoursResult.data.length > 0) {
          const listCard = document.createElement("div");
          listCard.className = "ui-card";
          const listHeader = document.createElement("div");
          listHeader.className = "ui-card__header";
          listHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent: "Special hours",
            }),
          );
          listCard.append(listHeader);
          const listBody = document.createElement("div");
          listBody.className = "ui-card__body";
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const hours of hoursResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = hours.service_date;
            const detail = document.createElement("p");
            detail.textContent = `Status: ${statusLabel(hours.status)}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(statusTone(hours.status), statusLabel(hours.status)),
            );
            if (hours.status === "awaiting_approval") {
              const approveBtn = document.createElement("button");
              approveBtn.type = "button";
              approveBtn.className =
                "ui-button ui-button--primary ui-button--sm";
              approveBtn.textContent = "Approve";
              approveBtn.addEventListener("click", async () => {
                await decideSpecialHours(
                  organizationId,
                  selectedPlatformLocationId!,
                  hours.id,
                  true,
                );
                await renderHours();
              });
              item.append(approveBtn);
            }
            list.append(item);
          }
          listBody.append(list);
          listCard.append(listBody);
          panel.append(listCard);
        }
      }

      // ---- Posts tab ----
      async function renderPosts(): Promise<void> {
        const panel = document.getElementById("tab-posts")!;
        panel.replaceChildren();
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;

        const postsResult = await fetchPostRevisions(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );
        const providerPostsResult = await fetchProviderPosts(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );

        const providerCard = document.createElement("div");
        providerCard.className = "ui-card";
        const providerHeader = document.createElement("div");
        providerHeader.className = "ui-card__header";
        providerHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "ui-card__heading",
            textContent: "Google Local Posts",
          }),
        );
        providerCard.append(providerHeader);
        const providerBody = document.createElement("div");
        providerBody.className = "ui-card__body";
        const reconcileBtn = document.createElement("button");
        reconcileBtn.type = "button";
        reconcileBtn.className = "ui-button ui-button--primary ui-button--md";
        reconcileBtn.textContent = "Refresh from Google";
        const providerStatus = document.createElement("p");
        providerStatus.setAttribute("role", "status");
        providerStatus.setAttribute("aria-live", "polite");
        providerStatus.className = "ui-text-secondary";
        reconcileBtn.addEventListener("click", async () => {
          reconcileBtn.disabled = true;
          reconcileBtn.textContent = "Refreshing…";
          const result = await reconcileProviderPosts(
            organizationId,
            selectedPlatformLocationId!,
            selectedGbpLocationId!,
          );
          if (result.kind === "ok") {
            postsStatusMessage = `${result.data.live_count} live on Google · ${result.data.processing_count} processing · ${result.data.persisted_count} observed over time.`;
            await renderPosts();
          } else {
            reconcileBtn.disabled = false;
            reconcileBtn.textContent = "Refresh from Google";
            providerStatus.textContent = describeFailure(
              result,
              "Google Local Posts",
            );
          }
        });
        providerBody.append(reconcileBtn, providerStatus);
        if (providerPostsResult.kind === "ok") {
          const counts = providerPostCounts(providerPostsResult.data);
          const observed = document.createElement("p");
          observed.className = "ui-text-secondary";
          observed.textContent = `${counts.live} live on Google · ${counts.processing} processing · ${counts.rejected} rejected · ${counts.observed} observed over time.`;
          providerBody.append(observed);
        }
        providerCard.append(providerBody);
        panel.append(providerCard);

        const actionStatus = document.createElement("p");
        actionStatus.setAttribute("role", "status");
        actionStatus.setAttribute("aria-live", "polite");
        actionStatus.className = "ui-text-secondary";
        actionStatus.textContent = postsStatusMessage;
        panel.append(actionStatus);

        // Draft post form
        const formCard = document.createElement("div");
        formCard.className = "ui-card";
        const formHeader = document.createElement("div");
        formHeader.className = "ui-card__header";
        formHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "ui-card__heading",
            textContent: "Draft a post",
          }),
        );
        formCard.append(formHeader);
        const formBody = document.createElement("div");
        formBody.className = "ui-card__body";
        const contentArea = document.createElement("textarea");
        contentArea.id = "post-content";
        contentArea.rows = 3;
        contentArea.placeholder = "Write your post…";
        formBody.append(contentArea);
        const draftBtn = document.createElement("button");
        draftBtn.type = "button";
        draftBtn.className = "ui-button ui-button--primary ui-button--md";
        draftBtn.textContent = "Draft post";
        const status = document.createElement("p");
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        status.className = "ui-text-secondary";
        draftBtn.addEventListener("click", async () => {
          const content = contentArea.value;
          if (!content.trim()) {
            status.textContent = "Enter post content first.";
            return;
          }
          const result = await createPostRevision(
            organizationId,
            selectedPlatformLocationId!,
            selectedGbpLocationId!,
            { postType: "standard", content },
          );
          status.textContent =
            result.kind === "ok"
              ? "Post drafted."
              : describeFailure(result, "Draft");
          if (result.kind === "ok") {
            postsStatusMessage = "Post drafted.";
            await renderPosts();
          }
        });
        const actions = document.createElement("div");
        actions.className = "ui-inline ui-inline--center";
        actions.append(draftBtn, status);
        formBody.append(actions);
        formCard.append(formBody);
        panel.append(formCard);

        // Posts list
        if (postsResult.kind === "ok" && postsResult.data.length > 0) {
          const listCard = document.createElement("div");
          listCard.className = "ui-card";
          const listHeader = document.createElement("div");
          listHeader.className = "ui-card__header";
          listHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent: "Posts",
            }),
          );
          listCard.append(listHeader);
          const listBody = document.createElement("div");
          listBody.className = "ui-card__body";
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const post of postsResult.data) {
            const presentation = postPresentation(post);
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent =
              post.content.length > 80
                ? post.content.slice(0, 80) + "…"
                : post.content;
            const detail = document.createElement("p");
            detail.textContent = `Status: ${presentation.label}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(presentation.tone, presentation.label),
            );
            if (post.status === "awaiting_approval") {
              const approveBtn = document.createElement("button");
              approveBtn.type = "button";
              approveBtn.className =
                "ui-button ui-button--primary ui-button--sm";
              approveBtn.textContent = "Approve";
              approveBtn.addEventListener("click", async () => {
                await decidePostRevision(
                  organizationId,
                  selectedPlatformLocationId!,
                  post.id,
                  true,
                );
                await renderPosts();
              });
              item.append(approveBtn);
            }
            if (presentation.canPublish) {
              const publishBtn = document.createElement("button");
              publishBtn.type = "button";
              publishBtn.className =
                "ui-button ui-button--primary ui-button--sm";
              publishBtn.textContent = "Publish";
              publishBtn.addEventListener("click", async () => {
                publishBtn.disabled = true;
                publishBtn.textContent = "Starting…";
                actionStatus.textContent = "Starting publication…";
                const idempotencyKey = postPublicationIdempotencyKey(post.id);
                const workflowStart = await startWorkflowRun(
                  organizationId,
                  "gbp.publish_post",
                  {
                    locationId: selectedPlatformLocationId!,
                    idempotencyKey,
                  },
                );
                if (workflowStart.kind !== "ok") {
                  actionStatus.textContent = describeFailure(
                    workflowStart,
                    "Publish",
                  );
                  publishBtn.disabled = false;
                  publishBtn.textContent = "Publish";
                  return;
                }
                const result = await publishPost(
                  organizationId,
                  selectedPlatformLocationId!,
                  post.id,
                  workflowStart.data.workflow_run_id,
                  idempotencyKey,
                );
                postsStatusMessage =
                  result.kind === "ok"
                    ? "Post publication reserved."
                    : describeFailure(result, "Publish");
                if (result.kind === "ok") {
                  await renderPosts();
                } else {
                  actionStatus.textContent = postsStatusMessage;
                  publishBtn.disabled = false;
                  publishBtn.textContent = "Publish";
                }
              });
              item.append(publishBtn);
            }
            if (presentation.canRecover && post.publication) {
              const recoverBtn = document.createElement("button");
              recoverBtn.type = "button";
              recoverBtn.className =
                "ui-button ui-button--secondary ui-button--sm";
              recoverBtn.textContent = "Recover safely";
              recoverBtn.addEventListener("click", async () => {
                recoverBtn.disabled = true;
                recoverBtn.textContent = "Checking…";
                actionStatus.textContent =
                  "Checking Google before recovering publication…";
                const result = await recoverPostPublication(
                  organizationId,
                  selectedPlatformLocationId!,
                  post.publication!.id,
                );
                postsStatusMessage =
                  result.kind === "ok"
                    ? "Publication recovery queued after provider reconciliation."
                    : describeFailure(result, "Recover publication");
                if (result.kind === "ok") {
                  await renderPosts();
                } else {
                  actionStatus.textContent = postsStatusMessage;
                  recoverBtn.disabled = false;
                  recoverBtn.textContent = "Recover safely";
                }
              });
              item.append(recoverBtn);
            }
            list.append(item);
          }
          listBody.append(list);
          listCard.append(listBody);
          panel.append(listCard);
        }
      }

      // ---- Media tab ----
      async function renderMedia(): Promise<void> {
        const panel = document.getElementById("tab-media")!;
        panel.replaceChildren();
        if (!selectedPlatformLocationId || !selectedGbpLocationId) return;

        const mediaResult = await fetchMedia(
          organizationId,
          selectedPlatformLocationId,
          selectedGbpLocationId,
        );

        // Propose media form
        const formCard = document.createElement("div");
        formCard.className = "ui-card";
        const formHeader = document.createElement("div");
        formHeader.className = "ui-card__header";
        formHeader.append(
          Object.assign(document.createElement("h3"), {
            className: "ui-card__heading",
            textContent: "Upload media",
          }),
        );
        formCard.append(formHeader);
        const formBody = document.createElement("div");
        formBody.className = "ui-card__body";
        const urlField = document.createElement("div");
        urlField.className = "ui-field";
        urlField.append(
          Object.assign(document.createElement("label"), {
            className: "ui-field__label",
            htmlFor: "media-reference",
            textContent: "Media URL",
          }),
        );
        const urlInput = document.createElement("input");
        urlInput.className = "ui-input";
        urlInput.id = "media-reference";
        urlInput.type = "text";
        urlInput.placeholder = "https://example.com/photo.jpg";
        urlField.append(urlInput);
        formBody.append(urlField);
        const proposeBtn = document.createElement("button");
        proposeBtn.type = "button";
        proposeBtn.className = "ui-button ui-button--primary ui-button--md";
        proposeBtn.textContent = "Propose media";
        const status = document.createElement("p");
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        status.className = "ui-text-secondary";
        proposeBtn.addEventListener("click", async () => {
          const reference = urlInput.value.trim();
          if (!reference) {
            status.textContent = "Enter a media URL first.";
            return;
          }
          const result = await proposeMedia(
            organizationId,
            selectedPlatformLocationId!,
            selectedGbpLocationId!,
            {
              mediaType: "photo",
              sourceReference: reference,
              rightsAuthority: "Business owner upload",
            },
          );
          status.textContent =
            result.kind === "ok"
              ? "Media proposed."
              : describeFailure(result, "Propose");
          if (result.kind === "ok") await renderMedia();
        });
        const actions = document.createElement("div");
        actions.className = "ui-inline ui-inline--center";
        actions.append(proposeBtn, status);
        formBody.append(actions);
        formCard.append(formBody);
        panel.append(formCard);

        // Media list
        if (mediaResult.kind === "ok" && mediaResult.data.length > 0) {
          const listCard = document.createElement("div");
          listCard.className = "ui-card";
          const listHeader = document.createElement("div");
          listHeader.className = "ui-card__header";
          listHeader.append(
            Object.assign(document.createElement("h3"), {
              className: "ui-card__heading",
              textContent: "Media",
            }),
          );
          listCard.append(listHeader);
          const listBody = document.createElement("div");
          listBody.className = "ui-card__body";
          const list = document.createElement("ul");
          list.className = "ui-record-list";
          for (const media of mediaResult.data) {
            const item = document.createElement("li");
            const info = document.createElement("div");
            const name = document.createElement("h3");
            name.textContent = statusLabel(media.media_type);
            const detail = document.createElement("p");
            detail.textContent = `Status: ${statusLabel(media.status)}`;
            info.append(name, detail);
            item.append(
              info,
              statusBadge(statusTone(media.status), statusLabel(media.status)),
            );
            list.append(item);
          }
          listBody.append(list);
          listCard.append(listBody);
          panel.append(listCard);
        }
      }

      async function boot(): Promise<void> {
        const result = await bootWorkspace("Business Profile");
        if (!applyBootResult(regions, result)) return;
        populateSwitcher(result.organizations, (o) => void loadOrganization(o));
        const org =
          result.organizations.find(
            (o) => o.organization_id === result.context.organizationId,
          ) ?? result.organizations[0];
        await loadOrganization(org);
      }

      void boot();
    </script>
  </body>
</html>
