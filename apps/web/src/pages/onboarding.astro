      // ---------- Step 6: products ----------

      /**
       * Wire the Enable / Restore-to-setup_required control for a single
       * product entitlement row. Both controls POST through the production
       * platform-administration API (never the deprecated DB provisioning
       * script) and refresh the onboarding read model immediately after
       * success so the resulting `setup_required` entitlement counts as
       * selected/effective. The backend `ENTITLEMENT_TRANSITIONS` guard
       * rejects any transition the current lifecycle does not permit; this
       * handler renders that truthful failure rather than retrying.
       */
      function wireEntitlementAction(
        organizationId: string,
        state: EntitlementRowState,
        alertContainerId: string,
        onDone: () => void,
      ): HTMLButtonElement | null {
        const alertInto = (kind: "error" | "success", message: string) => {
          const container = document.getElementById(alertContainerId);
          if (!container) return;
          const alert = document.createElement("div");
          alert.className = `alert alert--${kind}`;
          alert.setAttribute("role", kind === "error" ? "alert" : "status");
          const p = document.createElement("p");
          p.textContent = message;
          alert.append(p);
          container.replaceChildren(alert);
        };

        const button = document.createElement("button");
        button.type = "button";
        button.className = "button button--secondary button--sm";

        if (state.canEnable) {
          button.textContent = "Enable";
          button.addEventListener("click", async () => {
            button.disabled = true;
            button.textContent = "Enabling…";
            const result = await enableProduct(
              organizationId,
              state.productKey,
              `Enable ${state.productKey} for ${currentOrganization?.name ?? "this client"} during client onboarding.`,
            );
            if (result.kind !== "ok") {
              button.disabled = false;
              button.textContent = "Enable";
              alertInto("error", describeFailure(result));
              return;
            }
            alertInto("success", `${state.productKey} enabled.`);
            onDone();
          });
          return button;
        }

        if (state.canReEnable && state.entitlement !== null) {
          const entitlement = state.entitlement;
          button.textContent = "Restore to setup required";
          button.title =
            "Restores this deliberately disabled/suspended entitlement to setup_required through the governed transition API.";
          button.addEventListener("click", async () => {
            button.disabled = true;
            button.textContent = "Restoring…";
            const result = await reEnableProduct(
              organizationId,
              entitlement,
              `Operator restored ${state.productKey} entitlement to setup_required during onboarding.`,
            );
            if (result.kind !== "ok") {
              button.disabled = false;
              button.textContent = "Restore to setup required";
              alertInto("error", describeFailure(result));
              return;
            }
            alertInto("success", `${state.productKey} restored.`);
            onDone();
          });
          return button;
        }

        return null;
      }

      async function renderProducts(
        organizationId: string,
        state: OnboardingState | null,
      ): Promise<void> {
        const list = document.getElementById("onboarding-products-list")!;
        list.replaceChildren();
        const productsOutcome = await fetchProducts(organizationId);
        const productsByKey = new Map(
          productsOutcome.kind === "ok"
            ? (Array.isArray(productsOutcome?.data)
                ? productsOutcome.data
                : []
              ).map((product) => [product.key, product])
            : [],
        );
        // Build product_id -> product_key so entitlement rows (which carry
        // product_id) can be associated with the stable product key the rest
        // of the UI uses.
        const productIdToKey = new Map<string, string>();
        if (productsOutcome.kind === "ok") {
          for (const product of productsOutcome.data) {
            productIdToKey.set(product.id, product.key);
          }
        }
        // Truthful entitlement state from the production platform-admin API.
        // A non-admin (or any failure) still renders the onboarding read
        // model's per-product status below; the Enable control is only
        // offered when the rows load successfully.
        const { byKey: entitlementsByKey } = await loadEntitlementsByKey(
          organizationId,
          productIdToKey,
        );

        const statuses = state?.products ?? [];
        if (statuses.length === 0) {
          const empty = document.createElement("div");
          empty.className = "empty-state";
          empty.innerHTML =
            "<h3>Products load after the client is selected</h3><p></p>";
          list.append(empty);
          return;
        }
        for (const productStatus of statuses) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const title = document.createElement("h3");
          title.textContent =
            productsByKey.get(productStatus.product_key)?.name ??
            productStatus.product_name;
          const meta = document.createElement("p");
          const entitlement =
            entitlementsByKey.get(productStatus.product_key) ?? null;
          const row = describeEntitlementRow(
            productStatus.product_key,
            entitlement,
          );
          if (!productStatus.selected && entitlement === null) {
            meta.textContent = "Not enabled for this client yet.";
          } else if (entitlement && !row.selected) {
            meta.textContent = `Entitlement is ${entitlement.status.replace(/_/g, " ")}.`;
          } else if (entitlement && !row.effective) {
            meta.textContent = `Enabled — entitlement is ${entitlement.status.replace(/_/g, " ")}.`;
          } else if (productStatus.external_integration_pending) {
            meta.textContent =
              "Enabled — requires a connected external integration (does not block organization activation).";
          } else if (productStatus.blocking_findings.length > 0) {
            meta.textContent = productStatus.blocking_findings[0];
          } else if (productStatus.ready) {
            meta.textContent = "Ready.";
          } else {
            meta.textContent =
              productStatus.next_action ?? "Setup in progress.";
          }
          info.append(title, meta);
          const actions = document.createElement("div");
          actions.style.display = "flex";
          actions.style.flexDirection = "column";
          actions.style.gap = "0.5rem";
          actions.style.alignItems = "flex-end";
          const statusLabel =
            !productStatus.selected && entitlement === null
              ? "setup"
              : productStatus.ready
                ? "ready"
                : productStatus.external_integration_pending
                  ? "degraded"
                  : entitlement
                    ? entitlementBadgeKind(entitlement.status)
                    : "blocked";
          actions.append(badge(statusLabel));
          // Operator action: Enable (no entitlement) or Restore
          // (not_enabled/suspended). Archived is terminal and renders no
          // control. An existing effective entitlement is never recreated.
          const action = wireEntitlementAction(
            organizationId,
            row,
            "products-alert",
            () => void refreshWorkspace(),
          );
          if (action !== null) actions.append(action);
          item.append(info, actions);
          list.append(item);
        }
      }

      // ---------- Step 7: policies ----------

      function policyKeyLabel(key: string): string {
        const labels: Record<string, string> = {
          "default.approval": "Default approval policy",
          "default.notifications": "Default notification policy",
        };
        if (labels[key]) return labels[key];
        return key
          .replace(/[._]/g, " ")
          .replace(/\b\w/g, (c) => c.toUpperCase());
      }

      function policyRow(
        policy: PolicyRevision,
        organizationId: string,
        onApproved: () => void,
      ): HTMLLIElement {
        const item = document.createElement("li");
        const info = document.createElement("div");
        const title = document.createElement("h3");
        title.textContent = policyKeyLabel(policy.policy_key);
        info.append(title);
        const actions = document.createElement("div");
        if (policy.status === "pending_approval" || policy.status === "draft") {
          const approveButton = document.createElement("button");
          approveButton.type = "button";
          approveButton.className = "button button--secondary button--sm";
          approveButton.textContent = "Approve";
          approveButton.addEventListener("click", async () => {
            const result = await approvePolicy(organizationId, policy.id);
            if (result.kind !== "ok") {
              alertInto("policies-alert", "error", describeFailure(result));
              return;
            }
            onApproved();
          });
          actions.append(approveButton);
        } else {
          actions.append(
            badge(
              policy.status === "active" ? "ready" : "setup",
              policy.status,
            ),
          );
        }
        item.append(info, actions);
        return item;
      }

      async function renderPolicies(organizationId: string): Promise<void> {
        const approvalList = document.getElementById("approval-policies-list")!;
        const notificationList = document.getElementById(
          "notification-policies-list",
        )!;
        approvalList.replaceChildren();
        notificationList.replaceChildren();

        const approvals = await fetchEffectivePolicies(
          organizationId,
          "approval",
        );
        if (approvals.kind === "ok" && approvals.data.length > 0) {
          for (const policy of approvals.data) {
            approvalList.append(
              policyRow(policy, organizationId, () => void refreshWorkspace()),
            );
          }
        } else {
          const empty = document.createElement("div");
          empty.className = "empty-state";
          empty.innerHTML = "<h3>No approval policy yet</h3><p></p>";
          approvalList.append(empty);
        }

        const notifications = await fetchEffectivePolicies(
          organizationId,
          "notification",
        );
        if (notifications.kind === "ok" && notifications.data.length > 0) {
          for (const policy of notifications.data) {
            notificationList.append(
              policyRow(policy, organizationId, () => void refreshWorkspace()),
            );
          }
        } else {
          const empty = document.createElement("div");
          empty.className = "empty-state";
          empty.innerHTML = "<h3>No notification policy yet</h3><p></p>";
          notificationList.append(empty);
        }
      }

      function wireCreateApprovalPolicyForm(): void {
        const form = document.getElementById(
          "create-approval-policy-form",
        ) as HTMLFormElement;
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!currentOrganization) return;
          const data = new FormData(form);
          const outcome = await createPolicy(
            currentOrganization.id,
            "default.approval",
            "approval",
            "organization",
            {
              action_type: "generic",
              required_approver_permission: "organization.settings.manage",
              minimum_approvals: Number(data.get("minimum_approvals") ?? 1),
              self_approval_allowed: data.get("self_approval_allowed") === "on",
              material_edit_invalidates: true,
            },
            "Configured during client onboarding.",
          );
          if (outcome.kind !== "ok") {
            alertInto("policies-alert", "error", describeFailure(outcome));
            return;
          }
          alertInto("policies-alert", "success", "Approval policy created.");
          form.reset();
          await refreshWorkspace();
        });
      }

      function wireCreateNotificationPolicyForm(): void {
        const form = document.getElementById(
          "create-notification-policy-form",
        ) as HTMLFormElement;
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!currentOrganization) return;
          const outcome = await createPolicy(
            currentOrganization.id,
            "default.notifications",
            "notification",
            "organization",
            { mandatory_channels: ["email"], quiet_hours_allowed: true },
            "Configured during client onboarding.",
          );
          if (outcome.kind !== "ok") {
            alertInto("policies-alert", "error", describeFailure(outcome));
            return;
          }
          alertInto(
            "policies-alert",
            "success",
            "Notification policy created.",
          );
          form.reset();
          await refreshWorkspace();
        });
      }

      // ---------- Readiness + activation ----------

      const STEP_SECTION_IDS: Partial<
        Record<OnboardingState["steps"][number]["key"], string>
      > = {
        organization_profile: "section-profile",
        locations: "section-locations",
        primary_location: "section-locations",
        website_domain: "section-domain",
        industry: "section-industry",
        users: "section-users",
      };

      function renderChecklist(state: OnboardingState): void {
        const list = document.getElementById("checklist-list")!;
        list.replaceChildren();
        for (const step of state.steps) {
          const item = document.createElement("li");
          if (!step.blocking) item.classList.add("checklist__item--optional");
          const info = document.createElement("div");
          info.className = "checklist__info";
          const title = document.createElement("h3");
          title.textContent = step.label + (step.blocking ? "" : " (optional)");
          const detail = document.createElement("p");
          detail.textContent = step.next_action ?? step.detail;
          info.append(title, detail);
          const actionsCell = document.createElement("div");
          actionsCell.className = "checklist__actions";
          const statusKey =
            step.state === "complete"
              ? "ready"
              : step.blocking
                ? "blocked"
                : "setup";
          actionsCell.append(badge(statusKey, step.state.replace("_", " ")));
          const targetSectionId = STEP_SECTION_IDS[step.key];
          if (step.state !== "complete" && targetSectionId) {
            const jumpButton = document.createElement("a");
            jumpButton.href = `#${targetSectionId}`;
            jumpButton.className = "button button--secondary button--sm";
            jumpButton.textContent = "Resolve";
            actionsCell.append(jumpButton);
          }
          item.append(info, actionsCell);
          list.append(item);
        }
      }

      function renderReadiness(state: OnboardingState): void {
        const fill = document.getElementById("progress-bar-fill")!;
        const progressBar = document.getElementById("progress-bar")!;
        fill.style.width = `${state.progress_percent}%`;
        progressBar.setAttribute(
          "aria-valuenow",
          String(state.progress_percent),
        );
        document.getElementById("progress-label")!.textContent =
          `${state.progress_percent}% complete`;
        document.getElementById("progress-updated")!.textContent =
          `Last evaluated ${new Date(state.evaluated_at).toLocaleString()}`;

        const blockersPanel = document.getElementById("blockers-panel")!;
        blockersPanel.replaceChildren();
        if (state.blockers.length > 0) {
          const box = document.createElement("div");
          box.className = "alert alert--error";
          box.setAttribute("role", "alert");
          const heading = document.createElement("p");
          heading.textContent =
            "Activation is blocked until these are resolved:";
          const list = document.createElement("ul");
          for (const blocker of state.blockers) {
            const li = document.createElement("li");
            li.textContent = blocker;
            list.append(li);
          }
          box.append(heading, list);
          blockersPanel.append(box);
        }

        const warningsPanel = document.getElementById("warnings-panel")!;
        warningsPanel.replaceChildren();
        if (state.warnings.length > 0) {
          const box = document.createElement("div");
          box.className = "alert alert--warning";
          box.setAttribute("role", "status");
          const heading = document.createElement("p");
          heading.textContent = "Non-blocking, worth reviewing:";
          const list = document.createElement("ul");
          for (const warning of state.warnings) {
            const li = document.createElement("li");
            li.textContent = warning;
            list.append(li);
          }
          box.append(heading, list);
          warningsPanel.append(box);
        }

        const activateButton = document.getElementById(
          "activate-button",
        ) as HTMLButtonElement;
        if (state.organization_status === "active") {
          activateButton.hidden = true;
        } else {
          activateButton.hidden = false;
          activateButton.disabled = !state.activation_eligible;
          activateButton.title = state.activation_eligible
            ? ""
            : "Resolve every blocker above before activating.";
        }
      }

      function wireActivation(): void {
        const activateButton = document.getElementById(
          "activate-button",
        ) as HTMLButtonElement;
        const confirmPanel = document.getElementById("activation-confirm")!;
        const cancelButton = document.getElementById("activation-cancel")!;
        const confirmButton = document.getElementById(
          "activation-confirm-button",
        )!;

        activateButton.addEventListener("click", () => {
          if (!currentOrganization) return;
          document.getElementById("activation-consequence-text")!.textContent =
            `Activating ${currentOrganization.name} makes it a live client: its members can begin ` +
            "configuring products, and it will appear as an active client across the platform. This does not delete any data and can be followed by pause/offboarding later if needed.";
          confirmPanel.hidden = false;
          activateButton.hidden = true;
        });
        cancelButton.addEventListener("click", () => {
          confirmPanel.hidden = true;
          activateButton.hidden = false;
        });
        confirmButton.addEventListener("click", async () => {
          if (!currentOrganization) return;
          const result = await activateOrganization(
            currentOrganization.id,
            currentOrganization.version,
          );
          confirmPanel.hidden = true;
          if (result.kind !== "ok") {
            if (
              result.kind === "error" &&
              result.code === "ONBOARDING_INCOMPLETE"
            ) {
              alertInto(
                "readiness-alert",
                "error",
                "Onboarding is not complete yet. See the blockers listed above.",
              );
            } else {
              alertInto("readiness-alert", "error", describeFailure(result));
            }
            await refreshWorkspace();
            return;
          }
          alertInto(
            "readiness-alert",
            "success",
            `${result.data.name} is now active.`,
          );
          await refreshWorkspace();
        });
      }

      // ---------- Orchestration ----------

      async function refreshWorkspace(): Promise<void> {
        if (!currentOrganization) return;
        const organizationId = currentOrganization.id;

        const refreshed = await fetchOrganization(organizationId);
        if (refreshed.kind === "ok") currentOrganization = refreshed.data;

        document.getElementById("workspace-org-name")!.textContent =
          currentOrganization.name;
        const statusBadge = document.getElementById("workspace-status-badge")!;
        statusBadge.replaceChildren();
        statusBadge.append(
          badge(
            currentOrganization.status === "active" ? "ready" : "setup",
            currentOrganization.status,
          ),
        );

        await Promise.all([
          renderProfile(organizationId),
          renderLocations(organizationId),
          renderDomains(organizationId),
        ]);

        const stateOutcome = await fetchOnboardingState(organizationId);
        const state = stateOutcome.kind === "ok" ? stateOutcome.data : null;
        if (state) {
          renderChecklist(state);
          renderReadiness(state);
        }

        await renderUsers(organizationId);
        await renderProducts(organizationId, state);
        renderConnectStep();

        if (orgIsActive()) {
          unlockSection("section-users");
          unlockSection("section-policies");
          document.getElementById("users-help")!.textContent = "";
          document.getElementById("policies-help")!.textContent = "";
          document.getElementById("products-help")!.textContent = "";
          await renderPolicies(organizationId);
        } else {
          document.getElementById("users-help")!.textContent =
            "You can bootstrap yourself as the workspace owner now. Adding or inviting additional users beyond that requires the organization to be active first.";
          lockPostActivationSection(
            "section-users",
            "users-help",
            document.getElementById("users-help")!.textContent!,
          );
          // Owner-bootstrap remains usable before activation.
          (
            document.getElementById(
              "bootstrap-owner-button",
            ) as HTMLButtonElement
          ).disabled = false;
          document.getElementById("policies-help")!.textContent =
            "Policies can be created once this organization is active.";
          lockPostActivationSection(
            "section-policies",
            "policies-help",
            document.getElementById("policies-help")!.textContent!,
          );
          document.getElementById("products-help")!.textContent =
            "Enable products for this client. A setup_required entitlement is enough to permit the Google Business Profile OAuth connection.";
        }
      }

      async function loadOrganization(organizationId: string): Promise<void> {
        const outcome = await fetchOrganization(organizationId);
        if (outcome.kind !== "ok") {
          alertInto("picker-alert", "error", describeFailure(outcome));
          return;
        }
        currentOrganization = outcome.data;
        if (currentOrganization.status === "prospect") {
          const started = await startOnboarding(
            currentOrganization.id,
            currentOrganization.version,
          );
          if (started.kind === "ok") currentOrganization = started.data;
        }
        setOrgQueryParam(organizationId);
        (document.getElementById("org-picker") as HTMLSelectElement).value =
          organizationId;
        document.getElementById("client-workspace")!.hidden = false;
        await refreshWorkspace();
        document
          .getElementById("client-workspace")!
          .scrollIntoView({ behavior: "smooth", block: "start" });
      }

      function wireStaticForms(): void {
        wireCreateOrgForm();
        wireOrgPicker();
        wireProfileForm();
        wireCreateLocationForm();
        wireCreateDomainForm();
        wireIndustryForm();
        wireBootstrapOwnerButton();
        wireAddUserForm();
        wireCreateApprovalPolicyForm();
        wireCreateNotificationPolicyForm();
        wireActivation();
        wireStepper();
      }

      function wireStepper(): void {
        const sections: Record<string, string> = {
          profile: "section-profile",
          locations: "section-locations",
          website: "section-domain",
          industry: "section-industry",
          users: "section-users",
          products: "section-products",
          policies: "section-policies",
          activate: "section-activate",
          connect: "section-connect",
        };
        document
          .querySelectorAll<HTMLButtonElement>(
            "#onboarding-stepper [data-step]",
          )
          .forEach((button) => {
            button.addEventListener("click", () => {
              const sectionId = sections[button.dataset.step ?? ""];
              if (!sectionId) return;
              document.getElementById(sectionId)?.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });
            });
          });
      }

      function renderConnectStep(): void {
        if (!currentOrganization) return;
        const active = currentOrganization.status === "active";
        const status = document.getElementById("connect-status")!;
        status.replaceChildren(
          badge(
            active ? "ready" : "setup",
            active ? "Available" : "After activation",
          ),
        );
        document.getElementById("connect-help")!.textContent = active
          ? "Continue with provider authorization, resource mapping, and product-specific readiness. A connection is not complete until the required resource is mapped and current."
          : "Activate the client first. Provider authorization and resource mapping are intentionally completed in the standard organization workspace after activation.";
        document
          .querySelectorAll<HTMLAnchorElement>("#section-connect a")
          .forEach((link) => {
            const destination = new URL(link.href);
            destination.searchParams.set("org", currentOrganization!.id);
            link.href = destination.pathname + destination.search;
            link.setAttribute("aria-disabled", String(!active));
            link.tabIndex = active ? 0 : -1;
            link.onclick = active
              ? null
              : (event) => {
                  event.preventDefault();
                };
          });
        document
          .getElementById("section-connect")!
          .classList.toggle("is-disabled", !active);
      }

      /**
       * Top-level boot entry point.
       *
       * - Runs exactly once at a time: a second call while one is already
       *   in flight (e.g. a double Retry click) is ignored rather than
       *   starting an overlapping run.
       * - Wraps `runBoot` so that any *unexpected* exception still resolves
       *   to a rendered, operator-safe error naming the stage it happened
       *   in, never leaving the page stuck on "Loading…". Known, expected
       *   failures (a request returning a non-ok outcome) are handled
       *   explicitly inside `runBoot` itself and never reach this catch —
       *   it is a last resort, not the primary error-reporting path.
       */
      async function boot(): Promise<void> {
        if (bootInFlight) {
          console.info("[onboarding:boot] skipped: already in flight", {
            correlationId: bootCorrelationId,
          });
          return;
        }
        bootInFlight = true;
        bootCorrelationId = newCorrelationId();
        setRetryEnabled(false);
        logStage("start");
        try {
          await runBoot();
        } catch (error) {
          console.error("[onboarding:boot] unexpected exception", {
            correlationId: bootCorrelationId,
            stage: currentBootStage,
            error,
          });
          showBootError(
            currentBootStage,
            "Something unexpected went wrong while loading the onboarding workspace.",
          );
        } finally {
          bootInFlight = false;
          setRetryEnabled(true);
        }
      }

      async function runBoot(): Promise<void> {
        logStage("config");
        if (!readPublicConfig()) {
          showOnly(regions.notConfigured);
          return;
        }
        showOnly(regions.loading);

        logStage("session");
        const session = await getCurrentSession();
        if (session.status !== "signed-in") {
          goToLogin();
          return;
        }

        logStage("principal");
        const principal = await fetchPrincipal();
        if (principal.kind === "unauthenticated") {
          goToLogin();
          return;
        }
        if (principal.kind !== "ok") {
          showBootError("principal", describeFailure(principal));
          return;
        }
        applyShellPrincipal(principal.data);
        document.getElementById("sign-out-button")!.hidden = false;
        wireSignOut();
        currentPrincipal = principal.data;

        logStage("admin-status", { assurance: principal.data.assurance_level });
        const adminStatus = await fetchMyPlatformAdministratorStatus();
        if (adminStatus.kind === "unauthenticated") {
          goToLogin();
          return;
        }
        if (adminStatus.kind !== "ok") {
          showBootError("admin-status", describeFailure(adminStatus));
          return;
        }
        if (!adminStatus.data.is_platform_administrator) {
          showOnly(regions.notAdmin);
          return;
        }
        setPlatformAdminStatus(true);
        applyShellAudience("internal");
        if (!adminStatus.data.meets_required_assurance) {
          logStage("redirect-to-mfa");
          const next = encodeURIComponent(
            window.location.pathname + window.location.search,
          );
          window.location.assign(`/mfa?next=${next}`);
          return;
        }

        document.getElementById("active-organization-name")!.textContent =
          "Client onboarding";

        logStage("industries");
        const industriesOutcome = await populateIndustrySelects();
        wireStaticForms();

        logStage("organizations");
        const organizationsOutcome = await populateOrgPicker();

        // apiRequest already retries a 401 once against a freshly-refreshed
        // token before ever reporting "unauthenticated" — by the time it
        // surfaces here, the session is genuinely no longer valid (not a
        // transient staleness), so the truthful response is a real sign-in,
        // not a generic error.
        if (
          industriesOutcome.kind === "unauthenticated" ||
          organizationsOutcome.kind === "unauthenticated"
        ) {
          logStage("session-lost-mid-boot");
          goToLogin();
          return;
        }
        if (industriesOutcome.kind !== "ok") {
          showBootError(
            "industries",
            `Could not load industries: ${describeFailure(industriesOutcome)}`,
          );
          return;
        }
        if (organizationsOutcome.kind !== "ok") {
          showBootError(
            "organizations",
            `Could not load client organizations: ${describeFailure(organizationsOutcome)}`,
          );
          return;
        }

        logStage("content-render");
        showOnly(regions.content);

        const requestedOrgId = new URLSearchParams(window.location.search).get(
          "org",
        );
        if (requestedOrgId) {
          logStage("resume-organization", { organizationId: requestedOrgId });
          await loadOrganization(requestedOrgId);
        }

        logStage("complete");
      }

      wireBootErrorRetry();
      void boot();
    </script>
  </body>
</html>
