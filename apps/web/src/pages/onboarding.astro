---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta
      name="description"
      content="Guided client onboarding workspace"
    /><title>Client Onboarding · LILOs</title></head
  >
  <body
    ><AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1><p>
          No Supabase or API connection is configured for this build.
        </p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p>Loading Client Onboarding…</p>
      </div>

      <div id="boot-error" role="alert" hidden>
        <p id="boot-error-message"></p>
        <button type="button" class="button" id="boot-error-retry">Retry</button
        >
      </div>

      <div id="not-platform-admin" role="status" hidden>
        <h1>Platform administrator access required</h1><p>
          Client onboarding is only available to signed-in platform
          administrators. Ask an existing platform administrator to grant you
          access.
        </p>
      </div>

      <div id="onboarding-content" hidden>
        <div class="page-head">
          <div class="page-head__intro">
            <p class="eyebrow">Admin</p>
            <h1 id="page-title">Client Onboarding</h1>
            <p>
              Create the client organization, complete required setup, and
              activate the account — all from this workspace.
            </p>
          </div>
        </div>

        <section aria-labelledby="picker-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Step 0</p><h2 id="picker-title">
                Choose a client
              </h2>
            </div>
          </div>
          <div id="picker-alert"></div>
          <div class="field field--full">
            <label for="org-picker">Resume an existing onboarding</label>
            <select id="org-picker">
              <option value="">Select a client…</option>
            </select>
          </div>
          <h3 style="margin-top: 1.5rem;">Or start a new client</h3>
          <form
            id="create-org-form"
            class="form-grid"
            style="margin-top: 1rem;"
          >
            <div class="field">
              <label for="org-name">Organization name</label><input
                id="org-name"
                name="name"
                type="text"
                required
                placeholder="Acme Home Services"
              />
            </div>
            <div class="field">
              <label for="org-slug">Slug</label><input
                id="org-slug"
                name="slug"
                type="text"
                required
                pattern="[a-z0-9-]+"
                placeholder="acme-home-services"
              /><span class="field-hint"
                >Lowercase letters, numbers, and hyphens only.</span
              >
            </div>
            <div class="field">
              <label for="org-type">Organization type</label><select
                id="org-type"
                name="organization_type"
              >
                <option value="client" selected>Client</option>
                <option value="partner">Partner</option>
                <option value="demo">Demo</option>
              </select>
            </div>
            <div class="field">
              <label for="org-industry-create">Industry</label><select
                id="org-industry-create"
                name="industry_id"
              >
                <option value="">Loading industries…</option>
              </select>
            </div>
            <div class="field">
              <label for="org-timezone">Timezone</label><input
                id="org-timezone"
                name="timezone"
                type="text"
                required
                value="America/Los_Angeles"
              />
            </div>
            <div class="field">
              <label for="org-currency">Default currency</label><input
                id="org-currency"
                name="default_currency"
                type="text"
                required
                value="USD"
                maxlength="3"
                style="text-transform: uppercase;"
              />
            </div>
            <div class="field--full form-actions">
              <button type="submit" class="button" id="create-org-submit"
                >Start onboarding this client</button
              >
            </div>
          </form>
        </section>

        <div id="client-workspace" hidden>
          <div class="stepper" id="onboarding-stepper">
            <button class="stepper__step" data-step="profile" type="button"
              ><span class="stepper__number">1</span>Profile</button
            >
            <div class="stepper__connector"></div>
            <button class="stepper__step" data-step="locations" type="button"
              ><span class="stepper__number">2</span>Locations</button
            >
            <div class="stepper__connector"></div>
            <button class="stepper__step" data-step="website" type="button"
              ><span class="stepper__number">3</span>Website</button
            >
            <div class="stepper__connector"></div>
            <button class="stepper__step" data-step="industry" type="button"
              ><span class="stepper__number">4</span>Industry</button
            >
            <div class="stepper__connector"></div>
            <button class="stepper__step" data-step="users" type="button"
              ><span class="stepper__number">5</span>Users</button
            >
            <div class="stepper__connector"></div>
            <button class="stepper__step" data-step="products" type="button"
              ><span class="stepper__number">6</span>Products</button
            >
            <div class="stepper__connector"></div>
            <button class="stepper__step" data-step="policies" type="button"
              ><span class="stepper__number">7</span>Policies</button
            >
            <div class="stepper__connector"></div>
            <button class="stepper__step" data-step="activate" type="button"
              ><span class="stepper__number">8</span>Activate</button
            >
            <div class="stepper__connector"></div>
            <button class="stepper__step" data-step="connect" type="button"
              ><span class="stepper__number">9</span>Connect</button
            >
          </div>

          <section aria-labelledby="progress-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow" id="workspace-org-name">Client</p><h2
                  id="progress-title"
                >
                  Onboarding progress
                </h2>
              </div>
              <span id="workspace-status-badge"></span>
            </div>
            <div
              class="progress-bar"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              id="progress-bar"
            >
              <div
                class="progress-bar__fill"
                id="progress-bar-fill"
                style="width: 0%"
              >
              </div>
            </div>
            <p id="progress-label">0% complete</p>
            <p id="progress-updated" class="field-hint"></p>
          </section>

          <section aria-labelledby="checklist-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Checklist</p><h2 id="checklist-title">
                  Onboarding steps
                </h2>
              </div>
            </div>
            <ul class="checklist" id="checklist-list"></ul>
          </section>

          <section id="section-profile" aria-labelledby="profile-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Step 1</p><h2 id="profile-title">
                  Organization profile
                </h2>
              </div>
            </div>
            <div id="profile-alert"></div>
            <div id="profile-status" class="empty-state" hidden></div>
            <form id="profile-form" class="form-grid" hidden>
              <div class="field field--full">
                <label for="profile-brand-name">Brand name</label><input
                  id="profile-brand-name"
                  name="brand_name"
                  type="text"
                />
              </div>
              <div class="field field--full">
                <label for="profile-description">Business description</label
                ><textarea
                  id="profile-description"
                  name="business_description"
                  rows="3"></textarea>
              </div>
              <div class="field--full form-actions">
                <button type="submit" class="button" id="profile-submit"
                  >Save profile</button
                >
              </div>
            </form>
          </section>

          <section id="section-locations" aria-labelledby="locations-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Step 2</p><h2 id="locations-title">
                  Locations
                </h2>
              </div>
            </div>
            <div id="locations-alert"></div>
            <ul class="product-list" id="locations-list"></ul>
            <h3 style="margin-top: 1.5rem;">Add a location</h3>
            <form
              id="create-location-form"
              class="form-grid"
              style="margin-top: 1rem;"
            >
              <div class="field">
                <label for="loc-name">Location name</label><input
                  id="loc-name"
                  name="name"
                  type="text"
                  required
                />
              </div>
              <div class="field">
                <label for="loc-slug">Slug</label><input
                  id="loc-slug"
                  name="slug"
                  type="text"
                  required
                  pattern="[a-z0-9-]+"
                />
              </div>
              <div class="field field--full">
                <label>Location type</label>
                <div class="radio-group">
                  <label
                    ><input
                      type="radio"
                      name="location_type"
                      value="physical"
                      checked
                    /> Physical</label
                  ><label
                    ><input
                      type="radio"
                      name="location_type"
                      value="service_area"
                    /> Service area</label
                  ><label
                    ><input type="radio" name="location_type" value="hybrid" /> Hybrid</label
                  ><label
                    ><input type="radio" name="location_type" value="virtual" /> Virtual</label
                  >
                </div>
              </div>
              <div class="field">
                <label for="loc-timezone">Timezone</label><input
                  id="loc-timezone"
                  name="timezone"
                  type="text"
                  required
                  value="America/Los_Angeles"
                />
              </div>
              <div class="field">
                <label for="loc-country">Country code</label><input
                  id="loc-country"
                  name="country_code"
                  type="text"
                  required
                  value="US"
                  maxlength="2"
                  style="text-transform: uppercase;"
                />
              </div>
              <div class="field field--full">
                <label for="loc-address">Street address</label><input
                  id="loc-address"
                  name="address_line_1"
                  type="text"
                  placeholder="123 Main St"
                />
              </div>
              <div class="field">
                <label for="loc-city">City</label><input
                  id="loc-city"
                  name="city"
                  type="text"
                />
              </div>
              <div class="field">
                <label for="loc-region">State / region</label><input
                  id="loc-region"
                  name="region"
                  type="text"
                />
              </div>
              <div class="field">
                <label for="loc-postal">Postal code</label><input
                  id="loc-postal"
                  name="postal_code"
                  type="text"
                />
              </div>
              <div class="field field--full">
                <label for="loc-service-area"
                  >Service area description (service-area or hybrid only)</label
                ><input
                  id="loc-service-area"
                  name="service_area_description"
                  type="text"
                />
              </div>
              <div class="field field--full">
                <label
                  ><input id="loc-primary" name="is_primary" type="checkbox" /> Mark
                  as the primary location</label
                >
              </div>
              <div class="field--full form-actions">
                <button type="submit" class="button" id="create-location-submit"
                  >Add location</button
                >
              </div>
            </form>
          </section>

          <section id="section-domain" aria-labelledby="domain-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Step 3</p><h2 id="domain-title">
                  Website and domain
                </h2>
              </div>
            </div>
            <div id="domain-alert"></div>
            <ul class="product-list" id="domains-list"></ul>
            <form
              id="create-domain-form"
              class="form-grid"
              style="margin-top: 1rem;"
            >
              <div class="field">
                <label for="domain-value">Domain</label><input
                  id="domain-value"
                  name="domain"
                  type="text"
                  required
                  placeholder="example.com"
                />
              </div>
              <div class="field">
                <label
                  ><input
                    id="domain-primary"
                    name="is_primary"
                    type="checkbox"
                    checked
                  /> Mark as primary domain</label
                >
              </div>
              <div class="field--full form-actions">
                <button type="submit" class="button" id="create-domain-submit"
                  >Add domain</button
                >
              </div>
            </form>
          </section>

          <section id="section-industry" aria-labelledby="industry-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Step 4</p><h2 id="industry-title">
                  Industry
                </h2>
              </div>
            </div>
            <div id="industry-alert"></div>
            <form id="assign-industry-form" class="form-grid">
              <div class="field field--full">
                <label for="industry-select">Industry</label><select
                  id="industry-select"
                  name="industry_id"
                >
                  <option value="">Loading industries…</option>
                </select>
              </div>
              <div class="field--full form-actions">
                <button type="submit" class="button" id="assign-industry-submit"
                  >Assign industry</button
                >
              </div>
            </form>
          </section>

          <section id="section-users" aria-labelledby="users-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Step 5</p><h2 id="users-title">
                  Users and access
                </h2>
              </div>
            </div>
            <div id="users-alert"></div>
            <p id="users-help" class="field-hint"></p>
            <button
              type="button"
              class="button button--secondary"
              id="bootstrap-owner-button">Add me as workspace owner</button
            >
            <h3 style="margin-top: 1.5rem;">Members</h3>
            <ul class="product-list" id="members-list"></ul>
            <h3 style="margin-top: 1.5rem;">Pending invitations</h3>
            <ul class="product-list" id="invitations-list"></ul>
            <h3 style="margin-top: 1.5rem;">Add or invite a user</h3>
            <form
              id="add-user-form"
              class="form-grid"
              style="margin-top: 1rem;"
            >
              <div class="field">
                <label for="user-email">Email</label><input
                  id="user-email"
                  name="email"
                  type="email"
                  required
                  placeholder="owner@client.example"
                />
              </div>
              <div class="field">
                <label for="user-membership-type">Membership type</label><select
                  id="user-membership-type"
                  name="membership_type"
                >
                  <option value="client" selected>Client</option>
                  <option value="internal">Internal</option>
                  <option value="partner">Partner</option>
                </select>
              </div>
              <div class="field--full form-actions">
                <button
                  type="submit"
                  class="button button--secondary"
                  id="add-existing-user-submit"
                  formnovalidate
                  data-action="add"
                  >Add existing user (activates immediately)</button
                ><button
                  type="submit"
                  class="button"
                  id="invite-user-submit"
                  formnovalidate
                  data-action="invite"
                  >Invite user (pending until accepted)</button
                >
              </div>
            </form>
          </section>

          <section id="section-products" aria-labelledby="products-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Step 6</p><h2 id="products-title">
                  Products
                </h2>
              </div>
            </div>
            <p id="products-help" class="field-hint"></p>
            <div id="products-alert"></div>
            <ul class="product-list" id="onboarding-products-list"></ul>
          </section>

          <section id="section-policies" aria-labelledby="policies-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Step 7</p><h2 id="policies-title">
                  Approval and notification policies
                </h2>
              </div>
            </div>
            <p id="policies-help" class="field-hint"></p>
            <h3>Approval policies</h3>
            <ul class="product-list" id="approval-policies-list"></ul>
            <form
              id="create-approval-policy-form"
              class="form-grid"
              style="margin-top: 1rem;"
            >
              <div class="field">
                <label for="approval-min-approvals">Minimum approvals</label
                ><input
                  id="approval-min-approvals"
                  name="minimum_approvals"
                  type="number"
                  min="1"
                  value="1"
                  required
                />
              </div>
              <div class="field field--full">
                <label
                  ><input
                    id="approval-self-approval"
                    name="self_approval_allowed"
                    type="checkbox"
                  /> Allow self-approval</label
                >
              </div>
              <div class="field--full form-actions">
                <button
                  type="submit"
                  class="button"
                  id="create-approval-policy-submit"
                  >Create approval policy</button
                >
              </div>
            </form>
            <h3 style="margin-top: 1.5rem;">Notification policies</h3>
            <ul class="product-list" id="notification-policies-list"></ul>
            <form
              id="create-notification-policy-form"
              class="form-grid"
              style="margin-top: 1rem;"
            >
              <div class="field--full form-actions">
                <button
                  type="submit"
                  class="button"
                  id="create-notification-policy-submit"
                  >Create notification policy</button
                >
              </div>
            </form>
          </section>

          <section id="section-activate" aria-labelledby="readiness-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Step 8</p><h2 id="readiness-title">
                  Readiness and activation
                </h2>
              </div>
            </div>
            <div id="readiness-alert"></div>
            <div id="blockers-panel"></div>
            <div id="warnings-panel"></div>
            <div
              id="activation-confirm"
              hidden
              class="attention-card attention-card--urgent"
            >
              <h3>Confirm activation</h3>
              <p id="activation-consequence-text"></p>
              <footer>
                <button
                  type="button"
                  class="button button--secondary"
                  id="activation-cancel">Cancel</button
                ><button
                  type="button"
                  class="button"
                  id="activation-confirm-button"
                  >Yes, activate this organization</button
                >
              </footer>
            </div>
            <button type="button" class="button" id="activate-button" disabled
              >Activate organization</button
            >
          </section>

          <section id="section-connect" aria-labelledby="connect-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Step 9</p><h2 id="connect-title">
                  Connect services and complete setup
                </h2>
              </div>
              <span id="connect-status"></span>
            </div>
            <p id="connect-help">
              Activate the client first. Then connect providers, map their
              resources, and confirm each enabled product’s operational
              readiness from the product workspace.
            </p>
            <div class="directory-grid">
              <a class="settings-card" href="/integrations">
                <div class="settings-card__title">Connect providers</div>
                <p class="settings-card__desc">
                  Authorize Google and GitHub capabilities without exposing
                  credentials.
                </p>
              </a>
              <a class="settings-card" href="/gbp">
                <div class="settings-card__title">Map Business Profile</div>
                <p class="settings-card__desc">
                  Confirm which discovered Google location belongs to this
                  client location.
                </p>
              </a>
              <a class="settings-card" href="/seo">
                <div class="settings-card__title">Verify website data</div>
                <p class="settings-card__desc">
                  Review the site, Search Console property, and first crawl.
                </p>
              </a>
              <a class="settings-card" href="/settings">
                <div class="settings-card__title">
                  Confirm product readiness
                </div>
                <p class="settings-card__desc">
                  Resolve remaining product requirements before handoff.
                </p>
              </a>
            </div>
          </section>
        </div>
      </div>
    </AppShell>
    <script>
      import {
        fetchIndustries,
        fetchOrganizations,
        fetchOrganization,
        createOrganization,
        startOnboarding,
        assignIndustry,
        fetchOrganizationLocations,
        createLocation,
        fetchOrganizationProfile,
        createOrganizationProfile,
        fetchOrganizationDomains,
        createOrganizationDomain,
        setPrimaryOrganizationDomain,
        bootstrapOwner,
        fetchOnboardingState,
        activateOrganization,
        type AdminOrganization,
        type AdminLocation,
        type Industry,
        type IndustriesResponse,
        type PaginatedOrganizations,
        type OnboardingState,
      } from "../lib/platform-admin";
      import {
        fetchProducts,
        fetchEffectivePolicies,
        createPolicy,
        approvePolicy,
        addExistingUser,
        inviteUser,
        fetchMemberships,
        fetchInvitations,
        type PolicyRevision,
      } from "../lib/administration";
      import {
        describeEntitlementRow,
        enableProduct,
        entitlementBadgeKind,
        loadEntitlementsByKey,
        reEnableProduct,
        type EntitlementRowState,
      } from "../lib/product-entitlements";
      import {
        fetchMyPlatformAdministratorStatus,
        fetchPrincipal,
        type PrincipalSummary,
      } from "../lib/workspace";
      import { getCurrentSession, signOut } from "../lib/session";
      import { readPublicConfig } from "../lib/config";
      import type { ApiOutcome } from "../lib/api-client";
      import {
        applyShellAudience,
        applyShellPrincipal,
        setPlatformAdminStatus,
      } from "../lib/ui";

      const regions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        notAdmin: document.getElementById("not-platform-admin")!,
        content: document.getElementById("onboarding-content")!,
      };

      function showOnly(region: HTMLElement): void {
        for (const key of Object.keys(regions) as (keyof typeof regions)[]) {
          regions[key].hidden = regions[key] !== region;
        }
      }

      // ---------- Boot diagnostics ----------
      //
      // Every boot() run gets its own correlation ID, and every stage it
      // passes through is logged with that ID via console.info — safe,
      // structured, and never including a token, secret, or code. This is
      // what lets a failure be tied to a specific attempt (and, via the
      // timestamp/route, to the matching backend request in server logs)
      // instead of only ever seeing one undifferentiated "loading error".

      let bootInFlight = false;
      let bootCorrelationId = "";
      let currentBootStage = "start";

      function newCorrelationId(): string {
        if (typeof crypto !== "undefined" && "randomUUID" in crypto) {
          return crypto.randomUUID();
        }
        return `boot-${Date.now()}-${Math.random().toString(36).slice(2)}`;
      }

      function logStage(
        stage: string,
        detail: Record<string, unknown> = {},
      ): void {
        currentBootStage = stage;
        console.info("[onboarding:boot]", {
          correlationId: bootCorrelationId,
          stage,
          ...detail,
        });
      }

      /**
       * Renders an operator-safe failure with a Retry control and guarantees
       * the page leaves the "Loading…" state — the one path every boot
       * failure (a timed-out/failed request, or any unexpected exception)
       * must reach, so onboarding can never hang indefinitely. Always names
       * the specific stage that failed and carries the boot correlation ID,
       * never a generic undifferentiated message.
       */
      function showBootError(stage: string, message: string): void {
        document.getElementById("boot-error-message")!.textContent =
          `${message} (stage: ${stage}, ref: ${bootCorrelationId})`;
        showOnly(regions.error);
      }

      function setRetryEnabled(enabled: boolean): void {
        (
          document.getElementById("boot-error-retry") as HTMLButtonElement
        ).disabled = !enabled;
      }

      function wireBootErrorRetry(): void {
        document
          .getElementById("boot-error-retry")!
          .addEventListener("click", () => {
            void boot();
          });
      }

      function describeFailure(outcome: ApiOutcome<unknown>): string {
        switch (outcome.kind) {
          case "forbidden":
            return "You do not have permission to perform this action.";
          case "not-found":
            return "The requested resource could not be found.";
          case "disconnected":
            return "Could not reach the platform API.";
          case "unauthenticated":
            return "Your session has expired. Sign in again.";
          case "not-configured":
            return "This deployment is not configured.";
          case "error":
            return outcome.message;
          case "ok":
            return "";
        }
      }

      function goToLogin(): void {
        const next = encodeURIComponent(
          window.location.pathname + window.location.search,
        );
        window.location.assign(`/login?next=${next}`);
      }

      function wireSignOut(): void {
        document
          .getElementById("sign-out-button")
          ?.addEventListener("click", async () => {
            await signOut();
            goToLogin();
          });
