      function lockPostActivationSection(
        sectionId: string,
        helpId: string,
        message: string,
      ): void {
        const help = document.getElementById(helpId);
        if (help) help.textContent = message;
        const section = document.getElementById(sectionId);
        if (!section) return;
        for (const control of section.querySelectorAll(
          "button, input, select, textarea",
        )) {
          (control as HTMLButtonElement | HTMLInputElement).disabled = true;
        }
      }

      function unlockSection(sectionId: string): void {
        const section = document.getElementById(sectionId);
        if (!section) return;
        for (const control of section.querySelectorAll(
          "button, input, select, textarea",
        )) {
          (control as HTMLButtonElement | HTMLInputElement).disabled = false;
        }
      }

