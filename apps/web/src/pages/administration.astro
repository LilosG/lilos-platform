---
import AppShell from "../components/AppShell.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content="LILOs Administration workspace" /><title
    >
      Administration · LILOs
    </title></head
  >
  <body
    ><AppShell>
      <div id="boot-not-configured" role="status">
        <h1>This deployment is not configured</h1><p>
          No Supabase or API connection is configured for this build.
        </p>
      </div>

      <div id="boot-loading" role="status" aria-live="polite" hidden>
        <p>Loading Administration…</p>
      </div>

      <div id="boot-error" role="alert" hidden></div>

      <div id="workspace-empty" role="status" hidden>
        <h1>No organization access yet</h1><p>
          Your account is not a member of any organization. Ask an administrator
          to invite you.
        </p>
      </div>

      <div id="administration-unauthorized" role="status" hidden>
        <h1>Administration access required</h1><p>
          This workspace is available to platform administrators and agency
          operators. If you believe you should have access, contact your
          organization administrator.
        </p>
      </div>

      <div id="administration-content" hidden>
        <div class="page-head">
          <div class="page-head__intro">
            <p class="eyebrow">Admin</p>
            <h1>Administration</h1>
            <p>
              Manage client organizations, locations, and product access for
              this workspace.
            </p>
          </div>
        </div>

        <section
          id="platform-admin-section"
          aria-labelledby="clients-title"
          hidden
        >
          <div class="section-heading">
            <div>
              <p class="eyebrow">Client organizations</p>
              <h2 id="clients-title">Onboard and manage clients</h2>
            </div>
            <a href="/onboarding" class="button button--secondary button--sm"
              >Open guided onboarding</a
            >
          </div>
          <div id="platform-admin-alert"></div>
          <div class="metric-grid" id="portfolio-metrics"></div>
          <ul class="product-list" id="clients-list"></ul>

          <div id="client-detail" hidden class="stack-top-6">
            <div class="attention-card" id="client-detail-body"></div>
            <h4 class="stack-top-6">Add a location</h4>
            <form id="create-location-form" class="form-grid stack-top-4">
              <div class="field">
                <label for="loc-name">Location name</label><input
                  id="loc-name"
                  name="name"
                  type="text"
                  required
                />
              </div>
              <div class="field">
                <label for="loc-slug">Slug</label><input
                  id="loc-slug"
                  name="slug"
                  type="text"
                  required
                  pattern="[a-z][a-z0-9-]*"
                />
              </div>
              <div class="field field--full">
                <label>Location type</label>
                <div class="radio-group">
                  <label
                    ><input
                      type="radio"
                      name="location_type"
                      value="physical"
                      checked
                    /> Physical</label
                  ><label
                    ><input
                      type="radio"
                      name="location_type"
                      value="service_area"
                    />
                    Service area</label
                  ><label
                    ><input type="radio" name="location_type" value="hybrid" /> Hybrid</label
                  ><label
                    ><input type="radio" name="location_type" value="virtual" /> Virtual</label
                  >
                </div>
              </div>
              <div class="field">
                <label for="loc-timezone">Timezone</label><input
                  id="loc-timezone"
                  name="timezone"
                  type="text"
                  required
                  value="America/Los_Angeles"
                />
              </div>
              <div class="field">
                <label for="loc-country">Country code</label><input
                  id="loc-country"
                  name="country_code"
                  type="text"
                  required
                  value="US"
                  maxlength="2"
                  class="text-uppercase"
                />
              </div>
              <div class="field field--full">
                <label for="loc-address">Street address</label><input
                  id="loc-address"
                  name="address_line_1"
                  type="text"
                  placeholder="123 Main St"
                />
              </div>
              <div class="field">
                <label for="loc-city">City</label><input
                  id="loc-city"
                  name="city"
                  type="text"
                />
              </div>
              <div class="field">
                <label for="loc-region">State / region</label><input
                  id="loc-region"
                  name="region"
                  type="text"
                />
              </div>
              <div class="field">
                <label for="loc-postal">Postal code</label><input
                  id="loc-postal"
                  name="postal_code"
                  type="text"
                />
              </div>
              <div class="field">
                <label for="loc-phone">Phone</label><input
                  id="loc-phone"
                  name="phone"
                  type="tel"
                />
              </div>
              <div class="field field--full">
                <label for="loc-service-area"
                  >Service area description (service-area or hybrid only)</label
                ><input
                  id="loc-service-area"
                  name="service_area_description"
                  type="text"
                />
              </div>
              <div class="field field--full">
                <label
                  ><input id="loc-primary" name="is_primary" type="checkbox" /> Mark
                  as primary location</label
                >
              </div>
              <div class="field--full form-actions">
                <button type="submit" class="button" id="create-location-submit"
                  >Add location</button
                >
              </div>
            </form>
          </div>

          <h3 class="stack-top-8">Create a client organization</h3>
          <form id="create-org-form" class="form-grid stack-top-4">
            <div class="field">
              <label for="org-name">Organization name</label><input
                id="org-name"
                name="name"
                type="text"
                required
                placeholder="Acme Home Services"
              />
            </div>
            <div class="field">
              <label for="org-slug">Slug</label><input
                id="org-slug"
                name="slug"
                type="text"
                required
                pattern="[a-z][a-z0-9-]*"
                placeholder="acme-home-services"
              /><span class="field-hint"
                >Lowercase letters, numbers, and hyphens only.</span
              >
            </div>
            <div class="field">
              <label for="org-type">Organization type</label><select
                id="org-type"
                name="organization_type"
              >
                <option value="client" selected>Client</option>
                <option value="partner">Partner</option>
                <option value="demo">Demo</option>
                <option value="internal">Internal</option>
                <option value="test">Test</option>
              </select>
            </div>
            <div class="field">
              <label for="org-industry">Industry</label><select
                id="org-industry"
                name="industry_id"
              >
                <option value="">Loading industries…</option>
              </select><span class="field-hint"
                >Required for client, partner, and demo organizations.</span
              >
            </div>
            <div class="field">
              <label for="org-timezone">Timezone</label><input
                id="org-timezone"
                name="timezone"
                type="text"
                required
                value="America/Los_Angeles"
              /><span class="field-hint">IANA timezone identifier.</span>
            </div>
            <div class="field">
              <label for="org-currency">Default currency</label><input
                id="org-currency"
                name="default_currency"
                type="text"
                required
                value="USD"
                maxlength="3"
                class="text-uppercase"
              />
            </div>
            <div class="field field--full">
              <label for="org-website">Website (optional)</label><input
                id="org-website"
                name="website_url"
                type="url"
                placeholder="https://example.com"
              />
            </div>
            <div class="field--full form-actions">
              <button type="submit" class="button" id="create-org-submit"
                >Create organization</button
              >
            </div>
          </form>
        </section>

        <div id="org-scoped-sections">
          <section aria-labelledby="products-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Products</p><h2 id="products-title">
                  Product catalog and readiness
                </h2>
              </div>
            </div><ul class="product-list" id="products-list"></ul>
          </section>

          <section aria-labelledby="services-title">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Services</p><h2 id="services-title">
                  Service catalog
                </h2>
              </div>
            </div><ul class="product-list" id="services-list"></ul>
          </section>
        </div>
      </div>
    </AppShell>
    <script>
      import {
        fetchProducts,
        fetchServices,
        type AdministeredProduct,
      } from "../lib/administration";
      import {
        fetchMyOrganizations,
        fetchMyPlatformAdministratorStatus,
        fetchPrincipal,
        fetchProductReadiness,
        PRODUCT_KEYS,
        type PrincipalSummary,
      } from "../lib/workspace";
      import { selectDefaultOrganization } from "../lib/dashboard-logic";
      import { getCurrentSession, signOut } from "../lib/session";
      import { readPublicConfig } from "../lib/config";
      import type { ApiOutcome } from "../lib/api-client";
      import {
        fetchIndustries,
        fetchOrganizations as fetchAdminOrganizations,
        createOrganization,
        startOnboarding,
        activateOrganization,
        fetchOrganizationLocations,
        createLocation,
        activateLocation,
        bootstrapOwner,
        type AdminOrganization,
        type AdminLocation,
      } from "../lib/platform-admin";
      import {
        describeEntitlementRow,
        enableProduct,
        entitlementBadgeKind,
        loadEntitlementsByKey,
        reEnableProduct,
        type EntitlementRowState,
        type ProductEntitlementMap,
      } from "../lib/product-entitlements";
      import { withBootBoundary } from "../lib/boot-boundary";
      import {
        applyShellAudience,
        applyShellPrincipal,
        setPlatformAdminStatus,
        metricCard,
      } from "../lib/ui";
      import { statusLabel } from "../lib/status-language";

      const regions = {
        notConfigured: document.getElementById("boot-not-configured")!,
        loading: document.getElementById("boot-loading")!,
        error: document.getElementById("boot-error")!,
        empty: document.getElementById("workspace-empty")!,
        unauthorized: document.getElementById("administration-unauthorized")!,
        content: document.getElementById("administration-content")!,
      };

      let organizationId = "";

      function showOnly(region: HTMLElement): void {
        for (const key of Object.keys(regions) as (keyof typeof regions)[]) {
          regions[key].hidden = regions[key] !== region;
        }
      }

      function describeFailure(outcome: ApiOutcome<unknown>): string {
        switch (outcome.kind) {
          case "forbidden":
            return "You do not have permission to view Administration for this organization.";
          case "not-found":
            return "The requested resource could not be found.";
          case "disconnected":
            return "Could not reach the platform API.";
          case "unauthenticated":
            return "Your session has expired. Sign in again.";
          case "not-configured":
            return "This deployment is not configured.";
          case "error":
            return outcome.message;
          case "ok":
            return "";
        }
      }

      function goToLogin(): void {
        const next = encodeURIComponent(window.location.pathname);
        window.location.assign(`/login?next=${next}`);
      }

      function wireSignOut(): void {
        document
          .getElementById("sign-out-button")
          ?.addEventListener("click", async () => {
            await signOut();
            goToLogin();
          });
      }

      function badge(status: string, label = status): HTMLSpanElement {
        const el = document.createElement("span");
        el.className = `status status--${status}`;
        const dot = document.createElement("span");
        dot.setAttribute("aria-hidden", "true");
        dot.className = "status__dot";
        el.append(dot, document.createTextNode(label));
        return el;
      }

      let currentPrincipal: PrincipalSummary | null = null;
      let selectedClientOrganization: AdminOrganization | null = null;
      let administrationIsPlatformAdmin = false;
      let administrationEntitlementsByKey: ProductEntitlementMap = new Map();

      function platformAlert(kind: "error" | "success", message: string): void {
        const container = document.getElementById("platform-admin-alert")!;
        container.replaceChildren();
        const alert = document.createElement("div");
        alert.className = `alert alert--${kind}`;
        alert.setAttribute("role", kind === "error" ? "alert" : "status");
        const p = document.createElement("p");
        p.textContent = message;
        alert.append(p);
        container.append(alert);
      }

      async function renderServices(): Promise<void> {
        const list = document.getElementById("services-list")!;
        list.replaceChildren();
        const outcome = await fetchServices(organizationId);
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No services are configured yet.";
          list.append(item);
          return;
        }
        for (const service of outcome.data) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const title = document.createElement("h3");
          title.textContent = service.name;
          info.append(title);
          item.append(
            info,
            badge(
              service.status === "active" ? "ready" : "setup",
              service.status,
            ),
          );
          list.append(item);
        }
      }

      async function renderProducts(): Promise<void> {
        const list = document.getElementById("products-list")!;
        list.replaceChildren();
        const outcome = await fetchProducts(organizationId);
        // Build product_id -> product_key so entitlement rows (which carry
        // product_id) can be associated with the stable product key the rest
        // of the UI uses. The entitlement rows are only loaded when the
        // caller is a platform administrator (the platform-admin entitlement
        // routes require an active platform-admin grant); a non-admin still
        // sees the truthful readiness badge below, but no Enable control.
        const productIdToKey = new Map<string, string>();
        if (outcome.kind === "ok") {
          for (const product of outcome.data) {
            productIdToKey.set(product.id, product.key);
          }
        }
        if (administrationIsPlatformAdmin) {
          const loaded = await loadEntitlementsByKey(
            organizationId,
            productIdToKey,
          );
          administrationEntitlementsByKey = loaded.byKey;
        } else {
          administrationEntitlementsByKey = new Map();
        }
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(outcome);
          list.append(item);
          return;
        }
        if (outcome.data.length === 0) {
          const item = document.createElement("li");
          item.textContent = "No products are registered yet.";
          list.append(item);
          return;
        }
        const byKey = new Map(
          outcome.data.map((product) => [product.key, product]),
        );
        for (const key of PRODUCT_KEYS) {
          const product = byKey.get(key);
          list.append(await productRow(key, product));
        }
        for (const product of outcome.data) {
          if (
            !PRODUCT_KEYS.includes(product.key as (typeof PRODUCT_KEYS)[number])
          ) {
            list.append(await productRow(product.key, product));
          }
        }
      }

      /**
       * Wire the same shared Enable / Restore-to-setup_required control used
       * by /onboarding, so the two pages never diverge in entitlement
       * behavior. After a successful POST the readiness/entitlement state is
       * refreshed immediately. Lifecycle guards remain backend-owned; a
       * transition the current status does not permit is rendered as a
       * truthful failure rather than retried.
       */
      function wireAdminEntitlementAction(
        state: EntitlementRowState,
      ): HTMLButtonElement | null {
        if (!administrationIsPlatformAdmin) return null;
        const alert = (kind: "error" | "success", message: string) => {
          const container = document.getElementById("platform-admin-alert");
          if (!container) return;
          const box = document.createElement("div");
          box.className = `alert alert--${kind}`;
          box.setAttribute("role", kind === "error" ? "alert" : "status");
          const p = document.createElement("p");
          p.textContent = message;
          box.append(p);
          container.replaceChildren(box);
        };

        const button = document.createElement("button");
        button.type = "button";
        button.className = "button button--secondary button--sm";

        if (state.canEnable) {
          button.textContent = "Enable";
          button.title =
            "Enable this product for initial setup through the governed administration API.";
          button.addEventListener("click", async () => {
            button.disabled = true;
            button.textContent = "Enabling…";
            const result = await enableProduct(
              organizationId,
              state.productKey,
              `Enable ${state.productKey} from Administration.`,
            );
            if (result.kind !== "ok") {
              button.disabled = false;
              button.textContent = "Enable";
              alert("error", describeFailure(result));
              return;
            }
            alert("success", `${state.productKey} enabled.`);
            await renderProducts();
          });
          return button;
        }

        if (state.canReEnable && state.entitlement !== null) {
          const entitlement = state.entitlement;
          button.textContent = "Restore to setup required";
          button.title =
            "Restores this deliberately disabled or suspended product to its initial setup state.";
          button.addEventListener("click", async () => {
            button.disabled = true;
            button.textContent = "Restoring…";
            const result = await reEnableProduct(
              organizationId,
              entitlement,
              `Operator restored ${state.productKey} entitlement to its initial setup state from Administration.`,
            );
            if (result.kind !== "ok") {
              button.disabled = false;
              button.textContent = "Restore to setup required";
              alert("error", describeFailure(result));
              return;
            }
            alert("success", `${state.productKey} restored.`);
            await renderProducts();
          });
          return button;
        }

        return null;
      }

      async function productRow(
        key: string,
        product: AdministeredProduct | undefined,
      ): Promise<HTMLLIElement> {
        const item = document.createElement("li");
        const info = document.createElement("div");
        const title = document.createElement("h3");
        title.textContent = product?.name ?? key;
        const meta = document.createElement("p");
        meta.textContent =
          product?.description ?? "Not registered for this deployment.";
        info.append(title, meta);
        const actions = document.createElement("div");
        actions.style.display = "flex";
        actions.style.flexDirection = "column";
        actions.style.gap = "0.5rem";
        actions.style.alignItems = "flex-end";
        // Truthful readiness state from the per-organization readiness route.
        const readiness = await fetchProductReadiness(
          organizationId,
          key as Parameters<typeof fetchProductReadiness>[1],
        );
        // Truthful entitlement state from the platform-administration
        // entitlement route (loaded once per renderProducts pass). Reused
        // by /onboarding so the two pages cannot diverge.
        const entitlement = administrationEntitlementsByKey.get(key) ?? null;
        const rowState = describeEntitlementRow(key, entitlement);
        const readinessLabel =
          readiness.kind === "ok"
            ? readiness.data.readiness_state === "not_entitled"
              ? "setup"
              : readiness.data.readiness_state
            : "blocked";
        actions.append(badge(readinessLabel));
        // Render the truthful entitlement lifecycle state alongside the
        // readiness badge, instead of only the readiness badge. The badge
        // alone hid the case where no entitlement row existed at all (the
        // release-blocking GBP symptom).
        const entBadge = document.createElement("span");
        entBadge.className = `status status--${
          entitlement === null
            ? "blocked"
            : entitlementBadgeKind(entitlement.status)
        }`;
        const entDot = document.createElement("span");
        entDot.setAttribute("aria-hidden", "true");
        entDot.className = "status__dot";
        entBadge.append(entDot);
        entBadge.append(
          document.createTextNode(
            entitlement === null
              ? "No entitlement"
              : statusLabel(entitlement.status),
          ),
        );
        actions.append(entBadge);
        // Operator action: Enable (no entitlement) or Restore
        // (not_enabled/suspended). Archived is terminal; an existing
        // effective entitlement is never recreated.
        const action = wireAdminEntitlementAction(rowState);
        if (action !== null) actions.append(action);
        item.append(info, actions);
        return item;
      }

      async function renderClientDetail(
        organization: AdminOrganization,
      ): Promise<void> {
        selectedClientOrganization = organization;
        const detail = document.getElementById("client-detail")!;
        const body = document.getElementById("client-detail-body")!;
        detail.hidden = false;
        body.replaceChildren();

        const title = document.createElement("h3");
        title.textContent = organization.name;
        const meta = document.createElement("p");
        meta.textContent = `${humanize(organization.organization_type)} · ${humanize(organization.status)}`;
        body.append(title, meta);

        const actions = document.createElement("div");
        actions.className = "hero__actions";
        const onboardingLink = document.createElement("a");
        onboardingLink.href = `/onboarding?org=${organization.id}`;
        onboardingLink.className = "button button--secondary button--sm";
        onboardingLink.textContent = "Continue in guided onboarding";
        actions.append(onboardingLink);
        if (
          organization.status === "prospect" ||
          organization.status === "onboarding"
        ) {
          const activateButton = document.createElement("button");
          activateButton.type = "button";
          activateButton.className = "button button--secondary button--sm";
          activateButton.textContent = "Activate organization";
          activateButton.addEventListener("click", async () => {
            let current = organization;
            if (current.status === "prospect") {
              const started = await startOnboarding(
                current.id,
                current.version,
              );
              if (started.kind !== "ok") {
                platformAlert("error", describeFailure(started));
                return;
              }
              current = started.data;
            }
            const activated = await activateOrganization(
              current.id,
              current.version,
            );
            if (activated.kind !== "ok") {
              platformAlert("error", describeFailure(activated));
              return;
            }
            platformAlert("success", `${activated.data.name} is now active.`);
            await renderClientsList();
            await renderClientDetail(activated.data);
          });
          actions.append(activateButton);
        }
        if (currentPrincipal) {
          const ownerButton = document.createElement("button");
          ownerButton.type = "button";
          ownerButton.className = "button button--secondary button--sm";
          ownerButton.textContent = "Add me as workspace owner";
          ownerButton.title =
            "Grants you the owner role in this client's workspace so you can assign products and manage it.";
          ownerButton.addEventListener("click", async () => {
            const result = await bootstrapOwner(organization.id, {
              auth_user_id: currentPrincipal!.auth_user_id,
            });
            if (result.kind !== "ok") {
              platformAlert("error", describeFailure(result));
              return;
            }
            platformAlert(
              "success",
              result.data.owner_role_assignment_created
                ? "You are now the owner of this client's workspace."
                : "You already have owner access to this client's workspace.",
            );
          });
          actions.append(ownerButton);
        }
        body.append(actions);

        const locationsHeading = document.createElement("h4");
        locationsHeading.textContent = "Locations";
        locationsHeading.style.marginTop = "1.5rem";
        const locationsList = document.createElement("ul");
        locationsList.className = "product-list";
        body.append(locationsHeading, locationsList);

        const locations = await fetchOrganizationLocations(organization.id);
        if (locations.kind !== "ok") {
          const item = document.createElement("li");
          item.textContent = describeFailure(locations);
          locationsList.append(item);
        } else if (locations.data.items.length === 0) {
          const empty = document.createElement("div");
          empty.className = "empty-state";
          empty.innerHTML =
            "<h3>No locations yet</h3><p>Add this client's first location using the form below.</p>";
          locationsList.replaceWith(empty);
        } else {
          for (const location of locations.data.items) {
            locationsList.append(renderLocationRow(organization, location));
          }
        }
      }

      function renderLocationRow(
        organization: AdminOrganization,
        location: AdminLocation,
      ): HTMLLIElement {
        const item = document.createElement("li");
        const info = document.createElement("div");
        const title = document.createElement("h3");
        title.textContent =
          location.name + (location.is_primary ? " (primary)" : "");
        const meta = document.createElement("p");
        meta.textContent = `${statusLabel(location.location_type)} · ${statusLabel(location.status)}`;
        info.append(title, meta);
        const actionsCell = document.createElement("div");
        if (location.status === "setup_required") {
          const activateButton = document.createElement("button");
          activateButton.type = "button";
          activateButton.className = "button button--secondary button--sm";
          activateButton.textContent = "Activate";
          activateButton.addEventListener("click", async () => {
            const activated = await activateLocation(
              organization.id,
              location.id,
              location.version,
            );
            if (activated.kind !== "ok") {
              platformAlert("error", describeFailure(activated));
              return;
            }
            platformAlert("success", `${activated.data.name} is now active.`);
            await renderClientDetail(organization);
          });
          actionsCell.append(activateButton);
        } else {
          actionsCell.append(
            badge(location.status === "active" ? "ready" : "setup"),
          );
        }
        item.append(info, actionsCell);
        return item;
      }

      async function renderClientsList(): Promise<void> {
        const list = document.getElementById("clients-list")!;
        const metrics = document.getElementById("portfolio-metrics")!;
        list.replaceChildren();
        metrics.replaceChildren();
        const outcome = await fetchAdminOrganizations();
        if (outcome.kind !== "ok") {
          const item = document.createElement("li");
          item.setAttribute("role", "alert");
          item.append(
            Object.assign(document.createElement("p"), {
              className: "alert alert--error",
              textContent: describeFailure(outcome),
            }),
          );
          list.append(item);
          return;
        }
        if (outcome.data.items.length === 0) {
          const empty = document.createElement("li");
          empty.className = "empty-state";
          empty.innerHTML =
            "<h3>No client organizations yet</h3><p>Create the first one using the form below.</p>";
          list.append(empty);
          return;
        }
        renderPortfolioMetrics(outcome.data.items);
        for (const organization of outcome.data.items) {
          const item = document.createElement("li");
          const info = document.createElement("div");
          const title = document.createElement("h3");
          title.textContent = organization.name;
          const meta = document.createElement("p");
          meta.textContent = humanize(organization.organization_type);
          info.append(title, meta);
          const actionsCell = document.createElement("div");
          actionsCell.append(
            badge(
              organization.status === "active" ? "ready" : "setup",
              organization.status,
            ),
          );
          const manageButton = document.createElement("button");
          manageButton.type = "button";
          manageButton.className = "button button--secondary button--sm";
          manageButton.textContent = "Manage";
          manageButton.style.marginLeft = "0.6rem";
          manageButton.addEventListener("click", () => {
            void renderClientDetail(organization);
          });
          actionsCell.append(manageButton);
          item.append(info, actionsCell);
          list.append(item);
        }
      }

      function renderPortfolioMetrics(
        organizations: AdminOrganization[],
      ): void {
        const panel = document.getElementById("portfolio-metrics")!;
        panel.replaceChildren();
        const count = (statuses: string[]) =>
          organizations.filter((organization) =>
            statuses.includes(organization.status),
          ).length;
        panel.append(
          metricCard(
            "Clients",
            String(organizations.length),
            "Visible portfolio",
          ),
          metricCard(
            "Active",
            String(count(["active"])),
            "Live client workspaces",
          ),
          metricCard(
            "Onboarding",
            String(count(["prospect", "onboarding"])),
            "Setup in progress",
          ),
          metricCard(
            "Needs review",
            String(count(["paused", "offboarding", "suspended"])),
            "Lifecycle attention",
          ),
        );
      }

      function humanize(value: string): string {
        return statusLabel(value);
      }

      async function populateIndustries(): Promise<void> {
        const select = document.getElementById(
          "org-industry",
        ) as HTMLSelectElement;
        const industries = await fetchIndustries();
        if (industries.kind !== "ok") {
          select.innerHTML = '<option value="">Unavailable</option>';
          return;
        }
        select.innerHTML =
          '<option value="">No industry (internal/test organizations only)</option>' +
          industries.data.items
            .map(
              (industry) =>
                `<option value="${industry.id}">${industry.name}</option>`,
            )
            .join("");
      }

      function wireCreateOrganizationForm(): void {
        const form = document.getElementById(
          "create-org-form",
        ) as HTMLFormElement;
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const data = new FormData(form);
          const industryId = String(data.get("industry_id") ?? "");
          const outcome = await createOrganization({
            name: String(data.get("name") ?? ""),
            slug: String(data.get("slug") ?? ""),
            organization_type: data.get(
              "organization_type",
            ) as AdminOrganization["organization_type"],
            timezone: String(data.get("timezone") ?? ""),
            default_currency: String(
              data.get("default_currency") ?? "",
            ).toUpperCase(),
            industry_id: industryId || null,
            website_url: String(data.get("website_url") ?? "") || null,
          });
          if (outcome.kind !== "ok") {
            platformAlert("error", describeFailure(outcome));
            return;
          }
          platformAlert("success", `${outcome.data.name} was created.`);
          form.reset();
          await renderClientsList();
          await renderClientDetail(outcome.data);
        });
      }

      function wireCreateLocationForm(): void {
        const form = document.getElementById(
          "create-location-form",
        ) as HTMLFormElement;
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!selectedClientOrganization) {
            platformAlert(
              "error",
              "Select a client organization to manage first.",
            );
            return;
          }
          const data = new FormData(form);
          const outcome = await createLocation(selectedClientOrganization.id, {
            name: String(data.get("name") ?? ""),
            slug: String(data.get("slug") ?? ""),
            location_type: data.get(
              "location_type",
            ) as AdminLocation["location_type"],
            timezone: String(data.get("timezone") ?? ""),
            country_code: String(data.get("country_code") ?? "").toUpperCase(),
            address_line_1: String(data.get("address_line_1") ?? "") || null,
            city: String(data.get("city") ?? "") || null,
            region: String(data.get("region") ?? "") || null,
            postal_code: String(data.get("postal_code") ?? "") || null,
            phone: String(data.get("phone") ?? "") || null,
            service_area_description:
              String(data.get("service_area_description") ?? "") || null,
            is_primary: data.get("is_primary") === "on",
          });
          if (outcome.kind !== "ok") {
            platformAlert("error", describeFailure(outcome));
            return;
          }
          platformAlert("success", `${outcome.data.name} was added.`);
          form.reset();
          await renderClientDetail(selectedClientOrganization);
        });
      }

      async function renderPlatformAdmin(): Promise<boolean> {
        const probe = await fetchAdminOrganizations();
        if (probe.kind !== "ok") {
          return false;
        }
        document.getElementById("platform-admin-section")!.hidden = false;
        await populateIndustries();
        wireCreateOrganizationForm();
        wireCreateLocationForm();
        await renderClientsList();
        return true;
      }

      async function boot(): Promise<void> {
        if (!readPublicConfig()) {
          showOnly(regions.notConfigured);
          return;
        }
        showOnly(regions.loading);

        const session = await getCurrentSession();
        if (session.status !== "signed-in") {
          goToLogin();
          return;
        }

        const principal = await fetchPrincipal();
        if (principal.kind === "unauthenticated") {
          goToLogin();
          return;
        }
        if (principal.kind !== "ok") {
          regions.error.textContent = describeFailure(principal);
          showOnly(regions.error);
          return;
        }
        applyShellPrincipal(principal.data);
        const signOutButton = document.getElementById("sign-out-button")!;
        signOutButton.hidden = false;
        wireSignOut();
        currentPrincipal = principal.data;

        const adminStatus = await fetchMyPlatformAdministratorStatus();
        setPlatformAdminStatus({
          is_platform_administrator:
            adminStatus.kind === "ok" &&
            adminStatus.data.is_platform_administrator,
          meets_required_assurance:
            adminStatus.kind === "ok" &&
            adminStatus.data.meets_required_assurance,
        });
        if (
          adminStatus.kind === "ok" &&
          adminStatus.data.is_platform_administrator
        ) {
          applyShellAudience("internal");
        }
        if (
          adminStatus.kind === "ok" &&
          adminStatus.data.is_platform_administrator &&
          !adminStatus.data.meets_required_assurance
        ) {
          const next = encodeURIComponent(
            window.location.pathname + window.location.search,
          );
          window.location.assign(`/mfa?next=${next}`);
          return;
        }

        const isPlatformAdmin = await renderPlatformAdmin();
        administrationIsPlatformAdmin = isPlatformAdmin;

        const organizations = await fetchMyOrganizations();
        if (organizations.kind === "unauthenticated") {
          goToLogin();
          return;
        }
        if (organizations.kind !== "ok") {
          regions.error.textContent = describeFailure(organizations);
          showOnly(regions.error);
          return;
        }
        const hasAgencyMembership = organizations.data.some((org) =>
          ["internal", "partner", "support"].includes(org.membership_type),
        );
        if (!isPlatformAdmin && !hasAgencyMembership) {
          showOnly(regions.unauthorized);
          return;
        }
        const organization =
          organizations.data.length > 0
            ? selectDefaultOrganization(organizations.data)
            : null;
        if (!organization) {
          if (isPlatformAdmin) {
            document.getElementById("org-scoped-sections")!.hidden = true;
            document.getElementById("active-organization-name")!.textContent =
              "No personal workspace yet";
            showOnly(regions.content);
            return;
          }
          showOnly(regions.empty);
          return;
        }
        organizationId = organization.organization_id;
        document.getElementById("active-organization-name")!.textContent =
          organization.organization_name;
        applyShellAudience(organization.membership_type);

        await Promise.all([renderProducts(), renderServices()]);

        showOnly(regions.content);
      }

      // Final boot failure boundary: an unexpected exception during boot
      // (the production `data.map is not a function` class of bug) must
      // never leave the page permanently on "Loading Administration…".
      // Render the existing truthful error region instead. Known, expected
      // failures are still classified and rendered inside `boot` itself.
      void withBootBoundary(regions, boot, (error) =>
        error instanceof Error && error.message
          ? `Administration failed to load: ${error.message}`
          : "Administration failed to load unexpectedly.",
      );
    </script>
  </body>
</html>
