---
interface Props {
  id?: string;
  as?: "div" | "form";
  align?: "start" | "center" | "end";
  spread?: boolean;
  hidden?: boolean;
  class?: string;
}

const {
  id,
  as: Element = "div",
  align = "center",
  spread = false,
  hidden = false,
  class: className,
}: Props = Astro.props;
---

<Element
  id={id}
  class:list={[
    "ui-inline",
    `ui-inline--${align}`,
    spread && "ui-inline--spread",
    className,
  ]}
  hidden={hidden}
>
  <slot />
</Element>
