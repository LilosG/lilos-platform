---
interface Props {
  id?: string;
  minimum?: "sm" | "md" | "lg";
  class?: string;
  hidden?: boolean;
}
const { id, minimum = "md", class: className, hidden = false } = Astro.props;
---

<div id={id} class:list={["ui-card-grid", `ui-card-grid--${minimum}`, className]} hidden={hidden}>
  <slot />
</div>
