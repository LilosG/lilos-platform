---
interface Props {
  id?: string;
  as?: "div" | "section" | "article" | "form";
  gap?: "1" | "2" | "3" | "4" | "5" | "6" | "8";
  hidden?: boolean;
  class?: string;
}

const {
  id,
  as: Element = "div",
  gap = "4",
  hidden = false,
  class: className,
}: Props = Astro.props;
---

<Element
  id={id}
  class:list={["ui-stack", `ui-stack--${gap}`, className]}
  hidden={hidden}
>
  <slot />
</Element>
