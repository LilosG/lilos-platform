---
import type { AstroComponent } from "@lucide/astro";

interface Props {
  icon: AstroComponent;
  label?: string;
  size?: "sm" | "md" | "lg";
  class?: string;
  state?: "default" | "loading" | "error";
  active?: boolean;
  disabled?: boolean;
}

const {
  icon: LucideIcon,
  label,
  size = "md",
  class: className,
  state = "default",
  active = false,
  disabled = false,
} = Astro.props;
---

<LucideIcon
  class:list={["ui-icon", `ui-icon--${size}`, className]}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  focusable="false"
  data-state={state}
  data-active={active ? "true" : undefined}
  aria-disabled={disabled ? "true" : undefined}
/>
